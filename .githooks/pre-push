#!/bin/bash
# ClinicFinder pre-push hook — verifies site builds + internal links before push
# Catches: broken imports, bad data, template errors, missing files, dead links
# All must pass or push is blocked.
#
# VERSIONED HOOK (tracked in git, source of truth). Activate via:
#     git config core.hooksPath .githooks
# core.hooksPath is machine-local (not tracked) — a fresh clone runs that once.
# See .githooks/README.md.

set -e

SITE_DIR="$(git rev-parse --show-toplevel)"

# ── Build serialisation (#1478 / #1493) ──────────────────────────
# This checkout is shared: keeper crons, grind lanes and interactive sessions
# all push from it, and every one of them runs `rm -rf dist && npx astro build`
# in this hook. Two of them overlapping corrupt each other's dist, and the
# resulting failure wears the uniform of a defect in your own change. That is
# not hypothetical on this machine: on 2026-08-28 franchisevs lost two lanes to
# it in one morning and daycarecostguide had three pushes blocked in a row
# (ERR_MODULE_NOT_FOUND, ENOENT partway through `dist`, then a gate reporting a
# page family as "not built" seconds after it existed). CF is the lowest-volume
# of the four repos, which lowers the odds and does not change the mechanism:
# its keeper, its regulatory scan and any interactive lane share this one dist.
# MEASURED on this repo's own history (the retirement condition #1478's
# baseline named): of the 78 consecutive commit gaps since 2026-08-01,
# 38 (48%) are under 15 minutes and 25 under 5. This hook's window
# overlaps the next push's window most of the time, exactly as on franchisevs.
#
# The lock is held on fd 9 by THIS shell for as long as this hook lives. flock
# belongs to the open file description, not to a process, so the kernel
# releases it when the hook dies by ANY means — SIGKILL and OOM included.
# There is no stale-lock state, no staleness rule to get wrong and no live-PID
# probe that could mis-decide. NOT a `trap ... EXIT`: #837 prototyped and
# rejected that, because a bash trap cannot run on SIGKILL and an OOM kill IS
# SIGKILL.
#
# HELD ON AN fd RATHER THAN WRAPPING THE HOOK, and that is not a style choice.
# #1478's first version re-exec'd the whole hook under `build-serialize.py
# lock`. tools/pre-push-gate-check.py proves gates execute by tracing this hook
# with every external command NEUTERED, so a wrapper's shimmed `python3`
# returns 0 and swallows everything after it — franchisevs' 11 declared gates
# traced as 1, i.e. the fix would have disarmed an existing guard (#1116). An
# fd lock wraps nothing: every gate below stays a direct command in the trace.
#
# Keyed on $SITE_DIR, so a linked worktree does NOT queue behind the main
# checkout — it has its own dist. Only lanes sharing ONE checkout serialise,
# which is the case that corrupts. The wait is BOUNDED and a timeout FAILS LOUD
# rather than proceeding unlocked; proceeding unlocked would reinstate the race
# silently, the #818 fail-open shape.
#
# The call is UNCONDITIONAL. Guarding it behind an existence test would make
# pre-push-gate-check report GATE_DECLARED_BUT_NOT_EXECUTED, turning an
# existing guard red (#1116).
BS_LOCKFILE="/tmp/build-serialize$(printf '%s' "$SITE_DIR" | tr / -).lock"
exec 9>"$BS_LOCKFILE"
BS_LOCK_STATUS=0
python3 /Users/jake/dev/product-pipeline-1/tools/build-serialize.py acquire --fd 9 --resource "astro-build:$SITE_DIR" --timeout 3600 || BS_LOCK_STATUS=$?
if [ "$BS_LOCK_STATUS" -eq 75 ]; then
    echo ""
    echo "PUSH BLOCKED: another lane has been building in this checkout for"
    echo "  longer than the bound. NOT proceeding unlocked. Do NOT clear dist/:"
    echo "  that breaks the in-flight build's hook (#1478). Re-push when it ends."
    exit 1
elif [ "$BS_LOCK_STATUS" -ne 0 ]; then
    echo "[WARN] build-serialize unavailable (exit $BS_LOCK_STATUS) — this build is"
    echo "       NOT serialised against other lanes in this checkout (#1478)."
fi

echo "═══════════════════════════════════════════════════"
echo "  ClinicFinder Pre-Push: Build + Link Verification"
echo "═══════════════════════════════════════════════════"
echo ""

# ── Build check ──────────────────────────────────────────────────
echo "▸ Running astro build..."
cd "$SITE_DIR"
rm -rf dist
npx astro build 2>&1

if [ $? -ne 0 ]; then
    echo ""
    echo "✗ PUSH BLOCKED — astro build failed."
    exit 1
fi

# Record WHICH TREE and WHICH SOURCE STATE produced this dist (#1478). The
# `verify` gate below reads it; without the stamp that gate can only answer
# UNSTAMPED, which is "cannot vouch", never "fine".
python3 /Users/jake/dev/product-pipeline-1/tools/build-serialize.py stamp --repo "$SITE_DIR" --output dist || true

# ── Dead-link scan (static internal-link integrity) ──────────────
# Reuses the dist just built above (no --build). Catches inline-editorial
# 404s. 0 broken across 36,931 hrefs when added (2026-06-10).
echo ""
echo "▸ Running dead-link scan (static internal links)..."
if ! python3 /Users/jake/dev/product-pipeline-1/tools/dead-link-scan.py "$SITE_DIR"; then
    echo ""
    echo "✗ PUSH BLOCKED — dead-link scan found broken internal links."
    echo "  Fix the broken hrefs and re-push."
    exit 1
fi

# ── Vitest suites — ALL 14 (#1239a) ──────────────────────────────
# This hook did not contain the string `vitest` at all until 2026-08-19, while
# 14 suites / 315 assertions sat in tests/. So tests/seo-integrity.test.ts had
# NEVER gated a push, and CF — the portfolio's #1 site by clicks and impressions
# — was serving 15 duplicate-title groups, the worst being 12 pages all titled
# "health care — Clinic in Mpumalanga, Ehlanzeni District" across three locales.
# The suite that asserts zero duplicate titles was green in the repo and unrun.
#
# Runs AFTER the build, before the parity check: seo-integrity, sitemap,
# routing-integrity, build-output, page-completeness and performance all walk
# dist/. ~12s on this corpus — there is no cost argument.
#
# If you ever narrow this, prove what actually runs with
#   python3 /Users/jake/dev/product-pipeline-1/tools/pre-push-gate-check.py --repo .
# A declared gate is not a running gate (#1116).
echo ""

# ── Build provenance (#1478 / #1493) ─────────────────────────────
# Every gate from here down reads dist/. If another lane rebuilt or cleared it
# after the build above, those gates fail describing a symptom — a missing
# sample page, a wrong meta description, a nav link that is not there — and
# every one of those reads as a regression in YOUR change. On 2026-08-28 that
# cost daycarecostguide two blocked pushes: 7 vitest failures naming
# meta-descriptions and nav links, all dist-in-flux artifacts that passed
# unchanged on re-run. CF runs 14 vitest suites plus numeric-parity off dist
# here, and numeric-parity compares RENDERED text across 2,240 page pairs, so a
# half-written dist reads as a translation dropping digits from clinical
# figures — the most alarming false alarm this repo can produce. `verify` names
# the cause instead: FOREIGN_TREE, STALE_SOURCE
# or DIST_MISSING. Do NOT recover a hit by clearing dist — that destructive
# recovery is the thing #1478 exists to retire. Rebuild by re-pushing.
# Advisory-to-loud, never fail-open: exit 2 (UNSTAMPED) is reported and
# allowed, exit 1 (FOREIGN_TREE / STALE_SOURCE / DIST_MISSING) blocks.
BS_VERIFY_STATUS=0
python3 /Users/jake/dev/product-pipeline-1/tools/build-serialize.py verify --repo "$SITE_DIR" || BS_VERIFY_STATUS=$?
if [ "$BS_VERIFY_STATUS" -eq 1 ]; then
    echo ""
    echo "PUSH BLOCKED: the dist about to be tested is NOT this tree's current"
    echo "  build (see the verdict above). A failure below would NOT be a"
    echo "  regression in your change. Re-run the push; do NOT clear dist/."
    exit 1
fi

echo "▸ Running vitest suites (14 files, data + dist)..."
if ! npx vitest run < /dev/null; then
    echo ""
    echo "✗ PUSH BLOCKED — vitest suites failed."
    exit 1
fi

# ── Numeric parity (translations vs English) ─────────────────────
# The one translation defect the machine-translation disclaimer cannot cover:
# a dosage, threshold, fee or emergency number that lost a digit. The page still
# returns 200, builds clean, validates its schema and resolves its links — no
# other gate here can see it. Reuses the dist just built above.
# 2,240 translated pages, 0 unaccepted differences when added (2026-08-15).
echo ""
echo "▸ Running emergency-basis check (is every 24-hour claim labelled?)..."
if ! python3 "$SITE_DIR/tools/emergency-basis.py" --check; then
    echo ""
    echo "  A published facility claims 24-hour emergency care with no recorded basis,"
    echo "  or the emergency editorial states a total the corpus no longer supports."
    echo "  Regenerate with: python3 tools/emergency-basis.py"
    echo "  Do NOT resolve this by flipping services.emergency_24h — see #1349."
    exit 1
fi
echo ""

echo "▸ Running numeric-parity check (translated pages vs English)..."
if ! python3 "$SITE_DIR/tools/numeric-parity-check.py"; then
    echo ""
    echo "✗ PUSH BLOCKED — a translated page's figures differ from its English source."
    echo "  Read each finding in context before acting. If the difference is a numeral"
    echo "  legitimately rendered as a word, add it to tools/numeric-parity-baseline.json"
    echo "  WITH A REASON. Multi-digit figures can never be baselined — those are real."
    exit 1
fi

echo ""
echo "▸ Running phone-format check (is every published number dialable?)..."
if ! python3 "$SITE_DIR/tools/phone-format-check.py"; then
    echo ""
    echo "✗ PUSH BLOCKED — a published telephone number cannot be dialled."
    echo "  Do NOT pad or truncate it to the right length: that publishes a plausible"
    echo "  WRONG number, which is worse than an obviously broken one (#1510)."
    echo "  Re-source it from the record's own OSM object, or withhold it in"
    echo "  src/data/phone-defect.ts with the evidence."
    exit 1
fi

# ── Guard unit tests ─────────────────────────────────────────────
# The only proof the gates above can still go RED. A guard whose tests
# never run is one refactor away from passing unconditionally.
echo ""
echo "▸ Running guard unit tests (tools/tests)..."
if ! python3 -m pytest "$SITE_DIR/tools/tests" -q; then
    echo ""
    echo "✗ PUSH BLOCKED — guard unit tests failed."
    exit 1
fi

echo ""
echo "═══════════════════════════════════════════════════"
echo "  ✓ ClinicFinder build + link + parity checks passed."
echo "═══════════════════════════════════════════════════"
