#!/bin/bash
# ClinicFinder pre-push hook — verifies site builds + internal links before push
# Catches: broken imports, bad data, template errors, missing files, dead links
# All must pass or push is blocked.
#
# VERSIONED HOOK (tracked in git, source of truth). Activate via:
#     git config core.hooksPath .githooks
# core.hooksPath is machine-local (not tracked) — a fresh clone runs that once.
# See .githooks/README.md.

set -e

SITE_DIR="$(git rev-parse --show-toplevel)"

echo "═══════════════════════════════════════════════════"
echo "  ClinicFinder Pre-Push: Build + Link Verification"
echo "═══════════════════════════════════════════════════"
echo ""

# ── Build check ──────────────────────────────────────────────────
echo "▸ Running astro build..."
cd "$SITE_DIR"
rm -rf dist
npx astro build 2>&1

if [ $? -ne 0 ]; then
    echo ""
    echo "✗ PUSH BLOCKED — astro build failed."
    exit 1
fi

# ── Dead-link scan (static internal-link integrity) ──────────────
# Reuses the dist just built above (no --build). Catches inline-editorial
# 404s. 0 broken across 36,931 hrefs when added (2026-06-10).
echo ""
echo "▸ Running dead-link scan (static internal links)..."
if ! python3 /Users/jake/dev/product-pipeline-1/tools/dead-link-scan.py "$SITE_DIR"; then
    echo ""
    echo "✗ PUSH BLOCKED — dead-link scan found broken internal links."
    echo "  Fix the broken hrefs and re-push."
    exit 1
fi

# ── Vitest suites — ALL 14 (#1239a) ──────────────────────────────
# This hook did not contain the string `vitest` at all until 2026-08-19, while
# 14 suites / 315 assertions sat in tests/. So tests/seo-integrity.test.ts had
# NEVER gated a push, and CF — the portfolio's #1 site by clicks and impressions
# — was serving 15 duplicate-title groups, the worst being 12 pages all titled
# "health care — Clinic in Mpumalanga, Ehlanzeni District" across three locales.
# The suite that asserts zero duplicate titles was green in the repo and unrun.
#
# Runs AFTER the build, before the parity check: seo-integrity, sitemap,
# routing-integrity, build-output, page-completeness and performance all walk
# dist/. ~12s on this corpus — there is no cost argument.
#
# If you ever narrow this, prove what actually runs with
#   python3 /Users/jake/dev/product-pipeline-1/tools/pre-push-gate-check.py --repo .
# A declared gate is not a running gate (#1116).
echo ""
echo "▸ Running vitest suites (14 files, data + dist)..."
if ! npx vitest run < /dev/null; then
    echo ""
    echo "✗ PUSH BLOCKED — vitest suites failed."
    exit 1
fi

# ── Numeric parity (translations vs English) ─────────────────────
# The one translation defect the machine-translation disclaimer cannot cover:
# a dosage, threshold, fee or emergency number that lost a digit. The page still
# returns 200, builds clean, validates its schema and resolves its links — no
# other gate here can see it. Reuses the dist just built above.
# 2,240 translated pages, 0 unaccepted differences when added (2026-08-15).
echo ""
echo "▸ Running emergency-basis check (is every 24-hour claim labelled?)..."
if ! python3 "$SITE_DIR/tools/emergency-basis.py" --check; then
    echo ""
    echo "  A published facility claims 24-hour emergency care with no recorded basis,"
    echo "  or the emergency editorial states a total the corpus no longer supports."
    echo "  Regenerate with: python3 tools/emergency-basis.py"
    echo "  Do NOT resolve this by flipping services.emergency_24h — see #1349."
    exit 1
fi
echo ""

echo "▸ Running numeric-parity check (translated pages vs English)..."
if ! python3 "$SITE_DIR/tools/numeric-parity-check.py"; then
    echo ""
    echo "✗ PUSH BLOCKED — a translated page's figures differ from its English source."
    echo "  Read each finding in context before acting. If the difference is a numeral"
    echo "  legitimately rendered as a word, add it to tools/numeric-parity-baseline.json"
    echo "  WITH A REASON. Multi-digit figures can never be baselined — those are real."
    exit 1
fi

# ── Guard unit tests ─────────────────────────────────────────────
# The only proof the gates above can still go RED. A guard whose tests
# never run is one refactor away from passing unconditionally.
echo ""
echo "▸ Running guard unit tests (tools/tests)..."
if ! python3 -m pytest "$SITE_DIR/tools/tests" -q; then
    echo ""
    echo "✗ PUSH BLOCKED — guard unit tests failed."
    exit 1
fi

echo ""
echo "═══════════════════════════════════════════════════"
echo "  ✓ ClinicFinder build + link + parity checks passed."
echo "═══════════════════════════════════════════════════"
