---
import Base from '../layouts/Base.astro';
---

<Base title="Contact — Clinic Finder SA" description="Get in touch with Clinic Finder SA. Report incorrect facility data, suggest missing clinics, or ask questions." noindex={true}>
  <div class="container" style="padding: 2rem 0 3rem;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem;">
      <a href="/" style="color: var(--green-dark);">Home</a> › Contact
    </nav>

    <h1 style="font-size: 1.8rem; margin-bottom: 1.5rem;">Contact Us</h1>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--green-dark);">Get in Touch</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">Email us at <a href="mailto:hello@clinicfinder.co.za" style="color: var(--green-dark);">hello@clinicfinder.co.za</a>. We read every message and aim to respond within 48 hours.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--green-dark);">Data Corrections</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">If you spot incorrect facility information — wrong address, missing services, closed facility still listed, or a new facility we haven't added — please let us know. Include the facility name and what needs correcting. Corrections help everyone who uses this tool.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--green-dark);">Emergency</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">If you have a medical emergency, call <strong>10177</strong> (ambulance) or <strong>112</strong> (from mobile). You can also call the National Health Hotline at <strong>0800 029 999</strong> for health-related questions.</p>
    </section>
  </div>
</Base>
