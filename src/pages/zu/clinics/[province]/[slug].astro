---
/**
 * isiZulu facility detail page — translation of src/pages/clinics/[province]/[slug].astro
 * (issue #2). ~1,000 pages.
 *
 * Data and path logic are SHARED (src/data/pages/paths.ts) so the locales cannot diverge
 * in WHICH facilities they publish. The route is gated on COVERAGE.zu.facilities, which
 * turns true only once the facility-type editorial, the generated facility editorial and
 * these UI strings are all translated — the family is earned at once, not per facility.
 *
 * Facility names, addresses, suburb/city/district/province names, phone numbers, GPS
 * coordinates, operating-hours strings and the OSM record identifiers are sourced values
 * and are never translated: they are what a reader reads back at a clinic counter or
 * types into a maps app.
 */
import Base from '../../../../layouts/Base.astro';
import { facilities, SERVICE_MAP, provinceSlug, nearbyFacilities, mapsUrl, whatsappShareUrl } from '../../../../data/helpers';
import { generateFacilityEditorialZu } from '../../../../data/i18n/facility-editorial.zu';
import { getFacilityTypeEditorialZu } from '../../../../data/i18n/facility-types-editorial.zu';
import { typeLabelZu, servicePlainZu, serviceLabelZu, zuHref, zuLinks } from '../../../../data/i18n/zu';
import { facilityPaths } from '../../../../data/pages/paths';
import { facilitiesTranslated } from '../../../../i18n/translated';
import { careRole } from '../../../../data/care-role';
import { outsideSouthAfrica } from '../../../../data/outside-sa';
import { OUTSIDE_SA_CHROME_ZU, outsideSaWhatZu } from '../../../../data/i18n/outside-sa.xh-zu';
import { nameIsPlaceholder } from '../../../../data/unnamed';
import { administrativeName } from '../../../../data/administrative-name';
import { UNNAMED_CHROME_ZU } from '../../../../data/i18n/unnamed.xh-zu';
import { ADMIN_NAME_CHROME_ZU, adminNameWhatZu } from '../../../../data/i18n/administrative-name.xh-zu';
import {
  CARE_ROLE_CHROME_ZU,
  careRoleWhatZu,
  firstSentence,
} from '../../../../data/i18n/care-role.xh-zu';
import { emergencyIsInferred } from '../../../../data/emergency-basis';
import { renderablePhones, telephoneSchema } from '../../../../data/phone';

export function getStaticPaths() {
  return facilitiesTranslated('zu') ? facilityPaths() : [];
}

const { facility, titleSuffix, withheldReason } = Astro.props;
const nearby = nearbyFacilities(facility, 3);
const editorial = generateFacilityEditorialZu(facility);
// #1150 — the public-system editorial is gated on OPERATOR, not on `type`.
// `type` is an OSM-derived shape label: 16 retail pharmacies (Clicks, Dis-Chem,
// Medicross, independent chemists) import as type="clinic", and the clinic block
// tells the reader a clinic is "the front door of the South African public health
// system", nurse-driven and free. On a humanitarian site that sends someone to a
// Clicks expecting free public primary care. `operator_type` is the field that
// actually answers "is this the public system?", so it is the field that gates.
// Deliberately suppress only on a KNOWN private operator — 249 records are
// operator_type "unknown" and silently stripping their editorial would be a large
// unreviewed content deletion, not a correction.
const isPrivate = facility.operator_type === 'private';
// #1002 — three published records are not places anyone can be treated (a state
// forensic mortuary, an office building, a bedding retailer). The type editorial
// describes a clinic, which on those pages is a false description of the place, so
// it is suppressed here exactly as it is on the English route. The explanatory
// notice the English page shows is NOT reproduced here: a safety notice has to be
// written by a speaker of the language, not machine-phrased on a humanitarian site.
// #1361 — the #1349 notice IS now reproduced here. The rule it was withheld under
// ("a safety notice has to be written by a speaker of the language, not machine-phrased
// on a humanitarian site") is refuted by this very page: the most prominent safety
// notice on it — the translation disclaimer in src/i18n/strings.ts, which tells the
// reader not to make a treatment decision from this page — is itself machine-phrased
// isiZulu, and so is the "Iziphuthumayo zamahora angu-24"
// service chip that this notice qualifies. Withholding only the CAVEAT, while publishing
// the CLAIM it caveats, leaves the isiZulu reader with strictly less doubt than the
// English one about the same inference. Absence was the larger harm, so the notice ships,
// under the page-wide disclaimer that already says who wrote it. A first-language review
// of ALL isiXhosa/isiZulu safety copy is filed separately — that is the real remedy, and
// it is not a reason to leave a reader arriving at two in the morning with no caveat.
// DIGIT-FREE, deliberately: "imini nobusuku" rather than a numeral, so this notice
// cannot move the numeric multiset tools/numeric-parity-check.py compares.
const emergencyInferred = facility.services.emergency_24h && emergencyIsInferred(facility.slug);
const notCare = careRole(facility.slug);
// #1367 — the #1002 "this is not a care facility" notice, in isiZulu.
// It was withheld from this route under the same rule #1361 reversed: "a safety
// notice has to be written by a speaker of the language, not machine-phrased on a
// humanitarian site." The refutation is on this very page — src/i18n/strings.ts
// renders a machine-phrased isiZulu safety notice above the fold, and says so in
// isiZulu. Withholding it here withheld the CORRECTION of a false claim rather
// than a caveat on a true one: measured from built output on 2026-08-21, the notice
// stood on 6 of 6 English pages and 0 of 6 isiZulu pages, with no English fallback,
// so this route presented a state mortuary and a bedding retailer as facilities with
// nothing anywhere on the page saying otherwise.
// First-language review of all isiZulu safety copy is still right and is #1369.
// Wording, terminology and the no-numerals rule: src/data/i18n/care-role.xh-zu.ts.
const notCareWhat = notCare ? careRoleWhatZu(facility.slug) : null;
const notCareSummary = firstSentence(notCareWhat);
// #1381 — three published records are health facilities in Maseru, LESOTHO, carried
// under `province: "Free State"` because the map extract they came from is clipped to
// a bounding box that contains the whole enclave. The notice ships in this locale in
// the same commit as the English one, for the reason #1367 sets out at length:
// withholding a CORRECTION while publishing the false claim it corrects leaves this
// reader worse off than the English one, not safer. Wording: outside-sa.xh-zu.ts.
const notInSA = outsideSouthAfrica(facility.slug);
// 2026-08-26 — see src/data/unnamed.ts. Same predicate, same position and same styling
// as the English route, so the three locales cannot say different things about the
// same record.
const unnamed = !notCare && !notInSA && nameIsPlaceholder(facility.name);
// #1481 — see the English route for the full reasoning. Same predicate, same gating,
// so the three locales cannot say different things about the same record.
const adminName = !notCare && !notInSA ? administrativeName(facility.slug) : null;
const adminNameWhat = adminName ? adminNameWhatZu(facility.slug) : null;
const notInSAWhat = notInSA ? outsideSaWhatZu(facility.slug) : null;
const notInSASummary = firstSentence(notInSAWhat);
const typeEditorial = isPrivate || notCare || notInSA ? null : getFacilityTypeEditorialZu(facility.type);
const activeServices = Object.entries(facility.services)
  .filter(([, v]) => v)
  .map(([k]) => ({ key: k, slug: SERVICE_MAP[k]?.slug, plain: servicePlainZu(k), label: serviceLabelZu(k) }))
  .filter(s => s.slug);

const directionsUrl = mapsUrl(facility.coordinates.lat, facility.coordinates.lng, facility.name);
const shareUrl = whatsappShareUrl(facility);

const guideMap: Record<string, { slug: string; title: string }> = {
  arv_treatment: { slug: 'how-to-get-arvs', title: 'Ungawathola Kanjani Ama-ARV Emtholampilo Womphakathi' },
  tb_treatment: { slug: 'tb-treatment-what-to-expect', title: 'Ukwelashwa Kwe-TB — Okufanele Ukulindele' },
  maternity_antenatal: { slug: 'free-maternity-care', title: 'Ukunakekelwa Kokubeletha Mahhala Ezibhedlela Zomphakathi' },
  chronic_medication: { slug: 'chronic-medication-management', title: 'Imithi Yesifo Esingamahlalakhona Emitholampilo Yomphakathi' },
  emergency_24h: { slug: 'medical-emergency-guide', title: 'Okufanele Ukwenze Esimweni Esiphuthumayo Sezempilo' },
  dental: { slug: 'dental-care-public-clinics', title: 'Ukunakekelwa Kwamazinyo Emitholampilo Yomphakathi' },
  mental_health: { slug: 'mental-health-services', title: 'Izinsizakalo Zempilo Yengqondo Emitholampilo Yomphakathi' },
  family_planning: { slug: 'family-planning-contraception', title: 'Ukuhlela Umndeni Nezindlela Zokuvimbela Ukukhulelwa' },
  immunisation: { slug: 'child-immunisation-schedule', title: 'Ishejuli Yemijovo Yezingane (ENingizimu Afrika)' },
  hiv_testing: { slug: 'hiv-testing-guide', title: 'Ukuhlolela I-HIV — Kuphi, Kanjani & Okufanele Ukulindele' },
  child_health: { slug: 'child-immunisation-schedule', title: 'Ishejuli Yemijovo Yezingane (ENingizimu Afrika)' },
};
const matchedGuides = Object.entries(facility.services)
  .filter(([k, v]) => v && guideMap[k])
  .map(([k]) => guideMap[k])
  .filter((g, i, arr) => arr.findIndex(x => x.slug === g.slug) === i)
  .slice(0, 4);
const extraGuides = [
  { slug: 'ccmdd-chronic-meds-pickup', title: 'I-CCMDD — Ukulanda Imithi Yesifo Esingamahlalakhona Ngaphandle Komugqa' },
  { slug: 'hospital-referral-system', title: 'Ukusebenza Kokuthunyelwa Esibhedlela ENingizimu Afrika' },
  { slug: 'find-nearest-clinic', title: 'Ungawuthola Kanjani Umtholampilo Oseduze Nawe' },
];
const relatedGuides = [...matchedGuides];
for (const e of extraGuides) {
  if (relatedGuides.length >= 4) break;
  if (!relatedGuides.some(g => g.slug === e.slug)) relatedGuides.push(e);
}

const idMatch = facility.facility_id.match(/^zaf_(way|nodes?)_(\d+)$/);
const osmType = idMatch ? (idMatch[1] === 'way' ? 'way' : 'node') : 'node';
const osmId = idMatch ? idMatch[2] : facility.facility_id;
const osmUrl = `https://www.openstreetmap.org/${osmType}/${osmId}`;
const overpassUrl = `https://overpass-turbo.eu/?Q=${osmType}(${osmId})%3Bout%3B&R`;
const hotosmUrl = 'https://data.humdata.org/dataset/hotosm_zaf_health_facilities';

const addressParts = [facility.address.street, facility.address.suburb, facility.address.city, facility.address.postal_code].filter(Boolean);
const addressStr = addressParts.length > 0 ? addressParts.join(', ') : `${facility.province}${facility.district ? ', ' + facility.district : ''}`;

const typeName = typeLabelZu(facility.type).toLowerCase();

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ikhasi Lokuqala', item: 'https://clinicfinder.co.za/zu' },
    { '@type': 'ListItem', position: 2, name: 'Izifundazwe', item: 'https://clinicfinder.co.za/zu/clinics' },
    { '@type': 'ListItem', position: 3, name: facility.province, item: `https://clinicfinder.co.za/zu/clinics/${provinceSlug(facility.province)}` },
    { '@type': 'ListItem', position: 4, name: facility.name },
  ],
};

// FACILITY_TYPE_EDITORIAL_ZU prose carries inline <a href="/guides/…"> links. The
// rendered page emits them as HTML (set:html below); schema.org FAQ answer text must be
// plain, so strip the tags here rather than shipping markup into the structured data.
const plain = (s: string) => s.replace(/<[^>]+>/g, '');

const faqLd = typeEditorial ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: `Kufanele ngiye nini ${typeName}?`, acceptedAnswer: { '@type': 'Answer', text: plain(typeEditorial.whenToGo) } },
    { '@type': 'Question', name: `Basebenza bobani ${typeName}?`, acceptedAnswer: { '@type': 'Answer', text: plain(typeEditorial.staffing) } },
    { '@type': 'Question', name: `Lusebenza kanjani uhlelo lokuthunyelwa ${typeName}?`, acceptedAnswer: { '@type': 'Answer', text: plain(typeEditorial.referralFlow) } },
  ],
} : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': notCare ? 'LocalBusiness' : ['MedicalClinic', 'LocalBusiness'],
  name: facility.name,
  // #1002 — with no service flags this rendered the literal string "Izinsizakalo: ."
  // #1367 — the English route publishes the adjudicated first sentence here. This
  // route published only a name and a province, which is not a correction.
  description: notCare
    ? notCareSummary || `${facility.name}, ${facility.province}.`
    : notInSA
    ? notInSASummary || `${facility.name}, ${notInSA.country}.`
    : `${typeLabelZu(facility.type)} e-${facility.province}, eNingizimu Afrika.`
      + (activeServices.length ? ` Izinsizakalo: ${activeServices.map(s => s.plain).join(', ')}.` : ''),
  address: {
    '@type': 'PostalAddress',
    streetAddress: facility.address.street || undefined,
    addressLocality: facility.address.city || facility.district || facility.province,
    // #1381 — was hardcoded South African, which published a Lesotho clinic to search
    // engines as a Free State one in machine-readable form. The region is dropped
    // rather than guessed: we know the COUNTRY and no more.
    ...(notInSA ? {} : { addressRegion: facility.province }),
    addressCountry: notInSA ? notInSA.countryCode : 'ZA',
    postalCode: facility.address.postal_code || undefined,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: facility.coordinates.lat,
    longitude: facility.coordinates.lng,
  },
  url: `https://clinicfinder.co.za/zu${facility.url_path}`,
  ...(telephoneSchema(facility) ? { telephone: telephoneSchema(facility) } : {}),
  ...(facility.contact.email && { email: facility.contact.email }),
  ...(facility.contact.website && { sameAs: [facility.contact.website] }),
  ...(facility.operating_hours.raw
    ? { openingHoursSpecification: { '@type': 'OpeningHoursSpecification', description: facility.operating_hours.raw } }
    : facility.operating_hours.is_24_hour
      ? { openingHours: 'Mo-Su 00:00-23:59' }
      : {}),
  // #1381 — not ours to answer for a facility in another country's health system.
  ...(notCare || notInSA ? {} : { isAccessibleForFree: !isPrivate }),
  ...(activeServices.length ? { medicalSpecialty: activeServices.map(s => s.label) } : {}),
};
---
<Base
  title={notCare
    ? `${facility.name} — e-${facility.province}${titleSuffix}`
    : notInSA
      ? `${facility.name} — e-${notInSA.country}${titleSuffix}`
      : `${facility.name} — ${typeLabelZu(facility.type)} e-${facility.province}${titleSuffix}`}
  description={(notCare
      ? `${facility.name} akuwona umtholampilo futhi akekho umuntu owelashwa lapha.`
        + (notCareSummary ? ` ${notCareSummary}` : '')
      : notInSA
      ? `${facility.name} ise-${notInSA.country}, ayikho eNingizimu Afrika.`
        + (notInSASummary ? ` ${notInSASummary}` : '')
      : `${facility.name} ${typeName} e-${facility.province}.`
        + (activeServices.length ? ` Izinsizakalo: ${activeServices.slice(0, 5).map(s => s.plain).join(', ')}.` : ''))
    + ' Thola indlela nemininingwane yokuxhumana.'}
  jsonLd={[breadcrumbLd, jsonLd, ...(faqLd ? [faqLd] : [])]}
  noindex={Boolean(withheldReason)}
>
  <div class="container" style="padding: 32px 0;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
      <a href={zuHref('/')}>Ikhasi Lokuqala</a> &rsaquo;
      <a href={zuHref('/clinics')}>Izifundazwe</a> &rsaquo;
      <a href={zuHref(`/clinics/${provinceSlug(facility.province)}`)}>{facility.province}</a> &rsaquo;
      {facility.name}
    </nav>

    {/* #1368b — the chip row is the most prominent thing on the page after the name,
        and on an adjudicated non-care record it used to contradict the notice below
        it: Panorama Animal Clinic — a veterinary practice for pets — rendered a
        yellow "24 hours" chip on all three routes, so the top of the page offered
        round-the-clock human care while the notice further down said nobody is
        treated there at all. Measured on built output 2026-08-21: 1 of the 9
        adjudicated records renders the chip, on 3 built pages (en, xh, zu).

        Two changes, both gated on the SAME `notCare` predicate that already
        suppressed the type chip and the services section, so nothing about the
        other ~1,067 facility records changes:

         - the 24-hour chip is SUPPRESSED. The chip is a claim about when care is
           available here; on a record hand-adjudicated as "nobody is treated here"
           that claim is false whatever the flag holds. Nothing in the DATA is
           touched — `operating_hours.is_24_hour` and `services.emergency_24h` keep
           their values, so emergency-basis.py's corpus and its published totals are
           unmoved. #1349 forbids resolving a 24-hour claim by flipping the flag;
           this suppresses a RENDERING, which is the page saying less rather than
           saying something wrong.
         - a red warning chip takes the suppressed type chip's place, carrying the
           notice's own heading in short. The <h1> stays the facility's real name:
           the name is the true thing, it is the signage a reader matches on the
           ground and the string they searched for, so qualifying belongs beside it
           rather than inside it. */}
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px; flex-wrap: wrap;">
      <h1 style="font-size: 1.4rem;">{facility.name}</h1>
      {!notCare && !notInSA && <span class="chip chip--type">{typeLabelZu(facility.type)}</span>}
      {notCare && <span class="chip" style="background: #fdecea; color: #a4262c; font-weight: 600;">{CARE_ROLE_CHROME_ZU.chip}</span>}
      {/* #1381 — same reasoning as #1368b applied to the country: a type chip and a
          round-the-clock chip above a notice saying the place is in another country
          is the top of the page contradicting the correction below it. */}
      {!notCare && notInSA && <span class="chip" style="background: #fdecea; color: #a4262c; font-weight: 600;">{OUTSIDE_SA_CHROME_ZU.chip}</span>}
      {!notCare && !notInSA && facility.operating_hours.is_24_hour && <span class="chip" style="background: #fef3cd; color: #856404;">amahora angu-24</span>}
      {unnamed && <span class="chip" style="background: #fff8e6; color: #856404; font-weight: 600;">{UNNAMED_CHROME_ZU.chip}</span>}
      {adminName && <span class="chip" style="background: #fff8e6; color: #856404; font-weight: 600;">{ADMIN_NAME_CHROME_ZU.chip}</span>}
    </div>

    <p style="color: var(--text-muted); margin-bottom: 24px;">
      {addressStr}
    </p>

    {/* #1367 — same notice, same position and same styling as the English route, so
        the three locales cannot say different things about the same record. */}
    {notCare && (
      <section style="margin-bottom: 32px;">
        <div style="background: #fdecea; border-left: 4px solid #a4262c; border-radius: var(--radius); padding: 14px 16px;">
          <h2 style="font-size: 1rem; margin-bottom: 8px; color: #a4262c;">{CARE_ROLE_CHROME_ZU.heading}</h2>
          {notCareWhat && <p style="font-size: 0.9rem; line-height: 1.7; margin: 0 0 8px;">{notCareWhat}</p>}
          <p style="font-size: 0.9rem; line-height: 1.7; margin: 0;">
            {CARE_ROLE_CHROME_ZU.seeBefore}
            <a href={zuHref(`/clinics/${provinceSlug(facility.province)}`)}>{CARE_ROLE_CHROME_ZU.linkText(facility.province)}</a>.
          </p>
        </div>
      </section>
    )}

    {unnamed && (
      <section style="margin-bottom: 32px;">
        <div style="background: #fff8e6; border-left: 4px solid #b8860b; border-radius: var(--radius); padding: 14px 16px;">
          <h2 style="font-size: 1rem; margin-bottom: 8px;">{UNNAMED_CHROME_ZU.heading}</h2>
          <p style="font-size: 0.9rem; line-height: 1.7; margin: 0 0 8px;">{UNNAMED_CHROME_ZU.body}</p>
          <p style="font-size: 0.9rem; line-height: 1.7; margin: 0;">
            {UNNAMED_CHROME_ZU.seeBefore}<a href={zuHref(`/clinics/${provinceSlug(facility.province)}`)}>{UNNAMED_CHROME_ZU.linkText(facility.province)}</a>.
          </p>
        </div>
      </section>
    )}

    {adminName && (
      <section style="margin-bottom: 32px;">
        <div style="background: #fff8e6; border-left: 4px solid #b8860b; border-radius: var(--radius); padding: 14px 16px;">
          <h2 style="font-size: 1rem; margin-bottom: 8px;">{ADMIN_NAME_CHROME_ZU.heading}</h2>
          {adminNameWhat && <p style="font-size: 0.9rem; line-height: 1.7; margin: 0 0 8px;">{adminNameWhat}</p>}
          <p style="font-size: 0.9rem; line-height: 1.7; margin: 0;">
            {ADMIN_NAME_CHROME_ZU.seeBefore}<a href={zuHref(`/clinics/${provinceSlug(facility.province)}`)}>{ADMIN_NAME_CHROME_ZU.linkText(facility.province)}</a>.
          </p>
        </div>
      </section>
    )}

    {/* #1381 — same notice, same position and same styling as the English route, so
        the three locales cannot say different things about the same record. */}
    {notInSA && (
      <section style="margin-bottom: 32px;">
        <div style="background: #fdecea; border-left: 4px solid #a4262c; border-radius: var(--radius); padding: 14px 16px;">
          <h2 style="font-size: 1rem; margin-bottom: 8px; color: #a4262c;">{OUTSIDE_SA_CHROME_ZU.heading(notInSA.country)}</h2>
          {notInSAWhat && <p style="font-size: 0.9rem; line-height: 1.7; margin: 0 0 8px;">{notInSAWhat}</p>}
          <p style="font-size: 0.9rem; line-height: 1.7; margin: 0;">
            {OUTSIDE_SA_CHROME_ZU.seeBefore}
            <a href={zuHref(`/clinics/${provinceSlug(facility.province)}`)}>{OUTSIDE_SA_CHROME_ZU.linkText(facility.province)}</a>.
          </p>
        </div>
      </section>
    )}

    {/* #1368b — the notice sits ABOVE the action buttons, not below them. It used
        to render after "Show Google Maps Directions" and "Share on WhatsApp" on all
        nine adjudicated records (measured byte offsets, built output 2026-08-21),
        so the page offered directions to a state mortuary, a closed TB hospital
        whose own adjudication says "Do not travel here", and a bedding retailer
        before it told the reader what the place was. */}
    <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 32px;">
      <a href={directionsUrl} target="_blank" rel="noopener" class="btn btn--primary">
        Khombisa Indlela Nge-Google Maps
      </a>
      <a href={shareUrl} target="_blank" rel="noopener" class="btn btn--wa">
        Yabelana Nge-WhatsApp
      </a>
    </div>


    {/* #1002/#1350 — a record adjudicated as NOT walk-in care must not be
        described as a facility on this route either. The English page wraps both
        of these sections in the same gate; these two did not, so a state mortuary,
        a bedding retailer, a veterinary practice and a shopping centre kept their
        service chips and a generated "about this facility" paragraph in isiXhosa
        and isiZulu while the English page suppressed them. Found by
        tools/numeric-parity-check.py, which is the only thing that compares the
        three routes against each other. */}
    {!notCare && !notInSA && (
    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 12px;">Izinsizakalo ezitholakalayo</h2>
      <div style="display: flex; flex-wrap: wrap; gap: 6px;">
        {activeServices.map(s => (
          <a href={zuHref(`/services/${s.slug}`)} class="chip" style="text-decoration: none;">{s.plain}</a>
        ))}
      </div>
      {activeServices.length === 0 && <p style="color: var(--text-muted); font-size: 0.9rem;">Imininingwane yezinsizakalo yalesi sikhungo ayikaqinisekiswa.</p>}
      {emergencyInferred && (
        <div style="margin-top: 12px; background: #fff8e6; border-left: 4px solid #b8860b; border-radius: var(--radius); padding: 12px 14px;">
          <h3 style="font-size: 0.92rem; margin: 0 0 6px;">Kungani lesi sikhungo sifakwe ezinsizakalweni eziphuthumayo</h3>
          <p style="font-size: 0.85rem; line-height: 1.65; margin: 0; color: var(--text-muted);">
            Sithi lesi sikhungo sinokwelashwa kwezimo eziphuthumayo imini nobusuku ngenxa yohlobo
            lwesikhungo esiyilo, hhayi ngenxa yerekhodi ethile yalesi sikhungo. Ku-OpenStreetMap,
            umthombo wethu, ayikho imininingwane yomnyango wezimo eziphuthumayo yalesi sikhungo
            nganoma yiluphi uhlangothi &mdash; lokho kuyisikhala emephini, akulona uphawu lokuthi
            lo mnyango uvaliwe. Shayela ucingo ngaphambi kokuhamba ebusuku, futhi esimweni
            esiphuthumayo esiyingozi empilweni biza i-ambulensi kunokuba uzihambele wena.
          </p>
        </div>
      )}
    </section>
    )}

    {!notCare && !notInSA && (
    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 12px;">Mayelana nalesi sikhungo</h2>
      <p style="font-size: 0.9rem; line-height: 1.7; margin-bottom: 16px;" set:html={zuLinks(editorial.context)} />
      {editorial.tips.length > 0 && (
        <div style="display: grid; gap: 12px;">
          {editorial.tips.map(tip => (
            <div style="background: var(--bg-alt); border-radius: var(--radius); padding: 14px 16px; font-size: 0.9rem; line-height: 1.6;" set:html={zuLinks(tip)} />
          ))}
        </div>
      )}
    </section>
    )}

    {typeEditorial && (
      <section style="margin-bottom: 32px;">
        <h2 style="font-size: 1.1rem; margin-bottom: 12px;">Uyini {typeName}?</h2>
        <p style="font-size: 0.9rem; line-height: 1.7; margin-bottom: 16px;" set:html={zuLinks(typeEditorial.description)} />
        <details style="margin-bottom: 12px;">
          <summary style="cursor: pointer; font-weight: 600; font-size: 0.9rem; color: var(--primary-dark);">Kufanele ngiye nini {typeName}?</summary>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 8px; line-height: 1.6;" set:html={zuLinks(typeEditorial.whenToGo)} />
        </details>
        <details style="margin-bottom: 12px;">
          <summary style="cursor: pointer; font-weight: 600; font-size: 0.9rem; color: var(--primary-dark);">Basebenza bobani {typeName}?</summary>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 8px; line-height: 1.6;" set:html={zuLinks(typeEditorial.staffing)} />
        </details>
        <details>
          <summary style="cursor: pointer; font-weight: 600; font-size: 0.9rem; color: var(--primary-dark);">Lusebenza kanjani uhlelo lokuthunyelwa {typeName}?</summary>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 8px; line-height: 1.6;" set:html={zuLinks(typeEditorial.referralFlow)} />
        </details>
      </section>
    )}

    {isPrivate && !notCare && (
      <section style="margin-bottom: 32px;">
        <div style="background: #fef3cd; border-left: 4px solid #856404; border-radius: var(--radius); padding: 14px 16px;">
          <h2 style="font-size: 1rem; margin-bottom: 8px; color: #856404;">Isebenza ngokuzimela — akuwona umtholampilo kahulumeni wamahhala</h2>
          <p style="font-size: 0.9rem; line-height: 1.7; margin: 0;">Lena yindawo esebenza ngokuzimela. Ayiyona ingxenye yohlelo lwezempilo lomphakathi lwamahhala — lindela ukukhokha, noma ukusebenzisa umshwalense wezempilo, ukuze ubonwe lapha. Umtholampilo oholwa umhlengikazi ngaphakathi kwekhemisi ungagoma, uhlole umfutho wegazi noshukela, futhi welaphe amanxeba amancane, kodwa awukwazi ukukhipha incwadi yokuthunyelwa yomkhakha womphakathi futhi awukhipheli imithi kahulumeni yesikhathi eside. Ukuthola usizo lwamahhala, yiya emtholampilo kahulumeni noma esikhungweni sezempilo somphakathi.</p>
        </div>
      </section>
    )}

    {facility.operating_hours.raw && (
      <section style="margin-bottom: 32px;">
        <h2 style="font-size: 1.1rem; margin-bottom: 8px;">Amahora okusebenza</h2>
        <p style="font-size: 0.9rem;">{facility.operating_hours.raw}</p>
      </section>
    )}

    {(renderablePhones(facility).length > 0 || facility.contact.email || facility.contact.website) && (
      <section style="margin-bottom: 32px;">
        <h2 style="font-size: 1.1rem; margin-bottom: 8px;">Ukuxhumana</h2>
        <div style="display: grid; gap: 6px; font-size: 0.9rem;">
          {renderablePhones(facility).map(p => (
            <p><a href={`tel:${p.href}`}>{p.display}</a></p>
          ))}
          {facility.contact.email && (
            <p><a href={`mailto:${facility.contact.email}`}>{facility.contact.email}</a></p>
          )}
          {facility.contact.website && (
            <p><a href={facility.contact.website} target="_blank" rel="noopener">{facility.contact.website.replace(/^https?:\/\//, '')}</a></p>
          )}
        </div>
      </section>
    )}

    {facility.operator && (
      <section style="margin-bottom: 32px;">
        <h2 style="font-size: 1.1rem; margin-bottom: 8px;">Siqhutshwa ngu</h2>
        <p style="font-size: 0.9rem;">{facility.operator}</p>
      </section>
    )}

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 8px;">Indawo</h2>
      <p style="font-size: 0.85rem; color: var(--text-muted);">
        I-GPS: {facility.coordinates.lat.toFixed(4)}, {facility.coordinates.lng.toFixed(4)}
        {facility.district && ` · Isifunda: ${facility.district}`}
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 12px;">Izikhungo eziseduze</h2>
      <div style="display: grid; gap: 10px;">
        {nearby.map(n => {
          const nAddr = [n.address.street, n.address.suburb, n.address.city].filter(Boolean).join(', ');
          return (
          <a href={zuHref(n.url_path)} class="card" style="text-decoration: none; color: var(--text);">
            <strong>{n.name}</strong>
            {nAddr && <div style="font-size: 0.85rem; color: var(--text); margin-top: 2px;">{nAddr}</div>}
            <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 2px;">
              {typeLabelZu(n.type)} · {n.province}
            </div>
          </a>
        )})}
      </div>
    </section>

    {relatedGuides.length > 0 && (
      <section style="margin-bottom: 32px;">
        <h2 style="font-size: 1.1rem; margin-bottom: 12px;">Imihlahlandlela Ehlobene</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.75rem;">
          {relatedGuides.map(g => (
            <a href={zuHref(`/guides/${g.slug}`)} style="display: block; padding: 0.75rem 1rem; background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); text-decoration: none; font-size: 0.9rem; font-weight: 500;">{g.title}</a>
          ))}
        </div>
      </section>
    )}

    <section style="background: var(--bg-alt); border-radius: var(--radius); padding: 20px; margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 12px;">Umthombo wemininingwane</h2>
      <div style="display: grid; gap: 8px; font-size: 0.9rem;">
        <div style="display: flex; gap: 8px;">
          <strong style="min-width: 100px; color: var(--text-muted);">Umthombo:</strong>
          <span>{facility.data_source === 'overpass'
            ? <Fragment>
                <a href={osmUrl} target="_blank" rel="noopener">OpenStreetMap</a> (nge-<a href={overpassUrl} target="_blank" rel="noopener">Overpass API</a>) — imininingwane yendawo emephwe umphakathi
              </Fragment>
            : facility.data_source === 'hotosm'
            ? <Fragment>
                <a href={osmUrl} target="_blank" rel="noopener">OpenStreetMap</a> nge-<a href={hotosmUrl} target="_blank" rel="noopener">Humanitarian OpenStreetMap Team</a> — imininingwane yokumepha yosizo lwabantu
              </Fragment>
            : facility.data_source}</span>
        </div>
        <div style="display: flex; gap: 8px;">
          <strong style="min-width: 100px; color: var(--text-muted);">Irekhodi:</strong>
          <span><a href={osmUrl} target="_blank" rel="noopener">OSM {osmType} {osmId}</a></span>
        </div>
        <div style="display: flex; gap: 8px;">
          <strong style="min-width: 100px; color: var(--text-muted);">Kugcine ukuqinisekiswa:</strong>
          <span>{facility.last_verified}</span>
        </div>
        <div style="display: flex; gap: 8px;">
          <strong style="min-width: 100px; color: var(--text-muted);">Izinga lemininingwane:</strong>
          <span>{'★'.repeat(facility.data_quality_score)}{'☆'.repeat(5 - facility.data_quality_score)} ({facility.data_quality_score}/5)</span>
        </div>
      </div>
      <p style="margin-top: 12px; font-size: 0.85rem; color: var(--text-muted); line-height: 1.6;">
        Imininingwane yesikhungo &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">abanikeli be-OpenStreetMap</a>, itholakala ngaphansi kwe-<a href="https://opendatacommons.org/licenses/odbl/" target="_blank" rel="noopener">Open Database License</a>. Lolu lwazi lungase lungabonisi izinguquko zakamuva. Sincoma ukuthi ushayele isikhungo ucingo uqinisekise izinsizakalo namahora ngaphambi kokuvakasha. Uma lolu lwazi lungalungile, <a href="mailto:hello@clinicfinder.co.za">sithumelele i-imeyili</a> sizolubuyekeza.
      </p>
    </section>
  </div>
</Base>
