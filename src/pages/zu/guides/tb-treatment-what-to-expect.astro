---
// isiZulu translation of src/pages/guides/tb-treatment-what-to-expect.astro (issue #2).
// Sentence-for-sentence. Locale comes off the URL — no locale prop is passed.
import Base from '../../../layouts/Base.astro';
import { facilities } from '../../../data/helpers';
import { localePath } from '../../../i18n/config';

const tbClinics = facilities.filter(f => f.services.tb_treatment);

const zu = (p: string) => localePath(p, 'zu');

const faqs = [
  {
    question: 'Ingabe ukwelashwa kwe-TB kumahhala?',
    answer: 'Yebo. Konke ukuhlolwa nokwelashwa kwe-TB kumahhala ezikhungweni zezempilo zomphakathi eNingizimu Afrika. Lokhu kufaka ukuhlolwa kwesikhwehlela, ukuthwetshulwa kwesifuba (chest X-ray), umuthi, nama-apotimende okubuya futhi. I-TB yisifo okumele sibikwe — uhulumeni ukhokhela ukwelashwa ngoba ukwelapha isigameko ngasinye kuvikela umphakathi.',
  },
  {
    question: 'Ngingasebenza ngisaphuza imithi ye-TB?',
    answer: 'Ezimweni eziningi, yebo. Ngemva kwamaviki ama-2 okwelashwa, awusathatheli abanye futhi ungabuyela emsebenzini. Abanye abaqashi badinga incwadi kadokotela eqinisekisa ukuthi uphuza imithi futhi awusathatheli abanye. Uvikelwe ngokomthetho ekuxoshweni ngenxa ye-TB — kuwela ngaphansi kokucwaswa ngokukhubazeka.',
  },
  {
    question: 'Kwenzekani uma ngiphuthelwa imithamo ye-TB?',
    answer: 'Ukuphuthelwa imithamo yimbangela evame kunazo zonke ye-TB engalapheki ngemithi ejwayelekile. Uma uphuthelwa usuku noma ezimbili, buyela emtholampilo ngokushesha. Umhlengikazi uzobheka ukuthi ungaqhubeka lapho ugcine khona noma udinga ukuqala kabusha. Ungalindi kuze kufike i-apotimende yakho elandelayo — hamba ngokushesha okukhulu. Akukho sijeziso ngokubuya.',
  },
  {
    question: 'Iyini i-MDR-TB?',
    answer: 'I-TB engalapheki ngemithi eminingi (MDR-TB) yenzeka lapho amagciwane e-TB engasasabeli emithini emikhulu emibili (isoniazid ne-rifampicin), ngokuvamile ngenxa yokwelashwa okungaqedwanga. I-MDR-TB idinga ukwelashwa isikhathi eside (izinyanga ezingu-9-18 esikhundleni sezingu-6) ngemithi enamandla engase ibe nemiphumela emibi eminingi. Umuthi omusha i-bedaquiline uwuthuthukise kakhulu umphumela we-MDR-TB eNingizimu Afrika kusukela ngo-2018.',
  },
  {
    question: 'Ngingayithola i-TB uma nginegciwane le-HIV?',
    answer: 'Abantu abane-HIV basengozini ephindwe ka-15-22 yokuba ne-TB esebenzayo kunabantu abangenalo igciwane le-HIV. I-TB yimbangela ehamba phambili yokufa kubantu abaphila ne-HIV eNingizimu Afrika. Uma une-HIV, umtholampilo wakho kufanele ukuhlolele i-TB kukho konke ukuvakasha futhi ukunike i-isoniazid preventive therapy (IPT) uma ungenayo i-TB esebenzayo. Lokhu kunciphisa ingozi yakho ye-TB ngo-33-67%.',
  },
];

const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Ukwelashwa Kwe-TB eNingizimu Afrika — Okulindelekile',
  description: 'Uhambo lokwelashwa i-TB oluphelele emtholampilo womphakathi: ukuhlolwa, ukutholakala kwesifo, uhlelo lwe-DOTS lwezinyanga ezingu-6, nokubuya futhi.',
  totalTime: 'P6M',
  step: [
    { '@type': 'HowToStep', position: 1, name: 'Zihlole', text: 'Vakashela noma yimuphi umtholampilo womphakathi uma unokukhwehlela okuthathe amaviki angu-2+, ukujuluka ebusuku, noma ukwehla esisindweni. Imiphumela yokuhlolwa kwesikhwehlela ithatha amahora angu-2-48 nge-GeneXpert.' },
    { '@type': 'HowToStep', position: 2, name: 'Qala ukwelashwa', text: 'Ukwelashwa kwe-TB kumahhala. Isigaba esinamandla (izinyanga ezingu-2) sisebenzisa imithi engu-4: rifampicin, isoniazid, pyrazinamide, ethambutol — ephuzwa nsuku zonke.' },
    { '@type': 'HowToStep', position: 3, name: 'Ukubukelwa kwe-DOTS', text: 'Phuza umuthi wakho ubukelwa (DOTS) emtholampilo noma nomuntu okusekelayo ekwelashweni. Lokhu kuqinisekisa ukuthi uyawuphuza futhi kubamba imiphumela emibi yomuthi kusenesikhathi.' },
    { '@type': 'HowToStep', position: 4, name: 'Isigaba sokuqhubeka', text: 'Ngemva kwezinyanga ezingu-2, ushintshela emithini emibili (rifampicin + isoniazid) ezinyangeni ezingu-4 ezengeziwe. Ukuvakashela umtholampilo nyanga zonke ukuze kuhlolwe isikhwehlela.' },
    { '@type': 'HowToStep', position: 5, name: 'Qedela izinyanga ezingu-6', text: 'Qedela zonke izinyanga ezingu-6 noma ngabe usuzizwa ungcono. Ukuyeka kusenesikhathi kudala i-TB engalapheki ngemithi ejwayelekile, elukhuni futhi ethatha isikhathi eside ukwelashwa.' },
  ],
};

const jsonLd = [
  howToLd,
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Ukwelashwa Kwe-TB eNingizimu Afrika — Okulindelekile',
    description: 'Umhlahlandlela ophelele wokwelashwa isifo sofuba emitholampilo yomphakathi yaseNingizimu Afrika: ukutholakala kwesifo, i-DOTS, i-TB engalapheki ngemithi ejwayelekile, nokuqhubeka nokwelashwa.',
    url: 'https://clinicfinder.co.za/zu/guides/tb-treatment-what-to-expect',
    publisher: { '@type': 'Organization', name: 'Clinic Finder SA' },
    author: { '@type': 'Organization', name: 'Clinic Finder SA' },
    datePublished: '2026-04-16',
    dateModified: '2026-05-14',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(faq => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Ikhasi Lokuqala', item: 'https://clinicfinder.co.za/zu' }, { '@type': 'ListItem', position: 2, name: 'Imihlahlandlela', item: 'https://clinicfinder.co.za/zu/guides' }, { '@type': 'ListItem', position: 3, name: 'Ukwelashwa Kwe-TB' }] },
];
---
<Base
  title="Ukwelashwa Kwe-TB — Okulindelekile — Clinic Finder SA"
  description="Umhlahlandlela ophelele wokwelashwa isifo sofuba emitholampilo yomphakathi yaseNingizimu Afrika. Ukutholakala kwesifo, uhlelo lwe-DOTS, i-TB engalapheki ngemithi ejwayelekile, imiphumela emibi yomuthi, nokuqedela izinyanga ezingu-6."
  jsonLd={jsonLd}
>
  <div class="container" style="padding: 32px 0; max-width: 720px;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
      <a href={zu('/')}>Ikhasi Lokuqala</a> &rsaquo; <a href={zu('/guides')}>Imihlahlandlela</a> &rsaquo; Ukwelashwa Kwe-TB
    </nav>

    <h1 style="font-size: 1.5rem; margin-bottom: 8px;">Ukwelashwa Kwe-TB — Okulindelekile</h1>
    <p style="color: var(--text-muted); margin-bottom: 32px; line-height: 1.7;">
      INingizimu Afrika ingelinye lamazwe anamazinga aphezulu kunawo wonke e-TB emhlabeni, kodwa lesi sifo siyalapheka. Ukwelashwa kumahhala, kuthatha izinyanga ezingu-6 kwi-TB elapheka ngemithi ejwayelekile, futhi kunezinga lokwelapheka elingaphezu kuka-85% uma kuqedelwa. Lo mhlahlandlela ufaka lonke uhambo lokwelashwa.
    </p>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Ukutholakala kwesifo</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Uma unokukhwehlela okuthathe isikhathi esingaphezu kwamaviki ama-2, ukujuluka ebusuku, ukwehla esisindweni okungachazeki, noma umkhuhlane, iya emtholampilo oseduze nawe ucele ukuhlolelwa i-TB. Umtholampilo uzothatha isampula yesikhwehlela (ukhwehlelela esitsheni esincane) bese uyithumela ukuze ihlolwe nge-GeneXpert. Imiphumela ibuya phakathi kwamahora ama-2 emitholampilo enemishini yayo, noma phakathi kwamahora angu-48 uma ithunyelwe elebhu.
      </p>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 8px;">
        I-GeneXpert yiyona ehlolwa kuqala ejwayelekile eNingizimu Afrika. Ibona amagciwane e-TB futhi ngasikhathi sinye ibheke ukungasebenzi kwe-rifampicin (umuthi obaluleke kunayo yonke). Uma ukuhlolwa kukhombisa ukuthi une-TB, umtholampilo ungase futhi uyale ukuthwetshulwa kwesifuba namanye ama-culture esikhwehlela ukuze kuqondiswe ukwelashwa.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Uhlelo lwemithi</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Ukwelashwa okujwayelekile kwe-TB elapheka ngemithi ejwayelekile kuthatha <strong>izinyanga ezingu-6</strong> ezigabeni ezimbili:
      </p>
      <div style="margin-top: 12px; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;">
        <div style="display: grid; grid-template-columns: 1fr 2fr; font-size: 0.9rem;">
          <div style="padding: 12px; background: var(--primary-light); font-weight: 600; border-bottom: 1px solid var(--border);">Isigaba esinamandla</div>
          <div style="padding: 12px; border-bottom: 1px solid var(--border); line-height: 1.6;">Izinyanga 1-2: imithi emine (isoniazid, rifampicin, pyrazinamide, ethambutol). Iphuzwa nsuku zonke. Lokhu kubulala amagciwane amaningi e-TB.</div>
          <div style="padding: 12px; background: var(--primary-light); font-weight: 600;">Isigaba sokuqhubeka</div>
          <div style="padding: 12px; line-height: 1.6;">Izinyanga 3-6: imithi emibili (isoniazid, rifampicin). Iphuzwa nsuku zonke. Lokhu kuqeda amagciwane asele abuthakathakiswa yisigaba esinamandla.</div>
        </div>
      </div>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 12px;">
        Wonke umuthi unikezwa ngephilisi elilodwa elihlanganisiwe (fixed-dose combination) — uphuza iphilisi elilodwa ngosuku, hhayi amaphilisi amane ahlukene. Amaphilisi amahhala.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">I-DOTS — Ukwelashwa Okubukelwe Ngqo</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        INingizimu Afrika isebenzisa isu le-DOTS: ngesikhathi sesigaba esinamandla, isisebenzi sezempilo, ivolontiya lomphakathi, noma umuntu okusekelayo ekwelashweni ukubukela uphuza umthamo ngamunye. Lokhu akukhona ukungakwethembi — yiyona ndlela efakazelwe kakhulu emhlabeni yokuqinisekisa ukuthi ukwelashwa kuyaqedwa.
      </p>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 8px;">
        Umuntu okusekelayo we-DOTS angaba umhlengikazi womtholampilo, isisebenzi sezempilo somphakathi esikuvakashela ekhaya, isikhulu sezempilo emsebenzini, noma ilungu lomndeni olethembekile eliqeqeshwe umtholampilo. Injongo ukwenza ukwelashwa kwansuku zonke kube lula kuwe ngangokunokwenzeka — uma indlela esetshenziswayo njengamanje ingasebenzi, tshela umhlengikazi bese bethola enye indlela.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Imiphumela emibi yomuthi okumele uyiqaphele</h2>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-bottom: 12px;">
        Abantu abaningi bayakwazi ukuyibekezelela imithi ye-TB, kodwa eminye imiphumela emibi yomuthi ijwayelekile emavikini ambalwa okuqala:
      </p>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 8px;">
        <li><strong>Umchamo o-orenji/obomvu</strong> — lokhu kujwayelekile futhi kubangelwa yi-rifampicin. Akulimazi. Kungase futhi kungcolise amalensi omehlo nomjuluko.</li>
        <li><strong>Isicanucanu</strong> — phuza umuthi nokudla okuncane uma kudingeka. Ngokuvamile siyaphela ngemva kwamaviki ama-2 okuqala.</li>
        <li><strong>Ubuhlungu bamalunga</strong> — bubangelwa yi-pyrazinamide. Ngokuvamile bubuncane. Tshela umhlengikazi ekuvakasheni kwakho okulandelayo.</li>
        <li><strong>Ukuhlaba ezandleni/ezinyaweni</strong> — kubangelwa yi-isoniazid. Umtholampilo kufanele ukunike i-pyridoxine (vitamin B6) ukuvimbela lokhu.</li>
      </ol>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 12px;">
        <strong>Iya emtholampilo ngokushesha</strong> uma uba: namehlo noma isikhumba esiphuzi (ubuthi esibindini), ushintsho ekuboneni (i-ethambutol ingathinta amehlo), umqubuko omkhulu, noma ukuhlanza okungapheli. Lokhu akuvamile kodwa kudinga ukunakwa ngokushesha.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Kungani kubalulekile ukuqedela ukwelashwa</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Abantu abaningi bazizwa bengcono phakathi kwamaviki angu-2-4 okuqala ukwelashwa. Yiso lesi isikhathi esiyingozi kakhulu — ngoba uzizwa umuhle, kuyalinga ukuyeka. Kodwa amagciwane e-TB asaphila, abuthakathaka nje. Ukuyeka kusenesikhathi kucishe kuqinisekise ukuthi i-TB izobuya, futhi ingase ibuye njenge-TB engalapheki ngemithi ejwayelekile, elukhuni futhi ethatha isikhathi eside ukwelashwa.
      </p>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 8px;">
        Qedela zonke izinyanga ezingu-6. Akukho okuhlukile. Inkinga ye-TB eNingizimu Afrika ibangelwa kakhulu ukwelashwa okungaqedwa nokungasebenzi kwemithi okulandelayo.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Ukuvikela umndeni wakho ngesikhathi welashwa</h2>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-bottom: 12px;">
        I-TB isakazeka ngomoya lapho umuntu onaso ekhwehlela, ethimula, noma ekhuluma. Uyathathelana emavikini ama-2 okuqala okwelashwa — ngemva kwalokho, umuthi ucindezela amagciwane ngokwanele ukuze ukudlulisela kungabi lula. Kulawo maviki ama-2 okuqala:
      </p>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 6px;">
        <li><strong>Vula amafasitela.</strong> Amagciwane e-TB abuthana ezindaweni ezivalekile, ezingangeni kahle umoya. Gcina amafasitela evulekile kuwo wonke amakamelo ochitha isikhathi kuwo, ikakhulukazi ekamelweni lokulala. Ngisho nokuvula okuncane kwenza umehluko omkhulu.</li>
        <li><strong>Mboza lapho ukhwehlela.</strong> Khwehlelela endololwaneni yakho noma kuthishu, hhayi esandleni sakho. Lahla amathishu esikhwameni esivalekile.</li>
        <li><strong>Lala wedwa uma kungenzeka.</strong> Emavikini ama-2 okuqala, gwema ukwabelana umbhede nezingane noma amalungu omndeni ane-HIV, asengozini enkulu.</li>
        <li><strong>Bonke abantu ohlala nabo kufanele bahlolwe.</strong> Umtholampilo kufanele unikeze izitsha zesikhwehlela kuwo wonke umuntu ohlala naye ekhaya, ikakhulukazi izingane ezingaphansi kweminyaka emi-5 nanoma ubani one-HIV. Ukuhlolwa kwe-TB kwabantu abathintene nesiguli kumahhala futhi kuyaphoqelekile ohlelweni lukazwelonke — kuphikelele uma umtholampilo ungakunikezi.</li>
        <li><strong>Izingane ezingaphansi kweminyaka emi-5</strong> ezithintene nesiguli esiqinisekisiwe se-TB kufanele zithole i-isoniazid preventive therapy (IPT) izinyanga ezingu-6, noma ngabe ukuhlolwa kwazo kungakhombisi lutho — umtholampilo uzokuhlela lokhu.</li>
      </ol>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">I-TB ngesikhathi sokukhulelwa</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        I-TB ingelashwa futhi kumele yelashwe ngesikhathi sokukhulelwa — i-TB engelashwa iyingozi kakhulu enganeni kunemithi ye-TB. Uhlelo olujwayelekile lwemithi emine (isoniazid, rifampicin, pyrazinamide, ethambutol) lusetshenziswa kuso sonke isikhathi sokukhulelwa. I-Streptomycin kuphela umuthi we-TB ongavunyelwe nhlobo ngesikhathi sokukhulelwa ngenxa yokulimaza ukuzwa kwengane esesibelethweni, kodwa awusayona ingxenye yohlelo olujwayelekile.
      </p>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 8px;">
        Okubalulekile okumele ukucabangele: i-rifampicin yehlisa ukusebenza kwezindlela zokuvimbela ukukhulelwa ezisebenzisa amahomoni — sebenzisa amakhondomu njengesisekelo. Ukuncelisa ibele kuphephile ngenkathi welashwa i-TB, kodwa ingane kufanele ihlolwe futhi inikwe imithi yokuvimbela. Tshela kokubili umhlengikazi wakho we-TB nomhlengikazi wabakhulelwe ukuze bakwazi ukuhlanganisa ukunakekelwa kwakho — ukuvakasha kwe-TB nokwabakhulelwe ngokuvamile kungahlanganiswa emtholampilo owodwa.
      </p>
    </section>

    <section style="background: var(--bg-alt); border-radius: var(--radius); padding: 20px; margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 8px; color: var(--primary-dark);">Amalungelo akho njengesiguli se-TB</h2>
      <ul style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 6px;">
        <li><strong>Awukwazi ukuxoshwa</strong> emsebenzini ngoba une-TB. I-TB ikhubazeko lesikhashana ngaphansi komthetho wezabasebenzi waseNingizimu Afrika. Umqashi wakho kumele akunike ikhefu lokugula nezinhlelo ezifanele.</li>
        <li>Ungakwazi <strong>ukufaka isicelo sesibonelelo sokukhubazeka sesikhashana</strong> (R2,190/ngenyanga ngo-2026) uma i-TB ikuvimbela ukusebenza. Faka isicelo ehhovisi le-SASSA eliseduze nawe unombiko wezempilo ovela emtholampilo.</li>
        <li><strong>Ukutholakala kwesifo sakho kuyimfihlo</strong> — umtholampilo awuvumelekile ukukwabelana nomqashi wakho ngaphandle uma unikeza imvume ebhaliwe.</li>
        <li>Uma <strong>ungumsebenzi wasemayini noma owayengumsebenzi wasemayini</strong>, ungase ufanelekele isinxephezelo esivela ku-Tshiamiso Trust (izimayini zegolide) noma ku-Compensation Commissioner for Occupational Diseases (CCOD). I-TB etholakale emsebenzini wasemayini iyanxeshezelwa.</li>
      </ul>
    </section>

    <section style="background: var(--primary-light); border-radius: var(--radius); padding: 20px; margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 8px; color: var(--primary-dark);">Thola umtholampilo owelapha i-TB</h2>
      <p style="font-size: 0.9rem; margin-bottom: 12px;">
        Izikhungo ezingu-{tbClinics.length} kuhlu lwethu zinikeza ukwelashwa kwe-TB.
      </p>
      <a href="/services/tb" class="btn btn--primary" style="font-size: 0.9rem;">Bheka imitholampilo ye-TB</a>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px;">Imibuzo Ebuzwa Njalo</h2>
      <div style="display: grid; gap: 12px;">
        {faqs.map(faq => (
          <details style="border: 1px solid var(--border); border-radius: var(--radius);">
            <summary style="cursor: pointer; font-weight: 600; font-size: 0.95rem; padding: 14px; list-style: none; display: flex; justify-content: space-between; align-items: center;">
              {faq.question}
              <span style="color: var(--text-muted); flex-shrink: 0; margin-left: 12px;">+</span>
            </summary>
            <div style="padding: 0 14px 14px; font-size: 0.9rem; color: var(--text-muted); line-height: 1.7;">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <section style="border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; font-size: 0.85rem; color: var(--text-muted); line-height: 1.6;">
      <strong style="color: var(--text);">Imithombo:</strong> South African National TB Programme guidelines (2024). WHO End TB Strategy. GeneXpert implementation report — National Health Laboratory Service. DOTS strategy implementation guide — National Department of Health. Global Tuberculosis Report 2025 — WHO.
    </section>
      <section style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border);">
      <h2 style="font-size:1.2rem;margin-bottom:1rem;">Imihlahlandlela Ehlobene</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:0.75rem;">
