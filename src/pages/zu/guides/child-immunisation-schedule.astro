---
// isiZulu translation of src/pages/guides/child-immunisation-schedule.astro (issue #2).
// Sentence-for-sentence. Locale comes off the URL — no locale prop is passed.
// Every age band, dose number and vaccine code is carried across character-identical.
import Base from '../../../layouts/Base.astro';
import { facilities } from '../../../data/helpers';
import { localePath } from '../../../i18n/config';

const immunClinics = facilities.filter(f => f.services.immunisation);

const zu = (p: string) => localePath(p, 'zu');

const schedule = [
  { age: 'Ukuzalwa', vaccines: 'BCG (isifo sofuba, tuberculosis), OPV 0 (i-polio ephuzwayo)', notes: 'Unikezwa ngaphambi kokukhishwa esibhedlela noma ekuvakasheni kokuqala emtholampilo.' },
  { age: 'Amasonto angu-6', vaccines: 'DTaP-IPV-Hib-HBV 1 (6-in-1), OPV 1, PCV 1 (pneumococcal), RV 1 (rotavirus)', notes: 'Usuku lokuqala olukhulu lwemijovo — imijovo engu-4 + amaconsi angu-2 aphuzwayo. I-6-in-1 ivikela i-diphtheria, i-tetanus, i-pertussis, i-polio, i-Hib, ne-hepatitis B.' },
  { age: 'Amasonto angu-10', vaccines: 'DTaP-IPV-Hib-HBV 2, RV 2', notes: 'Umthamo wesibili we-6-in-1 kanye ne-rotavirus yesibili.' },
  { age: 'Amasonto angu-14', vaccines: 'DTaP-IPV-Hib-HBV 3, PCV 2, RV 3', notes: 'Umthamo wesithathu we-6-in-1, i-pneumococcal yesibili, i-rotavirus yesithathu. Uchungechunge lwe-rotavirus seluphelile.' },
  { age: 'Izinyanga ezingu-6', vaccines: 'Measles 1 (ezindaweni ezisengcupheni enkulu kuphela)', notes: 'Unikezwa kuphela ezindaweni lapho kubhebhetheka khona isimungumungwane. Umthamo wokuqala ojwayelekile ungowezinyanga ezingu-9.' },
  { age: 'Izinyanga ezingu-9', vaccines: 'Measles 1, PCV 3', notes: 'Umthamo wokuqala ojwayelekile wesimungumungwane. I-pneumococcal yesithathu. Uchungechunge lwe-pneumococcal seluphelile.' },
  { age: 'Izinyanga ezingu-12', vaccines: 'Measles 2', notes: 'Umthamo wesibili wesimungumungwane. Uchungechunge lwesimungumungwane seluphelile.' },
  { age: 'Izinyanga ezingu-18', vaccines: 'DTaP-IPV-Hib-HBV booster', notes: 'Umjovo oqinisayo (booster) we-6-in-1. Ubalulekile ekuvikelweni kwesikhathi eside.' },
  { age: 'Iminyaka engu-6', vaccines: 'Td (tetanus + diphtheria booster)', notes: 'Umjovo oqinisayo wokungena esikoleni. Unikezwa ngohlelo lwezempilo lwezikole noma emtholampilo.' },
  { age: 'Iminyaka engu-12', vaccines: 'Td booster, HPV (amantombazane kuphela, imithamo engu-2 ehlukaniswe izinyanga ezingu-6)', notes: 'Umjovo we-HPV uvikela umdlavuza womlomo wesibeletho. Unikezwa ezikoleni. Uhlelo lwemithamo engu-2 ezinyangeni ezingu-0 nezingu-6.' },
];

const faqs = [
  {
    question: 'Ingabe imijovo imahhala emitholampilo yomphakathi?',
    answer: 'Yebo. Yonke imijovo esohlelweni lwe-Expanded Programme on Immunisation (EPI-SA) imahhala ezikhungweni zezempilo zomphakathi. Awudingi umshwalense wezempilo (medical aid). Le mijovo iyatholakala nakodokotela abazimele kodwa ngenkokhelo — asikho isizathu sezokwelapha sokukhetha abazimele kunabomphakathi kwimijovo ejwayelekile, ngoba imijovo iyafana.',
  },
  {
    question: 'Kuthiwani uma ingane yami iphuthelwe umjovo?',
    answer: 'Yiya emtholampilo ngokushesha ngangokunokwenzeka. Akudingeki ukuqala uchungechunge phansi — umtholampilo uzoqhubeka lapho uhlelo lugcine khona (uhlelo lokufica). Phatha incwadi ye-Road to Health ukuze umhlengikazi abone ukuthi yimiphi imijovo esinikeziwe. Uma ulahlekelwe yincwadi, umhlengikazi uzoqala entsha futhi angase anikeze eminye imijovo futhi ukuze kuphephe.',
  },
  {
    question: 'Ingabe ingane yami ingajovwa uma inomkhuhlane wamakhaza?',
    answer: 'Yebo, ezimweni eziningi. Ukugula okuncane (amakhala agobhozayo, umkhuhlane ophansi, ukukhwehlela) AKUSONA isizathu sokubambezela umjovo. Okuwukuphela kwezinto ezivimbelayo yilezi: umkhuhlane ophezulu (ongaphezu kuka-38.5°C), ukusabela okubi kakhulu kwe-allergy emthamweni odlule womjovo ofanayo, noma ukuntuleka kwamasosha omzimba okuqinisekisiwe (kwimijovo ephilayo njenge-BCG ne-OPV). Ungabambezeli — wonke umjovo ophuthelwe noma obambezelekile uyisikhathi sokuba sengozini.',
  },
  {
    question: 'Ingabe umjovo we-HPV uphephile?',
    answer: 'Yebo. Umjovo we-HPV usunikezwe abantu abangaphezu kwezigidi ezingu-300 emhlabeni wonke kusukela ngo-2006. Uvikela izinhlobo ze-HPV ezibangela amaphesenti angu-70% omdlavuza womlomo wesibeletho. INingizimu Afrika yawuqala ngo-2014 kumantombazane aneminyaka engu-9-12 ngohlelo lwezempilo lwezikole. Imiphumela emibi yomuthi mincane (ingalo ebuhlungu, umkhuhlane ophansi ngezinye izikhathi). Umdlavuza womlomo wesibeletho ubulala abesifazane baseNingizimu Afrika abangaphezu kuka-3,000 ngonyaka — umjovo uyakuvimbela lokhu.',
  },
  {
    question: 'Umjovo wengane yami ubhalwa kuphi?',
    answer: 'Encwadini ye-Road to Health (RTHB) — incwadi eluhlaza noma ephuzi enikezwa ekuzalweni. Leli irekhodi elisemthethweni lezempilo lengane yakho. Liphathe kukho konke ukuvakasha emtholampilo nakukho konke ukubhalisa esikoleni. Uma lilahlekile, yiya emtholampilo lapho ingane yakho igcine ukujovelwa khona — bangase babe namarekhodi. Umtholampilo uzokhipha incwadi entsha.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Uhlelo Lwemijovo Yezingane — INingizimu Afrika (EPI-SA)',
    description: 'Uhlelo olugcwele lwemijovo lwaseNingizimu Afrika kusukela ekuzalweni kuya eminyakeni engu-12: yimiphi imijovo, inini, nokuthi uyithola kuphi.',
    url: 'https://clinicfinder.co.za/zu/guides/child-immunisation-schedule',
    publisher: { '@type': 'Organization', name: 'Clinic Finder SA' },
    author: { '@type': 'Organization', name: 'Clinic Finder SA' },
    datePublished: '2026-04-16',
    dateModified: '2026-05-14',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(faq => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'Ungayithola Kanjani Imijovo Yengane Yakho Emtholampilo Womphakathi eNingizimu Afrika',
    description: 'Izinyathelo ezingu-5 zokuqinisekisa ukuthi ingane yakho ithola yonke imijovo ye-EPI-SA ngesikhathi.',
    step: [
      { '@type': 'HowToStep', position: 1, name: 'Phatha incwadi yakho ye-Road to Health uya emtholampilo', text: 'Incwadi ye-Road to Health (RTHB — incwadi eluhlaza noma ephuzi enikezwa ekuzalweni) iyirekhodi elisemthethweni lemijovo lengane yakho. Liphathe kukho konke ukuvakasha emtholampilo. Umhlengikazi uyalihlola ukuze abone ukuthi yimiphi imijovo esifanele. Uma ulahlekelwe yiyo, yiya emtholampilo lapho ingane yakho igcine ukujovelwa khona — bangakhipha entsha futhi bangase banikeze imijovo futhi ukuze kuphephe.' },
      { '@type': 'HowToStep', position: 2, name: 'Yiya kunoma yimuphi umtholampilo womphakathi — ayidingeki i-apotimende', text: 'Imijovo iyatholakala kunoma yimuphi umtholampilo womphakathi, isikhungo sezempilo somphakathi, noma isibhedlela esinikeza izinsizakalo zezempilo yezingane. Ayidingeki i-apotimende noma ukubhukha. Ngena nje ngamahora omtholampilo (ngokuvamile ngo-7:30am–4pm ngezinsuku zomsebenzi). Eminye imitholampilo inezinsuku ezithile zemijovo — shayela ucingo kuqala ubuze, kodwa iningi lizojova noma yingasiphi usuku.' },
      { '@type': 'HowToStep', position: 3, name: 'Tshela umhlengikazi ngeminyaka yengane yakho nokuthi yimiphi imijovo efanele', text: 'Khombisa i-RTHB. Umhlengikazi uzohlola ukuthi yimiphi imijovo efanele ngokweminyaka yengane yakho. Uhlelo lwe-EPI-SA luqala ekuzalweni luye eminyakeni engu-12. Uma ingane yakho iphuthelwe eminye imijovo, umhlengikazi uzolandela uhlelo lokufica — akudingeki ukuqala uchungechunge phansi. Yonke imijovo imahhala.' },
      { '@type': 'HowToStep', position: 4, name: 'Linda imizuzu engu-15 ngemva komjovo ukuze ubukelwe', text: 'Ngemva komjovo, hlala emtholampilo imizuzu engu-15 ukuze umhlengikazi abheke noma yikuphi ukusabela okusheshayo (okuyivelakancane kakhulu). Imiphumela emibi yomuthi ejwayelekile: ingalo ebuhlungu, umkhuhlane omncane, ukukhala — konke kujwayelekile futhi kudlula phakathi kwamahora angu-24-48. Nikeza i-paracetamol (i-Panado) uma ingane ingakhululekile. Ukusabela okubi kakhulu okudinga usizo lwezokwelapha kuyivelakancane kakhulu (cishe umthamo owu-1 kwisigidi semithamo).' },
      { '@type': 'HowToStep', position: 5, name: 'Hlela ukuvakasha okulandelayo ngokohlelo lwe-EPI-SA', text: 'Buza umhlengikazi ukuthi umjovo olandelayo ufanele nini bese ukubhala kukhalenda lakho. Izinsuku ezibalulekile: amasonto angu-6 (usuku lokuqala olukhulu lwemijovo — imijovo engu-4 + amaconsi angu-2 aphuzwayo), amasonto angu-10, amasonto angu-14, izinyanga ezingu-9 (isimungumungwane sokuqala), izinyanga ezingu-12 (isimungumungwane sesibili), izinyanga ezingu-18 (umjovo oqinisayo), iminyaka engu-6 (umjovo oqinisayo wokungena esikoleni), kanye neminyaka engu-12 (i-Td + i-HPV kumantombazane). Ukuphuthelwa noma ukubambezela imijovo kushiya ingane yakho isengozini yezifo ezingavimbeleka.' },
    ],
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Ikhasi Lokuqala', item: 'https://clinicfinder.co.za/zu' }, { '@type': 'ListItem', position: 2, name: 'Imihlahlandlela', item: 'https://clinicfinder.co.za/zu/guides' }, { '@type': 'ListItem', position: 3, name: 'Uhlelo Lwemijovo Yezingane (INingizimu Afrika)' }] },
];
---
<Base
  title="Uhlelo Lwemijovo Yezingane (INingizimu Afrika) — Clinic Finder SA"
  description="Uhlelo olugcwele lwemijovo lwe-EPI-SA kusukela ekuzalweni kuya eminyakeni engu-12. Yimiphi imijovo eminyakeni ngayinye, imithamo yokufica, i-HPV yamantombazane, nokuthi ungajovwa kuphi mahhala."
  jsonLd={jsonLd}
>
  <div class="container" style="padding: 32px 0; max-width: 720px;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
      <a href={zu('/')}>Ikhasi Lokuqala</a> &rsaquo; <a href={zu('/guides')}>Imihlahlandlela</a> &rsaquo; Uhlelo Lwemijovo Yezingane
    </nav>

    <h1 style="font-size: 1.5rem; margin-bottom: 8px;">Uhlelo Lwemijovo Yezingane (INingizimu Afrika)</h1>
    <p style="color: var(--text-muted); margin-bottom: 32px; line-height: 1.7;">
      Uhlelo lwaseNingizimu Afrika lwe-Expanded Programme on Immunisation (EPI-SA) lunikeza imijovo emahhala evikela izifo ezingu-13 kusukela ekuzalweni kuya eminyakeni engu-12. Yonke imijovo inikezwa emitholampilo yomphakathi — awudingi umshwalense wezempilo (medical aid) noma i-apotimende. Lolu hlelo lusebenza kusukela ngo-2026.
    </p>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px; color: var(--primary-dark);">Uhlelo lwemijovo</h2>
      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
          <thead>
            <tr style="background: var(--primary-light);">
              <th style="padding: 10px; text-align: left; border-bottom: 2px solid var(--border); white-space: nowrap;">Iminyaka</th>
              <th style="padding: 10px; text-align: left; border-bottom: 2px solid var(--border);">Imijovo</th>
              <th style="padding: 10px; text-align: left; border-bottom: 2px solid var(--border);">Amanothi</th>
            </tr>
          </thead>
          <tbody>
            {schedule.map((row, i) => (
              <tr style={i % 2 === 1 ? 'background: var(--bg-alt)' : ''}>
                <td style="padding: 10px; border-bottom: 1px solid var(--border); font-weight: 600; white-space: nowrap; vertical-align: top;">{row.age}</td>
                <td style="padding: 10px; border-bottom: 1px solid var(--border); line-height: 1.5; vertical-align: top;">{row.vaccines}</td>
                <td style="padding: 10px; border-bottom: 1px solid var(--border); color: var(--text-muted); line-height: 1.5; vertical-align: top;">{row.notes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Yini imijovo eyivikelayo</h2>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-bottom: 12px;">
        Uhlelo lwe-EPI-SA lumboza izifo ezingu-13 ezazibulala noma zikhubaze izinkulungwane zezingane zaseNingizimu Afrika minyaka yonke:
      </p>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 0.9rem;">
        <div style="padding: 8px; background: var(--bg-alt); border-radius: 4px;"><strong>BCG:</strong> Isifo sofuba (i-TB) — izinhlobo ezinzima zezingane</div>
        <div style="padding: 8px; background: var(--bg-alt); border-radius: 4px;"><strong>OPV/IPV:</strong> I-polio</div>
        <div style="padding: 8px; background: var(--bg-alt); border-radius: 4px;"><strong>DTaP:</strong> I-diphtheria, i-tetanus, i-pertussis (ukukhwehlela okubi)</div>
        <div style="padding: 8px; background: var(--bg-alt); border-radius: 4px;"><strong>Hib:</strong> I-Haemophilus influenzae type b (i-meningitis)</div>
        <div style="padding: 8px; background: var(--bg-alt); border-radius: 4px;"><strong>HBV:</strong> I-Hepatitis B</div>
        <div style="padding: 8px; background: var(--bg-alt); border-radius: 4px;"><strong>PCV:</strong> Isifo se-pneumococcal (inyumoniya, i-meningitis)</div>
        <div style="padding: 8px; background: var(--bg-alt); border-radius: 4px;"><strong>RV:</strong> I-Rotavirus (isifo sohudo esinzima)</div>
        <div style="padding: 8px; background: var(--bg-alt); border-radius: 4px;"><strong>Measles:</strong> Isimungumungwane (ukuqubuka, umkhuhlane, izinkinga)</div>
        <div style="padding: 8px; background: var(--bg-alt); border-radius: 4px;"><strong>HPV:</strong> I-Human papillomavirus (umdlavuza womlomo wesibeletho)</div>
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Imijovo yokufica</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Uma ingane yakho iphuthelwe eminye imijovo, ungethuki — iyise emtholampilo ngokushesha ngangokunokwenzeka. Umhlengikazi uzohlola incwadi ye-Road to Health bese enikeza noma yimiphi imithamo esalele. Akudingeki ukuqala noma yiluphi uchungechunge kusukela ekuqaleni. Amasosha omzimba "ayayikhumbula" imithamo edlule ngisho noma sekudlule iminyaka.
      </p>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 8px;">
        Izimo ezijwayelekile zokufica:
      </p>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 6px; margin-top: 8px;">
        <li><strong>Uzalelwe ekhaya / imithamo yokuzalwa iphuthelwe:</strong> Yiya emtholampilo phakathi namasonto ama-2 ukuze uthole i-BCG ne-OPV0.</li>
        <li><strong>Imijovo yamasonto angu-6 iphuthelwe:</strong> Ingase inikezwe noma nini kuze kufike ezinyangeni ezingu-12. Umtholampilo uzolungisa uhlelo.</li>
        <li><strong>Kusanda kuphuthelwa isimungumungwane sezinyanga ezingu-9:</strong> Nikeza ngokushesha ngangokunokwenzeka. Umthamo wesibili wezinyanga ezingu-12 usengase unikezwe ngesikhathi (okungenani amasonto ama-4 phakathi kwemithamo).</li>
        <li><strong>Ayikho incwadi ye-Road to Health:</strong> Umtholampilo uzoqala entsha. Eminye imijovo ingase iphindwe uma lingekho irekhodi — lokhu kuphephile.</li>
      </ol>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Amathiphu osuku lomjovo</h2>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 8px;">
        <li><strong>Phatha incwadi ye-Road to Health</strong> — umhlengikazi uyidinga ukuze abhale imijovo futhi abheke okufanele kwenziwe.</li>
        <li><strong>Gqokisa ingane izingubo ezikhululekile</strong> — iningi lemijovo lijovelwa ethangeni (ngaphansi kwezinyanga ezingu-12) noma engalweni ephezulu (ngaphezu kwezinyanga ezingu-12). Ukufinyelela okulula konga isikhathi.</li>
        <li><strong>Ncelisa ibele ngesikhathi somjovo noma ngokushesha ngemva kwawo</strong> — lokhu kunciphisa ubuhlungu futhi kuthulise ingane. Ucwaningo luqinisekisa ukuthi yiyona ndlela esebenza kakhulu yokudambisa ubuhlungu bezinsana ngaphandle kwemithi.</li>
        <li><strong>Lindela imiphumela emibi yomuthi emincane</strong> — iqhubu elincane elibomvu lapho kujovwe khona, umkhuhlane ophansi (ongaphansi kuka-38°C), nokukhala amahora angu-24-48 kujwayelekile. Nikeza i-paracetamol (umthamo ngokwesisindo) uma ingane ingakhululekile.</li>
        <li><strong>Fika ekuseni</strong> — iningi lemitholampilo lijova ekuseni (07:00-12:00). Fika ngo-07:00 ukugwema ukulinda isikhathi eside.</li>
      </ol>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px;">Imijovo Ephuthelwe Noma Yephuze — Imithetho Yokufica</h2>
      <p style="font-size: 0.9rem; line-height: 1.7; color: var(--text-muted); margin-bottom: 12px;">Umthamo ophuthelwe awusho ukuthi kuqalwa phansi. Inqubomgomo yokufica ye-EPI iqala kabusha kusukela emthamweni ophuthelwe, igcine yonke imithamo eyanikezwa ngaphambili isebenza. Izikhathi ezincane phakathi kwemithamo zisasebenza — umhlengikazi uzobala usuku olulandelayo oluphephile.</p>
      <div style="overflow-x: auto; margin-bottom: 16px;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem;">
          <thead><tr style="border-bottom: 2px solid var(--border);">
            <th style="text-align: left; padding: 10px 8px;">Umjovo</th>
            <th style="text-align: left; padding: 10px 8px;">Isikhathi Esincane Phakathi</th>
            <th style="text-align: left; padding: 10px 8px;">Iminyaka Ephezulu Yokufica</th>
          </tr></thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">OPV (i-polio ephuzwayo)</td><td style="padding: 8px;">amasonto ama-4 phakathi kwemithamo</td><td style="padding: 8px;">iminyaka emi-5</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">I-Hexavalent (DTaP-IPV-Hib-HepB)</td><td style="padding: 8px;">amasonto ama-4 phakathi kwemithamo</td><td style="padding: 8px;">iminyaka engu-7</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">PCV (pneumococcal)</td><td style="padding: 8px;">amasonto angu-8 phakathi kwemithamo eyisisekelo</td><td style="padding: 8px;">iminyaka emi-5</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">I-Rotavirus</td><td style="padding: 8px;">amasonto ama-4 phakathi kwemithamo</td><td style="padding: 8px;">Ayikwazi ukuqalwa ngemva kwamasonto angu-15; ayikwazi ukunikezwa ngemva kwamasonto angu-32</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">Isimungumungwane (Measles)</td><td style="padding: 8px;">amasonto ama-4 phakathi kwemithamo</td><td style="padding: 8px;">Awukho umkhawulo ophezulu — nikeza noma kunini uma kuphuthelwe</td></tr>
          </tbody>
        </table>
      </div>
      <p style="font-size: 0.9rem; line-height: 1.7; color: var(--text-muted);">I-Rotavirus ukuphela komjovo we-EPI onomkhawulo oqinile weminyaka — uma ingane yakho iphuthelwa yileso sikhathi, eminye imithamo esohlelweni iyaqhubeka njengenjwayelo. Tshela umtholampilo usuku lomjovo wokugcina onikeziwe ukuze bakwazi ukuhlela ukufica ngendlela efanele.</p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px;">Ukusabela Komjovo — Nini Lapho Kufanele Ukhathazeke</h2>
      <p style="font-size: 0.9rem; line-height: 1.7; color: var(--text-muted); margin-bottom: 12px;">Ukusabela okuningi kuncane futhi kudlula emahoreni angu-48. Okumbalwa kudinga usizo lwezokwelapha.</p>
      <div style="display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <div style="font-weight: 600; margin-bottom: 8px; color: var(--primary-dark);">Okujwayelekile — kunakekele ekhaya</div>
          <ol style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.7; padding-left: 1.2rem; margin: 0;">
            <li>Ukubomvu/ukuvuvukala lapho kujovwe khona (48h)</li>
            <li>Umkhuhlane ophansi ongaphansi kuka-38°C (24-48h)</li>
            <li>Ukukhala, ukungadli kahle (24h)</li>
            <li>Uhudo oluncane ngemva kwe-rotavirus (izinsuku ezingu-3)</li>
            <li>Iqhubu/isibazi esincane se-BCG (amasonto angu-6-12 ukuze siphole)</li>
          </ol>
        </div>
        <div style="border: 1px solid var(--border); border-left: 3px solid #c0392b; border-radius: var(--radius); padding: 16px;">
          <div style="font-weight: 600; margin-bottom: 8px; color: #c0392b;">Yiya emtholampilo ngokushesha</div>
          <ol style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.7; padding-left: 1.2rem; margin: 0;">
            <li>Umkhuhlane ongaphezu kuka-39°C ongehli nge-paracetamol</li>
            <li>Isithuthwane noma ukudlikiza</li>
            <li>Ukuvuvukala okusabalala kudlule ithambo</li>
            <li>Ithumba le-BCG elikhulu kuna-3cm noma eliphuma ubovu</li>
            <li>Ingane ediyazayo, engasabeli, noma ekhala amahora angu-3+ ingaduduzeki</li>
          </ol>
        </div>
      </div>
    </section>

    <section style="background: var(--primary-light); border-radius: var(--radius); padding: 20px; margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 8px; color: var(--primary-dark);">Thola umtholampilo onikeza imijovo</h2>
      <p style="font-size: 0.9rem; margin-bottom: 12px;">
        Izikhungo ezingu-{immunClinics.length} kuhlu lwethu zinikeza izinsizakalo zemijovo.
      </p>
      <a href="/services/immunisation" class="btn btn--primary" style="font-size: 0.9rem;">Bheka imitholampilo yemijovo</a>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px;">Imibuzo Ebuzwa Njalo</h2>
      <div style="display: grid; gap: 12px;">
        {faqs.map(faq => (
          <details style="border: 1px solid var(--border); border-radius: var(--radius);">
            <summary style="cursor: pointer; font-weight: 600; font-size: 0.95rem; padding: 14px; list-style: none; display: flex; justify-content: space-between; align-items: center;">
              {faq.question}
              <span style="color: var(--text-muted); flex-shrink: 0; margin-left: 12px;">+</span>
            </summary>
            <div style="padding: 0 14px 14px; font-size: 0.9rem; color: var(--text-muted); line-height: 1.7;">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <section style="border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; font-size: 0.85rem; color: var(--text-muted); line-height: 1.6;">
      <strong style="color: var(--text);">Imithombo:</strong> Expanded Programme on Immunisation — South Africa (EPI-SA, 2023 schedule). National Department of Health immunisation guidelines. WHO position papers on childhood vaccines. Road to Health booklet (RTHB) guidelines — NDoH. HPV vaccination programme — South African school health services.
    </section>
      <section style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border);">
