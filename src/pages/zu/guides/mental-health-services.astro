            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 10px 12px; font-weight: 600;">Childline SA</td><td style="padding: 10px 12px;">116 (toll-free)</td><td style="padding: 10px 12px;">Izingane nentsha — ukuhlukunyezwa, ukubhuqwa, impilo yengqondo, ukuphepha ku-inthanethi</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 10px 12px; font-weight: 600;">SANCA</td><td style="padding: 10px 12px;">086 14 SANCA (72622)</td><td style="padding: 10px 12px;">Ukusetshenziswa kabi kwezidakamizwa — utshwala, izidakamizwa, ukugembula. Ukuthunyelwa ekululameni</td></tr>
