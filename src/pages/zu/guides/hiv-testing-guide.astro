---
// isiZulu translation of src/pages/guides/hiv-testing-guide.astro (issue #2).
// Sentence-for-sentence. Locale comes off the URL — no locale prop is passed.
import Base from '../../../layouts/Base.astro';
import { facilities } from '../../../data/helpers';
import { localePath } from '../../../i18n/config';

const hivClinics = facilities.filter(f => f.services.hiv_testing);

const zu = (p: string) => localePath(p, 'zu');

const faqs = [
  {
    question: 'Kuthatha isikhathi esingakanani ukuhlolelwa i-HIV?',
    answer: 'Ukuhlolwa okusheshayo kokuhlatshwa komunwe kuthatha cishe imizuzu engu-20 kusukela ekuqaleni kuze kufike emphumeleni. Yikho ukuhlolwa okujwayelekile emitholampilo yomphakathi eNingizimu Afrika. Umhlengikazi uhlaba umunwe wakho, afake iconsi legazi kucezu lokuhlola, bese elinda imizuzu engu-15. Uma ukuhlolwa kokuqala okusheshayo kukhombisa ukuthi unegciwane, kwenziwa ukuhlolwa kwesibili okusheshayo ngokushesha ukuze kuqinisekiswe. Uma kokubili kukhombisa ukuthi unegciwane, unikezwa ukwelashwa ngama-ARV ngalo lolo suku.',
  },
  {
    question: 'Ngingahlolwa ngingaziwa?',
    answer: 'Yebo. Unelungelo lokuhlolelwa i-HIV ngaphandle kokuveza igama lakho. Ungacela ukuthi igama lakho lingabhalwa — umtholampilo ukunika inombolo esikhundleni salo. Umphumela wakho wokuhlolwa awulokothi wabelwane nomqashi wakho, umndeni, noma omunye umuntu ngaphandle kwemvume yakho ebhaliwe. Lokhu kuvikelwa yi-National Health Act nomthethosisekelo. Uma isisebenzi sezempilo sidalula isimo sakho ngaphandle kwemvume, kuyicala.',
  },
  {
    question: 'Kwenzekani uma ngitholakala nginegciwane?',
    answer: 'INingizimu Afrika ilandela ukuqala ama-ARV ngalo lolo suku. Uma utholakala unegciwane: (1) umhlengikazi wenza ukuhlolwa kwezempilo (isisindo, umfutho wegazi, ukubheka i-TB), (2) athathe igazi le-CD4 count nezinga legciwane egazini (viral load), (3) akuqalise ku-TLD (iphilisi elilodwa, kanye ngosuku) ngalo lolo suku. Awudingi ukulinda imiphumela yegazi. Ama-ARV amahhala, ayasebenza kakhulu, futhi abantu abaningi baphila iminyaka ejwayelekile besebenzisa imithi. Bheka umhlahlandlela wethu ophelele: Ungawathola Kanjani Ama-ARV Emtholampilo Womphakathi.',
  },
  {
    question: 'Kufanele ngihlolwe kangaki?',
    answer: 'Imihlahlandlela yaseNingizimu Afrika incoma: abantu abadala abaya ocansini — okungenani kanye ngonyaka. Abasengozini enkulu (abalingani abaningi, ukungasebenzisi ikhondomu njalo, isimo somlingani singaziwa) — njalo ezinyangeni ezingu-3-6. Abesifazane abakhulelwe — ekuvakasheni kokuqala kwabakhulelwe, futhi emavikini angu-32, nasekubelethweni. Amadoda alala namanye amadoda — njalo ezinyangeni ezingu-3. Abantu abane-TB — kukho konke ukuvakasha kwe-TB (ukuhlolwa kwe-TB ne-HIV ndawonye kujwayelekile).',
  },
  {
    question: 'Iyini i-PrEP futhi ngingayithola kuphi?',
    answer: 'I-PrEP (Pre-Exposure Prophylaxis) iphilisi lansuku zonke (imithi efanayo naleyo ekuma-ARV) eliphuzwa abantu abangenalo igciwane le-HIV ukuvimbela ukuthelelwa yi-HIV. Isebenza ngo-99% uma iphuzwa njalo. I-PrEP iyatholakala mahhala emitholampilo yomphakathi eNingizimu Afrika kunoma ubani osengozini enkulu ye-HIV. Udinga ukuhlolwa okukhombisa ukuthi awunalo igciwane kuqala, bese unikezwa umuthi ngumhlengikazi womtholampilo. Buya njalo ezinyangeni ezingu-3 uphinde uhlolelwe i-HIV futhi ulande umuthi.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Ukuhlolelwa i-HIV eNingizimu Afrika — Kuphi, Kanjani, Nokulindelekile',
    description: 'Umhlahlandlela ophelele wokuhlolelwa i-HIV mahhala emitholampilo yomphakathi yaseNingizimu Afrika: ukuhlolwa okusheshayo, ukuhlolwa ungaziwa, amakhithi okuzihlola, i-PrEP, nokwenzekayo ngemva kwalokho.',
    url: 'https://clinicfinder.co.za/zu/guides/hiv-testing-guide',
    publisher: { '@type': 'Organization', name: 'Clinic Finder SA' },
    author: { '@type': 'Organization', name: 'Clinic Finder SA' },
    datePublished: '2026-04-16',
    dateModified: '2026-05-14',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(faq => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'Ungakuthola Kanjani Ukuhlolelwa i-HIV Mahhala Emtholampilo Womphakathi eNingizimu Afrika',
    description: 'Inqubo yezinyathelo ezingu-5 kusukela ekungeneni emtholampilo kuya ekutholeni umphumela wakho nezinyathelo ezilandelayo.',
    step: [
      { '@type': 'HowToStep', position: 1, name: 'Iya kunoma yimuphi umtholampilo womphakathi — akudingeki i-apotimende', text: 'Ngena kunoma yimuphi umtholampilo womphakathi, isikhungo sezempilo somphakathi, noma isibhedlela ngamahora okusebenza. Ukuhlolelwa i-HIV kuyatholakala kuzo zonke izikhungo zezempilo zomphakathi eNingizimu Afrika. Ungahlolela futhi ezindaweni zokuhlola ezihambayo, emikhankasweni yomphakathi, nakwezinye izindawo zokusebenza. Ayidingeki incwadi yokuthunyelwa, umshwalense wezempilo, noma umazisi. Unelungelo lokuhlolwa ungaziwa.' },
      { '@type': 'HowToStep', position: 2, name: 'Cela ukuhlolelwa i-HIV — i-HCT noma i-VCT', text: 'Tshela umhlengikazi ukuthi ufuna ukuhlolelwa i-HIV. Ungakucela njengengxenye yokuvakasha okujwayelekile noma ukuze uhlolwe kuphela. I-HCT (HIV Counselling and Testing) ifaka ukwelulekwa ngaphambi kokuhlolwa lapho umhlengikazi echaza inqubo, isikhathi sewindi, nemfihlo. Ukwelulekwa kuthatha imizuzu engu-5–10. Ungakwenqaba ukwelulekwa kodwa kuyanconywa, ikakhulukazi kwabahlolwa okokuqala.' },
      { '@type': 'HowToStep', position: 3, name: 'Hlolwa ngokuhlatshwa komunwe okusheshayo (imizuzu engu-20)', text: 'Umhlengikazi uhlaba umunwe wakho, afake iconsi legazi kucezu lokuhlola olusheshayo, bese elinda imizuzu engu-15 umphumela. Uma ukuhlolwa kokuqala kukhombisa ukuthi unegciwane, kwenziwa ukuhlolwa kwesibili okusheshayo ngokushesha ukuze kuqinisekiswe. Uma kokubili kukhombisa ukuthi unegciwane, unikezwa ukwelashwa ngama-ARV ngalo lolo suku. Uma ungenalo igciwane, uthola umphumela okhombisa lokho neseluleko sokuzivikela (amakhondomu, i-PrEP uma usengozini enkulu).' },
      { '@type': 'HowToStep', position: 4, name: 'Uma unegciwane — qala ukwelashwa ngalo lolo suku', text: 'INingizimu Afrika ilandela ukuqala ama-ARV ngalo lolo suku (Universal Test and Treat). Uma kuqinisekisiwe ukuthi unegciwane: umhlengikazi wenza ukuhlolwa kwezempilo (isisindo, umfutho wegazi, ukubheka i-TB), athathe igazi le-CD4 count nezinga legciwane egazini, bese ekuqalisa ku-TLD (tenofovir + lamivudine + dolutegravir — iphilisi elilodwa, kanye ngosuku). Awudingi ukulinda imiphumela yegazi. Ama-ARV amahhala futhi ayasebenza kakhulu.' },
      { '@type': 'HowToStep', position: 5, name: 'Uma ungenalo igciwane — cabangela i-PrEP futhi uphinde uhlolwe njalo', text: 'Uma usengozini enkulu ye-HIV (abalingani abaningi, umlingani unegciwane le-HIV, ukungasebenzisi ikhondomu njalo), buza umhlengikazi nge-PrEP — iphilisi lansuku zonke elisebenza ngo-99% ekuvimbeleni ukuthelelwa yi-HIV. I-PrEP imahhala emitholampilo yomphakathi. Phinde uhlolwe njalo ezinyangeni ezingu-3–6 uma usengozini enkulu, noma okungenani kanye ngonyaka uma uya ocansini. Ukuhlolwa kuyisinyathelo esibaluleke kunazo zonke ekuqedeni lo mshayabhuqe.' },
    ],
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Ikhasi Lokuqala', item: 'https://clinicfinder.co.za/zu' }, { '@type': 'ListItem', position: 2, name: 'Imihlahlandlela', item: 'https://clinicfinder.co.za/zu/guides' }, { '@type': 'ListItem', position: 3, name: 'Ukuhlolelwa i-HIV' }] },
];
---
<Base
  title="Ukuhlolelwa i-HIV — Kuphi, Kanjani & Okulindelekile — Clinic Finder SA"
  description="Ukuhlolelwa i-HIV mahhala emitholampilo yomphakathi yaseNingizimu Afrika: ukuhlolwa okusheshayo, ukuhlolwa ungaziwa, amakhithi okuzihlola, i-PrEP, nokwenzekayo uma utholakala unegciwane."
  jsonLd={jsonLd}
>
  <div class="container" style="padding: 32px 0; max-width: 720px;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
      <a href={zu('/')}>Ikhasi Lokuqala</a> &rsaquo; <a href={zu('/guides')}>Imihlahlandlela</a> &rsaquo; Ukuhlolelwa i-HIV
    </nav>

    <h1 style="font-size: 1.5rem; margin-bottom: 8px;">Ukuhlolelwa i-HIV — Kuphi, Kanjani & Okulindelekile</h1>
    <p style="color: var(--text-muted); margin-bottom: 32px; line-height: 1.7;">
      INingizimu Afrika inohlelo lokwelashwa i-HIV olukhulu kunawo wonke emhlabeni — abantu abangaphezu kuka-5.7 million baphuza ama-ARV. Kodwa kulinganiselwa ukuthi abantu abayi-1.5 million abaphila ne-HIV abasazi isimo sabo. Ukuhlolwa kumahhala, kuyashesha, kuyimfihlo, futhi kuyisinyathelo esibaluleke kunazo zonke ongasithatha. Lo mhlahlandlela ufaka konke okudingeka ukwazi.
    </p>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Ungahlolelwa kuphi</h2>
      <div style="display: grid; gap: 12px;">
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <strong style="color: var(--primary-dark);">Imitholampilo nezibhedlela zomphakathi</strong>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.5;">Ngena nje ucele ukuhlolelwa i-HIV. Mahhala. Akudingeki i-apotimende. Kuyatholakala kuso sonke isikhungo sezempilo somphakathi ezweni. Imiphumela ngemizuzu engu-20.</p>
        </div>
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <strong style="color: var(--primary-dark);">Izindawo zokuhlola ezihambayo</strong>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.5;">Amatende okuhlola aphethwe uhulumeni nezinhlangano ezingekho ngaphansi kukahulumeni ezitobhini zamatekisi, ezikhungweni zokuthenga, emicimbini yomphakathi, nasezindaweni zokusebenza. Mahhala. Ngokuvamile ayatholakala ngezimpelasonto nakusihlwa lapho imitholampilo ivaliwe.</p>
        </div>
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <strong style="color: var(--primary-dark);">Amakhithi okuzihlolela i-HIV</strong>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.5;">I-OraQuick namanye amakhithi okuzihlola ayatholakala emakhemisi (R100-R150) futhi kwesinye isikhathi amahhala ezinhlanganweni ezingekho ngaphansi kukahulumeni nasemitholampilo. Ukusulwa emlonyeni — akudingeki igazi. Imiphumela ngemizuzu engu-20. Uma kukhombisa ukuthi unegciwane, kufanele uqinisekise emtholampilo ngokuhlolwa okusebenzisa igazi ngaphambi kokuqala ukwelashwa.</p>
        </div>
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <strong style="color: var(--primary-dark);">Odokotela abazimele namalebhu e-pathology</strong>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.5;">Kuyatholakala kodokotela abazimele nasemalebhu e-pathology (Lancet, Ampath, PathCare). Kubiza u-R200-R500 kuya ngohlobo lokuhlolwa. Kukhokhelwa amaningi ama-medical aid. Asikho isizathu sezokwelapha sokukhetha okuzimele kunokomphakathi — ukuhlolwa okusheshayo kuyafana.</p>
        </div>
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Kwenzekani ngesikhathi uhlolwa emtholampilo</h2>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 8px;">
        <li><strong>Ukwelulekwa ngaphambi kokuhlolwa</strong> — umeluleki noma umhlengikazi uchaza ukuthi ukuhlolwa kubandakanyani, ukuthi imiphumela engaba khona isho ukuthini, futhi aphendule imibuzo yakho. Lokhu kuthatha cishe imizuzu emi-5. Ungakwenqaba ukuhlolwa nganoma yisiphi isikhathi.</li>
        <li><strong>Ukuhlolwa</strong> — umhlengikazi uhlaba umunwe wakho afake iconsi legazi kucezu lokuhlola olusheshayo. Ulinda cishe imizuzu engu-15.</li>
        <li><strong>Umphumela wokuqala</strong> — uma ungenalo igciwane, welulekwa ngokuhlala ungenalo (amakhondomu, i-PrEP, ukuhlolwa komlingani). Uma unegciwane, kwenziwa ukuhlolwa kwesibili okusheshayo ngokushesha kusetshenziswa elinye ikhithi ukuze kuqinisekiswe.</li>
        <li><strong>Kuqinisekisiwe ukuthi unegciwane</strong> — umhlengikazi wenza ukuhlolwa kwezempilo (isisindo, i-BP, ukubheka i-TB), athathe igazi le-CD4 nezinga legciwane egazini, bese ekunikeza ukuqala ama-ARV ngalo lolo suku. Ungaqala ukwelashwa namuhla.</li>
        <li><strong>Ukwelulekwa ngemva kokuhlolwa</strong> — noma ngabe unegciwane noma awunalo, umeluleki uxoxa ngezinyathelo ezilandelayo, ukwazisa umlingani (ngokuzithandela), nezinhlelo zokubuya futhi.</li>
      </ol>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Isikhathi sewindi — kungani isikhathi sibalulekile</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Akukho ukuhlolwa kwe-HIV okungabona ukutheleleka ngokushesha ngemva kokuthintana negciwane. <strong>Isikhathi sewindi</strong> yisikhathi esiphakathi kokuthintana negciwane okungenzeka nesikhathi lapho ukuhlolwa kungabona khona i-HIV ngokwethembeka. Ngalesi sikhathi sewindi, ungase ube nalo igciwane kodwa ukuhlolwa kukhombise ukuthi awunalo.
      </p>
      <div style="overflow-x: auto; margin-top: 12px;">
        <table style="width: 100%; font-size: 0.88rem; border-collapse: collapse; line-height: 1.6;">
          <thead>
            <tr style="background: var(--bg-alt); text-align: left;">
              <th style="padding: 10px 12px; border-bottom: 2px solid var(--border);">Uhlobo lokuhlolwa</th>
              <th style="padding: 10px 12px; border-bottom: 2px solid var(--border);">Isikhathi sewindi</th>
              <th style="padding: 10px 12px; border-bottom: 2px solid var(--border);">Kutholakala kuphi</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 10px 12px; font-weight: 600;">Ukuhlatshwa komunwe okusheshayo (antibody)</td><td style="padding: 10px 12px;">amaviki angu-6-12 ngemva kokuthintana negciwane</td><td style="padding: 10px 12px;">Yonke imitholampilo yomphakathi (ukuhlolwa okujwayelekile)</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 10px 12px; font-weight: 600;">Ukuhlolwa kwelebhu kwesizukulwane sesi-4 (antigen + antibody)</td><td style="padding: 10px 12px;">amaviki angu-2-4 ngemva kokuthintana negciwane</td><td style="padding: 10px 12px;">Amalebhu (Lancet, Ampath), ezinye izibhedlela</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 10px 12px; font-weight: 600;">I-NAT / PCR (viral RNA)</td><td style="padding: 10px 12px;">izinsuku ezingu-10-14 ngemva kokuthintana negciwane</td><td style="padding: 10px 12px;">Emalebhu kuphela. Kusetshenziselwa ukuhlola izinsana nokuhlola igazi elinikelwe</td></tr>
          </tbody>
        </table>
      </div>
      <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 8px; line-height: 1.6;">Uma kwenzeke into ethile ekubeke engozini (ucansi olungavikelekile, ukuhlatshwa yinaliti, ikhondomu eliqhumile), hlolwa emavikini angu-6 uphinde uhlolwe emavikini angu-12 ukuze uthole umphumela oqinisekile. Ukuhlolwa okukhombisa ukuthi awunalo igciwane emavikini angu-12 kusho ukuthi awuthelelekanga kuleyo ndaba. Uma into eyenzekile ibisengozini enkulu futhi isanda kwenzeka (phakathi kwamahora angu-72), iya ngqo emtholampilo ucele i-PEP — bheka ngezansi.</p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">I-PEP — ukuvimbela okuphuthumayo ngemva kokuthintana negciwane</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        I-PEP (Post-Exposure Prophylaxis) uhlelo lwezinsuku ezingu-28 lwama-ARV oluphuzwa ngemva kokuthintana negciwane le-HIV okungenzeka ukuze kuvinjelwe ukutheleleka. Kufanele iqalwe <strong>phakathi kwamahora angu-72</strong> ngemva kokuthintana negciwane — ngokushesha kungcono (kungcono phakathi kwamahora ama-2). I-PEP imahhala kuzo zonke izikhungo zezempilo zomphakathi.
      </p>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 8px;"><strong>Nini ongacela ngayo i-PEP:</strong></p>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 4px; margin-top: 8px;">
        <li>Ukuhlukunyezwa ngokocansi noma ukudlwengulwa (iya e-Thuthuzela Care Centre noma kunoma yisiphi isibhedlela lapho kwelashwa khona izimo eziphuthumayo — i-PEP iyingxenye yenqubo ejwayelekile ngemva kokudlwengulwa)</li>
        <li>Ikhondomu eliqhume ngesikhathi socansi nomlingani one-HIV noma ongaziwa isimo sakhe</li>
        <li>Ukuhlatshwa yinaliti (izisebenzi zezempilo)</li>
        <li>Ukusebenzisa izinaliti ndawonye</li>
      </ol>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 12px;">
        I-PEP iyisifundo esiphelele sezinsuku ezingu-28 — kufanele uqedele zonke izinsuku ezingu-28 ukuze isebenze. Imiphumela emibi yomuthi (isicanucanu, ukukhathala) ivamile kodwa iyaphatheka. Ngemva kokuqeda i-PEP, hlolelwa i-HIV emavikini angu-6 nasemavikini angu-12 ukuze kuqinisekiswe umphumela.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">I-PrEP — ukuvimbela kwabantu abangenalo igciwane le-HIV</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        I-PrEP (Pre-Exposure Prophylaxis) iphilisi lansuku zonke elivimbela ukuthelelwa yi-HIV. Liqukethe imithi efanayo nesetshenziswa kuma-ARV (tenofovir + emtricitabine) futhi <strong>lisebenza ngo-99%</strong> uma liphuzwa njalo. INingizimu Afrika yenza i-PrEP itholakale mahhala emitholampilo yomphakathi kunoma ubani osengozini enkulu ye-HIV.
      </p>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 8px;">
        <strong>Ubani okufanele acabangele i-PrEP:</strong>
      </p>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 4px; margin-top: 8px;">
        <li>Abantu abanomlingani one-HIV (izithandani ezinesimo esihlukene)</li>
        <li>Abantu abanabalingani abaningi bocansi</li>
        <li>Abantu abangawasebenzisi njalo amakhondomu</li>
        <li>Amadoda alala namanye amadoda</li>
        <li>Abasebenzi bocansi</li>
        <li>Noma ubani ozizwa esengozini futhi efuna ukuvikeleka okwengeziwe</li>
      </ol>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 12px;">
        Ukuqala i-PrEP: iya kunoma yimuphi umtholampilo womphakathi onikeza izinsizakalo ze-HIV, uhlolwe kutholakale ukuthi awunalo igciwane, bese ucela i-PrEP. Uzodinga ukubuya njalo ezinyangeni ezingu-3 uphinde uhlolelwe i-HIV futhi ulande umuthi. I-PrEP ayikuvikeli kwezinye izifo ezithathelwana ngocansi — amakhondomu asanconywa kanye ne-PrEP.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Amalungelo akho</h2>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 6px;">
        <li><strong>Imvume:</strong> Akekho ongakuhlolela i-HIV ngaphandle kwemvume yakho oyinike wazi (ngaphandle kweziguli eziquleke ezimweni eziphuthumayo).</li>
        <li><strong>Imfihlo:</strong> Umphumela wakho uyimfihlo. Awukwazi ukudalulwa kunoma ubani — umqashi, umndeni, umlingani — ngaphandle kwemvume yakho ebhaliwe.</li>
        <li><strong>Akukho ukucwaswa:</strong> Awukwazi ukuxoshwa emsebenzini, ukunqatshelwa imfundo, ukwenqatshelwa umshwalense, noma ukuphathwa ngendlela ehlukile ngenxa yesimo sakho se-HIV. Lokhu kuvikelwa yi-Employment Equity Act ne-Promotion of Equality Act.</li>
        <li><strong>Ukwazisa umlingani:</strong> Ukutshela umlingani wakho kunconywa kakhulu kodwa kungokuzithandela. Umtholampilo ungasiza ngokwazisa umlingani uma ufuna — umeluleki uxhumana nomlingani wakho ngaphandle kokuveza ukuthi ubani ocele lokho kwaziswa.</li>
      </ol>
    </section>

    <section style="background: var(--primary-light); border-radius: var(--radius); padding: 20px; margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 8px; color: var(--primary-dark);">Thola umtholampilo wokuhlolelwa i-HIV</h2>
      <p style="font-size: 0.9rem; margin-bottom: 12px;">
        Izikhungo ezingu-{hivClinics.length} kuhlu lwethu zinikeza ukuhlolelwa i-HIV.
      </p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="/services/hiv-testing" class="btn btn--primary" style="font-size: 0.9rem;">Bheka imitholampilo yokuhlolelwa i-HIV</a>
        <a href={zu('/guides/how-to-get-arvs')} class="btn btn--outline" style="font-size: 0.9rem;">Umhlahlandlela wokwelashwa ngama-ARV</a>
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px;">Imibuzo Ebuzwa Njalo</h2>
      <div style="display: grid; gap: 12px;">
        {faqs.map(faq => (
          <details style="border: 1px solid var(--border); border-radius: var(--radius);">
            <summary style="cursor: pointer; font-weight: 600; font-size: 0.95rem; padding: 14px; list-style: none; display: flex; justify-content: space-between; align-items: center;">
              {faq.question}
              <span style="color: var(--text-muted); flex-shrink: 0; margin-left: 12px;">+</span>
            </summary>
            <div style="padding: 0 14px 14px; font-size: 0.9rem; color: var(--text-muted); line-height: 1.7;">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <section style="border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; font-size: 0.85rem; color: var(--text-muted); line-height: 1.6;">
      <strong style="color: var(--text);">Imithombo:</strong> National HIV Testing Services Policy (NDoH, 2016). National HIV Self-Testing Framework (2018). PrEP implementation guidelines — NDoH. UNAIDS 90-90-90 targets and South Africa progress report. National Health Act — patient rights provisions. Employment Equity Act — HIV non-discrimination.
    </section>
    <section style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border);">
      <h2 style="font-size:1.2rem;margin-bottom:1rem;">Imihlahlandlela Ehlobene</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:0.75rem;">
      <a href={zu('/guides/how-to-get-arvs')} style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Ungawathola Kanjani Ama-ARV</a>
      <a href={zu('/guides/family-planning-contraception')} style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Ukuhlela Umndeni &amp; Izindlela Zokuvimbela Ukukhulelwa</a>
      <a href={zu('/guides/mental-health-services')} style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Izinsizakalo Zempilo Yengqondo</a>
      <a href={zu('/guides/find-nearest-clinic')} style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Thola Umtholampilo Oseduze Nawe</a>
      </div>
    </section>
    <section style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border);">
      <h2 style="font-size:1.2rem;margin-bottom:1rem;">Thola Imitholampilo Ngesifundazwe</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:0.75rem;">
      <a href="/clinics/gauteng" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Gauteng</a>
      <a href="/clinics/kwazulu-natal" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">KwaZulu-Natal</a>
      <a href="/clinics/western-cape" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Western Cape</a>
      <a href="/clinics/eastern-cape" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Eastern Cape</a>
      <a href="/clinics/limpopo" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Limpopo</a>
      <a href="/clinics/mpumalanga" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Mpumalanga</a>
      <a href="/clinics/north-west" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">North West</a>
      <a href="/clinics/free-state" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Free State</a>
      <a href="/clinics/northern-cape" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Northern Cape</a>
      </div>
    </section>
  </div>
</Base>
