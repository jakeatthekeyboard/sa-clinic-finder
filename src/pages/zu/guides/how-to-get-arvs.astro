---
// isiZulu translation of src/pages/guides/how-to-get-arvs.astro (issue #2).
// Sentence-for-sentence. Locale comes off the URL — no locale prop is passed.
import Base from '../../../layouts/Base.astro';
import { facilities, SERVICE_MAP } from '../../../data/helpers';
import { localePath } from '../../../i18n/config';

const arvClinics = facilities.filter(f => f.services.arv_treatment);
const provinceCounts: Record<string, number> = {};
arvClinics.forEach(f => { provinceCounts[f.province] = (provinceCounts[f.province] || 0) + 1; });

const zu = (p: string) => localePath(p, 'zu');

const faqs = [
  {
    question: 'Ngingawathola ama-ARV (antiretrovirals) ngingenawo umazisi?',
    answer: 'Yebo. Awukwazi ukunqatshelwa ukuhlolelwa i-HIV noma ukwelashwa ngoba ungenawo umazisi. Imitholampilo ingase icele elinye iphepha lokukukhomba (imvume yokukhosela, iphepha lembacu, isifungo esibhalwe esiteshini samaphoyisa) ukuze idale ifayela lakho, kodwa ukwelashwa akunqatshelwa. Uma umtholampilo unqaba, shayela ucingo losizo lwe-Treatment Action Campaign: 0800 322 322.',
  },
  {
    question: 'Abiza malini ama-ARV emtholampilo kahulumeni?',
    answer: 'Ukwelashwa ngama-ARV kumahhala ngokuphelele kuzo zonke izikhungo zezempilo zomphakathi eNingizimu Afrika. Lokhu kufaka umuthi, ukuhlolwa kwegazi (i-CD4 count nezinga legciwane egazini / viral load), kanye nokubonana nesisebenzi sezempilo. Awudingi umshwalense wezempilo (medical aid).',
  },
  {
    question: 'Ngingawaqala ama-ARV ngalo lolo suku engitholakala ngalo ukuthi nginegciwane?',
    answer: 'Yebo. INingizimu Afrika ilandela inqubomgomo yokuqala ngalo lolo suku kusukela ngo-2017. Uma utholakala unegciwane le-HIV, umhlengikazi angakuqalisa kuma-ARV ngalo lolo suku ngemva kokuhlolwa okufushane kwezempilo nokuthathwa kwegazi. Awudingi ukulinda imiphumela yegazi ukuze uqale.',
  },
  {
    question: 'Kwenzekani uma ngiphuthelwa imithamo yama-ARV?',
    answer: 'Ukuphuthelwa imithamo kwandisa ingozi yokuthi umuthi ungabe usasebenza (drug resistance), okusho ukuthi uhlelo lwakho lwemithi lwamanje lungase luyeke ukusebenza. Uma uphuthelwa umthamo, uwuphuze ngokushesha uma nje usukhumbula (ngaphandle uma sekusondele isikhathi somthamo olandelayo). Uma ungawaphuzanga imithi isikhathi esingaphezu kwenyanga, buyela emtholampilo — bazokuqalisa kabusha, mhlawumbe kuqale ukuhlolwa kwegazi. Akukho sijeziso noma ukwahlulelwa ngokubuya.',
  },
  {
    question: 'Ngingawalanda ama-ARV ekhemisi esikhundleni somtholampilo?',
    answer: 'Yebo, uma uzinzile ekwelashweni (izinga legciwane egazini licindezelekile izinyanga ezingu-12 noma ngaphezulu). Uhlelo lwe-CCMDD lukuvumela ukuthi ulande ama-ARV akho ezindaweni zokulanda ezingaphandle ezingaphezu kuka-3,000, kufaka amakhemisi azimele, amahholo omphakathi, nezindawo zokusebenza. Cela umhlengikazi womtholampilo ukuthi akubhalise ku-CCMDD.',
  },
];

const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Ungawathola Kanjani Ama-ARV Emtholampilo Womphakathi eNingizimu Afrika',
  description: 'Umhlahlandlela wesinyathelo nesinyathelo wokuqala ukwelashwa mahhala ngama-ARV emtholampilo kahulumeni. Ukuqala ngalo lolo suku kuyatholakala.',
  totalTime: 'PT2H',
  step: [
    { '@type': 'HowToStep', position: 1, name: 'Zihlole', text: 'Ngena kunoma yimuphi umtholampilo womphakathi ucele ukuhlolelwa i-HIV mahhala. Imiphumela ngemizuzu engu-20 ngokuhlolwa okusheshayo kokuhlatshwa komunwe.' },
    { '@type': 'HowToStep', position: 2, name: 'Ukuqala ngalo lolo suku', text: 'Uma utholakala unegciwane, umhlengikazi wenza ukuhlolwa kwezempilo bese ekuqalisa kuma-ARV ngalo lolo suku. Uhlelo olujwayelekile: i-TLD — iphilisi elilodwa, kanye ngosuku.' },
    { '@type': 'HowToStep', position: 3, name: 'Phatha amaphepha akho', text: 'Phatha umazisi wakho waseNingizimu Afrika noma ipasipoti, noma yimuphi umuthi okuwuphuzayo njengamanje, nekhadi lakho lomtholampilo uma unalo.' },
    { '@type': 'HowToStep', position: 4, name: 'Ukubuya futhi', text: 'Buya ngenyanga eyodwa, ngezinyanga ezintathu, bese kuba njalo ngezinyanga eziyisithupha lapho usuzinzile. Ukuhlolwa kwegazi kubheka izinga legciwane egazini nokusebenza kwezinso.' },
    { '@type': 'HowToStep', position: 5, name: 'Landa umuthi nyanga zonke', text: 'Landa umuthi nyanga zonke ekhemisi lomtholampilo. Iziguli ezizinzile zingajoyina i-CCMDD ukuze zilande emakhemisini noma kuma-ATM.' },
  ],
};

const jsonLd = [
  howToLd,
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Ungawathola Kanjani Ama-ARV Emtholampilo Womphakathi eNingizimu Afrika',
    description: 'Umhlahlandlela wesinyathelo nesinyathelo wokuqala ukwelashwa ngama-ARV emtholampilo kahulumeni eNingizimu Afrika.',
    url: 'https://clinicfinder.co.za/zu/guides/how-to-get-arvs',
    publisher: { '@type': 'Organization', name: 'Clinic Finder SA' },
    author: { '@type': 'Organization', name: 'Clinic Finder SA' },
    datePublished: '2026-04-16',
    dateModified: '2026-05-14',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(faq => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Ikhasi Lokuqala', item: 'https://clinicfinder.co.za/zu' }, { '@type': 'ListItem', position: 2, name: 'Imihlahlandlela', item: 'https://clinicfinder.co.za/zu/guides' }, { '@type': 'ListItem', position: 3, name: 'Ungawathola Kanjani Ama-ARV Emtholampilo Womphakathi' }] },
];
---
<Base
  title="Ungawathola Kanjani Ama-ARV Emtholampilo Womphakathi — Clinic Finder SA"
  description="Umhlahlandlela wesinyathelo nesinyathelo wokuqala ukwelashwa ngama-ARV emtholampilo kahulumeni eNingizimu Afrika. Ukuqala ngalo lolo suku, okufanele ukuphathe, ukuhlolwa kwegazi, nemithi yamahhala."
  jsonLd={jsonLd}
>
  <div class="container" style="padding: 32px 0; max-width: 720px;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
      <a href={zu('/')}>Ikhasi Lokuqala</a> &rsaquo; <a href={zu('/guides')}>Imihlahlandlela</a> &rsaquo; Ungawathola Kanjani Ama-ARV
    </nav>

    <h1 style="font-size: 1.5rem; margin-bottom: 8px;">Ungawathola Kanjani Ama-ARV Emtholampilo Womphakathi</h1>
    <p style="color: var(--text-muted); margin-bottom: 32px; line-height: 1.7;">
      Ukwelashwa ngama-ARV (antiretrovirals) kumahhala kuwo wonke umtholampilo womphakathi eNingizimu Afrika. Ungaqala ngalo lolo suku otholakala ngalo unegciwane. Lo mhlahlandlela ukukhombisa yonke inqubo — kusukela ekufikeni emtholampilo kuya ekulandeni komuthi wakho nyanga zonke.
    </p>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Isinyathelo 1: Zihlole</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Ngena kunoma yimuphi umtholampilo womphakathi ucele ukuhlolelwa i-HIV. Ukuhlolwa kumahhala, kuyimfihlo, futhi kuthatha cishe imizuzu engu-20 (ukuhlolwa okusheshayo kokuhlatshwa komunwe). Awudingi i-apotimende. Imiphumela unikezwa yona uwedwa — ayilokothi yabelwane nomqashi wakho, umndeni, noma omunye umuntu ngaphandle kwemvume yakho.
      </p>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 8px;">
        Uma ungathandi ukuya emtholampilo wendawo yakini, noma yisiphi isikhungo somphakathi kunoma yisiphi isifundazwe sizokuhlola. Ungahlolela futhi ezindaweni zokuhlola ezihambayo (bheka amatende ezempilo kahulumeni ezitobhini zamatekisi nasezikhungweni zokuthenga) noma ucele isisebenzi sezempilo somphakathi endaweni yakini.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Isinyathelo 2: Ukuqala ngalo lolo suku</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Uma utholakala unegciwane, umhlengikazi uzokwenza ukuhlolwa kwezempilo okufushane: isisindo, umfutho wegazi (blood pressure), ukubheka izimpawu ze-TB, nokuthatha igazi le-CD4 count nokuhlolwa kwezinga legciwane egazini (viral load). Inqubomgomo yaseNingizimu Afrika kusukela ngoSeptember 2017 <strong>ukuqala ama-ARV ngalo lolo suku</strong> — awudingi ukulinda imiphumela yegazi ukuze uqale ukwelashwa.
      </p>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 8px;">
        Uhlelo lokuqala olujwayelekile yi-TLD (tenofovir + lamivudine + dolutegravir) — iphilisi elilodwa, kanye ngosuku. Lisebenza kakhulu, linemiphumela emibi emincane, futhi licindezela igciwane kubantu abaningi phakathi kwezinyanga ezingu-3-6.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Isinyathelo 3: Okufanele ukuphathe</h2>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 8px;">
        <li><strong>Umazisi waseNingizimu Afrika, ipasipoti, noma imvume yokukhosela</strong> — ukuze kudalwe ifayela lakho lomtholampilo. Uma ungenayo neyodwa yalezi, umtholampilo kufanele usakwelaphe (bheka Imibuzo Ebuzwa Njalo ngezansi).</li>
        <li><strong>Ubufakazi bekheli</strong> — abudingeki ngaso sonke isikhathi, kodwa busiza umtholampilo ukuthi ukubeke esikhungweni esiseduze ukuze ubuye futhi.</li>
        <li><strong>Noma yimuphi umuthi owuphuzayo njengamanje</strong> — ikakhulukazi uma uphuza imithi ye-TB, imithi kashukela, noma imithi yesithuthwane. Eminye imithi ixabana nama-ARV futhi umhlengikazi kufanele azi.</li>
        <li><strong>Ikhadi eliluhlaza lomtholampilo</strong> — uma usuvele unalo kusukela ekuvakasheni kwangaphambili. Uma ungenalo, umtholampilo uzokudalela ifayela elisha lesiguli.</li>
      </ol>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Isinyathelo 4: Ukubuya futhi</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Ezinyangeni ezingu-6 zokuqala, uzovakashela umtholampilo nyanga zonke uzolanda umuthi wakho futhi ubonane nomhlengikazi. Ukuhlolwa kwegazi kwenzeka ngenyanga yesi-3 (izinga legciwane egazini) nangenyanga yesi-6 (izinga legciwane egazini + ukusebenza kwezinso). Uma usuzinzile — izinga legciwane egazini licindezelekile, akukho miphumela emibi — ukuvakasha kuya kuba njalo ezinyangeni ezingu-2-3.
      </p>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 8px;">
        Ngemva kwezinyanga ezingu-12 zezinga legciwane egazini elicindezelekile, ungabhalisela i-<a href={zu('/guides/ccmdd-chronic-meds-pickup')}>CCMDD</a> (Central Chronic Medicine Dispensing and Distribution). Lokhu kukuvumela ukuthi ulande ama-ARV akho ekhemisi elizimele, ehholo lomphakathi, noma endaweni yokulanda emsebenzini — akusekho ukuma emigqeni yomtholampilo ukulanda imithi ejwayelekile.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Isinyathelo 5: Ukuqhubeka nokwelashwa</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Ama-ARV ayimithi yempilo yonke — alikho ikhambi le-HIV, kodwa ukwelashwa kucindezela igciwane kangangokuthi abantu abaphuza ama-ARV baphila iminyaka ejwayelekile futhi abakwazi ukudlulisela i-HIV ngokocansi (U=U: Undetectable = Untransmittable).
      </p>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 8px;">
        Into ebaluleke kunazo zonke ukuphuza iphilisi lakho ngesikhathi esifanayo nsuku zonke. Beka i-alamu ocingweni. Uma uhamba, phatha umuthi owanele. Uma uphelelwa, iya emtholampilo oseduze kunoma yikuphi ezweni — bangakunika umuthi wesikhashana kulindwe ukudluliselwa kwefayela lakho.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Imiphumela emibi ejwayelekile ye-TLD</h2>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-bottom: 12px;">
        I-TLD (tenofovir + lamivudine + dolutegravir) abantu abaningi bayakwazi ukuyibekezelela, kodwa eminye imiphumela emibi yomuthi ijwayelekile emavikini angu-2-4 okuqala. Cishe yonke iyaziphelela ngokwayo.
      </p>
      <ul style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 6px;">
        <li><strong>Ukuqwasha noma amaphupho acacile</strong> — umphumela omubi obikwa kakhulu we-dolutegravir. Uvamise ukuphela emavikini angu-2-4. Ukuphuza iphilisi lakho ekuseni esikhundleni sasebusuku kungasiza.</li>
        <li><strong>Ikhanda elibuhlungu nesiyezi</strong> — kujwayelekile emavikini angu-1-2 okuqala. I-paracetamol oyithenga ngaphandle kwencwadi kadokotela iphephile ukuyiphuza nama-ARV.</li>
        <li><strong>Isicanucanu</strong> — phuza iphilisi lakho nokudla ukuze unciphise lokhu. Uma isicanucanu siqhubeka ngemva kwenyanga, tshela umhlengikazi.</li>
        <li><strong>Ukukhuluphala</strong> — i-dolutegravir ihlotshaniswa nokukhuluphala kwabanye abantu, ikakhulukazi abesifazane. Ucwaningo lusikisela u-3-5 kg onyakeni wokuqala ngokwesilinganiso. Lokhu kuyinto eyaziwayo ekumele uyibekezelele emthini omuhle kakhulu.</li>
        <li><strong>Ukukhathazeka ngezinso (akuvamile)</strong> — i-tenofovir ingathinta ukusebenza kwezinso, yingakho umtholampilo uhlola izinso zakho ezinyangeni ezingu-3 nezingu-6. Uma usuvele unesifo sezinso, tshela umhlengikazi ngaphambi kokuqala.</li>
      </ul>
      <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 8px; line-height: 1.6;"><strong>Buyela emtholampilo ngokushesha uma:</strong> uba nomqubuko, ubuhlungu obukhulu esiswini, ukuphenduka kube phuzi kwamehlo noma kwesikhumba, noma ukuhlanza okungapheli okukuvimbela ukuthi iphilisi lakho lihlale phansi. Lokhu akuvamile kodwa kudinga ukunakwa ngokushesha.</p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Kuthiwani uma izinga legciwane egazini lami lingacindezeleki?</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Abantu abaningi abaphuza i-TLD bafinyelela ezingeni legciwane egazini elingatholakali (ngaphansi kuka-50 copies/mL) phakathi kwezinyanga ezingu-3-6. Uma ukuhlolwa kwegazi kwakho kwenyanga yesi-3 kukhombisa izinga legciwane egazini elingaphezu kuka-1,000 copies/mL, umtholampilo uzokunika ukwelulekwa ngokuphuza imithi ngendlela — isizathu esivame kakhulu sokwehluleka ukuphuthelwa imithamo, hhayi ukungasebenzi komuthi.
      </p>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 8px;">
        Uzophinde uhlolelwe izinga legciwane egazini ezinyangeni ezingu-3 kamuva. Uma lisaphezu kuka-1,000 ngemva kokuqinisekiswa ukuthi uphuza imithi kahle, umtholampilo uzoyala ukuhlolwa kokungasebenzi komuthi (resistance test). Uma kuqinisekiswa ukuthi umuthi awusasebenzi, udlulela ohlelweni lwesibili lwemithi — kusemahhala, kuseyiphilisi elilodwa ngosuku ezimweni eziningi (zidovudine + lamivudine + dolutegravir noma okufanayo). Zikhona izinhlelo zesithathu zemithi ezimweni ezingavamile lapho olwesibili nalo lwehluleka, kodwa lezi zidinga ukuthunyelwa kudokotela oyingcweti.
      </p>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 8px;">
        Okubalulekile ongakuthatha: ukwehluleka kohlelo lokuqala akusona isimo esibucayi. Uhlelo lwezempilo lunezinye izinhlelo zemithi ezisekelayo. Kodwa ukukhuluma iqiniso nomhlengikazi wakho mayelana nemithamo oyiphuthelwe kuvimbela ushintsho olungadingekile futhi kugcina izindlela zakho zokwelashwa zesikhathi esizayo.
      </p>
    </section>

    <section style="background: var(--bg-alt); border-radius: var(--radius); padding: 20px; margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 8px; color: var(--primary-dark);">Amalungelo akho njengesiguli esiphuza ama-ARV</h2>
      <ul style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 6px;">
        <li>Unelungelo <strong>lemfihlo</strong> — akekho emtholampilo ongadalula isimo sakho se-HIV kunoma ubani ngaphandle kwemvume yakho ebhaliwe.</li>
        <li>Unelungelo <strong>lesithunzi</strong> — abasebenzi bomtholampilo abavumelekile ukukujabhisa, ukukukhuza, noma ukukunqabela ukwelashwa nganoma yisiphi isizathu, kufaka nokubuya ngemva kokuyeka imithi.</li>
        <li>Unelungelo <strong>lokudlulisa</strong> — ungadlulisela ifayela lakho lama-ARV kunoma yimuphi umtholampilo womphakathi kunoma yisiphi isifundazwe nganoma yisiphi isikhathi.</li>
        <li>Unelungelo <strong>lokwelashwa noma ngabe ungowaliphi izwe</strong> — abafuna ukukhosela, ababaleki, nabantu abangenawo amaphepha banelungelo lokwelashwa ngama-ARV.</li>
        <li>Uma amalungelo akho ephulwa, xhumana ne-<strong>Treatment Action Campaign</strong> ku-0800 322 322 noma i-<strong>Health Ombud</strong> ku-012 942 7808.</li>
      </ul>
    </section>

    <section style="background: var(--primary-light); border-radius: var(--radius); padding: 20px; margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 8px; color: var(--primary-dark);">Thola umtholampilo onikeza ama-ARV</h2>
      <p style="font-size: 0.9rem; margin-bottom: 12px;">
        Izikhungo ezingu-{arvClinics.length} kuhlu lwethu zinikeza ukwelashwa ngama-ARV kuzo zonke izifundazwe ezingu-9.
      </p>
      <a href="/services/arvs" class="btn btn--primary" style="font-size: 0.9rem;">Bheka imitholampilo yama-ARV</a>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px;">Imibuzo Ebuzwa Njalo</h2>
      <div style="display: grid; gap: 12px;">
        {faqs.map(faq => (
          <details style="border: 1px solid var(--border); border-radius: var(--radius);">
            <summary style="cursor: pointer; font-weight: 600; font-size: 0.95rem; padding: 14px; list-style: none; display: flex; justify-content: space-between; align-items: center;">
              {faq.question}
              <span style="color: var(--text-muted); flex-shrink: 0; margin-left: 12px;">+</span>
            </summary>
            <div style="padding: 0 14px 14px; font-size: 0.9rem; color: var(--text-muted); line-height: 1.7;">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <section style="border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; font-size: 0.85rem; color: var(--text-muted); line-height: 1.6;">
      <strong style="color: var(--text);">Imithombo:</strong> South African National Department of Health ARV treatment guidelines (2023 update). Treatment Action Campaign. UNAIDS country profile — South Africa. WHO consolidated guidelines on HIV prevention, testing, treatment. CCMDD implementation framework (National Department of Health, 2018).
    </section>
    <section style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border);">
      <h2 style="font-size:1.2rem;margin-bottom:1rem;">Imihlahlandlela Ehlobene</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:0.75rem;">
