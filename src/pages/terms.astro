---
import Base from '../layouts/Base.astro';
---

<Base title="Terms of Use — Clinic Finder SA" description="Terms of use for Clinic Finder SA. Usage terms, disclaimers, and limitations of liability." noindex={true}>
  <div class="container" style="padding: 2rem 0 3rem;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem;">
      <a href="/" style="color: var(--primary-dark);">Home</a> › Terms of Use
    </nav>

    <h1 style="font-size: 1.8rem; margin-bottom: 0.5rem;">Terms of Use</h1>
    <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem;">Last updated: May 15, 2026</p>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">Acceptance of Terms</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">By accessing Clinic Finder SA ("the site"), you agree to these terms. If you do not agree, please do not use the site.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">Purpose & Scope</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">Clinic Finder SA is a free public health facility directory for South Africa. The site helps users locate public clinics, community health centres, and hospitals by province, service, or proximity. Content is for informational purposes only and does not constitute medical advice.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">No Medical Advice</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">Information on this site, including health guides, service descriptions, and facility details, is educational and not a substitute for professional medical advice, diagnosis, or treatment. Always consult a qualified healthcare provider for medical concerns. In a medical emergency, call 10177 (national ambulance) or go to your nearest emergency facility.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">Accuracy of Information</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">Facility data is sourced from the National Department of Health's facility registry and supplemented by provincial health department records. Operating hours, services offered, and contact details change without notice. We update records regularly but cannot guarantee that every detail is current. If you find outdated information, please <a href="/contact" style="color: var(--primary-dark);">let us know</a>.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">Location Features</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">The "Find nearest clinic" feature uses your browser's geolocation API. This data is processed locally in your browser and never stored on our servers. Distance calculations are approximate and should not replace navigation software when travelling to a facility.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">Limitation of Liability</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">Clinic Finder SA is provided "as is" without warranties of any kind. We are not liable for damages arising from your use of or reliance on information on this site, including but not limited to incorrect facility details, unavailable services, or travel decisions based on distance estimates.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">Intellectual Property</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">Original editorial content, guides, and analysis are owned by Clinic Finder SA. Facility data sourced from public government records is not proprietary. You may reference our content with attribution.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">Changes to Terms</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">We may update these terms at any time. Continued use of the site after changes constitutes acceptance of the updated terms.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">Contact</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">Questions about these terms? Email <a href="mailto:hello@clinicfinder.co.za" style="color: var(--primary-dark);">hello@clinicfinder.co.za</a>.</p>
    </section>
  </div>
</Base>
