---
import Base from '../layouts/Base.astro';
---

<Base title="Privacy Policy — Clinic Finder SA" description="Privacy policy for Clinic Finder SA. How we handle visitor data and third-party services." noindex={true}>
  <div class="container" style="padding: 2rem 0 3rem;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem;">
      <a href="/" style="color: var(--primary-dark);">Home</a> › Privacy
    </nav>

    <h1 style="font-size: 1.8rem; margin-bottom: 0.5rem;">Privacy Policy</h1>
    <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem;">Last updated: May 9, 2026</p>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">Overview</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">Clinic Finder SA is a free public health tool. We do not require registration, login, or any personal information to use this site.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">What We Collect</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">We collect basic usage analytics (pages viewed, device type, referral source) through Vercel Analytics — a privacy-focused service that uses no cookies and stores no personal data. If you email us, we retain your message to respond and improve the site.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">Location Data</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">The "Find nearest" features use your browser's geolocation API to find clinics near you. This location data is processed in your browser only — it is never sent to our servers or stored.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">Contact</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">For privacy questions, email <a href="mailto:hello@clinicfinder.co.za" style="color: var(--primary-dark);">hello@clinicfinder.co.za</a>.</p>
    </section>
  </div>
</Base>
