---
import Base from '../../layouts/Base.astro';
import { facilities, SERVICE_MAP } from '../../data/helpers';
import { SERVICE_EDITORIAL } from '../../data/service-editorial';

const services = Object.entries(SERVICE_MAP).map(([key, svc]) => ({
  key,
  ...svc,
  count: facilities.filter(f => f.services[key]).length,
  hasEditorial: !!SERVICE_EDITORIAL[key],
  guideSlug: SERVICE_EDITORIAL[key]?.guideSlug,
})).sort((a, b) => b.count - a.count);

const SERVICE_DESCRIPTIONS: Record<string, string> = {
  arv_treatment: 'Antiretroviral treatment for HIV. Same-day initiation available at all clinics since 2017.',
  tb_treatment: 'Tuberculosis screening, GeneXpert testing, and DOTS treatment. Free 6-month regimen.',
  maternity_antenatal: 'Free antenatal care, delivery, and postnatal check-ups. No medical aid required.',
  chronic_medication: 'Hypertension, diabetes, epilepsy, asthma, depression. Free lifelong medication.',
  emergency_24h: '24-hour casualty and emergency stabilisation. Constitutional right — no one turned away.',
  dental: 'Extractions, fillings, dentures, emergency pain relief. Walk-in for emergencies.',
  mental_health: 'Depression, anxiety, PTSD, substance abuse. Screening, medication, counselling referral.',
  child_health: 'Growth monitoring, nutrition support, IMCI assessment. Free for all under-6s.',
  family_planning: 'Injectables, implant, pill, IUD, condoms. Free for all. Age 12+ without parental consent.',
  immunisation: 'Full EPI-SA schedule: birth to 12 years, 13 diseases. Catch-up doses at any age.',
  hiv_testing: 'Rapid finger-prick test (15 min). Free, confidential, anonymous. Self-test kits available.',
};

const totalFacilities = facilities.filter(f => f.province !== '').length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Health Services at Public Clinics — Clinic Finder SA',
  description: `Find public clinics by service across ${totalFacilities} facilities in South Africa.`,
  url: 'https://clinicfinder.co.za/services',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://clinicfinder.co.za/services/${s.slug}`,
      name: s.plain,
    })),
  },
};
---
<Base
  title="Services at Public Clinics — Clinic Finder SA"
  description="Find public clinics by service: ARVs, TB treatment, maternity care, emergency, dental, mental health, chronic medication, immunisation, and more."
  jsonLd={[jsonLd, { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://clinicfinder.co.za/' }, { '@type': 'ListItem', position: 2, name: 'Services' }] }]}
>
  <div class="container" style="padding: 32px 0;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
      <a href="/">Home</a> &rsaquo; Services
    </nav>
    <h1 style="font-size: 1.5rem; margin-bottom: 8px;">Find Clinics by Service</h1>
    <p style="color: var(--text-muted); margin-bottom: 32px; max-width: 640px; line-height: 1.6;">
      All primary healthcare services at public clinics are free for South African residents. Select a service below to find facilities that offer it, with details on what to expect and who is eligible.
    </p>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px;">
      {services.map(s => (
        <a href={`/services/${s.slug}`} class="card" style="text-decoration: none; color: var(--text);">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px;">
            <div>
              <strong style="font-size: 1.05rem;">{s.plain}</strong>
              {SERVICE_DESCRIPTIONS[s.key] && (
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px; line-height: 1.5;">{SERVICE_DESCRIPTIONS[s.key]}</p>
              )}
              <div style="font-size: 0.85rem; color: var(--primary-dark); margin-top: 8px; font-weight: 600;">
                {s.count} facilities &rarr;
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

    <section style="margin-top: 40px; background: var(--bg-alt); border-radius: var(--radius); padding: 24px; max-width: 720px;">
      <h2 style="font-size: 1.15rem; margin-bottom: 12px; color: var(--primary-dark);">Not sure what service you need?</h2>
      <p style="font-size: 0.95rem; line-height: 1.7; margin-bottom: 16px;">
        Walk into any public clinic and tell the nurse your symptoms. They will assess you, decide what care you need, and either treat you on-site or refer you to the right facility. You do not need to know the "service name" — just describe what is wrong.
      </p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="/search" class="btn btn--primary" style="font-size: 0.9rem;">Find your nearest clinic</a>
        <a href="/guides" class="btn btn--outline" style="font-size: 0.9rem;">Browse health guides</a>
      </div>
    </section>

    <section style="margin-top: 32px; max-width: 720px;">
      <h2 style="font-size: 1.15rem; margin-bottom: 12px; color: var(--primary-dark);">How free healthcare works in South Africa</h2>
      <div style="font-size: 0.9rem; line-height: 1.7; display: grid; gap: 12px;">
        <p>
          South Africa's Constitution (Section 27) guarantees the right to access healthcare services. At the primary clinic level, all services listed above are free — no medical aid, no means test, no documentation requirement for emergency care. This covers consultations, medication from the Essential Drugs List (EDL), laboratory tests, and procedures that can be performed at the clinic.
        </p>
        <p>
          The <strong>Essential Drugs List</strong> determines which medications are available for free at public facilities. It includes over 600 medicines covering chronic conditions (hypertension, diabetes, epilepsy, HIV, depression), acute infections, pain management, and paediatric formulations. If a medicine is on the EDL, your clinic will dispense it at no charge. Medicines not on the list require a specialist motivation and may only be available at hospital level.
        </p>
        <p>
          Hospital-level care (district, regional, and tertiary hospitals) uses a <strong>means-tested fee structure</strong> called the Uniform Patient Fee Schedule (UPFS). Patients earning below the threshold — roughly R100,000 per year for a single person — qualify as H0 (fully subsidised, no fees). Higher earners pay graduated fees. However, emergency treatment, children under 6, pregnant women, and patients with notifiable diseases (TB, cholera, measles) are always exempt from fees.
        </p>
        <p>
          The <strong>National Health Insurance (NHI)</strong> Bill, signed into law in May 2024, aims to create a single-payer universal health coverage fund. Full implementation is phased over years. In the interim, the existing clinic-hospital-referral system described here remains the way South Africans access public healthcare.
        </p>
      </div>
    </section>

    <section style="margin-top: 32px; max-width: 720px; margin-bottom: 32px;">
      <h2 style="font-size: 1.15rem; margin-bottom: 12px; color: var(--primary-dark);">Clinic-level vs hospital-level services</h2>
      <div style="font-size: 0.9rem; line-height: 1.7; display: grid; gap: 12px;">
        <p>
          Not every service is available at every facility type. Clinics handle roughly 80% of health needs: chronic medication, immunisations, HIV/TB care, family planning, antenatal visits, and minor injuries. Services requiring surgery, X-ray, laboratory work, or overnight admission need a hospital — and usually a referral letter from your clinic.
        </p>
        <p>
          <strong>What clinics can do that hospitals often cannot:</strong> same-day walk-in for primary complaints (no appointment), faster chronic medication refills, CCMDD enrolment for external medication collection, and community-based follow-up by community health workers.
        </p>
        <p>
          <strong>What hospitals offer that clinics cannot:</strong> surgery under anaesthesia, emergency resuscitation, X-ray and ultrasound, on-site laboratory results, blood transfusion, overnight observation, specialist assessment (orthopaedics, ENT, ophthalmology, psychiatry), and intensive care.
        </p>
      </div>
    </section>
  </div>
</Base>
