---
import Base from '../../layouts/Base.astro';
import { facilities, PROVINCES, SERVICE_MAP, SERVICE_SLUGS, provinceSlug, typeLabel } from '../../data/helpers';
import { SERVICE_EDITORIAL } from '../../data/service-editorial';

export function getStaticPaths() {
  return Object.entries(SERVICE_MAP).map(([key, svc]) => ({
    params: { service: svc.slug },
    props: { serviceKey: key, serviceName: svc.plain, serviceLabel: svc.label },
  }));
}

const { serviceKey, serviceName, serviceLabel } = Astro.props;

// Services whose per-facility flag is DERIVED from national policy rather than
// verified clinic by clinic. Every such page must say so on the page itself — the
// listing otherwise reads as a per-facility confirmation we have not done.
// See TODO #1001: before this, arv_treatment was true for 2 of 1,076 facilities and
// tb_treatment for 9, so the page contradicted its own editorial (and national policy)
// by implying ARVs were available at two clinics nationally — an under-listing that is
// more dangerous than an over-listing on a service people travel to reach.
const DERIVED_SERVICES: Record<string, string> = {
  arv_treatment:
    'South Africa’s National Strategic Plan on HIV provides ARVs free at all public health facilities, to everyone living with HIV, regardless of CD4 count, nationality or documentation status.',
  tb_treatment:
    'TB diagnosis and treatment are provided free at all public health facilities in South Africa under the National TB Programme, regardless of nationality or documentation status.',
};
const editorial = SERVICE_EDITORIAL[serviceKey];
const serviceFacilities = facilities
  .filter(f => f.services[serviceKey] && f.province !== '')
  .sort((a, b) => a.province.localeCompare(b.province) || a.name.localeCompare(b.name));

const byProvince = PROVINCES.map(p => ({
  name: p,
  slug: provinceSlug(p),
  facilities: serviceFacilities.filter(f => f.province === p),
})).filter(p => p.facilities.length > 0);

const topProvinces = byProvince.slice(0, 3);

const serviceGuideMap: Record<string, { href: string; title: string }> = {
  arv_treatment: { href: '/guides/how-to-get-arvs', title: 'How to Get ARVs' },
  tb_treatment: { href: '/guides/tb-treatment-what-to-expect', title: 'TB Treatment — What to Expect' },
  maternity_antenatal: { href: '/guides/free-maternity-care', title: 'Free Maternity Care' },
  chronic_medication: { href: '/guides/chronic-medication-management', title: 'Chronic Medication Management' },
  emergency_24h: { href: '/guides/medical-emergency-guide', title: 'Medical Emergency Guide' },
  dental: { href: '/guides/dental-care-public-clinics', title: 'Dental Care at Public Clinics' },
  mental_health: { href: '/guides/mental-health-services', title: 'Mental Health Services' },
  family_planning: { href: '/guides/family-planning-contraception', title: 'Family Planning & Contraception' },
  immunisation: { href: '/guides/child-immunisation-schedule', title: 'Child Immunisation Schedule' },
  hiv_testing: { href: '/guides/hiv-testing-guide', title: 'HIV Testing Guide' },
  child_health: { href: '/guides/child-immunisation-schedule', title: 'Child Immunisation Schedule' },
};
const primaryGuide = serviceGuideMap[serviceKey];
const otherGuides = Object.entries(serviceGuideMap)
  .filter(([k]) => k !== serviceKey)
  .map(([, g]) => g)
  .filter((g, i, arr) => arr.findIndex(x => x.href === g.href) === i);
const extraServiceGuides = [
  { href: '/guides/ccmdd-chronic-meds-pickup', title: 'CCMDD Chronic Meds Pickup' },
  { href: '/guides/hospital-referral-system', title: 'Hospital Referral System' },
  { href: '/guides/find-nearest-clinic', title: 'How to Use Public Clinics' },
];
const relatedServiceGuides: { href: string; title: string }[] = [];
if (primaryGuide) relatedServiceGuides.push(primaryGuide);
for (const g of [...otherGuides, ...extraServiceGuides]) {
  if (relatedServiceGuides.length >= 4) break;
  if (!relatedServiceGuides.some(x => x.href === g.href)) relatedServiceGuides.push(g);
}

const genericFaqs = [
  {
    q: `Where can I get ${serviceName.toLowerCase()} in South Africa?`,
    a: `${serviceFacilities.length} public clinics and hospitals across South Africa offer ${serviceName.toLowerCase()}. ${topProvinces.length > 0 ? `The provinces with the most facilities are ${topProvinces.map(p => `${p.name} (${p.facilities.length})`).join(', ')}.` : ''} All services at government facilities are free for South African citizens and permanent residents.`,
  },
  {
    q: `Is ${serviceName.toLowerCase()} free at public clinics?`,
    a: `Yes. ${serviceName} is provided free of charge at all public health facilities in South Africa. You do not need medical aid or insurance. Bring your South African ID or passport and your clinic card if you have one.`,
  },
  {
    q: `Do I need a referral for ${serviceName.toLowerCase()}?`,
    // editorial.eligibility carries inline <a href> markup (it is rendered with set:html
    // further down). An FAQ answer is plain text in both the <details> block and the
    // schema.org JSON-LD, so strip the tags here — same treatment as whatToExpect above.
    a: editorial?.eligibility
      ? `Eligibility: ${editorial.eligibility.replace(/<[^>]+>/g, '')} In most cases, you can walk in to any public clinic that offers this service. District hospitals may require a referral from a primary clinic unless it is an emergency.`
      : `In most cases, you can walk in to any public clinic that offers ${serviceName.toLowerCase()}. District hospitals may require a referral from a primary health clinic unless it is an emergency.`,
  },
];

const serviceFaqs = [...genericFaqs, ...(editorial?.faqs ?? [])];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": serviceFaqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://clinicfinder.co.za/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://clinicfinder.co.za/services' },
    { '@type': 'ListItem', position: 3, name: serviceName },
  ],
};

const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `How to Get ${serviceName} at a Public Clinic`,
  description: `Step-by-step guide to accessing ${serviceName.toLowerCase()} at government health facilities in South Africa.`,
  step: editorial?.whatToExpect
    ? editorial.whatToExpect.map(s => ({ '@type': 'HowToStep', name: s.step, text: s.detail.replace(/<[^>]+>/g, '') }))
    : [
        { '@type': 'HowToStep', name: 'Find a facility', text: `Use the clinic finder to locate one of ${serviceFacilities.length} public facilities offering ${serviceName.toLowerCase()}.` },
        { '@type': 'HowToStep', name: 'Walk in with your ID', text: 'Bring your South African ID or passport and any existing clinic card. No appointment is needed at primary clinics.' },
        { '@type': 'HowToStep', name: 'See the healthcare worker', text: `Tell the nurse or doctor what you need. They will assess you and provide ${serviceName.toLowerCase()} or refer you to the appropriate facility.` },
        { '@type': 'HowToStep', name: 'Collect your medication', text: 'If prescribed, collect medication from the facility pharmacy. All medication on the Essential Drugs List is free.' },
      ],
};

const jsonLd = editorial ? [
  breadcrumbLd,
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: `${serviceName} at Public Clinics in South Africa`,
    description: `Find ${serviceFacilities.length} public clinics and hospitals offering ${serviceName.toLowerCase()} across South Africa.`,
    url: `https://clinicfinder.co.za/services/${SERVICE_MAP[serviceKey].slug}`,
    publisher: { '@type': 'Organization', name: 'Clinic Finder SA' },
    author: { '@type': 'Organization', name: 'Clinic Finder SA' },
    datePublished: '2026-04-16',
    dateModified: '2026-06-04',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    about: { '@type': 'MedicalCondition', name: serviceLabel },
    lastReviewed: '2026-04-16',
  },
  howToLd,
  faqJsonLd,
] : [breadcrumbLd, howToLd, faqJsonLd];
---
<Base
  title={editorial?.title || `${serviceName} — Public Clinics in South Africa`}
  description={editorial?.metaDescription || `Find ${serviceFacilities.length} public clinics and hospitals offering ${serviceName.toLowerCase()} across South Africa. Browse by province.`}
  jsonLd={jsonLd}
>
  <div class="container" style="padding: 32px 0;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
      <a href="/">Home</a> &rsaquo; <a href="/services">Services</a> &rsaquo; {serviceName}
    </nav>
    <h1 style="font-size: 1.5rem; margin-bottom: 8px;">{serviceName}</h1>
    <p style="color: var(--text-muted); margin-bottom: 24px;">{serviceFacilities.length} public facilities across South Africa</p>

    {editorial && (
      <section style="margin-bottom: 32px; max-width: 720px;">
        <p style="line-height: 1.7; font-size: 0.95rem; color: var(--text);" set:html={editorial.intro} />
        {editorial.keyFact && (
          <div style="margin-top: 16px; border-left: 4px solid var(--primary); padding: 12px 16px; background: var(--primary-light); border-radius: 0 var(--radius) var(--radius) 0;">
            <strong style="font-size: 0.85rem; color: var(--primary-dark);">Key fact:</strong>
            <span style="font-size: 0.9rem; margin-left: 4px;">{editorial.keyFact}</span>
          </div>
        )}
      </section>
    )}

    {editorial && (
      <section style="margin-bottom: 32px; max-width: 720px;">
        <h2 style="font-size: 1.2rem; margin-bottom: 16px; color: var(--primary-dark);">What to expect</h2>
        <div style="display: grid; gap: 12px;">
          {editorial.whatToExpect.map((step, i) => (
            <div style="display: flex; gap: 16px; align-items: flex-start;">
              <div style="flex-shrink: 0; width: 36px; height: 36px; background: var(--primary-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; color: var(--primary-dark); font-size: 0.9rem;">{i + 1}</div>
              <div>
                <strong style="font-size: 0.95rem;">{step.step}</strong>
                <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 2px; line-height: 1.6;" set:html={step.detail} />
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {editorial && (
      <section style="background: var(--bg-alt); border-radius: var(--radius); padding: 20px; margin-bottom: 32px; max-width: 720px;">
        <h2 style="font-size: 1.1rem; margin-bottom: 8px; color: var(--primary-dark);">Who is eligible?</h2>
        <p style="font-size: 0.9rem; line-height: 1.7;" set:html={editorial.eligibility} />
      </section>
    )}

    {editorial?.whatToBring && editorial.whatToBring.length > 0 && (
      <section style="margin-bottom: 32px; max-width: 720px;">
        <h2 style="font-size: 1.2rem; margin-bottom: 16px; color: var(--primary-dark);">What to bring</h2>
        <div style="display: grid; gap: 8px;">
          {editorial.whatToBring.map(item => (
            <div style="display: flex; gap: 12px; align-items: flex-start; padding: 10px 14px; border: 1px solid var(--border); border-radius: var(--radius);">
              <span style="flex-shrink: 0; color: var(--primary-dark); font-size: 1rem; line-height: 1.4;">&#9745;</span>
              <span style="font-size: 0.9rem; line-height: 1.6;">{item}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {editorial?.patientTips && editorial.patientTips.length > 0 && (
      <section style="margin-bottom: 32px; max-width: 720px;">
        <h2 style="font-size: 1.2rem; margin-bottom: 16px; color: var(--primary-dark);">Tips for patients</h2>
        <div style="display: grid; gap: 10px;">
          {editorial.patientTips.map(tip => (
            <div style="display: flex; gap: 12px; align-items: flex-start; background: var(--bg-alt); border-radius: var(--radius); padding: 14px 16px;">
              <span style="flex-shrink: 0; color: var(--primary-dark); font-size: 1.1rem; line-height: 1;">&#10003;</span>
              <p style="font-size: 0.9rem; line-height: 1.6; margin: 0;" set:html={tip} />
            </div>
          ))}
        </div>
      </section>
    )}

    {editorial?.realityCheck && (
      <section style="margin-bottom: 32px; max-width: 720px; border-left: 4px solid var(--border); padding: 16px 20px;">
        <h2 style="font-size: 1.1rem; margin-bottom: 8px;">Quality of care — what to expect in practice</h2>
        <p style="font-size: 0.9rem; line-height: 1.7; color: var(--text-muted);">{editorial.realityCheck}</p>
      </section>
    )}

    {editorial?.deepDive && editorial.deepDive.length > 0 && (
      <section style="margin-bottom: 32px; max-width: 720px;">
        {editorial.deepDive.map(section => (
          <div style="margin-bottom: 28px;">
            <h2 style="font-size: 1.15rem; margin-bottom: 12px; color: var(--primary-dark);">{section.heading}</h2>
            <p style="font-size: 0.9rem; line-height: 1.7; color: var(--text);" set:html={section.body} />
          </div>
        ))}
      </section>
    )}

    {editorial?.provincialNotes && (
      <section style="margin-bottom: 32px; max-width: 720px; background: var(--bg-alt); border-radius: var(--radius); padding: 20px;">
        <h2 style="font-size: 1.15rem; margin-bottom: 12px; color: var(--primary-dark);">Provincial differences</h2>
        <p style="font-size: 0.9rem; line-height: 1.7;" set:html={editorial.provincialNotes} />
      </section>
    )}

    {editorial?.myths && editorial.myths.length > 0 && (
      <section style="margin-bottom: 32px; max-width: 720px;">
        <h2 style="font-size: 1.15rem; margin-bottom: 16px; color: var(--primary-dark);">Common misconceptions</h2>
        <div style="display: grid; gap: 16px;">
          {editorial.myths.map(m => (
            <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
              <div style="display: flex; gap: 8px; align-items: flex-start; margin-bottom: 8px;">
                <span style="flex-shrink: 0; color: #dc3545; font-weight: 700; font-size: 0.85rem;">MYTH:</span>
                <p style="font-size: 0.9rem; font-style: italic; margin: 0; line-height: 1.5;">{m.myth}</p>
              </div>
              <div style="display: flex; gap: 8px; align-items: flex-start;">
                <span style="flex-shrink: 0; color: var(--primary-dark); font-weight: 700; font-size: 0.85rem;">FACT:</span>
                <p style="font-size: 0.9rem; margin: 0; line-height: 1.6; color: var(--text-muted);">{m.fact}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {editorial?.helplines && editorial.helplines.length > 0 && (
      <section style="margin-bottom: 32px; max-width: 720px; background: var(--primary-light); border-radius: var(--radius); padding: 20px;">
        <h2 style="font-size: 1.15rem; margin-bottom: 12px; color: var(--primary-dark);">Helplines and support</h2>
        <div style="display: grid; gap: 10px;">
          {editorial.helplines.map(h => (
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; background: rgba(255,255,255,0.6); border-radius: var(--radius);">
              <div>
                <strong style="font-size: 0.9rem;">{h.name}</strong>
                <div style="font-size: 0.8rem; color: var(--text-muted);">{h.hours}</div>
              </div>
              <a href={`tel:${h.number.replace(/\s/g, '')}`} style="font-size: 0.95rem; font-weight: 700; color: var(--primary-dark); text-decoration: none; white-space: nowrap;">{h.number}</a>
            </div>
          ))}
        </div>
      </section>
    )}

    {editorial?.guideSlug && (
      <section style="background: var(--primary-light); border-radius: var(--radius); padding: 20px; margin-bottom: 32px; max-width: 720px;">
        <h2 style="font-size: 1.1rem; margin-bottom: 8px; color: var(--primary-dark);">Read the full guide</h2>
        <p style="font-size: 0.9rem; margin-bottom: 12px;">
          Our guide covers everything in detail: step-by-step process, FAQs, and practical tips.
        </p>
        <a href={`/guides/${editorial.guideSlug}`} class="btn btn--primary" style="font-size: 0.9rem;">
          {editorial.guideName} &rarr;
        </a>
      </section>
    )}

    <section style="margin-bottom: 32px; max-width: 720px;">
      <h2 style="font-size: 1.15rem; margin-bottom: 16px;">Frequently Asked Questions</h2>
      {serviceFaqs.map(f => (
        <details style="border-bottom: 1px solid var(--border); padding: 12px 0;">
          <summary style="cursor: pointer; font-weight: 600; font-size: 0.95rem;">{f.q}</summary>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 8px; line-height: 1.6;">{f.a}</p>
        </details>
      ))}
    </section>

    {relatedServiceGuides.length > 0 && (
      <section style="margin-bottom: 32px; max-width: 720px;">
        <h2 style="font-size: 1.15rem; margin-bottom: 12px;">Related Health Guides</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.75rem;">
          {relatedServiceGuides.map(g => (
            <a href={g.href} style="display: block; padding: 0.75rem 1rem; background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); text-decoration: none; font-size: 0.9rem; font-weight: 500;">{g.title}</a>
          ))}
        </div>
      </section>
    )}

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.15rem; margin-bottom: 12px;">Other Health Services</h2>
      <div style="display: flex; flex-wrap: wrap; gap: 8px;">
        {Object.entries(SERVICE_MAP).filter(([k]) => k !== serviceKey).map(([k, svc]) => (
          <a href={`/services/${svc.slug}`} style="display: inline-block; padding: 6px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 0.85rem; color: var(--text); text-decoration: none; transition: border-color 0.15s;">
            {svc.plain}
          </a>
        ))}
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.15rem; margin-bottom: 12px;">Browse by Province</h2>
      <div style="display: flex; flex-wrap: wrap; gap: 8px;">
        {PROVINCES.map(p => (
          <a href={`/clinics/${provinceSlug(p)}`} style="display: inline-block; padding: 6px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 0.85rem; color: var(--text); text-decoration: none; transition: border-color 0.15s;">
            {p}
          </a>
        ))}
      </div>
    </section>

    <h2 style="font-size: 1.2rem; margin-bottom: 16px;">{serviceFacilities.length} facilities offering {serviceName.toLowerCase()}</h2>

    {DERIVED_SERVICES[serviceKey] && (
      <section style="border-left: 4px solid var(--primary-dark); background: var(--bg-alt); border-radius: var(--radius); padding: 16px 20px; margin-bottom: 24px; max-width: 720px;">
        <h3 style="font-size: 0.95rem; margin: 0 0 8px;">How this list was compiled</h3>
        <p style="font-size: 0.9rem; line-height: 1.7; margin: 0; color: var(--text-muted);">
          {DERIVED_SERVICES[serviceKey]} These facilities are listed because they are confirmed
          public health facilities, <strong>not</strong> because each one was individually checked
          for this service. Stock and staffing vary by clinic and by day &mdash;
          <strong>phone ahead before travelling</strong>, especially for a first visit.
          Facility records come from OpenStreetMap; if something here is wrong, please
          <a href="/contact"> tell us</a> and we will correct it.
        </p>
      </section>
    )}

    {byProvince.map(prov => (
      <section style="margin-bottom: 32px;">
        <h3 style="font-size: 1.1rem; margin-bottom: 12px;">
          <a href={`/clinics/${prov.slug}`}>{prov.name}</a>
          <span style="font-weight: normal; color: var(--text-muted); font-size: 0.9rem;"> ({prov.facilities.length})</span>
        </h3>
        <div style="display: grid; gap: 8px;">
          {prov.facilities.map(f => {
            const addr = [f.address.street, f.address.suburb, f.address.city].filter(Boolean).join(', ');
            // Deliberately ONE line and free of wrapper elements (#1248): this markup
            // is serialised once per facility, 1,044 times on /services/immunisation,
            // so every tag and every newline between tags is multiplied by that.
            // .svc-card in Base.astro is the grid that used to be .svc-card-row; the
            // chip is placed by CSS, not by a wrapper div, and its inline style now
            // lives in that class too.
            return (
              <a href={f.url_path} class="svc-card"><strong>{f.name}</strong>{addr && <span class="svc-card-addr">{addr}</span>}<span class="svc-card-meta">{typeLabel(f.type)}{f.district && ` · ${f.district}`}</span>{f.operating_hours.is_24_hour && <span class="chip">24h</span>}</a>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</Base>
