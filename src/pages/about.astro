---
import Base from '../layouts/Base.astro';
---

<Base title="About — Clinic Finder SA" description="Learn about Clinic Finder SA — a free directory helping South Africans find their nearest public health facility." jsonLd={[{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://clinicfinder.co.za/' }, { '@type': 'ListItem', position: 2, name: 'About' }] }]}>
  <div class="container" style="padding: 2rem 0 3rem;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem;">
      <a href="/" style="color: var(--green-dark);">Home</a> › About
    </nav>

    <h1 style="font-size: 1.8rem; margin-bottom: 1.5rem;">About Clinic Finder SA</h1>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--green-dark);">What We Do</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">Clinic Finder SA is a free, mobile-first directory of South Africa's public health facilities. We help people find their nearest clinic, hospital, or community health centre — with directions, operating hours, and available services — so they can access the care they need without phone calls or guesswork.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--green-dark);">Why We Built This</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">South Africa has over 3,500 public health facilities, but finding the right one isn't always easy. Information is scattered across provincial departments, often outdated, and rarely searchable. Many people — especially in rural areas or informal settlements — don't know which facilities are closest or what services they offer. This tool puts that information in one place, accessible on any phone.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--green-dark);">Our Data</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">Facility data comes from OpenStreetMap and the Humanitarian OpenStreetMap Team (HOTOSM), supplemented with information from the National Department of Health's facility registry. We present facility names, addresses, types, services offered, and geographic coordinates. Data is updated regularly but may not reflect recent closures or service changes.</p>
      <p style="line-height: 1.7; color: var(--text-muted); margin-top: 0.75rem;">This is not an official government site. For the most current facility information, contact your provincial Department of Health or call the National Health Hotline at <strong>0800 029 999</strong>.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--green-dark);">Contact</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">Found incorrect information? Want to suggest a missing facility? Email us at <a href="mailto:hello@clinicfinder.co.za" style="color: var(--green-dark);">hello@clinicfinder.co.za</a> or visit our <a href="/contact" style="color: var(--green-dark);">contact page</a>.</p>
    </section>
  </div>
</Base>
