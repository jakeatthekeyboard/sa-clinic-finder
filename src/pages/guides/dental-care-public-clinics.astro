---
import Base from '../../layouts/Base.astro';
import { facilities } from '../../data/helpers';
import GuideBreadcrumb from '../../components/GuideBreadcrumb.astro';

const dentalClinics = facilities.filter(f => f.services.dental);

const faqs = [
  {
    question: 'Is dental care free at public clinics?',
    answer: 'Yes, but with limitations. Emergency dental treatment (extractions, abscess drainage, severe pain) is free at all public dental clinics and hospital dental departments. Preventive and restorative care (fillings, cleaning, dentures) is also free where available, but the waiting list can be months long. Complex procedures (root canals, crowns, bridges, implants) are generally not available in the public system — you would need private dental care for these.',
  },
  {
    question: 'Do I need an appointment for dental?',
    answer: 'For emergency dental pain: most clinics and hospitals accept walk-ins, but you may need to arrive very early (before 07:00) as dental slots fill quickly. For routine dental care: yes, you usually need an appointment. Ask the clinic receptionist to put you on the dental waiting list. Waiting times vary from weeks to months depending on the facility and province.',
  },
  {
    question: 'Can children get dental care at public clinics?',
    answer: 'Yes. Children are a priority for public dental services. School dental screenings happen through the Integrated School Health Programme (ISHP), but coverage is patchy. Any child can access emergency dental treatment at a public clinic. For preventive care (fissure sealants, fluoride application, fillings), take your child to the clinic dental department — children are usually seen faster than adults.',
  },
  {
    question: 'What about dentures?',
    answer: 'Full and partial dentures are available at some public dental facilities, but waiting times are long — often 6-18 months. The process: (1) dental assessment and extractions if needed, (2) healing period (usually 3-6 months after extractions), (3) impressions and denture fabrication, (4) fitting and adjustments. Priority is given to patients who cannot eat properly. Not all facilities have denture services — ask at a community health centre or hospital dental department.',
  },
];

const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to access dental care at a South African public clinic',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Find a facility with dental services',
      text: 'Not every primary clinic has a dental chair. Look for a community health centre (CHC), district hospital dental department, or dental training hospital (attached to Wits, Pretoria, UWC, UKZN, Sefako Makgatho, or Limpopo universities). Use Clinic Finder to search for facilities offering dental care in your area.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Arrive early with your ID and clinic card',
      text: 'For emergency dental pain (severe toothache, abscess, broken tooth), go to the facility as a walk-in before 07:00 — dental slots fill fast and most clinics operate 07:30-16:00. Bring your South African ID document and clinic card (green card). For non-emergency care, phone the facility first to get on the dental waiting list.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Get assessed by the dental therapist or dentist',
      text: 'A dental therapist, oral hygienist, or dentist will examine your teeth, take X-rays if needed, and determine what treatment is required. Emergency patients (pain, swelling, infection) are prioritised. For routine care such as fillings or cleaning, you may be booked for a follow-up appointment.',
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Receive treatment — extractions, fillings, or denture referral',
      text: 'Emergency extractions and abscess drainage are usually done on the same day. Basic fillings and scaling (teeth cleaning) may be done immediately or at a scheduled appointment. For dentures, the process takes several visits over 6-18 months: assessment, extractions, healing period, impressions, fabrication, and fitting. All treatment at public facilities is free.',
    },
    {
      '@type': 'HowToStep',
      position: 5,
      name: 'Follow up and maintain preventive care',
      text: 'After treatment, follow the aftercare instructions (no rinsing for 24 hours after extraction, complete any antibiotics course). For ongoing dental health, brush twice daily with fluoride toothpaste, limit sugar between meals, and return for annual check-ups. Children should be taken for preventive care (fissure sealants, fluoride application) — they are usually seen faster than adults at public dental clinics.',
    },
  ],
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Getting Dental Care at a Public Clinic in South Africa',
    description: 'What dental services are available at South African public clinics: emergency extractions, fillings, dentures, and how to access them.',
    url: 'https://clinicfinder.co.za/guides/dental-care-public-clinics',
    publisher: { '@type': 'Organization', name: 'Clinic Finder SA' },
    datePublished: '2026-04-16',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(faq => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
  howToLd,
];
---
<Base
  title="Dental Care at Public Clinics — Clinic Finder SA"
  description="What dental services are available at South African public clinics: emergency extractions, fillings, dentures, children's dental care, and how to access them."
  jsonLd={jsonLd}
>
  <GuideBreadcrumb title="Dental Care at Public Clinics — Clinic Finder SA" />
  <div class="container" style="padding: 32px 0; max-width: 720px;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
      <a href="/">Home</a> &rsaquo; <a href="/guides">Guides</a> &rsaquo; Dental Care
    </nav>

    <h1 style="font-size: 1.5rem; margin-bottom: 8px;">Dental Care at Public Clinics</h1>
    <p style="color: var(--text-muted); margin-bottom: 32px; line-height: 1.7;">
      South Africa has a severe shortage of public dental services — only about 1 dentist per 10,000 people in the public sector, compared to 1 per 2,000 in the private sector. But free dental care does exist. This guide covers what is available, how to access it, and what to expect.
    </p>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--green-dark);">What dental services are available?</h2>
      <div style="display: grid; gap: 12px;">
        <div style="border-left: 4px solid var(--green); padding: 12px 16px; background: var(--green-light); border-radius: 0 var(--radius) var(--radius) 0;">
          <strong style="color: var(--green-dark);">Available at most dental clinics</strong>
          <ol style="padding-left: 16px; font-size: 0.9rem; margin-top: 4px; line-height: 1.6; display: grid; gap: 2px;">
            <li>Tooth extractions (pulling teeth)</li>
            <li>Abscess drainage</li>
            <li>Emergency pain relief</li>
            <li>Basic fillings (amalgam or composite)</li>
            <li>Scaling and polishing (teeth cleaning)</li>
            <li>Oral health education</li>
          </ol>
        </div>
        <div style="border-left: 4px solid #fd7e14; padding: 12px 16px; background: #fff8f0; border-radius: 0 var(--radius) var(--radius) 0;">
          <strong style="color: #e65100;">Available at some facilities (longer wait)</strong>
          <ol style="padding-left: 16px; font-size: 0.9rem; margin-top: 4px; line-height: 1.6; display: grid; gap: 2px;">
            <li>Full and partial dentures</li>
            <li>Children's fissure sealants</li>
            <li>Fluoride application</li>
            <li>Basic orthodontics (severe cases only)</li>
          </ol>
        </div>
        <div style="border-left: 4px solid #dc3545; padding: 12px 16px; background: #fff5f5; border-radius: 0 var(--radius) var(--radius) 0;">
          <strong style="color: #dc3545;">Generally NOT available in public sector</strong>
          <ol style="padding-left: 16px; font-size: 0.9rem; margin-top: 4px; line-height: 1.6; display: grid; gap: 2px;">
            <li>Root canal treatment</li>
            <li>Crowns, bridges, veneers</li>
            <li>Dental implants</li>
            <li>Cosmetic dentistry</li>
            <li>Teeth whitening</li>
          </ol>
        </div>
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--green-dark);">Where to go</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Not every primary clinic has dental services. Dental care is concentrated at:
      </p>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 8px; margin-top: 8px;">
        <li><strong>Community health centres (CHCs)</strong> — larger facilities that usually have a dental chair and dental therapist. This is your best first stop for routine dental needs.</li>
        <li><strong>District and regional hospitals</strong> — hospital dental departments handle more complex cases, dentures, and referrals from CHCs. May have oral hygienists and dentists on staff.</li>
        <li><strong>Dental training hospitals</strong> — facilities attached to dental schools (Wits, Pretoria, Western Cape, KZN, Sefako Makgatho, Limpopo). These often have shorter waiting times because students need patients. Treatment is supervised by qualified dentists. Free.</li>
        <li><strong>Mobile dental units</strong> — some provinces run mobile dental clinics that visit underserved areas on a rotating schedule. Ask your local clinic if a mobile unit serves your area.</li>
      </ol>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--green-dark);">What to do for dental pain right now</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        If you have severe dental pain and cannot get to a clinic today:
      </p>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 6px; margin-top: 8px;">
        <li><strong>Take ibuprofen (Nurofen) or paracetamol (Panado)</strong> — available at any pharmacy without prescription. Ibuprofen works better for dental pain because it reduces inflammation. Follow dosage instructions on the box.</li>
        <li><strong>Rinse with warm salt water</strong> — half a teaspoon of salt in a glass of warm water. Swish gently around the painful area. Repeat every 2-3 hours.</li>
        <li><strong>Do NOT put aspirin directly on the gum</strong> — this is a common misconception that can cause chemical burns on the tissue.</li>
        <li><strong>Go to the clinic first thing tomorrow morning</strong> — arrive before 07:00. Emergency dental patients are usually seen on a walk-in basis but slots fill fast.</li>
        <li><strong>If the pain is accompanied by swelling, fever, or difficulty breathing/swallowing</strong> — go to a hospital emergency room. A dental abscess can become life-threatening if the infection spreads.</li>
      </ol>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--green-dark);">Dental training hospitals — shorter waits, free care</h2>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-bottom: 12px;">
        South Africa has six dental schools attached to universities. Their training clinics treat public patients free of charge while final-year students learn under direct supervision. Because students need clinical hours, waiting times are often shorter than at government hospitals — especially for fillings, dentures, and orthodontics.
      </p>
      <div style="overflow-x: auto;">
        <table style="width: 100%; font-size: 0.88rem; border-collapse: collapse; line-height: 1.6;">
          <thead>
            <tr style="background: var(--bg-alt); text-align: left;">
              <th style="padding: 10px 12px; border-bottom: 2px solid var(--border);">University</th>
              <th style="padding: 10px 12px; border-bottom: 2px solid var(--border);">Location</th>
              <th style="padding: 10px 12px; border-bottom: 2px solid var(--border);">Dental hospital</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 10px 12px;">University of the Witwatersrand</td><td style="padding: 10px 12px;">Johannesburg, Gauteng</td><td style="padding: 10px 12px;">Wits Oral Health Centre (Charlotte Maxeke campus)</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 10px 12px;">University of Pretoria</td><td style="padding: 10px 12px;">Pretoria, Gauteng</td><td style="padding: 10px 12px;">Oral and Dental Hospital, Bophelo Road</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 10px 12px;">University of the Western Cape</td><td style="padding: 10px 12px;">Cape Town, Western Cape</td><td style="padding: 10px 12px;">Tygerberg Oral Health Centre</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 10px 12px;">University of KwaZulu-Natal</td><td style="padding: 10px 12px;">Durban, KwaZulu-Natal</td><td style="padding: 10px 12px;">King Edward VIII Hospital dental department</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 10px 12px;">Sefako Makgatho Health Sciences University</td><td style="padding: 10px 12px;">Pretoria, Gauteng</td><td style="padding: 10px 12px;">Medunsa Oral Health Centre</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 10px 12px;">University of Limpopo</td><td style="padding: 10px 12px;">Mankweng, Limpopo</td><td style="padding: 10px 12px;">Mankweng Hospital dental unit</td></tr>
          </tbody>
        </table>
      </div>
      <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 8px; line-height: 1.6;">Walk in or phone the dental school reception to book. Bring your ID and clinic card. Treatments take longer than at a private dentist (students work carefully under supervision) but the standard of care is high — and it is free.</p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--green-dark);">Preventing dental problems</h2>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-bottom: 12px;">
        Public dental services are stretched thin. Prevention saves you from joining long waiting lists — and from pain that could have been avoided.
      </p>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 6px;">
        <li><strong>Brush twice a day with fluoride toothpaste.</strong> The cheapest toothpaste at Shoprite or PnP contains fluoride — you do not need an expensive brand. Replace your toothbrush every 3 months or when the bristles splay.</li>
        <li><strong>Cut down sugar, especially between meals.</strong> It is not how much sugar you eat — it is how often. Sipping sugary drinks (cold drink, juice, sweetened tea) throughout the day bathes your teeth in acid constantly. Drink water between meals.</li>
        <li><strong>Do not use your teeth as tools.</strong> Opening bottles, tearing packets, and cracking nuts with your teeth causes fractures that lead to extractions.</li>
        <li><strong>If you grind your teeth at night,</strong> tell the clinic — this is common with stress and eventually cracks teeth. A simple mouthguard (not available at most public clinics, but affordable at R200-R500 from a private dentist) prevents expensive damage.</li>
        <li><strong>Children under 6:</strong> use a pea-sized amount of toothpaste and supervise brushing. Baby teeth matter — early loss from decay causes permanent teeth to come through crooked, leading to much bigger problems later.</li>
      </ol>
    </section>

    <section style="background: var(--green-light); border-radius: var(--radius); padding: 20px; margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 8px; color: var(--green-dark);">Find a clinic with dental services</h2>
      <p style="font-size: 0.9rem; margin-bottom: 12px;">
        {dentalClinics.length} facilities in our database offer dental care.
      </p>
      <a href="/services/dental" class="btn btn--primary" style="font-size: 0.9rem;">Browse dental clinics</a>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px;">Frequently Asked Questions</h2>
      <div style="display: grid; gap: 12px;">
        {faqs.map(faq => (
          <details style="border: 1px solid var(--border); border-radius: var(--radius);">
            <summary style="cursor: pointer; font-weight: 600; font-size: 0.95rem; padding: 14px; list-style: none; display: flex; justify-content: space-between; align-items: center;">
              {faq.question}
              <span style="color: var(--text-muted); flex-shrink: 0; margin-left: 12px;">+</span>
            </summary>
            <div style="padding: 0 14px 14px; font-size: 0.9rem; color: var(--text-muted); line-height: 1.7;">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <section style="border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; font-size: 0.85rem; color: var(--text-muted); line-height: 1.6;">
      <strong style="color: var(--text);">Sources:</strong> National Oral Health Strategy (NDoH, 2023). South African Dental Association workforce report. HPCSA dental practitioner statistics. Integrated School Health Programme — oral health component. Essential Drugs List — dental formulary.
    </section>
      <section style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border);">
      <h2 style="font-size:1.2rem;margin-bottom:1rem;">Related Guides</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:0.75rem;">
      <a href="/guides/hospital-referral-system" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Hospital Referral System</a>
      <a href="/guides/child-immunisation-schedule" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Child Immunisation Schedule</a>
      <a href="/guides/chronic-medication-management" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Chronic Medication Management</a>
      <a href="/guides/medical-emergency-guide" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Medical Emergency Guide</a>
      </div>
    </section>
  </div>
</Base>
