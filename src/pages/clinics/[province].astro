---
import Base from '../../layouts/Base.astro';
import { facilities, PROVINCES, SERVICE_MAP, provinceSlug, typeLabel } from '../../data/helpers';
import { PROVINCE_EDITORIAL } from '../../data/province-editorial';

export function getStaticPaths() {
  return PROVINCES.map(p => ({
    params: { province: provinceSlug(p) },
    props: { provinceName: p },
  }));
}

const { provinceName } = Astro.props;
const provFacilities = facilities
  .filter(f => f.province === provinceName)
  .sort((a, b) => a.name.localeCompare(b.name));

const typeBreakdown = provFacilities.reduce((acc, f) => {
  acc[f.type] = (acc[f.type] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const serviceBreakdown = Object.keys(SERVICE_MAP).map(key => ({
  key,
  label: SERVICE_MAP[key].plain,
  count: provFacilities.filter(f => f.services[key]).length,
})).filter(s => s.count > 0).sort((a, b) => b.count - a.count);

const editorial = PROVINCE_EDITORIAL[provinceName];

const twentyFourHour = provFacilities.filter(f => f.operating_hours?.is_24_hour);
const withARVs = provFacilities.filter(f => f.services?.arvs);
const topService = serviceBreakdown[0];

const faqs = [
  {
    q: `How many public clinics are in ${provinceName}?`,
    a: `There are ${provFacilities.length} public health facilities in ${provinceName}. These include ${Object.entries(typeBreakdown).map(([t, c]) => `${c} ${typeLabel(t).toLowerCase()}${c !== 1 ? 's' : ''}`).join(', ')}. ${twentyFourHour.length > 0 ? `${twentyFourHour.length} of these facilities are recorded as open 24 hours.` : 'Operating hours vary by facility.'}`,
  },
  {
    q: `Can I get ARV treatment in ${provinceName}?`,
    a: withARVs.length > 0
      ? `Yes. ${withARVs.length} of ${provFacilities.length} public facilities in ${provinceName} offer ARV services. Treatment is free at government facilities — you do not need a referral to start, just visit any clinic offering ARVs with your ID.`
      : `ARV availability varies. Check individual facility pages for current service listings. All South African public clinics provide ARV referrals even if they don't dispense on-site.`,
  },
  {
    q: `What services do public clinics in ${provinceName} offer?`,
    a: topService
      ? `The most widely available service is ${topService.label.toLowerCase()} (offered at ${topService.count} of ${provFacilities.length} facilities). Other common services include ${serviceBreakdown.slice(1, 4).map(s => `${s.label.toLowerCase()} (${s.count})`).join(', ')}. All services at government facilities are free for South African citizens.`
      : `Services vary by facility. All government clinics provide basic primary healthcare. Check individual facility pages for specific services.`,
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://clinicfinder.co.za/' },
    { '@type': 'ListItem', position: 2, name: 'Provinces', item: 'https://clinicfinder.co.za/clinics' },
    { '@type': 'ListItem', position: 3, name: provinceName },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `How to Access Public Healthcare in ${provinceName}`,
  description: `Step-by-step guide to visiting a public clinic in ${provinceName}, South Africa.`,
  step: [
    { '@type': 'HowToStep', name: 'Find a facility', text: `Use the clinic finder to locate one of the ${provFacilities.length} public facilities in ${provinceName}. Filter by service type if you need something specific like ARVs or maternity care.` },
    { '@type': 'HowToStep', name: 'Check what to bring', text: 'Bring your South African ID or passport, clinic card (if you have one), and any current medication. Arrive early — most clinics operate on a first-come, first-served basis.' },
    { '@type': 'HowToStep', name: 'Visit the clinic', text: 'Walk in to any public clinic — no appointment needed for primary care. Tell the nurse your symptoms and they will assess, treat, or refer you.' },
    { '@type': 'HowToStep', name: 'Follow up if referred', text: 'If the clinic refers you to a hospital, keep your referral letter. District hospitals require a referral from a primary clinic unless it is an emergency.' },
  ],
};
---
<Base
  title={`Public Clinics in ${provinceName} — Clinic Finder SA`}
  description={`Find ${provFacilities.length} public clinics and hospitals in ${provinceName}, South Africa. Filter by ARVs, maternity, TB treatment, emergency services.`}
  jsonLd={[breadcrumbLd, faqJsonLd, howToLd]}
>
  <div class="container" style="padding: 32px 0;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
      <a href="/">Home</a> &rsaquo; <a href="/clinics">Provinces</a> &rsaquo; {provinceName}
    </nav>
    <h1 style="font-size: 1.5rem; margin-bottom: 8px;">Public Clinics in {provinceName}</h1>
    <p style="color: var(--text-muted); margin-bottom: 24px;">{provFacilities.length} government health facilities</p>

    {editorial && (
      <section style="margin-bottom: 32px; line-height: 1.7;">
        <div style="max-width: 720px; color: var(--text); font-size: 0.95rem;">
          <p set:html={editorial.intro} />
        </div>
      </section>
    )}

    <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px;">
      {Object.entries(typeBreakdown).map(([type, count]) => (
        <span class="chip chip--type">{typeLabel(type)} ({count})</span>
      ))}
    </div>

    <details style="margin-bottom: 24px;">
      <summary style="cursor: pointer; font-weight: 600; font-size: 0.95rem;">Services available in {provinceName}</summary>
      <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px;">
        {serviceBreakdown.map(s => (
          <span class="chip">{s.label} ({s.count})</span>
        ))}
      </div>
    </details>

    {editorial && (
      <section style="background: var(--bg-alt); border-radius: var(--radius); padding: 24px; margin-bottom: 32px;">
        <h2 style="font-size: 1.15rem; margin-bottom: 16px; color: var(--primary-dark);">Health tips for {provinceName}</h2>
        <div style="display: grid; gap: 16px;">
          {editorial.healthTips.map(tip => (
            <div>
              <strong style="font-size: 0.95rem;">{tip.title}</strong>
              <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.6;" set:html={tip.text} />
            </div>
          ))}
        </div>
      </section>
    )}

    {editorial && (
      <section style="border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; margin-bottom: 32px;">
        <h2 style="font-size: 1.15rem; margin-bottom: 16px; color: var(--primary-dark);">What to bring to a public clinic</h2>
        <ol style="list-style: none; padding: 0; display: grid; gap: 12px;">
          {editorial.whatToBring.map((item, i) => (
            <li style="display: flex; gap: 12px; font-size: 0.9rem;">
              <span style="flex-shrink: 0; width: 24px; height: 24px; background: var(--primary); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700;">{i + 1}</span>
              <div>
                <strong>{item.item}</strong>
                <p style="color: var(--text-muted); margin-top: 2px; line-height: 1.5;">{item.note}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {editorial?.contacts && (
      <section style="background: var(--bg-alt); border-radius: var(--radius); padding: 24px; margin-bottom: 32px;">
        <h2 style="font-size: 1.15rem; margin-bottom: 16px; color: var(--primary-dark);">Emergency & health department contacts</h2>
        <div style="display: grid; gap: 10px; font-size: 0.9rem;">
          <div style="display: flex; gap: 12px; align-items: flex-start;">
            <strong style="min-width: 140px; color: var(--text-muted); flex-shrink: 0;">Ambulance:</strong>
            <span><a href={`tel:${editorial.contacts.ambulance}`}>{editorial.contacts.ambulance}</a> (national number — works from any phone)</span>
          </div>
          <div style="display: flex; gap: 12px; align-items: flex-start;">
            <strong style="min-width: 140px; color: var(--text-muted); flex-shrink: 0;">Health department:</strong>
            <span>{editorial.contacts.healthDeptName} — <a href={`tel:${editorial.contacts.healthDeptPhone.replace(/\s/g, '')}`}>{editorial.contacts.healthDeptPhone}</a></span>
          </div>
          {editorial.contacts.crisisLine && (
            <div style="display: flex; gap: 12px; align-items: flex-start;">
              <strong style="min-width: 140px; color: var(--text-muted); flex-shrink: 0;">Crisis line:</strong>
              <span>{editorial.contacts.crisisLine}</span>
            </div>
          )}
          {editorial.contacts.complaintsLine && (
            <div style="display: flex; gap: 12px; align-items: flex-start;">
              <strong style="min-width: 140px; color: var(--text-muted); flex-shrink: 0;">Complaints:</strong>
              <span><a href={`tel:${editorial.contacts.complaintsLine.replace(/\s/g, '')}`}>{editorial.contacts.complaintsLine}</a> (patient rights &amp; service complaints)</span>
            </div>
          )}
          <div style="display: flex; gap: 12px; align-items: flex-start;">
            <strong style="min-width: 140px; color: var(--text-muted); flex-shrink: 0;">From any mobile:</strong>
            <span><a href="tel:112">112</a> (emergency) — works without airtime</span>
          </div>
        </div>
      </section>
    )}

    {editorial?.districtHighlights && editorial.districtHighlights.length > 0 && (
      <section style="margin-bottom: 32px;">
        <h2 style="font-size: 1.15rem; margin-bottom: 16px; color: var(--primary-dark);">Health districts in {provinceName}</h2>
        <div style="display: grid; gap: 16px;">
          {editorial.districtHighlights.map(d => (
            <div style="border-left: 3px solid var(--primary); padding-left: 16px;">
              <strong style="font-size: 0.95rem;">{d.name}</strong>
              <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.6;">{d.context}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {editorial?.deepDive && editorial.deepDive.length > 0 && (
      <section style="margin-bottom: 32px; max-width: 720px;">
        {editorial.deepDive.map(section => (
          <div style="margin-bottom: 28px;">
            <h2 style="font-size: 1.15rem; margin-bottom: 12px; color: var(--primary-dark);">{section.heading}</h2>
            <p style="font-size: 0.9rem; line-height: 1.7; color: var(--text);" set:html={section.body} />
          </div>
        ))}
      </section>
    )}

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.15rem; margin-bottom: 12px;">Helpful Guides</h2>
      <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 12px;">Practical information for visiting public clinics in {provinceName}:</p>
      <div style="display: grid; gap: 8px;">
        {[
          { title: 'How to Find Your Nearest Clinic', slug: 'find-nearest-clinic' },
          { title: 'What to Do in a Medical Emergency', slug: 'medical-emergency-guide' },
          { title: 'How Hospital Referrals Work in South Africa', slug: 'hospital-referral-system' },
          { title: 'CCMDD — Collecting Chronic Meds Without the Queue', slug: 'ccmdd-chronic-meds-pickup' },
          { title: 'Child Immunisation Schedule (South Africa)', slug: 'child-immunisation-schedule' },
          { title: 'Family Planning & Contraception', slug: 'family-planning-contraception' },
        ].map(g => (
          <a href={`/guides/${g.slug}`} style="display: block; padding: 10px 14px; border: 1px solid var(--border); border-radius: 6px; font-size: 0.9rem; color: var(--text); text-decoration: none; transition: border-color 0.15s;">
            {g.title}
          </a>
        ))}
      </div>
      <a href="/guides" style="display: inline-block; margin-top: 12px; font-size: 0.85rem; color: var(--primary-dark);">View all guides &rarr;</a>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.15rem; margin-bottom: 16px;">Frequently Asked Questions</h2>
      {faqs.map(f => (
        <details style="border-bottom: 1px solid var(--border); padding: 12px 0;">
          <summary style="cursor: pointer; font-weight: 600; font-size: 0.95rem;">{f.q}</summary>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 8px; line-height: 1.6;">{f.a}</p>
        </details>
      ))}
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.15rem; margin-bottom: 12px;">Health Services in {provinceName}</h2>
      <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 12px;">Find facilities offering specific services in this province:</p>
      <div style="display: flex; flex-wrap: wrap; gap: 8px;">
        {serviceBreakdown.slice(0, 8).map(s => (
          <a href={`/services/${SERVICE_MAP[s.key].slug}`} style="display: inline-block; padding: 6px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 0.85rem; color: var(--text); text-decoration: none; transition: border-color 0.15s;">
            {s.label} <span style="color: var(--text-muted);">({s.count})</span>
          </a>
        ))}
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.15rem; margin-bottom: 12px;">Other Provinces</h2>
      <div style="display: flex; flex-wrap: wrap; gap: 8px;">
        {PROVINCES.filter(p => p !== provinceName).map(p => (
          <a href={`/clinics/${provinceSlug(p)}`} style="display: inline-block; padding: 6px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 0.85rem; color: var(--text); text-decoration: none; transition: border-color 0.15s;">
            {p}
          </a>
        ))}
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.15rem; margin-bottom: 12px;">Health Guides</h2>
      <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 12px;">Practical guides to help you navigate public health services:</p>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.75rem;">
        <a href="/guides/find-nearest-clinic" style="display: block; padding: 0.75rem 1rem; background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); text-decoration: none; font-size: 0.9rem; font-weight: 500;">How to Use Public Clinics</a>
        <a href="/guides/hospital-referral-system" style="display: block; padding: 0.75rem 1rem; background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); text-decoration: none; font-size: 0.9rem; font-weight: 500;">Hospital Referral System</a>
        <a href="/guides/medical-emergency-guide" style="display: block; padding: 0.75rem 1rem; background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); text-decoration: none; font-size: 0.9rem; font-weight: 500;">Medical Emergency Guide</a>
        <a href="/guides/chronic-medication-management" style="display: block; padding: 0.75rem 1rem; background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); text-decoration: none; font-size: 0.9rem; font-weight: 500;">Chronic Medication</a>
        <a href="/guides/ccmdd-chronic-meds-pickup" style="display: block; padding: 0.75rem 1rem; background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); text-decoration: none; font-size: 0.9rem; font-weight: 500;">CCMDD Meds Pickup</a>
        <a href="/guides/hiv-testing-guide" style="display: block; padding: 0.75rem 1rem; background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); text-decoration: none; font-size: 0.9rem; font-weight: 500;">HIV Testing Guide</a>
      </div>
      <p style="margin-top: 0.75rem;"><a href="/guides" style="color: var(--primary-dark); font-weight: 500; font-size: 0.9rem;">All guides &rarr;</a></p>
    </section>

    <h2 style="font-size: 1.15rem; margin-bottom: 16px;">All facilities in {provinceName}</h2>
    <div style="display: grid; gap: 12px;">
      {provFacilities.map(f => (
        <a href={f.url_path} class="card" style="text-decoration: none; color: var(--text); display: flex; justify-content: space-between; align-items: center;">
          <div>
            <strong>{f.name}</strong>
            <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 2px;">
              {typeLabel(f.type)}
              {f.district && ` · ${f.district}`}
              {f.operating_hours.is_24_hour && ' · 24h'}
            </div>
          </div>
          <div style="display: flex; gap: 4px; flex-shrink: 0;">
            {Object.entries(f.services).filter(([,v]) => v).slice(0, 3).map(([k]) => (
              <span class="chip" style="font-size: 0.7rem; padding: 2px 6px;">{SERVICE_MAP[k]?.plain || k}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>
