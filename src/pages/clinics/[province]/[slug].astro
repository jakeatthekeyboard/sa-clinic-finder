---
import Base from '../../../layouts/Base.astro';
import { facilities, PROVINCES, SERVICE_MAP, provinceSlug, typeLabel, nearbyFacilities, mapsUrl, whatsappShareUrl } from '../../../data/helpers';
import { generateFacilityEditorial } from '../../../data/facility-editorial';
import { getFacilityTypeEditorial, REFERRAL_HIERARCHY } from '../../../data/facility-types-editorial';
import { withheldKeys } from '../../../data/facility-quality.mjs';

export function getStaticPaths() {
  const validFacilities = facilities.filter(f => PROVINCES.includes(f.province as any));

  // #929 — pages whose OSM `name` is a category string ("health care", "Clinic") or
  // that duplicate a facility already on the site are withheld from the sitemap by
  // astro.config.mjs. Mark the SAME set noindex so the two signals agree; a page in
  // neither the sitemap nor the index is one we have simply stopped volunteering,
  // while staying live for anyone who reaches it. No sourced value is edited.
  const withheld = withheldKeys(validFacilities);

  // Detect duplicate base titles: "Name — Type in Province"
  const titleCounts = new Map<string, number>();
  for (const f of validFacilities) {
    const baseTitle = `${f.name} — ${typeLabel(f.type)} in ${f.province}`;
    titleCounts.set(baseTitle, (titleCounts.get(baseTitle) || 0) + 1);
  }

  return validFacilities.map(f => {
    const baseTitle = `${f.name} — ${typeLabel(f.type)} in ${f.province}`;
    let titleSuffix = '';
    if ((titleCounts.get(baseTitle) || 0) > 1) {
      // Disambiguate: prefer city > suburb > district > slug tail
      const loc = f.address.city || f.address.suburb || f.district;
      if (loc) {
        titleSuffix = `, ${loc}`;
      } else {
        // Extract suffix from slug (e.g. "health-care-limpopo-2" → "2")
        const namePart = f.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
        const tail = f.slug.slice(namePart.length).replace(/^-/, '');
        if (tail) {
          titleSuffix = ` (${tail})`;
        }
      }
    }

    return {
      params: { province: provinceSlug(f.province), slug: f.slug },
      props: { facility: f, titleSuffix, withheldReason: withheld.get(`${f.province}|${f.slug}`) ?? null },
    };
  });
}

const { facility, titleSuffix, withheldReason } = Astro.props;
const nearby = nearbyFacilities(facility, 3);
const editorial = generateFacilityEditorial(facility);
// #1150 — the public-system editorial is gated on OPERATOR, not on `type`.
// `type` is an OSM-derived shape label: 16 retail pharmacies (Clicks, Dis-Chem,
// Medicross, independent chemists) import as type="clinic", and the clinic block
// tells the reader a clinic is "the front door of the South African public health
// system", nurse-driven and free. On a humanitarian site that sends someone to a
// Clicks expecting free public primary care. `operator_type` is the field that
// actually answers "is this the public system?", so it is the field that gates.
// Deliberately suppress only on a KNOWN private operator — 249 records are
// operator_type "unknown" and silently stripping their editorial would be a large
// unreviewed content deletion, not a correction.
const isPrivate = facility.operator_type === 'private';
const typeEditorial = isPrivate ? null : getFacilityTypeEditorial(facility.type);
const activeServices = Object.entries(facility.services)
  .filter(([, v]) => v)
  .map(([k]) => ({ key: k, ...SERVICE_MAP[k] }))
  .filter(s => s.plain);

const directionsUrl = mapsUrl(facility.coordinates.lat, facility.coordinates.lng, facility.name);
const shareUrl = whatsappShareUrl(facility);

const guideMap: Record<string, { href: string; title: string }> = {
  arv_treatment: { href: '/guides/how-to-get-arvs', title: 'How to Get ARVs' },
  tb_treatment: { href: '/guides/tb-treatment-what-to-expect', title: 'TB Treatment — What to Expect' },
  maternity_antenatal: { href: '/guides/free-maternity-care', title: 'Free Maternity Care' },
  chronic_medication: { href: '/guides/chronic-medication-management', title: 'Chronic Medication Management' },
  emergency_24h: { href: '/guides/medical-emergency-guide', title: 'Medical Emergency Guide' },
  dental: { href: '/guides/dental-care-public-clinics', title: 'Dental Care at Public Clinics' },
  mental_health: { href: '/guides/mental-health-services', title: 'Mental Health Services' },
  family_planning: { href: '/guides/family-planning-contraception', title: 'Family Planning & Contraception' },
  immunisation: { href: '/guides/child-immunisation-schedule', title: 'Child Immunisation Schedule' },
  hiv_testing: { href: '/guides/hiv-testing-guide', title: 'HIV Testing Guide' },
  child_health: { href: '/guides/child-immunisation-schedule', title: 'Child Immunisation Schedule' },
};
const matchedGuides = Object.entries(facility.services)
  .filter(([k, v]) => v && guideMap[k])
  .map(([k]) => guideMap[k])
  .filter((g, i, arr) => arr.findIndex(x => x.href === g.href) === i)
  .slice(0, 4);
const extraGuides = [
  { href: '/guides/ccmdd-chronic-meds-pickup', title: 'CCMDD Chronic Meds Pickup' },
  { href: '/guides/hospital-referral-system', title: 'Hospital Referral System' },
  { href: '/guides/find-nearest-clinic', title: 'How to Use Public Clinics' },
];
const relatedGuides = [...matchedGuides];
for (const e of extraGuides) {
  if (relatedGuides.length >= 4) break;
  if (!relatedGuides.some(g => g.href === e.href)) relatedGuides.push(e);
}

const idMatch = facility.facility_id.match(/^zaf_(way|nodes?)_(\d+)$/);
const osmType = idMatch ? (idMatch[1] === 'way' ? 'way' : 'node') : 'node';
const osmId = idMatch ? idMatch[2] : facility.facility_id;
const osmUrl = `https://www.openstreetmap.org/${osmType}/${osmId}`;
const overpassUrl = `https://overpass-turbo.eu/?Q=${osmType}(${osmId})%3Bout%3B&R`;
const hotosmUrl = 'https://data.humdata.org/dataset/hotosm_zaf_health_facilities';

const addressParts = [facility.address.street, facility.address.suburb, facility.address.city, facility.address.postal_code].filter(Boolean);
const addressStr = addressParts.length > 0 ? addressParts.join(', ') : `${facility.province}${facility.district ? ', ' + facility.district : ''}`;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://clinicfinder.co.za/' },
    { '@type': 'ListItem', position: 2, name: 'Provinces', item: 'https://clinicfinder.co.za/clinics' },
    { '@type': 'ListItem', position: 3, name: facility.province, item: `https://clinicfinder.co.za/clinics/${provinceSlug(facility.province)}` },
    { '@type': 'ListItem', position: 4, name: facility.name },
  ],
};

// FACILITY_TYPE_EDITORIAL prose carries inline <a href="/guides/…"> links. The rendered
// page emits them as HTML (set:html below); schema.org FAQ answer text must be plain, so
// strip the tags here rather than shipping markup into the structured data.
const plain = (s: string) => s.replace(/<[^>]+>/g, '');

const faqLd = typeEditorial ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: `When should I go to a ${typeLabel(facility.type).toLowerCase()}?`, acceptedAnswer: { '@type': 'Answer', text: plain(typeEditorial.whenToGo) } },
    { '@type': 'Question', name: `What staff work at a ${typeLabel(facility.type).toLowerCase()}?`, acceptedAnswer: { '@type': 'Answer', text: plain(typeEditorial.staffing) } },
    { '@type': 'Question', name: `How does the referral system work at a ${typeLabel(facility.type).toLowerCase()}?`, acceptedAnswer: { '@type': 'Answer', text: plain(typeEditorial.referralFlow) } },
  ],
} : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['MedicalClinic', 'LocalBusiness'],
  name: facility.name,
  description: `${typeLabel(facility.type)} in ${facility.province}, South Africa. Services: ${activeServices.map(s => s.plain).join(', ')}.`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: facility.address.street || undefined,
    addressLocality: facility.address.city || facility.district || facility.province,
    addressRegion: facility.province,
    addressCountry: 'ZA',
    postalCode: facility.address.postal_code || undefined,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: facility.coordinates.lat,
    longitude: facility.coordinates.lng,
  },
  url: `https://clinicfinder.co.za${facility.url_path}`,
  ...(facility.contact.phone && { telephone: facility.contact.phone }),
  ...(facility.contact.email && { email: facility.contact.email }),
  ...(facility.contact.website && { sameAs: [facility.contact.website] }),
  ...(facility.operating_hours.raw
    ? { openingHoursSpecification: { '@type': 'OpeningHoursSpecification', description: facility.operating_hours.raw } }
    : facility.operating_hours.is_24_hour
      ? { openingHours: 'Mo-Su 00:00-23:59' }
      : {}),
  isAccessibleForFree: !isPrivate,
  medicalSpecialty: activeServices.map(s => s.label),
};
---
<Base
  title={`${facility.name} — ${typeLabel(facility.type)} in ${facility.province}${titleSuffix}`}
  description={`${facility.name} is a ${typeLabel(facility.type).toLowerCase()} in ${facility.province}. Services: ${activeServices.slice(0, 5).map(s => s.plain).join(', ')}. Get directions and contact details.`}
  jsonLd={[breadcrumbLd, jsonLd, ...(faqLd ? [faqLd] : [])]}
  noindex={Boolean(withheldReason)}
>
  <div class="container" style="padding: 32px 0;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
      <a href="/">Home</a> &rsaquo;
      <a href="/clinics">Provinces</a> &rsaquo;
      <a href={`/clinics/${provinceSlug(facility.province)}`}>{facility.province}</a> &rsaquo;
      {facility.name}
    </nav>

    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px; flex-wrap: wrap;">
      <h1 style="font-size: 1.4rem;">{facility.name}</h1>
      <span class="chip chip--type">{typeLabel(facility.type)}</span>
      {facility.operating_hours.is_24_hour && <span class="chip" style="background: #fef3cd; color: #856404;">24 hours</span>}
    </div>

    <p style="color: var(--text-muted); margin-bottom: 24px;">
      {addressStr}
    </p>

    <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 32px;">
      <a href={directionsUrl} target="_blank" rel="noopener" class="btn btn--primary">
        Show Google Maps Directions
      </a>
      <a href={shareUrl} target="_blank" rel="noopener" class="btn btn--wa">
        Share on WhatsApp
      </a>
    </div>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 12px;">Services available</h2>
      <div style="display: flex; flex-wrap: wrap; gap: 6px;">
        {activeServices.map(s => (
          <a href={`/services/${s.slug}`} class="chip" style="text-decoration: none;">{s.plain}</a>
        ))}
      </div>
      {activeServices.length === 0 && <p style="color: var(--text-muted); font-size: 0.9rem;">Service details not yet verified for this facility.</p>}
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 12px;">About this facility</h2>
      <p style="font-size: 0.9rem; line-height: 1.7; margin-bottom: 16px;" set:html={editorial.context} />
      {editorial.tips.length > 0 && (
        <div style="display: grid; gap: 12px;">
          {editorial.tips.map(tip => (
            <div style="background: var(--bg-alt); border-radius: var(--radius); padding: 14px 16px; font-size: 0.9rem; line-height: 1.6;" set:html={tip} />
          ))}
        </div>
      )}
    </section>

    {typeEditorial && (
      <section style="margin-bottom: 32px;">
        <h2 style="font-size: 1.1rem; margin-bottom: 12px;">What is a {typeLabel(facility.type).toLowerCase()}?</h2>
        <p style="font-size: 0.9rem; line-height: 1.7; margin-bottom: 16px;" set:html={typeEditorial.description} />
        <details style="margin-bottom: 12px;">
          <summary style="cursor: pointer; font-weight: 600; font-size: 0.9rem; color: var(--primary-dark);">When should I go to a {typeLabel(facility.type).toLowerCase()}?</summary>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 8px; line-height: 1.6;" set:html={typeEditorial.whenToGo} />
        </details>
        <details style="margin-bottom: 12px;">
          <summary style="cursor: pointer; font-weight: 600; font-size: 0.9rem; color: var(--primary-dark);">What staff work at a {typeLabel(facility.type).toLowerCase()}?</summary>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 8px; line-height: 1.6;" set:html={typeEditorial.staffing} />
        </details>
        <details>
          <summary style="cursor: pointer; font-weight: 600; font-size: 0.9rem; color: var(--primary-dark);">How does the referral system work at a {typeLabel(facility.type).toLowerCase()}?</summary>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 8px; line-height: 1.6;" set:html={typeEditorial.referralFlow} />
        </details>
      </section>
    )}

    {isPrivate && (
      <section style="margin-bottom: 32px;">
        <div style="background: #fef3cd; border-left: 4px solid #856404; border-radius: var(--radius); padding: 14px 16px;">
          <h2 style="font-size: 1rem; margin-bottom: 8px; color: #856404;">Privately operated — not a free public clinic</h2>
          <p style="font-size: 0.9rem; line-height: 1.7; margin: 0;">This is a privately operated facility. It is not part of the free public primary healthcare system — expect to pay, or to use medical aid, to be seen here. A nurse-led clinic inside a retail pharmacy can give vaccinations, check blood pressure and glucose, and dress minor wounds, but it cannot issue a public-sector referral letter and it does not dispense state chronic medication. For free care, go to a public clinic or community health centre.</p>
        </div>
      </section>
    )}

    {facility.operating_hours.raw && (
      <section style="margin-bottom: 32px;">
        <h2 style="font-size: 1.1rem; margin-bottom: 8px;">Operating hours</h2>
        <p style="font-size: 0.9rem;">{facility.operating_hours.raw}</p>
      </section>
    )}

    {(facility.contact.phone || facility.contact.email || facility.contact.website) && (
      <section style="margin-bottom: 32px;">
        <h2 style="font-size: 1.1rem; margin-bottom: 8px;">Contact</h2>
        <div style="display: grid; gap: 6px; font-size: 0.9rem;">
          {facility.contact.phone && (
            <p><a href={`tel:${facility.contact.phone}`}>{facility.contact.phone}</a></p>
          )}
          {facility.contact.email && (
            <p><a href={`mailto:${facility.contact.email}`}>{facility.contact.email}</a></p>
          )}
          {facility.contact.website && (
            <p><a href={facility.contact.website} target="_blank" rel="noopener">{facility.contact.website.replace(/^https?:\/\//, '')}</a></p>
          )}
        </div>
      </section>
    )}

    {facility.operator && (
      <section style="margin-bottom: 32px;">
        <h2 style="font-size: 1.1rem; margin-bottom: 8px;">Operated by</h2>
        <p style="font-size: 0.9rem;">{facility.operator}</p>
      </section>
    )}

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 8px;">Location</h2>
      <p style="font-size: 0.85rem; color: var(--text-muted);">
        GPS: {facility.coordinates.lat.toFixed(4)}, {facility.coordinates.lng.toFixed(4)}
        {facility.district && ` · District: ${facility.district}`}
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 12px;">Nearby facilities</h2>
      <div style="display: grid; gap: 10px;">
        {nearby.map(n => {
          const nAddr = [n.address.street, n.address.suburb, n.address.city].filter(Boolean).join(', ');
          return (
          <a href={n.url_path} class="card" style="text-decoration: none; color: var(--text);">
            <strong>{n.name}</strong>
            {nAddr && <div style="font-size: 0.85rem; color: var(--text); margin-top: 2px;">{nAddr}</div>}
            <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 2px;">
              {typeLabel(n.type)} · {n.province}
            </div>
          </a>
        )})}
      </div>
    </section>

    {relatedGuides.length > 0 && (
      <section style="margin-bottom: 32px;">
        <h2 style="font-size: 1.1rem; margin-bottom: 12px;">Related Guides</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.75rem;">
          {relatedGuides.map(g => (
            <a href={g.href} style="display: block; padding: 0.75rem 1rem; background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); text-decoration: none; font-size: 0.9rem; font-weight: 500;">{g.title}</a>
          ))}
        </div>
      </section>
    )}

    <section style="background: var(--bg-alt); border-radius: var(--radius); padding: 20px; margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 12px;">Data source</h2>
      <div style="display: grid; gap: 8px; font-size: 0.9rem;">
        <div style="display: flex; gap: 8px;">
          <strong style="min-width: 100px; color: var(--text-muted);">Source:</strong>
          <span>{facility.data_source === 'overpass'
            ? <Fragment>
                <a href={osmUrl} target="_blank" rel="noopener">OpenStreetMap</a> (via <a href={overpassUrl} target="_blank" rel="noopener">Overpass API</a>) — community-mapped geographic data
              </Fragment>
            : facility.data_source === 'hotosm'
            ? <Fragment>
                <a href={osmUrl} target="_blank" rel="noopener">OpenStreetMap</a> via <a href={hotosmUrl} target="_blank" rel="noopener">Humanitarian OpenStreetMap Team</a> — humanitarian mapping data
              </Fragment>
            : facility.data_source}</span>
        </div>
        <div style="display: flex; gap: 8px;">
          <strong style="min-width: 100px; color: var(--text-muted);">Record:</strong>
          <span><a href={osmUrl} target="_blank" rel="noopener">OSM {osmType} {osmId}</a></span>
        </div>
        <div style="display: flex; gap: 8px;">
          <strong style="min-width: 100px; color: var(--text-muted);">Last verified:</strong>
          <span>{facility.last_verified}</span>
        </div>
        <div style="display: flex; gap: 8px;">
          <strong style="min-width: 100px; color: var(--text-muted);">Data quality:</strong>
          <span>{'★'.repeat(facility.data_quality_score)}{'☆'.repeat(5 - facility.data_quality_score)} ({facility.data_quality_score}/5)</span>
        </div>
      </div>
      <p style="margin-top: 12px; font-size: 0.85rem; color: var(--text-muted); line-height: 1.6;">
        Facility data &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap contributors</a>, available under the <a href="https://opendatacommons.org/licenses/odbl/" target="_blank" rel="noopener">Open Database License</a>. This information may not reflect the latest changes. We recommend phoning the facility to confirm services and hours before visiting. If this information is incorrect, <a href="mailto:hello@clinicfinder.co.za">email us</a> and we will update it.
      </p>
    </section>
  </div>
</Base>
