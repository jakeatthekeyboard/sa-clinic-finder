---
/**
 * isiXhosa "Terms of Use" page — sentence-for-sentence translation of
 * src/pages/terms.astro. The last-updated date, the email address, the site name and
 * the national ambulance number 10177 are carried across unchanged, as is the noindex
 * directive. The English page remains the authoritative version of these terms — the
 * translation disclaimer the layout renders above says so on every page.
 */
import Base from '../../layouts/Base.astro';
import { localeHrefFor } from '../../i18n/links';

const L = localeHrefFor('xh');
---

<Base title="Imiqathango Yokusebenzisa — Clinic Finder SA" description="Imiqathango yokusebenzisa iClinic Finder SA. Imiqathango yokusebenzisa, izilumkiso, nemida yoxanduva." noindex={true}>
  <div class="container" style="padding: 2rem 0 3rem;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem;">
      <a href={L('/')} style="color: var(--primary-dark);">Ikhaya</a> › Imiqathango Yokusebenzisa
    </nav>

    <h1 style="font-size: 1.8rem; margin-bottom: 0.5rem;">Imiqathango Yokusebenzisa</h1>
    <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem;">Ihlaziywe okokugqibela: 15 Meyi 2026</p>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">Ukwamkela imiqathango</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">Ngokungena kwiClinic Finder SA ("le sayithi"), uyavuma le miqathango. Ukuba akuvumi, nceda ungayisebenzisi le sayithi.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">Injongo nobubanzi</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">IClinic Finder SA luluhlu lwasimahla lwamaziko empilo karhulumente aseMzantsi Afrika. Le sayithi inceda abasebenzisi bafumane iikliniki zikarhulumente, amaziko empilo oluntu, nezibhedlele ngephondo, ngenkonzo, okanye ngokusondelelana. Umxholo wenzelwe ukwazisa kuphela kwaye asilocebiso lezonyango.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">Asilocebiso lezonyango</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">Inkcazelo ekule sayithi, kubandakanya izikhokelo zempilo, iinkcazelo zeenkonzo, neenkcukacha zamaziko, yeyokufundisa kwaye ayithathi indawo yecebiso lezonyango elivela kwingcali, uxilongo, okanye unyango. Soloko uthetha nomsebenzi wezempilo ofanelekileyo ngeenkxalabo zezonyango. Xa kukho ingxaki engxamisekileyo yezonyango, fowunela u-10177 (i-ambulensi yesizwe) okanye uye kwiziko longxamiseko elikufuphi nawe.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">Ukuchaneka kwenkcazelo</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">Idatha yamaziko ithathwe kuluhlu lwamaziko lweNational Department of Health kwaye yongezelelwa ziirekhodi zamasebe ezempilo amaphondo. Amaxesha okusebenza, iinkonzo ezinikwayo, neenkcukacha zoqhagamshelwano ziyatshintsha ngaphandle kwesaziso. Sihlaziya iirekhodi rhoqo kodwa asinakuqinisekisa ukuba yonke inkcukacha ihambelana nexesha. Ukuba ufumana inkcazelo endala, nceda <a href={L('/contact')} style="color: var(--primary-dark);">usazise</a>.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">Iimpawu zendawo</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">Uphawu oluthi "Fumana ikliniki ekufuphi" lusebenzisa i-geolocation API yebhrawuza yakho. Le datha isetyenzwa kwibhrawuza yakho kwaye ayigcinwa kwiiseva zethu. Ukubalwa komgama kuqikelelwa kwaye akufanele kuthathe indawo yesoftware yokwalathisa xa usiya kwiziko.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">Umda woxanduva</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">IClinic Finder SA inikwa "njengoko injalo" ngaphandle kwazo naziphi na iziqinisekiso. Asinaxanduva ngomonakalo ovela ekusebenziseni kwakho okanye ekuxhomekekeni kwakho kwinkcazelo ekule sayithi, kubandakanya kodwa kungaphelelanga kwiinkcukacha zamaziko ezingachanekanga, iinkonzo ezingafumanekiyo, okanye izigqibo zokuhamba ezisekelwe kuqikelelo lomgama.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">Ipropati yengqondo</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">Umxholo wokuqala wohlelo, izikhokelo, nohlalutyo zezeClinic Finder SA. Idatha yamaziko ethathwe kwiirekhodi zikarhulumente ezivulelekileyo asiyoyethu. Ungawusebenzisa umxholo wethu ukuba usinika udumo.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">Utshintsho kwimiqathango</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">Sinokuyihlaziya le miqathango nangaliphi na ixesha. Ukuqhubeka usebenzisa le sayithi emva kotshintsho kuthetha ukuba uyayamkela imiqathango ehlaziyiweyo.</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: var(--primary-dark);">Uqhagamshelwano</h2>
      <p style="line-height: 1.7; color: var(--text-muted);">Unemibuzo ngale miqathango? Thumela i-imeyile ku-<a href="mailto:hello@clinicfinder.co.za" style="color: var(--primary-dark);">hello@clinicfinder.co.za</a>.</p>
    </section>
  </div>
</Base>
