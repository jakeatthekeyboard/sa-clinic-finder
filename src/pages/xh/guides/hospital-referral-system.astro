---
/**
 * isiXhosa — sentence-for-sentence translation of src/pages/guides/hospital-referral-system.astro.
 * Slugs stay English (they are the join key for hreflang and the language switcher).
 */
import Base from '../../../layouts/Base.astro';
import { localePath } from '../../../i18n/config';

const L = (p: string) => localePath(p, 'xh');

const faqs = [
  {
    question: 'Ndingaya ngqo esibhedlele ndingenayo incwadi yokuthunyelwa?',
    answer: 'Kungxamiseko — ewe, ngamaxesha onke. Yiya ngqo kwigumbi longxamiseko lesibhedlele esikufuphi. Kwizinto ezingengomngxamiseko — ngokomthetho, hayi. Izibhedlele zikarhulumente kufuneka zifune incwadi yokuthunyelwa evela ekliniki okanye kwiziko lezempilo loluntu. Ngokwenene, ezinye izibhedlele ziya kubona izigulana ezingenayo incwadi kodwa uya kulinda ixesha elide kakhulu kunezigulana ezithunyelweyo, kwaye ungabuyiselwa ekliniki yakho. Le nkqubo isebenza ngcono xa uqala ekliniki.',
  },
  {
    question: 'Kuthatha ixesha elingakanani ukufumana incwadi yokuthunyelwa?',
    answer: 'Incwadi yokuthunyelwa ngokwayo unikwa yona xa utyelele ikliniki — umongikazi okanye ugqirha uyibhala ngokusekelwe kuhlolo lwakhe. Into elindelweyo li-appointment yesibhedlele. Ukuthunyelwa okungxamisekileyo (kurhaneleka umhlaza, kufuneka utyando, iimeko ezingazinzanga) kunokubonwa kwiintsuku ezimbalwa. Ukuthunyelwa okuqhelekileyo (uluvo lwengcali, utyando olungangxamisekanga, ukujongwa kwesifo esingunaphakade) kunokuthatha iinyanga ezi-2-12 kuxhomekeka kwisibhedlele, kwicandelo lengcali, nakwiphondo.',
  },
  {
    question: 'Ndingakhetha na isibhedlele endithunyelwa kuso?',
    answer: 'Ngokuqhelekileyo hayi. Indlela yokuthunyelwa ikuthumela kwisibhedlele esisebenzela indawo ohlala kuyo. Ikliniki nganye ithumela kwisibhedlele esithile sesithili, esithumela kwisibhedlele esithile sengingqi. Ungacela elinye iziko, kodwa ikliniki ayinyanzelekanga ukuba ivume oku ngaphandle kokuba kukho isizathu sonyango (umzekelo isibhedlele sengingqi asinaye ugqirha oyingcali ofunekayo).',
  },
  {
    question: 'Kuthekani ukuba ikliniki ayikwazi ukundinceda kodwa ayifuni ukundithumela?',
    answer: 'Ukuba ukholelwa ukuba ufuna unyango lwengcali ikliniki engenakukunika lona, unelungelo lokucela isizathu sokuba kutheni ukuthunyelwa kwakho kusaliwa. Ukuba awonelisekanga, khwelela ngaphezulu: (1) Cela ukubona umphathi wekliniki. (2) Qhagamshelana ne-ofisi yezempilo yesithili. (3) Ngenisa isikhalazo kwi-Health Ombud: 012 366 7599. Akufanele wenze oku rhoqo — iikliniki ezininzi ziyathumela ngokufanelekileyo — kodwa lilungelo lakho.',
  },
  {
    question: 'Ndifuna incwadi yokuthunyelwa entsha kutyelelo ngalunye lwesibhedlele?',
    answer: 'Hayi kunyango oluqhubekayo kwisibhedlele esinye. Xa sele ungenile kwinkqubo yesibhedlele ngenxa yemeko ethile (umzekelo uya kwikliniki yeswekile esibhedlele), unikwa ii-appointment zokulandela ngokuthe ngqo. Ufuna incwadi entsha yokuthunyelwa kuphela ukuba: (a) uya kwelinye icandelo lengcali, (b) kudlule iinyanga ezingaphezu kwe-6-12 ungatyelelanga, okanye (c) utshintsha izibhedlele.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Indlela Esebenza Ngayo Inkqubo Yokuthunyelwa Esibhedlele eMzantsi Afrika',
    description: 'Ikhonkco lokuthunyelwa ukusuka ekliniki ukuya esibhedlele: xa uyifuna, indlela yokuyifumana, nokwenzekayo xa uyitsiba.',
    url: 'https://clinicfinder.co.za/xh/guides/hospital-referral-system',
    publisher: { '@type': 'Organization', name: 'Clinic Finder SA' },
    author: { '@type': 'Organization', name: 'Clinic Finder SA' },
    datePublished: '2026-04-16',
    dateModified: '2026-05-14',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(faq => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    'name': 'Indlela Yokufumana Incwadi Yokuthunyelwa Esibhedlele eMzantsi Afrika',
    'description': 'Hamba ikhonkco lokuthunyelwa lwezempilo zikarhulumente ukusuka ekliniki ukuya kwi-appointment yesibhedlele yengcali.',
    'step': [
      {'@type': 'HowToStep', 'position': 1, 'name': 'Tyelela ikliniki yakho yokuqala kuqala', 'text': 'Yiya kwikliniki okanye kwiziko lezempilo loluntu elikufuphi nawe — le yindawo yokungena kwikhonkco lokuthunyelwa. Yiza nesazisi sakho nawo nawaphi na amayeza owasebenzisayo. Umongikazi uya kuhlola imeko yakho aze agqibe ukuba unyango lwasekliniki lwanele okanye ufuna uluvo lwengcali yesibhedlele.'},
      {'@type': 'HowToStep', 'position': 2, 'name': 'Cela incwadi yokuthunyelwa ukuba imeko yakho ifuna unyango lwengcali', 'text': 'Ukuba ikliniki ayikwazi ukujongana nemeko yakho, umongikazi okanye ugqirha ubhala incwadi yokuthunyelwa. Ukuba ukholelwa ukuba uyayifuna incwadi yokuthunyelwa kodwa awunikwa, cela ngokuthe ngqo. Ukuba uyaliwa, khwelela ngaphezulu kumphathi wekliniki okanye kwi-ofisi yezempilo yesithili. Unelungelo lokucela izizathu.'},
      {'@type': 'HowToStep', 'position': 3, 'name': 'Yamkela incwadi yakho yokuthunyelwa', 'text': 'Incwadi yokuthunyelwa iquka isigulo sakho, imbali yonyango lwakho, nesibhedlele esicetyiswayo. Uthunyelwa kwisibhedlele sendawo ohlala kuyo — ikliniki ithumela kwisibhedlele sesithili, esithumela kwesengingqi, size sithumele kwisibhedlele esiphezulu. Ngokuqhelekileyo awunakho ukukhetha esinye isibhedlele ngaphandle kokuba kukho isizathu sonyango.'},
      {'@type': 'HowToStep', 'position': 4, 'name': 'Linda i-appointment yakho yesibhedlele', 'text': 'Ukuthunyelwa okungxamisekileyo (kurhaneleka umhlaza, kufuneka utyando, iimeko ezingazinzanga) kunokubonwa kwiintsuku ezimbalwa. Ukuthunyelwa okuqhelekileyo (uluvo lwengcali, utyando olungangxamisekanga) kunokuthatha iinyanga ezi-2-12 kuxhomekeka kwisibhedlele, kwicandelo lengcali, nakwiphondo. Qhagamshelana nesibhedlele ukuqinisekisa umhla we-appointment yakho.'},
      {'@type': 'HowToStep', 'position': 5, 'name': 'Yiya kwi-appointment yakho yesibhedlele', 'text': 'Yiza nencwadi yakho yokuthunyelwa, isazisi, nawo onke amayeza owasebenzisayo kwi-appointment. Xa sele ungenile kwinkqubo yesibhedlele ngenxa yemeko ethile, ufumana ii-appointment zokulandela ngokuthe ngqo ungadingi izincwadi ezintsha zokuthunyelwa — ngaphandle kokuba uya kwelinye icandelo lengcali okanye kudlule iinyanga ezingaphezu kwe-6-12.'},
    ],
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Ikhaya', item: 'https://clinicfinder.co.za/xh' }, { '@type': 'ListItem', position: 2, name: 'Izikhokelo', item: 'https://clinicfinder.co.za/xh/guides' }, { '@type': 'ListItem', position: 3, name: 'Indlela Esebenza Ngayo Inkqubo Yokuthunyelwa Esibhedlele eMzantsi Afrika' }] },
];
---
<Base
  title="Indlela Esebenza Ngayo Inkqubo Yokuthunyelwa Esibhedlele eMzantsi Afrika — Clinic Finder SA"
  description="Inkqubo yokuthunyelwa esibhedlele yaseMzantsi Afrika icaciswa: ukusuka ekliniki ukuya kwesesithili, kwesengingqi, ukuya kwesiphezulu. Xa uyifuna incwadi yokuthunyelwa, indlela yokuyifumana, nento omawuyilindele."
  jsonLd={jsonLd}
>
  <div class="container" style="padding: 32px 0; max-width: 720px;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
      <a href={L('/')}>Ikhaya</a> &rsaquo; <a href={L('/guides')}>Izikhokelo</a> &rsaquo; Inkqubo Yokuthunyelwa Esibhedlele
    </nav>

    <h1 style="font-size: 1.5rem; margin-bottom: 8px;">Indlela Esebenza Ngayo Inkqubo Yokuthunyelwa Esibhedlele eMzantsi Afrika</h1>
    <p style="color: var(--text-muted); margin-bottom: 32px; line-height: 1.7;">
      Inkqubo yezempilo karhulumente yaseMzantsi Afrika yakhelwe kwikhonkco lokuthunyelwa: uqala ekliniki, kwaye ukuba ikliniki ayikwazi ukujongana nemeko yakho, bakuthumela ngaphezulu esibhedlele. Ukuqonda le nkqubo kukunceda ufumane unyango olufanelekileyo ngokukhawuleza.
    </p>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Ikhonkco lokuthunyelwa</h2>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-bottom: 16px;">
        Inkqubo inamanqanaba amane. Inqanaba ngalinye lijongana neemeko elingakwaziyo ukuzenza inqanaba elingaphantsi kwalo:
      </p>
      <div style="display: grid; gap: 12px;">
        <div style="display: flex; gap: 16px; align-items: flex-start;">
          <div style="flex-shrink: 0; width: 40px; height: 40px; background: var(--primary-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; color: var(--primary-dark);">1</div>
          <div>
            <strong style="font-size: 1rem;">Ikliniki yokuqala / Iziko lezempilo loluntu</strong>
            <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.6;">Isebenza ngabongikazi kwaye ngamanye amaxesha ngugqirha otyelelayo. Ijongana: nezifo ezingunaphakade (i-HIV, uxinzelelo lwegazi oluphezulu, iswekile), izigulo ezincinci, ucwangciso losapho, unyango lwabakhulelweyo, ugonyo, unyango lwe-TB, nonyango olusisiseko lwamanxeba. Yindawo ekufuneka kuhlangatyezwane kuyo ne-90% yeemfuno zempilo.</p>
          </div>
        </div>
        <div style="display: flex; gap: 16px; align-items: flex-start;">
          <div style="flex-shrink: 0; width: 40px; height: 40px; background: var(--primary-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; color: var(--primary-dark);">2</div>
          <div>
            <strong style="font-size: 1rem;">Isibhedlele sesithili</strong>
            <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.6;">Sinoogqirha, utyando olusisiseko, i-X-ray, ilebhu, newadi yabakhulelweyo. Sijongana: nokukhulelwa okunobunzima, amathambo aphukileyo, ukukhutshwa kwe-appendix, ukuzinziswa kweemeko ezingxamisekileyo, neemeko ezifuna ukulaliswa esibhedlele. Ngokuqhelekileyo yindawo yokuqala kwabathunyelwa ziikliniki.</p>
          </div>
        </div>
        <div style="display: flex; gap: 16px; align-items: flex-start;">
          <div style="flex-shrink: 0; width: 40px; height: 40px; background: var(--primary-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; color: var(--primary-dark);">3</div>
          <div>
            <strong style="font-size: 1rem;">Isibhedlele sengingqi</strong>
            <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.6;">Sinoogqirha abaziingcali (abatyandi, oogqirha babantwana, oogqirha bezifo zangaphakathi, oogqirha babakhulelweyo, oogqirha bengqondo). Sijongana: notyando olunzima, ukuqaliswa konyango lomhlaza, ukukhulelwa okuyingozi, neemeko zonyango ezifuna iingcali. Kuthunyelwa kuso ukusuka kwizibhedlele zesithili.</p>
          </div>
        </div>
        <div style="display: flex; gap: 16px; align-items: flex-start;">
          <div style="flex-shrink: 0; width: 40px; height: 40px; background: var(--primary-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; color: var(--primary-dark);">4</div>
          <div>
            <strong style="font-size: 1rem;">Isibhedlele esiphezulu / esiphakathi</strong>
            <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.6;">Izibhedlele zemfundo ezineengcali ezizodwa (utyando lwengqondo, utyando lwentliziyo nesifuba, unyango lomhlaza, ukufakelwa kwamalungu omzimba). Zijongana: neemeko ezinzima kunazo zonke, izifo ezinqabileyo, utyando oluphambili, ukufundisa nophando. Imizekelo: Chris Hani Baragwanath, Groote Schuur, Inkosi Albert Luthuli, Steve Biko, Tygerberg.</p>
          </div>
        </div>
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Xa ikliniki ikuthumela</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Izizathu eziqhelekileyo zokuba ikliniki ikuthumele esibhedlele:
      </p>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 6px; margin-top: 8px;">
        <li><strong>Isigulo esingaphaya kwamandla ekliniki</strong> — kurhaneleka umhlaza, iqhuma elingaziwayo, iziphumo zovavanyo lwegazi ezingaqhelekanga ezingapheliyo</li>
        <li><strong>Kufuneka utyando</strong> — i-hernia, inyongo, iinkqubo zamathambo, ukuthatha inxalenye yenyama yovavanyo (biopsy)</li>
        <li><strong>Iingxaki zokukhulelwa</strong> — i-pre-eclampsia, umntwana ohleli ngokuphosakeleyo esibelekweni, ukutyandwa ngaphambili, ukukhulelwa amawele</li>
        <li><strong>Amayeza angasebenziyo</strong> — i-TB engaphenduli emayezeni, unyango lwe-HIV olungasebenziyo, iswekile engalawulekiyo nangona kusetyenziswa amayeza aphezulu asekliniki</li>
        <li><strong>Uhlolo lwengcali</strong> — uvavanyo lwentliziyo, i-endoscopy, i-MRI, iimeko zamehlo neendlebe ezifuna iingcali</li>
        <li><strong>Ingxaki yempilo yengqondo</strong> — umntu ophambeneyo, umngcipheko wokuzibulala, ukuyeka iziyobisi ngendlela emandundu</li>
      </ol>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Iqulethe ntoni incwadi yokuthunyelwa</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Ikliniki ikunika incwadi yokuthunyelwa ebhaliweyo. Iquka:
      </p>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 6px; margin-top: 8px;">
        <li>Iinkcukacha zakho (igama, isazisi, inombolo yekliniki)</li>
        <li>Isigulo sakho okanye imeko erhaneleka ukuba unayo</li>
        <li>Into ikliniki esele iyenzile (uvavanyo, amayeza, unyango oluzanyiweyo)</li>
        <li>Isizathu sokuthunyelwa (into ikliniki engakwaziyo ukujongana nayo)</li>
        <li>Inqanaba longxamiseko</li>
        <li>Sesiphi isibhedlele/eliphi icandelo othunyelwa kulo</li>
      </ol>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 12px;">
        <strong>Sukuyilahla le ncwadi.</strong> Isibhedlele siyayifuna ukuze sazi ukuba ufikeleni nokuba yintoni esele yenziwe. Ngaphandle kwayo, unokubuyiselwa ekliniki uyokuthatha enye — ulahlekelwe luhambo kwaye ubambezeleke unyango lwakho.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Into omawuyilindele esibhedlele</h2>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 8px;">
        <li><strong>Ukubhalisa</strong> — yiya kwidesika yokwamkelwa nencwadi yakho yokuthunyelwa, isazisi, nekhadi lekliniki. Baya kuvula ifayile yesibhedlele (okanye bafumane ekhoyo).</li>
        <li><strong>Ukulinda</strong> — iikliniki zangaphandle zesibhedlele zixakekile. Ukuthunyelwa okungxamisekileyo kubekwa phambili. Ukuthunyelwa okuqhelekileyo kunokulinda iiyure ezininzi. Yiza namanzi, ukutya okuncinci, isitshaja sefowuni, nento oza kuyifunda.</li>
        <li><strong>Uhlolo</strong> — ugqirha (rhoqo yi-registrar okanye i-medical officer) uya kukuhlola, ajonge incwadi yokuthunyelwa yekliniki, kwaye anokucela olunye uvavanyo.</li>
        <li><strong>Isiphumo</strong> — uya kuthi: unyangwe uze ubuyiselwe ekliniki yakho ukuze uqhubeke unyango, unikwe i-appointment yokulandela yesibhedlele, okanye ulaliswe.</li>
      </ol>
    </section>

    <section style="background: var(--bg-alt); border-radius: var(--radius); padding: 20px; margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 12px; color: var(--primary-dark);">Amacebiso okwenza le nkqubo ikusebenzele</h2>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 8px;">
        <li><strong>Qala ekliniki.</strong> Sukuyitsiba le nkqubo uye ngqo esibhedlele — uya kulinda ixesha elide kwaye unokugxothwa.</li>
        <li><strong>Gcina onke amaxwebhu akho ndawonye.</strong> Incwadi yokuthunyelwa, ikhadi lekliniki, isazisi, uluhlu lwamayeza, iziphumo zovavanyo lwegazi. Zifake kwisikhwama sepleyiti okanye kwifolda.</li>
        <li><strong>Buza ngamaxesha okulinda.</strong> Xa ufumana incwadi yokuthunyelwa, buza umongikazi: "Kuza kuthatha ixesha elingakanani ukufumana i-appointment yesibhedlele?" Oku kukwenza wazi into omayilindele.</li>
        <li><strong>Landela.</strong> Ukuba awukayifumani i-appointment kwixesha ebelilindeleke, buyela ekliniki ubacele ukuba balandele nesibhedlele.</li>
        <li><strong>Yiya kwi-appointment yakho.</strong> Amanani abantu abangayi kuma-appointment abo esibhedlele aphezulu, into elahla amathuba yaye yandise amaxesha okulinda kubo bonke abantu. Ukuba awukwazi ukuya, fowunela isibhedlele ubhukishe elinye ixesha.</li>
      </ol>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px;">Amaxesha Okulinda — Yintoni Enokwenzeka</h2>
      <p style="font-size: 0.9rem; line-height: 1.7; color: var(--text-muted); margin-bottom: 12px;">Amaxesha okulinda ayahluka kakhulu ngokwephondo, ngokwecandelo lengcali, nangokungxamiseka. La ngamanani aqhelekileyo — asizizo iziqinisekiso.</p>
      <div style="overflow-x: auto; margin-bottom: 16px;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem;">
          <thead><tr style="border-bottom: 2px solid var(--border);">
            <th style="text-align: left; padding: 10px 8px;">Icandelo Lengcali</th>
            <th style="text-align: left; padding: 10px 8px;">Ukuthunyelwa Okungxamisekileyo</th>
            <th style="text-align: left; padding: 10px 8px;">Ukuthunyelwa Okuqhelekileyo</th>
          </tr></thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">Utyando (jikelele)</td><td style="padding: 8px;">iiveki ezi-1-2</td><td style="padding: 8px;">iinyanga ezi-3-12</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">Amathambo (iqatha/idolo)</td><td style="padding: 8px;">iiveki ezi-2-4</td><td style="padding: 8px;">iinyanga ezi-6-24</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">Amehlo (i-cataract)</td><td style="padding: 8px;">iiveki ezi-4-8</td><td style="padding: 8px;">iinyanga ezi-6-18</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">Iindlebe, impumlo nomqala (ENT)</td><td style="padding: 8px;">iiveki ezi-2-4</td><td style="padding: 8px;">iinyanga ezi-3-12</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">Impilo yengqondo</td><td style="padding: 8px;">Ngosuku olunye (ingxaki engxamisekileyo)</td><td style="padding: 8px;">iiveki ezi-4-12</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">Umhlaza</td><td style="padding: 8px;">iiveki ezi-1-2</td><td style="padding: 8px;">iiveki ezi-2-6</td></tr>
          </tbody>
        </table>
      </div>
      <p style="font-size: 0.9rem; line-height: 1.7; color: var(--text-muted);">Ukuba imeko yakho iya isiba mandundu ngoxa ulindile, buyela ekliniki — banokukhwelela ukuthunyelwa kwakho ngaphezulu okanye bakuthumele kwicandelo longxamiseko. Sukuhlala nje ulindile usezintlungwini.</p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px;">Amalungelo Akho Xa Uthunyelwe</h2>
      <p style="font-size: 0.9rem; line-height: 1.7; color: var(--text-muted); margin-bottom: 12px;">I-Patients' Rights Charter noMthetho weMpilo weSizwe bayakukhusela kuyo yonke inkqubo yokuthunyelwa.</p>
      <div style="display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <div style="font-weight: 600; margin-bottom: 8px;">Ilungelo lolwazi</div>
          <p style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.6; margin: 0;">Ungacela ukubona incwadi yakho yokuthunyelwa, wazi ukuba uthunyelwa kwesiphi isibhedlele, kwaye ufumane ixesha lokulinda eliqikelelweyo. Ikliniki kufuneka icacise ukuba kutheni uthunyelwa.</p>
        </div>
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <div style="font-weight: 600; margin-bottom: 8px;">Ilungelo lokwala</div>
          <p style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.6; margin: 0;">Ungakwazi ukwala ukuthunyelwa okanye inkqubo yonyango. Ugqirha kufuneka acacise imingcipheko yokwala aze abhale phantsi isigqibo sakho, kodwa akakwazi ukukunyanzela unyango (ngaphandle kweemeko ezingxamisekileyo zempilo yengqondo phantsi koMthetho weMpilo yeNgqondo).</p>
        </div>
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <div style="font-weight: 600; margin-bottom: 8px;">Ilungelo lokukhalaza</div>
          <p style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.6; margin: 0;">Ukuba isibhedlele silahlekelwa yincwadi yakho yokuthunyelwa, sirhoxisa ii-appointment rhoqo, okanye sinika unyango olubi: khalaza kwi-ofisi ye-CEO yesibhedlele kuqala, uze uye kwi-Health Ombud yephondo, uze uye kwi-Office of Health Standards Compliance (OHSC). Umnxeba: 080 011 6472.</p>
        </div>
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <div style="font-weight: 600; margin-bottom: 8px;">Ilungelo lonyango longxamiseko</div>
          <p style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.6; margin: 0;">Icandelo 27 loMgaqo-siseko liqinisekisa unyango lwempilo olungxamisekileyo nokuba awunayo incwadi yokuthunyelwa, nokuba awukwazi ukuhlawula, nokuba awunawo amaxwebhu. Akukho sibhedlele esinokugxotha isigulana esingxamisekileyo. Jonga uluhlu lwethu <a href="/services/emergency">lwamaziko ongxamiseko avulekileyo iiyure ezingama-24</a>.</p>
        </div>
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px;">Imibuzo Ebuzwa Rhoqo</h2>
      <div style="display: grid; gap: 12px;">
        {faqs.map(faq => (
          <details style="border: 1px solid var(--border); border-radius: var(--radius);">
            <summary style="cursor: pointer; font-weight: 600; font-size: 0.95rem; padding: 14px; list-style: none; display: flex; justify-content: space-between; align-items: center;">
              {faq.question}
              <span style="color: var(--text-muted); flex-shrink: 0; margin-left: 12px;">+</span>
            </summary>
            <div style="padding: 0 14px 14px; font-size: 0.9rem; color: var(--text-muted); line-height: 1.7;">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <section style="border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; font-size: 0.85rem; color: var(--text-muted); line-height: 1.6;">
