---
/**
 * isiXhosa CCMDD guide — sentence-for-sentence translation of
 * src/pages/guides/ccmdd-chronic-meds-pickup.astro.
 * Slugs stay English (they are the join key for hreflang and the language switcher).
 */
import Base from '../../../layouts/Base.astro';
import { facilities } from '../../../data/helpers';
import { localePath } from '../../../i18n/config';

const L = (p: string) => localePath(p, 'xh');

const chronicClinics = facilities.filter(f => f.services.chronic_medication);

const faqs = [
  {
    question: 'Zeziphi izifo ezifanelekayo kwi-CCMDD?',
    answer: 'Izifo ezidla ngokubhaliswa kwi-CCMDD zezi: i-HIV (usela ii-ARV uzinzile, umthamo wentsholongwane egazini uphantsi), uxinzelelo lwegazi oluphezulu (hypertension) (uxinzelelo lwegazi lulawuleka), isifo seswekile (diabetes) (uHlobo 1 no-2, i-HbA1c izinzile), isifo sokuwa (epilepsy) (akukho kuwa usela amayeza), umbefu (asthma) (ulawuleka nge-inhaler), izifo zempilo yengqondo (uzinzile kumayeza engqondo), kunye ne-hypothyroidism. Nasiphi na isifo esiqhubekayo esifuna amayeza aphindaphindwayo singafaneleka ukuba uzinzile ngokwezonyango.',
  },
  {
    question: 'Ndibhalisa njani kwi-CCMDD?',
    answer: 'Awunakuzibhalisa ngokwakho. Umongikazi okanye ugqirha wasekliniki yakho kufuneka avavanye ukuba uzinzile kunyango aze akubhalise kwinkqubo ye-elektroniki ye-CCMDD. Kutyelelo lwakho olulandelayo lwasekliniki, buza umongikazi: "Ndiyafaneleka na kwi-CCMDD?" Ukuba uzinzile (idla ngokuba ziinyanga ezi-6-12 usenyangweni neempawu zilawuleka), baya kukubhalisa bakuncede ukhethe indawo yokulanda amayeza. Ukubhalisa kuthatha malunga nemizuzu eli-10.',
  },
  {
    question: 'Ndingayitshintsha indawo yam yokulanda amayeza?',
    answer: 'Ewe. Xelela ikliniki yakho kutyelelo lwakho olulandelayo lohlolo aze batshintshe indawo yakho yokulanda kwinkqubo. Izizathu eziqhelekileyo zokutshintsha: ukufudukela kwindawo entsha, ikhemesti elula ngakumsebenzi, okanye indawo yangoku inemigca emide. Utshintsho luqala ukusebenza kwixesha lakho elilandelayo lokulanda amayeza (idla ngokuba yinyanga elandelayo).',
  },
  {
    question: 'Kwenzeka ntoni ukuba andiwalandi amayeza am?',
    answer: 'Ukuba awulandi ngaphakathi kwexesha lokulanda (idla ngokuba ziintsuku ezi-5 zoshishino ukusuka kumhla wokuhanjiswa), amayeza abuyiselwa umva. Ikliniki iyaziswa kwaye umsebenzi wezempilo woluntu unokuqhagamshelana nawe. Ukuba uphoswa kukulanda kabini kulandelelana, unokususwa kwi-CCMDD kwaye kuya kufuneka ubuyele ekliniki uze ulande khona ude ubhaliswe kwakhona. Musa ukuvumela oku kwenzeke — ukuba awukwazi ukulanda, thumela ilungu losapho linencwadi esayinwe yemvume.',
  },
  {
    question: 'Ndisafuna ukuya ekliniki ukuba ndisebenzisa i-CCMDD?',
    answer: 'Ewe, kodwa ngamaxesha ambalwa kakhulu. Kufuneka ubuyele ekliniki rhoqo ngeenyanga ezi-6-12 (kuxhomekeka kwisifo sakho) ukuze uhlolwe ngokwezonyango: uvavanyo lwegazi, uhlolo lweempawu, kunye nokuhlaziywa kwencwadi yamayeza. I-appointment yasekliniki yeyokuba ugqirha okanye umongikazi ajonge ukuba unyango lwakho lusasebenza — into ebuywa yi-CCMDD kukulanda amayeza kwanyanga zonke.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'I-CCMDD — Ukulanda Amayeza Aqhubekayo Ngaphandle Komgca',
    description: 'Indlela esebenza ngayo inkqubo ye-Central Chronic Medicine Dispensing and Distribution eMzantsi Afrika: ukufaneleka, iindawo zokulanda, ukubhalisa.',
    url: 'https://clinicfinder.co.za/xh/guides/ccmdd-chronic-meds-pickup',
    publisher: { '@type': 'Organization', name: 'Clinic Finder SA' },
    author: { '@type': 'Organization', name: 'Clinic Finder SA' },
    datePublished: '2026-04-16',
    dateModified: '2026-05-14',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(faq => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    'name': 'Indlela Yokubhalisela Ukulanda Amayeza Aqhubekayo Kwi-CCMDD',
    'description': 'Fumana amayeza akho aqhubekayo kwindawo yokulanda elula endaweni yokuma emgceni ekliniki inyanga nenyanga.',
    'step': [
      {'@type': 'HowToStep', 'position': 1, 'name': 'Qinisekisa ukuba isifo sakho sizinzile', 'text': 'Kufuneka ube kunyango iinyanga ezi-6-12 neempawu ezilawulekayo — umthamo wentsholongwane egazini uphantsi kwi-HIV, uxinzelelo lwegazi olulawulekayo kwi-hypertension, i-HbA1c ezinzileyo kwisifo seswekile. Umongikazi okanye ugqirha wasekliniki yakho wenza olu hlolo kutyelelo olucwangcisiweyo.'},
      {'@type': 'HowToStep', 'position': 2, 'name': 'Buza umongikazi wakho wasekliniki ngokufaneleka kwi-CCMDD', 'text': 'Kutyelelo lwakho olulandelayo lwasekliniki, buza: "Ndiyafaneleka na kwi-CCMDD?" Umongikazi ujonga imbali yonyango lwakho nokuzinza kwakho. Ukuba uyafaneleka, bakubhalisa kwinkqubo ye-elektroniki ye-CCMDD — ukubhalisa kuthatha malunga nemizuzu eli-10.'},
      {'@type': 'HowToStep', 'position': 3, 'name': 'Khetha indawo yokulanda elula', 'text': 'Khetha kwiindawo zokulanda ezikhoyo kufuphi nawe: iikhemesti zabucala, amaziko oluntu, okanye iindawo zokulanda emsebenzini. Khetha ngokusekelwe kwimfuphi nekhaya okanye umsebenzi kunye namaxesha emigca. Ungayitshintsha indawo yakho yokulanda kamva nakuluphi na uhlolo olucwangcisiweyo lwasekliniki.'},
      {'@type': 'HowToStep', 'position': 4, 'name': 'Landa amayeza akho apakishwe kwangaphambili inyanga nenyanga', 'text': 'Amayeza akho apakishwa kwangaphambili kwikhemesti ephakathi aze athunyelwe kwindawo oyikhethileyo yokulanda. Landa ngaphakathi kwexesha leentsuku ezi-5 lokulanda. Ukuba awukwazi ukulanda, thumela ilungu losapho linencwadi yemvume esayiniweyo. Ukuphoswa kukulanda kabini kulandelelana kukususa kule nkqubo.'},
      {'@type': 'HowToStep', 'position': 5, 'name': 'Buyela ekliniki ukuze uhlolwe ngamaxesha athile', 'text': 'Yiya kuhlolo lonyango rhoqo ngeenyanga ezi-6-12 (kuxhomekeka kwisifo sakho) ukuze wenziwe uvavanyo lwegazi, uhlolo lweempawu, nokuhlaziywa kwencwadi yamayeza. I-CCMDD ithatha indawo yokulanda amayeza kwanyanga zonke, hayi indawo yokujongwa ngokwezonyango — uhlolo luqinisekisa ukuba unyango lwakho lusasebenza.'},
    ],
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Ikhaya', item: 'https://clinicfinder.co.za/xh' }, { '@type': 'ListItem', position: 2, name: 'Izikhokelo', item: 'https://clinicfinder.co.za/xh/guides' }, { '@type': 'ListItem', position: 3, name: 'CCMDD' }] },
];
---
<Base
  title="I-CCMDD — Ukulanda Amayeza Aqhubekayo Ngaphandle Komgca — Clinic Finder SA"
  description="Indlela esebenza ngayo inkqubo ye-CCMDD: landa amayeza aqhubekayo kwikhemesti okanye kwindawo yokulanda yoluntu endaweni yokuma emgceni ekliniki. Ukufaneleka, ukubhalisa, neendawo zokulanda."
  jsonLd={jsonLd}
>
  <div class="container" style="padding: 32px 0; max-width: 720px;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
      <a href={L('/')}>Ikhaya</a> &rsaquo; <a href={L('/guides')}>Izikhokelo</a> &rsaquo; Amayeza Aqhubekayo e-CCMDD
    </nav>

    <h1 style="font-size: 1.5rem; margin-bottom: 8px;">I-CCMDD — Ukulanda Amayeza Aqhubekayo Ngaphandle Komgca</h1>
    <p style="color: var(--text-muted); margin-bottom: 32px; line-height: 1.7;">
      Inkqubo ye-Central Chronic Medicine Dispensing and Distribution (CCMDD) yenye yeenkonzo ezibaluleke kakhulu — nezaziwa kancinci kakhulu — kwinkqubo yezempilo karhulumente yaseMzantsi Afrika. Ivumela izigulana ezizinzileyo ezinezifo eziqhubekayo ukuba zilande amayeza azo kwindawo yokulanda elula endaweni yokuma emgceni iiyure ekliniki inyanga nenyanga. Zingaphezu kwezigulana ezizizigidi ezingama-4.9 ezibhalisiweyo.
    </p>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Yintoni i-CCMDD?</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        I-CCMDD yinkqubo karhulumente epakisha kwangaphambili amayeza aqhubekayo kwikhemesti ephakathi ize iwathumele kwiindawo zokulanda zangaphandle kulo lonke ilizwe. Endaweni yokuhlala emgceni wasekliniki ulanda ezo pilisi zinye ozisela inyanga nenyanga, ungena kwikhemesti yabucala, iziko loluntu, okanye indawo emsebenzini ekufuphi nekhaya lakho uze ulande iphakethe lamayeza elitywiniweyo neliphawuliweyo.
      </p>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 8px;">
        Inkqubo yayiqale yenzelwe izigulana ze-HIV ezizinzileyo ezisela ii-ARV, kodwa yandiswe ukuze ibandakanye zonke izifo eziqhubekayo: uxinzelelo lwegazi oluphezulu (hypertension), isifo seswekile (diabetes), isifo sokuwa (epilepsy), umbefu (asthma), izifo zempilo yengqondo, nezinye. Isimahla — akukho nto uyihlawulayo kwindawo yokulanda.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Ngubani ofanelekayo?</h2>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-bottom: 12px;">
        Ungabhaliswa kwi-CCMDD ukuba uhlangabezana nazo zonke ezi mfuno:
      </p>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 8px;">
        <li><strong>Ukunyangwa kwisifo esiqhubekayo iinyanga ezi-6-12</strong> (kuxhomekeka kwisifo)</li>
        <li><strong>Uzinzile ngokwezonyango</strong> — isifo sakho silawuleka. Kwi-HIV: umthamo wentsholongwane egazini uphantsi. Kwi-hypertension: uxinzelelo lwegazi lukwinqanaba elifunekayo. Kwisifo seswekile: i-HbA1c ilawuleka.</li>
        <li><strong>Akukho tshintsho lomthamo weyeza kwiinyanga ezi-3 ezidlulileyo</strong></li>
        <li><strong>Akukho nkxalabo ngokubambelela kunyango</strong> — ubusoloko ulanda amayeza rhoqo</li>
      </ol>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 12px;">
        Umongikazi okanye ugqirha wakho wenza isigqibo sokugqibela. Ukuba wenqatshiwe, buza ukuba yintoni omawuyenze ukuze ufaneleke — idla ngokuba ngumba wokuzinza iinyanga ezimbalwa ezongezelelweyo.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Iintlobo zeendawo zokulanda</h2>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-bottom: 12px;">
        I-CCMDD isebenza ngothungelwano lweendawo zokulanda zangaphandle ezingaphezu kwe-3,000 kulo lonke uMzantsi Afrika:
      </p>
      <div style="display: grid; gap: 12px;">
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <strong style="color: var(--primary-dark);">Iikhemesti zabucala</strong>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.5;">Clicks, Dis-Chem, neekhemesti ezizimeleyo. Yeyona ndawo yokulanda iqhelekileyo. Ulanda kwikhawuntara yamayeza njengakuyo nayiphi na enye incwadi yamayeza — usokhemesti uqinisekisa isazisi sakho aze akunike iphakethe elitywiniweyo.</p>
        </div>
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <strong style="color: var(--primary-dark);">Iiklabhu zoluntu zokubambelela kunyango</strong>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.5;">Amaqela ezigulana ezingama-25-30 ahlangana kwindawo yoluntu (iholo yecawa, ithala leencwadi, igumbi elisecaleni kwekliniki) ukuze alande amayeza kunye. Umlungiselelo usasaza amaphakethe. Kubandakanya nohlolo olufutshane lwempilo nenkxaso yoontanga.</p>
        </div>
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <strong style="color: var(--primary-dark);">Ukulanda ngokukhawuleza ekliniki</strong>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.5;">Kwizigulana ezikhetha ikliniki yazo kodwa zifuna ukutsiba umgca. Amaphakethe e-CCMDD afika epakishwe kwangaphambili — uya kwifestile ekhethekileyo ye-CCMDD, uqinisekise isazisi sakho, uze uhambe. Akukho kulinda ikhemesti ilungiselele amayeza.</p>
        </div>
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <strong style="color: var(--primary-dark);">Emsebenzini nakwezinye iindawo</strong>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.5;">Abanye abaqeshi abakhulu neeyunivesithi banazo iindawo zokulanda ze-CCMDD. Ulanda ngamaxesha omsebenzi, akukho mfuneko yokutyelela ikliniki. Buza i-ofisi yezempilo yasemsebenzini ukuba oku luyafumaneka na.</p>
        </div>
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Indlela yokubhaliswa</h2>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 8px;">
        <li><strong>Kutyelelo lwakho olulandelayo lwasekliniki</strong>, xelela umongikazi ukuba ufuna ukujoyina i-CCMDD.</li>
        <li>Umongikazi ujonga ukuzinza kwakho ngokwezonyango esebenzisa ifayile yakho neziphumo zegazi zamva nje.</li>
        <li>Ukuba uyafaneleka, bakubhalisa kwinkqubo ye-elektroniki ye-CCMDD (kuthatha malunga nemizuzu eli-10).</li>
        <li>Ukhetha indawo oyithandayo yokulanda kuluhlu lweendawo ezikhoyo.</li>
        <li>Amayeza akho alungiselelwa kwindawo ephakathi aze athunyelwe kwindawo oyikhethileyo phambi komhla wakho olandelayo wokulanda.</li>
        <li>Ufumana i-SMS xa iphakethe lakho lilungile. Landa ngaphakathi kweentsuku ezi-5 zoshishino.</li>
      </ol>
    </section>

    <section style="background: var(--bg-alt); border-radius: var(--radius); padding: 20px; margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 12px; color: var(--primary-dark);">Kutheni oku kubalulekile</h2>
      <p style="font-size: 0.95rem; line-height: 1.7;">
        Phambi kwe-CCMDD, izigulana ezinezifo eziqhubekayo zazichitha umyinge <strong>weeyure ezi-4-8 ngenyanga</strong> ekliniki zilande nje amayeza afanayo azisela inyanga nenyanga. Abantu abaninzi — ingakumbi abo basebenza imisebenzi ehlawulwa ngeyure — bayeka ukulanda kuba bengakwazi ukulahlekelwa ngumvuzo wosuku inyanga nenyanga. Oku kwakhokelela ekuphazamisekeni konyango, ekumelaneni namayeza (ingakumbi kwi-HIV nakwi-TB), nakwiintlekele zokufa ebezinokuthintelwa.
      </p>
      <p style="font-size: 0.95rem; line-height: 1.7; margin-top: 8px;">
        I-CCMDD inciphisa ixesha lokulanda ukuya <strong>ngaphantsi kwemizuzu eli-15</strong>. Amazinga okubambelela kunyango kwizigulana ze-CCMDD aphezulu ngokuphawulekayo kunakwizigulana ezisebenzisa ikliniki kuphela. Ukuba uyafaneleka, ukubhalisa yenye yezona zinto zibalulekileyo onokuzenzela impilo yakho yexesha elide.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Ukusombulula iingxaki eziqhelekileyo ze-CCMDD</h2>
      <div style="display: grid; gap: 12px;">
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <strong style="color: var(--primary-dark);">"Iphakethe lam belingekho kwindawo yokulanda"</strong>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.6;">Ukulibaziseka kokuhanjiswa kuyenzeka, ingakumbi ekupheleni kwenyanga. Kuqala jonga i-SMS yakho — kufuneka iqinisekise umhla wokuhanjiswa. Ukuba iphakethe lilahlekile ngokwenene, qhagamshelana neziko leefowuni ze-CCMDD (0800 242 243) unenombolo yakho yesazisi. Okwangoku, yiya kwikliniki obhaliswe kuyo — banokukunika amayeza angxamisekileyo kwikhemesti yabo ngoxa ingxaki isombululwa.</p>
        </div>
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <strong style="color: var(--primary-dark);">"Ikhemesti ithi andikho kwinkqubo"</strong>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.6;">Oku kudla ngokuthetha ukuba ukubhalisa kwakho akuphumelelanga kakuhle okanye uhlolo lwakho lonyango selidlulile ixesha (inkqubo iyabacima ngokuzenzekelayo izigulana ezidlulwe ngumhla wohlolo). Buyela kwikliniki obhaliswe kuyo unesazisi sakho nekhadi eliluhlaza. Umongikazi unokujonga imeko yakho ye-CCMDD aze akubhalise kwakhona ukuba kuyafuneka.</p>
        </div>
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <strong style="color: var(--primary-dark);">"Ndiyahamba kwaye andikwazi ukulanda kwindawo yam eqhelekileyo"</strong>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.6;">Amaphakethe e-CCMDD athunyelwa kwindawo yakho yokulanda obhaliswe kuyo kuphela. Ukuba uza kuba ungekho, landa kwangaphambili phambi kokuba uhambe. Ukuba uphoswa lixesha lokulanda, yiya nakuyiphi na ikliniki karhulumente kwindawo oyityeleleyo — chaza ukuba usisigulana se-CCMDD baze bakunike amayeza angxamisekileyo. Hamba nekhadi lakho eliluhlaza nesazisi xa uhamba.</p>
        </div>
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <strong style="color: var(--primary-dark);">"Kufuneka omnye umntu andilandele"</strong>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.6;">Ilungu losapho okanye umntu omthembayo unokulanda egameni lakho. Bafuna: isazisi sakho (okanye ikopi), esabo isazisi, nencwadi esayinwe nguwe ebavumela ukuba balande. Ezinye iindawo zokulanda zamkela umnxeba ovela kuwe ukuqinisekisa. Qhagamshelana nendawo yakho yokulanda kwangaphambili ukuqinisekisa iimfuno zabo zokulandelwa ngomnye umntu.</p>
        </div>
      </div>
    </section>

    <section style="background: var(--primary-light); border-radius: var(--radius); padding: 20px; margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 8px; color: var(--primary-dark);">Fumana ikliniki yamayeza aqhubekayo</h2>
      <p style="font-size: 0.9rem; margin-bottom: 12px;">
        Amaziko angu-{chronicClinics.length} kwidatabhesi yethu anikezela ngeenkonzo zamayeza aqhubekayo. Buza nge-CCMDD kutyelelo lwakho olulandelayo.
      </p>
      <a href="/services/chronic-medication" class="btn btn--primary" style="font-size: 0.9rem;">Khangela iikliniki zamayeza aqhubekayo</a>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px;">Imibuzo Ebuzwa Rhoqo</h2>
      <div style="display: grid; gap: 12px;">
        {faqs.map(faq => (
          <details style="border: 1px solid var(--border); border-radius: var(--radius);">
            <summary style="cursor: pointer; font-weight: 600; font-size: 0.95rem; padding: 14px; list-style: none; display: flex; justify-content: space-between; align-items: center;">
              {faq.question}
              <span style="color: var(--text-muted); flex-shrink: 0; margin-left: 12px;">+</span>
            </summary>
            <div style="padding: 0 14px 14px; font-size: 0.9rem; color: var(--text-muted); line-height: 1.7;">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <section style="border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; font-size: 0.85rem; color: var(--text-muted); line-height: 1.6;">
      <strong style="color: var(--text);">Imithombo:</strong> CCMDD Implementation Framework (National Department of Health, 2018). Differentiated Service Delivery models for HIV — SA adaptation. CCMDD monthly statistics — NDoH quarterly reports. Right to Care — CCMDD operational guidelines.
    </section>
      <section style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border);">
