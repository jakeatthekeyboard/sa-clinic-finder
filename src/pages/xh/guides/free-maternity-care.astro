---
/**
 * isiXhosa — inguqulelo yesivakalisi-nge-sivakalisi ye src/pages/guides/free-maternity-care.astro
 */
import Base from '../../../layouts/Base.astro';
import { facilities } from '../../../data/helpers';
import { localePath } from '../../../i18n/config';

const L = (p: string) => localePath(p, 'xh');

const maternityClinics = facilities.filter(f => f.services.maternity_antenatal);

const faqs = [
  {
    question: 'Kufuneka ndiye nini kutyelelo lwam lokuqala lwangaphambi kokubeleka (antenatal)?',
    answer: 'Kwangoko kangangoko unako — okona kulungileyo phambi kweeveki eziyi-12 zokukhulelwa. Ukubhalisa kwangoko kuvumela ikliniki ukuba ifumanise ukukhulelwa okunomngcipheko omkhulu (ukukhulelwa ngaphandle kwesibeleko, i-pre-eclampsia, i-HIV, ukusweleka kwegazi), iqale i-folic acid, kwaye icwangcise ukhathalelo lwakho. UMzantsi Afrika ucebisa ubuncinane utyelelo lwe-antenatal olusi-8 luphela. Ungabhalisa nakuyiphi na ikliniki karhulumente enikeza iinkonzo zokubeleka.',
  },
  {
    question: 'Ngaba ukubeleka esibhedlele sikarhulumente kusimahla ngokwenene?',
    answer: 'Ewe. Ukubeleka esibhedlele sikarhulumente okanye kwiyunithi yababelekisi (midwife obstetric unit, MOU) kusimahla kubo bonke abafazi, nokuba ungowaliphi na ilizwe okanye unayo na i-medical aid. Oku kubandakanya ukubeleka okuqhelekileyo, ukubeleka okuncediswayo, kunye nokuhlinzwa (caesarean section) ukuba kuyafuneka ngokwezonyango. Ekuphela kwexesha ekuhlawulwa ngalo kukuba ukhetha iwadi yabucala (apho ikhoyo) okanye ungumntu ongahlaliyo apha ofuna iinkonzo ozikhethelayo.',
  },
  {
    question: 'Ngaba ndingazikhethela apho ndiza kubelekela khona?',
    answer: 'Ukukhulelwa okunomngcipheko omncinci kujongwa kwiiyunithi zababelekisi (MOUs) okanye kwizibhedlele zesithili ezikufuphi nekhaya lakho. Ukukhulelwa okunomngcipheko omkhulu (amawele, i-pre-eclampsia, i-HIV eneengxaki, ukuhlinzwa kwangaphambili) kuthunyelwa kwizibhedlele zengingqi okanye ezikhulu. Awunakukhetha isibhedlele esingafanelekanga kumgangatho womngcipheko wakho, kodwa ungacela indawo ethile ekumgangatho ofanayo. Thetha ngeenketho zakho nomongikazi wakho we-antenatal.',
  },
  {
    question: 'Kuthekani ukuba ndiphila nentsholongwane kagawulayo (HIV-positive) ndikhulelwe?',
    answer: 'Bonke abafazi abakhulelweyo bayavavanywa i-HIV kutyelelo lokuqala lwe-antenatal. Ukuba unayo, ii-ARV ziqalwa ngoko nangoko (kuqalwa ngayo loo mini). Inkqubo ye-PMTCT yoMzantsi Afrika (Prevention of Mother-to-Child Transmission) yehlise ukudluliselwa kusana kwafika ngaphantsi kwe-1% xa oomama besemayezeni. Usana lwakho luya kufumana idosi ye-ARV yokukhusela ekuzalweni kwaye luvavanywe ekuzalweni, kwiiveki eziyi-10, nakwiinyanga eziyi-18. Ukuncancisa kuyacetyiswa — ii-ARV zenza ubisi lwebele lukhuseleke.',
  },
  {
    question: 'Ngaba kukho into ekufuneka ndize nayo esibhedlele xa ndisiya kubeleka?',
    answer: 'Yiza: nencwadi yakho yokubeleka (incwadi eluhlaza, maternity case record), isazisi okanye ipasipoti, izinto zokuhlamba, iimpahla zangaphantsi ezi-2-3, ii-pads (zokopha okuninzi), ilokhwe yokulala okanye iimpahla ezikhululekileyo, iimpahla zokugoduka zakho, nezosana: iivesti ezi-2, oosuti bokulala aba-2, ingubo, iinapkeni, nomnqwazi. Isibhedlele sinika ukutya nezinto zonyango ezisisiseko. Musa ukuza nezinto ezixabisekileyo.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Ukhathalelo Lwasimahla Lokukhulelwa Ezibhedlele Zikarhulumente eMzantsi Afrika',
    description: 'Yonke into abafazi abakhulelweyo abanokuyifumana simahla kwiikliniki zikarhulumente zoMzantsi Afrika: ukhathalelo lwangaphambi kokubeleka, ukubeleka, inkxaso emva kokubeleka.',
    url: 'https://clinicfinder.co.za/xh/guides/free-maternity-care',
    publisher: { '@type': 'Organization', name: 'Clinic Finder SA' },
    author: { '@type': 'Organization', name: 'Clinic Finder SA' },
    datePublished: '2026-04-16',
    dateModified: '2026-05-14',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(faq => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'Indlela Yokufumana Ukhathalelo Lwasimahla Lokukhulelwa Esibhedlele Sikarhulumente eMzantsi Afrika',
    description: 'Inkqubo yamanyathelo ama-5 ukusuka kutyelelo lokuqala lwangaphambi kokubeleka ukuya ekubelekeni nakukhathalelo emva kokubeleka — konke kusimahla kumaziko karhulumente.',
    step: [
      { '@type': 'HowToStep', position: 1, name: 'Bhalisa utyelelo lwakho lokuqala lwangaphambi kokubeleka phambi kweeveki eziyi-12', text: 'Yiya kwikliniki karhulumente ekufuphi nawe enikeza iinkonzo zokubeleka/ze-antenatal kwangoko kangangoko unako — okona kulungileyo phambi kweeveki eziyi-12 zokukhulelwa. Ukubhalisa kwangoko kuvumela ikliniki ukuba ifumanise iimeko ezinomngcipheko omkhulu (ukukhulelwa ngaphandle kwesibeleko, i-pre-eclampsia, i-HIV, ukusweleka kwegazi), iqale i-folic acid, kwaye icwangcise ukhathalelo lwakho. Yiza nesazisi sakho nazo naziphi na iirekhodi zokukhulelwa kwangaphambili. Akukho appointment ifunekayo.' },
      { '@type': 'HowToStep', position: 2, name: 'Yiya kutyelelo lwe-antenatal olungaphantsi kwesi-8', text: 'Izikhokelo zoMzantsi Afrika zicebisa ubuncinane utyelelo lwe-antenatal olusi-8 ngexesha lokukhulelwa. Kutyelelo ngalunye: kujongwa uxinzelelo lwegazi, uvavanyo lomchamo, ukubetha kwentliziyo yosana nokukhula kwalo, kunye novavanyo lwe-HIV ne-syphilis (kutyelelo lokuqala). Ufumana incwadi yokubeleka (incwadi eluhlaza, maternity case record) — yiza nayo kutyelelo ngalunye nasesibhedlele xa usiya kubeleka. Lonke utyelelo lusimahla.' },
      { '@type': 'HowToStep', position: 3, name: 'Yazi iziko lakho lokubelekela', text: 'Ukukhulelwa okunomngcipheko omncinci kubelekelwa kwiyunithi yababelekisi (MOU) okanye kwisibhedlele sesithili esikufuphi nekhaya lakho. Ukukhulelwa okunomngcipheko omkhulu (amawele, i-pre-eclampsia, i-HIV eneengxaki, ukuhlinzwa kwangaphambili) kuthunyelwa kwizibhedlele zengingqi okanye ezikhulu. Umongikazi wakho we-antenatal uya kukuxelela apho umawuye khona ngokusekelwe kumgangatho womngcipheko wakho. Bhalisa kwiziko lakho lokubelekela phambi komhla wakho wokubeleka ukuze babe neerekhodi zakho.' },
      { '@type': 'HowToStep', position: 4, name: 'Yiya esibhedlele xa uqala ukubeleka', text: 'Yiya kwiziko lakho elimiselweyo xa iinimba zisiza rhoqo (yonke imizuzu emi-5 ngeyure) okanye xa amanzi eqhawuka. Yiza: nencwadi yokubeleka, isazisi, izinto zokuhlamba, ii-pads, iimpahla zangaphantsi zokutshintsha, iimpahla ezikhululekileyo, kwaye nezosana — iivesti ezi-2, oosuti bokulala aba-2, ingubo, iinapkeni, nomnqwazi. Ukubeleka kusimahla kubo bonke abafazi, kubandakanya nokuhlinzwa (caesarean section) ukuba kuyafuneka ngokwezonyango.' },
      { '@type': 'HowToStep', position: 5, name: 'Buya utyelele emva kokubeleka kwiintsuku ezi-3, kwiiveki ezi-6, nakwiinyanga ezi-6', text: 'Emva kokubeleka, buyela ekliniki kwiintsuku ezi-3 (okanye ngaphakathi kweveki yokuqala) ukuze wena nosana nijongwe, kwiiveki ezi-6 kuhlolwe konke, nakwiinyanga ezi-6. Utyelelo lweeveki ezi-6 lubalulekile: lubandakanya izitofu zokugonya zosana (ithimetheybhile ye-EPI-SA yeeveki ezi-6), iingcebiso zocwangciso losapho, novavanyo lwe-HIV kusana ukuba umama ephila nentsholongwane. Lonke ukhathalelo emva kokubeleka lusimahla.' },
    ],
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Ikhaya', item: 'https://clinicfinder.co.za/xh' }, { '@type': 'ListItem', position: 2, name: 'Izikhokelo', item: 'https://clinicfinder.co.za/xh/guides' }, { '@type': 'ListItem', position: 3, name: 'Ukhathalelo Lwasimahla Lokukhulelwa Ezibhedlele Zikarhulumente' }] },
];
---
<Base
  title="Ukhathalelo Lwasimahla Lokukhulelwa Ezibhedlele Zikarhulumente — Clinic Finder SA"
  description="Isikhokelo esipheleleyo sokhathalelo lwasimahla lokukhulelwa nokubeleka eMzantsi Afrika: utyelelo lwe-antenatal, ukubeleka esibhedlele, ukhathalelo emva kokubeleka, i-PMTCT, nento omawuze nayo."
  jsonLd={jsonLd}
>
  <div class="container" style="padding: 32px 0; max-width: 720px;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
      <a href={L('/')}>Ikhaya</a> &rsaquo; <a href={L('/guides')}>Izikhokelo</a> &rsaquo; Ukhathalelo Lwasimahla Lokukhulelwa
    </nav>

    <h1 style="font-size: 1.5rem; margin-bottom: 8px;">Ukhathalelo Lwasimahla Lokukhulelwa Ezibhedlele Zikarhulumente</h1>
    <p style="color: var(--text-muted); margin-bottom: 32px; line-height: 1.7;">
      Wonke umfazi okhulelweyo eMzantsi Afrika unelungelo lokufumana simahla ukhathalelo lwangaphambi kokubeleka (antenatal care), ukubeleka, kunye nenkxaso emva kokubeleka kumaziko empilo karhulumente. Akufuneki i-medical aid. Esi sikhokelo sichaza into onokuyilindela ukusuka kutyelelo lwakho lokuqala ekliniki ukuya ekugoduseni usana lwakho.
    </p>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Ukhathalelo lwangaphambi kokubeleka (antenatal care)</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Bhalisa utyelelo lwakho lokuqala lwe-antenatal kwangoko kangangoko unako — phambi kweeveki eziyi-12 kokona kulungileyo. Kutyelelo lokuqala, umongikazi uya:
      </p>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 6px; margin-top: 8px;">
        <li>Aqinisekise ukukhulelwa aze aqikelele umhla wakho wokubeleka</li>
        <li>Ajonge uxinzelelo lwegazi lakho, ubunzima bakho, nomchamo</li>
        <li>Athathe igazi ukuvavanya i-HIV, i-syphilis, ukusweleka kwegazi, nohlobo lwegazi</li>
        <li>Aqalise i-folic acid nezongezelelo zentsimbi (iron)</li>
        <li>Akunike incwadi yokubeleka (incwadi eluhlaza, maternity case record) — yiza nayo kutyelelo ngalunye</li>
        <li>Ahlole izinto ezinomngcipheko aze akuthumele esibhedlele ukuba kuyafuneka</li>
      </ol>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 12px;">
        UMzantsi Afrika ucebisa <strong>ubuncinane utyelelo lwe-antenatal olusi-8</strong>: nyanga nganye kude kube ziiveki eziyi-28, emva koko rhoqo ngeeveki ezi-2 kude kube ziiveki eziyi-36, emva koko veki nganye kude kubelekwe. Utyelelo ngalunye lujonga ukukhula kosana, uxinzelelo lwegazi lakho, kwaye luvavanya iingxaki ezinjenge-pre-eclampsia neswekile yokukhulelwa (gestational diabetes).
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Apho uza kubelekela khona</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Apho ubelekela khona kuxhomekeka kumgangatho womngcipheko wokukhulelwa kwakho:
      </p>
      <div style="margin-top: 12px; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;">
        <div style="display: grid; grid-template-columns: 1fr 2fr; font-size: 0.9rem;">
          <div style="padding: 12px; background: var(--primary-light); font-weight: 600; border-bottom: 1px solid var(--border);">Umngcipheko omncinci</div>
          <div style="padding: 12px; border-bottom: 1px solid var(--border); line-height: 1.6;">IYunithi Yababelekisi (Midwife Obstetric Unit, MOU) okanye isibhedlele sesithili. Isebenza ngababelekisi. Ijongana nokubeleka okuqhelekileyo. Ukuba kuvela iingxaki xa ubeleka, uthuthelwa esibhedlele.</div>
          <div style="padding: 12px; background: var(--primary-light); font-weight: 600; border-bottom: 1px solid var(--border);">Umngcipheko ophakathi</div>
          <div style="padding: 12px; border-bottom: 1px solid var(--border); line-height: 1.6;">Isibhedlele sesithili esinoogqirha abakhoyo. Sijongana nokubeleka okuncediswayo (vacuum/forceps) nokuhlinzwa okuthile. Uthunyelwa apha ukuba une-pre-eclampsia, usana luhleli ngempumlo (breech), okanye uhlinzwe ngaphambili.</div>
          <div style="padding: 12px; background: var(--primary-light); font-weight: 600;">Umngcipheko omkhulu</div>
          <div style="padding: 12px; line-height: 1.6;">Isibhedlele sengingqi okanye esikhulu. Sinamaziko apheleleyo otyando, i-ICU, nokhathalelo olunzulu lwabantwana abasandul' ukuzalwa. Kwabakhulelwe abantwana abaninzi, i-pre-eclampsia ebuhlungu kakhulu, i-placenta praevia, nokubeleka kwangaphambi kwexesha.</div>
        </div>
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Into omawuyipakishe uye esibhedlele</h2>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 8px;">
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <strong style="font-size: 0.95rem; color: var(--primary-dark);">Eyakho</strong>
          <ol style="padding-left: 16px; font-size: 0.9rem; line-height: 1.6; margin-top: 8px; display: grid; gap: 4px;">
            <li>Incwadi yokubeleka (incwadi eluhlaza)</li>
            <li>Isazisi okanye ipasipoti</li>
            <li>Ilokhwe yokulala okanye iimpahla ezikhululekileyo</li>
            <li>Iimpahla zangaphantsi ezi-2-3 zokutshintsha</li>
            <li>Ii-pads zokopha okuninzi</li>
            <li>Izinto zokuhlamba</li>
            <li>Iimpahla zokugoduka ezikhululekileyo</li>
            <li>Ukutya okuncinci namanzi</li>
          </ol>
        </div>
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <strong style="font-size: 0.95rem; color: var(--primary-dark);">Eyosana</strong>
          <ol style="padding-left: 16px; font-size: 0.9rem; line-height: 1.6; margin-top: 8px; display: grid; gap: 4px;">
            <li>Iivesti ezi-2 zomqhaphu</li>
            <li>Oosuti bokulala aba-2 (babygrows)</li>
            <li>Umnqwazi ofudumeleyo</li>
            <li>Ingubo yokwamkela usana</li>
            <li>Iinapkeni zosana olusandul' ukuzalwa</li>
            <li>Iimpahla zokugoduka</li>
          </ol>
        </div>
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Emva kokubeleka — ukhathalelo emva kokubeleka</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Emva kokubeleka okuqhelekileyo, uya kuhlala esibhedlele iiyure ezi-6-24. Emva kokuhlinzwa (caesarean section), lindela iintsuku ezi-3-4. Phambi kokuba ukhutshwe, umongikazi uya:
      </p>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 6px; margin-top: 8px;">
        <li>Ajonge ukuba usana lutya kakuhle na (inkxaso yokuncancisa iyafumaneka)</li>
        <li>Anike usana i-BCG (isitofu se-TB) nesitofu se-polio esiselwayo — izitofu zokuqala ezibini</li>
        <li>Anike incwadi ye-Road to Health yosana (irekhodi yezitofu nokukhula)</li>
        <li>Amisele utyelelo emva kokubeleka ngaphakathi kweentsuku ezi-3-6</li>
        <li>Athethe ngeenketho zocwangciso losapho</li>
      </ol>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 12px;">
        Kufuneka ubuyele ekliniki ngaphakathi kweentsuku ezi-6 emva kokubeleka, uze ubuye kwakhona kwiiveki ezi-6. Utyelelo lweeveki ezi-6 lubalulekile: umongikazi ujonga ukuchacha kwakho, ukukhula kosana, uqhubeka nezitofu zokugonya, kwaye angafumanisa kwangethuba ukudandatheka emva kokubeleka (postnatal depression). Musa ukulutsiba olu tyelelo.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px;">Ukukhulelwa Okunomngcipheko Omkhulu — Xa Ufumana Ukhathalelo Olongezelelweyo</h2>
      <p style="font-size: 0.9rem; line-height: 1.7; color: var(--text-muted); margin-bottom: 12px;">Iimeko ezithile zikususa kuKhathalelo Olusisiseko lwe-Antenatal (utyelelo lwe-4-8) zikuse kwindlela enzulu ngakumbi. Usisi wasekliniki uzifumanisa ezi meko kutyelelo lwakho lokuqala lokubhalisa aze akuthumele kwikliniki ye-ANC esesibhedlele.</p>
      <div style="overflow-x: auto; margin-bottom: 16px;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem;">
          <thead><tr style="border-bottom: 2px solid var(--border);">
            <th style="text-align: left; padding: 10px 8px;">Into Enomngcipheko</th>
            <th style="text-align: left; padding: 10px 8px;">Kwenzeka Ntoni</th>
          </tr></thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">Uphila nentsholongwane kagawulayo (HIV-positive)</td><td style="padding: 8px;">I-ART ukusuka kutyelelo lokuqala (umgaqo we-PMTCT), i-viral load kwiinyanga ezi-3 nakwiiveki eziyi-36, usana luvavanywe ekuzalweni nakwiiveki eziyi-10</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">Uxinzelelo lwegazi oluphezulu / i-pre-eclampsia</td><td style="padding: 8px;">Ukujongwa kwe-BP rhoqo ngeeveki ezi-2, ukujongwa kweprotheyini emchameni, ukubeleka kucwangciswe kwiiveki eziyi-37-38 ukuba kubuhlungu kakhulu</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">Iswekile (yokukhulelwa okanye ebikho ngaphambili)</td><td style="padding: 8px;">Ukujongwa kweglucose, ukuthunyelwa kwingcali yokutya, i-insulin ukuba kuyafuneka, ukubeleka kwiiveki eziyi-38-39</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">Ukuhlinzwa kwangaphambili (caesarean section)</td><td style="padding: 8px;">Ubhaliswe kwisibhedlele sesithili, uhlolelwe ukuzama ukubeleka ngokwendalo okanye ukuhlinzwa okucwangcisiweyo kwakhona</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">Umntwana okwishumi elivisayo (ngaphantsi kweminyaka eli-18)</td><td style="padding: 8px;">Uvavanyo lwenkonzo yezentlalo, inkxaso yokutya, isicwangciso sokubuyela esikolweni</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">Ngaphezu kweminyaka engama-35 okanye usana lokuqala ungaphezu kwama-40</td><td style="padding: 8px;">Ii-scan ezongezelelweyo zokukhula, ukucwangcisa ukubeleka kwangaphambili ukuba kuyafuneka</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px;">Iimpawu Zongxamiseko Ngexesha Lokukhulelwa</h2>
      <p style="font-size: 0.9rem; line-height: 1.7; color: var(--text-muted); margin-bottom: 12px;">Yiya kwiwadi yokubeleka yesibhedlele esikufuphi nawe (hayi ekliniki) ngoko nangoko ukuba unayo nayiphi na kwezi zinto. Musa ukulinda i-appointment.</p>
      <div style="display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div style="border: 1px solid var(--border); border-left: 3px solid #c0392b; border-radius: var(--radius); padding: 16px;">
          <div style="font-weight: 600; margin-bottom: 8px; color: #c0392b;">Phambi kokubeleka</div>
          <ol style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.7; padding-left: 1.2rem; margin: 0;">
            <li>Ukopha esithweni sangasese (nokuba kuncinci kangakanani)</li>
            <li>Intloko ebuhlungu kakhulu nokungaboni kakuhle okanye ukubona amachaphaza</li>
            <li>Ukudumba ngequbuliso kobuso nezandla</li>
            <li>Usana olungashukumiyo iiyure eziyi-12+ (emva kweeveki eziyi-28)</li>
            <li>Amanzi aqhawuka phambi kweeveki eziyi-37</li>
            <li>Umkhuhlane ongaphezu kwe-38°C nomzimba obuhlungu</li>
          </ol>
        </div>
