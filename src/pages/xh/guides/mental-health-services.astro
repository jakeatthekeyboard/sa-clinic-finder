---
/**
 * isiXhosa mental health guide — sentence-for-sentence translation of
 * src/pages/guides/mental-health-services.astro.
 * Slugs stay English (they are the join key for hreflang and the language switcher).
 */
import Base from '../../../layouts/Base.astro';
import { facilities } from '../../../data/helpers';
import { localePath } from '../../../i18n/config';

const L = (p: string) => localePath(p, 'xh');

const mhClinics = facilities.filter(f => f.services.mental_health);

const faqs = [
  {
    question: 'Ndingaya ekliniki ngokudandatheka (depression) ngaphandle kwencwadi yokuthunyelwa?',
    answer: 'Ewe. Ungangena nakuyiphi na ikliniki karhulumente uze uxelele umongikazi ukuba unengxaki yempilo yengqondo. Akufuneki incwadi yokuthunyelwa, ukufunyaniswa kwesifo, okanye isizathu esithile — ukuziva ungxwelerhekile, ukungakwazi ukulala, ukungakwazi ukusebenza emsebenzini, okanye ukuziva ungenathemba zonke zizizathu ezivumelekileyo zokufuna uncedo. Umongikazi uza kwenza uhlolo lokuqala aze akunyange ekliniki okanye akuthumele kwingcali yengqondo (psychologist) okanye kugqirha wengqondo (psychiatrist).',
  },
  {
    question: 'Ngaba unyango lwempilo yengqondo lusimahla?',
    answer: 'Ewe. Impilo yengqondo ibandakanyiwe phantsi kwezempilo esisiseko eMzantsi Afrika. Ukubonana nogqirha, amayeza (achasene nokudandatheka, achasene noxinzelelo lwengqondo, ne-antipsychotic), nocebiso lwengqondo kumaziko karhulumente zisimahla. Unyango lweengcali zengqondo kwinqanaba lesibhedlele lunokuba neentlawulo ezisekelwe kwingeniso yakho, kodwa unyango kwinqanaba lekliniki esisiseko luhlala lusimahla.',
  },
  {
    question: 'Ngawaphi amayeza endinokuwafumana ekliniki?',
    answer: 'Iikliniki zezempilo esisiseko zinokubhala: i-fluoxetine (i-SSRI yohlobo lwe-Prozac yokudandatheka noxinzelelo lwengqondo), i-amitriptyline (yokudandatheka, iintlungu eziqhubekayo, nokungalali), kunye ne-haloperidol okanye i-risperidone (yokuphambana kwengqondo). Ezi zibandakanya izifo eziqhelekileyo. Ukuba isifo sakho sifuna iyeza lengcali, ikliniki iya kukuthumela kugqirha wengqondo wesibhedlele sesithili onoluhlu olubanzi lwamayeza.',
  },
  {
    question: 'Ndingalufumana ucebiso, hayi amayeza kuphela?',
    answer: 'Ewe. Iikliniki ezininzi ngoku zinokufikelela kubacebisi bezithethi-ntlanganiso okanye kwiingcali zengqondo ngenkqubo edibeneyo yezempilo ezikolweni okanye ngamaqela empilo yengqondo esithili. Umgangatho nokufumaneka kwahluka ngokwephondo — iGauteng neWestern Cape zinezona zibonelelo zininzi. Ukuba ikliniki yakho ayinikezeli ngocebiso, cela ukuthunyelwa kwiziko lezempilo loluntu elikufuphi okanye kwisibhedlele sesithili esinesebe lezengqondo.',
  },
  {
    question: 'Kwenzeka ntoni ukuba umntu ukwingxaki engxamisekileyo yempilo yengqondo?',
    answer: 'Ukuba umntu uyingozi kuye okanye kwabanye: tsalela u-10111 (SAPS) okanye u-10177 (i-ambulensi). Mse kwiyunithi engxamisekileyo evulekileyo iiyure ezingama-24 ekufuphi — ungalindi i-appointment yekliniki. Phantsi koMthetho woNyango lweMpilo yeNgqondo (Mental Health Care Act), umntu okwingxaki engxamisekileyo unokungeniswa iiyure ezingama-72 ukuze abukelwe ahlolwe kwiziko lengqondo elimiselweyo. Ilungu losapho, ilungu le-SAPS, okanye ingcali yezempilo inokuqalisa ukungeniswa ngaphandle kwemvume ukuba umntu uyalile uncedo kodwa esengozini ngokucacileyo.',
  },
];

const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Indlela yokufumana iinkonzo zempilo yengqondo kwiziko likarhulumente eMzantsi Afrika',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Ngena nakuyiphi na ikliniki karhulumente — akukho ncwadi yokuthunyelwa efunekayo',
      text: 'Yiya kwikliniki karhulumente yezempilo esisiseko ekufuphi nawe ngamaxesha okusebenza (idla ngoku-07:30-16:00 ngeentsuku zeveki). Xelela unobhala okanye umongikazi ukuba ufuna ukuthetha nomntu ngempilo yakho yengqondo. Akukho i-appointment, incwadi yokuthunyelwa, okanye ukufunyaniswa kwesifo okufunekayo — ukuziva ungxwelerhekile, ukungakwazi ukulala, okanye ukungakwazi ukusebenza zonke zizizathu ezivumelekileyo. Phatha isazisi sakho saseMzantsi Afrika.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Gqiba uhlolo lwempilo yengqondo',
      text: 'Umongikazi uza kukusa kwigumbi labucala aze asebenzise izixhobo zokuhlola ezimiselweyo — uluhlu lwemibuzo lwe-PHQ-9 lokudandatheka kunye ne-GAD-7 yoxinzelelo lwengqondo. Phendula ngokunyaniseka; akukho zimpendulo ziphosakeleyo. Uhlolo luthatha malunga nemizuzu eli-15-20 kwaye lunceda umongikazi ahlole ubunzima besifo sakho aze agqibe ngenqanaba elifanelekileyo lonyango.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Fumana amayeza kunye/okanye ucebiso ekliniki',
      text: 'Ukuba uhlolo lubonisa ukudandatheka okanye uxinzelelo lwengqondo, umongikazi okanye ugqirha unokubhala amayeza kwangaloo mini — idla ngokuba yi-fluoxetine (i-SSRI) yokudandatheka noxinzelelo lwengqondo, okanye i-amitriptyline yokudandatheka okunokungalali. Onke amayeza empilo yengqondo kwiikliniki zikarhulumente asimahla. Ukuba abacebisi bezithethi-ntlanganiso okanye iingcali zengqondo bakhona ekliniki (kwahluka ngokwephondo — iGauteng neWestern Cape zinezona zininzi), uya kubhaliselwa iiseshoni zocebiso.',
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Yiya kwii-appointment zokubuya ukuze kujongwe inkqubela',
      text: 'Buyela ekliniki njengoko kucwangcisiwe — idla ngokuba rhoqo kwiiveki ezi-2-4 ekuqaleni, emva koko nyanga zonke xa sele uzinzile. Umongikazi uza kuphinda asebenzise izixhobo zokuhlola ukulandela inkqubela yakho aze alungise amayeza ukuba kuyafuneka. Abantu abaninzi babona ukuphucuka ngaphakathi kweeveki ezi-4-6 emva kokuqala amayeza. Unyango luqhubeka ubuncinci iinyanga ezili-12 emva kokuba iimpawu ziphelile. Ungayeki amayeza ungathethanga nomongikazi okanye ugqirha wakho.',
    },
    {
      '@type': 'HowToStep',
      position: 5,
      name: 'Thunyelwa kwingcali ukuba kuyafuneka',
      text: 'Ukuba isifo sakho sifuna ngaphezu konyango lwekliniki esisiseko, umongikazi uya kukuthumela phezulu: kuqala kwiziko lezempilo loluntu okanye kwisibhedlele sesithili (ingcali yengqondo, umongikazi wengqondo, uluhlu olubanzi lwamayeza), emva koko kugqirha wengqondo wesibhedlele sengingqi ukuba kuyafuneka. Kwingxaki engxamisekileyo yempilo yengqondo — ingozi kuwe okanye kwabanye — yiya ngqo kwiyunithi engxamisekileyo evulekileyo iiyure ezingama-24 okanye utsalele i-SADAG ku-0800 567 567 (simahla, 24/7).',
    },
  ],
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Iinkonzo Zempilo Yengqondo Kwiikliniki Zikarhulumente eMzantsi Afrika',
    description: 'Apho ungafumana khona uncedo ngokudandatheka, uxinzelelo lwengqondo, i-PTSD, nokusetyenziswa gwenxa kweziyobisi kwinkqubo yezempilo karhulumente yaseMzantsi Afrika.',
    url: 'https://clinicfinder.co.za/xh/guides/mental-health-services',
    publisher: { '@type': 'Organization', name: 'Clinic Finder SA' },
    author: { '@type': 'Organization', name: 'Clinic Finder SA' },
    datePublished: '2026-04-16',
    dateModified: '2026-05-14',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(faq => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
  howToLd,
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Ikhaya', item: 'https://clinicfinder.co.za/xh' }, { '@type': 'ListItem', position: 2, name: 'Izikhokelo', item: 'https://clinicfinder.co.za/xh/guides' }, { '@type': 'ListItem', position: 3, name: 'Iinkonzo Zempilo Yengqondo Kwiikliniki Zikarhulumente' }] },
];
---
<Base
  title="Iinkonzo Zempilo Yengqondo Kwiikliniki Zikarhulumente — Clinic Finder SA"
  description="Apho ungafumana khona uncedo ngokudandatheka, uxinzelelo lwengqondo, i-PTSD, nokusetyenziswa gwenxa kweziyobisi kwinkqubo yezempilo karhulumente yaseMzantsi Afrika. Unyango simahla, into omawuyilindele, nezibonelelo zengxaki engxamisekileyo."
  jsonLd={jsonLd}
>
  <div class="container" style="padding: 32px 0; max-width: 720px;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
      <a href={L('/')}>Ikhaya</a> &rsaquo; <a href={L('/guides')}>Izikhokelo</a> &rsaquo; Iinkonzo Zempilo Yengqondo
    </nav>

    <h1 style="font-size: 1.5rem; margin-bottom: 8px;">Iinkonzo Zempilo Yengqondo Kwiikliniki Zikarhulumente</h1>
    <p style="color: var(--text-muted); margin-bottom: 32px; line-height: 1.7;">
      Omnye kwabathathu baseMzantsi Afrika uya kuba nesifo sempilo yengqondo ebomini bakhe, kodwa ngaphantsi kwe-25% abafumana unyango. Iikliniki zikarhulumente zingakunceda — ukudandatheka (depression), uxinzelelo lwengqondo (anxiety), i-PTSD, nokusetyenziswa gwenxa kweziyobisi zonke zinyangwa simahla. Esi sikhokelo sicacisa okufumanekayo nendlela yokukufumana.
    </p>

    <section style="background: #fef3cd; border-radius: var(--radius); padding: 20px; margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 8px; color: #856404;">Ingxaki engxamisekileyo? Fumana uncedo ngoku</h2>
      <div style="font-size: 0.95rem; line-height: 1.7; color: #856404;">
        <p><strong>Umnxeba we-SADAG:</strong> 0800 567 567 (simahla, 24/7)</p>
        <p><strong>Umnxeba wengxaki yokuzibulala:</strong> 0800 567 567</p>
        <p><strong>Umnxeba we-SMS:</strong> 31393 (Cipla 24/7)</p>
        <p><strong>Ungxamiseko:</strong> 10177 (i-ambulensi) okanye 10111 (SAPS)</p>
        <p style="margin-top: 8px;">Ukuba wena okanye umntu omaziyo usengozini ngoku, yiya <a href="/services/emergency" style="color: #856404; font-weight: 600;">kwiziko elingxamisekileyo elivulekileyo iiyure ezingama-24</a> elikufuphi.</p>
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Onokukufumana kwikliniki esisiseko</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Iikliniki zikarhulumente lilo icango lokungena kunyango lwempilo yengqondo eMzantsi Afrika. Ekliniki, ungafumana:
      </p>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 8px; margin-top: 8px;">
        <li><strong>Uhlolo novavanyo</strong> — umongikazi usebenzisa izixhobo ezimiselweyo (i-PHQ-9 yokudandatheka, i-GAD-7 yoxinzelelo lwengqondo) ukuhlola isifo sakho</li>
        <li><strong>Amayeza</strong> — amayeza achasene nokudandatheka (fluoxetine, amitriptyline), amayeza oxinzelelo lwengqondo, kunye nama-antipsychotic asisiseko ayafumaneka kwinqanaba lekliniki</li>
        <li><strong>Ucebiso</strong> — ucebiso olusisiseko lwenkxaso oluvela kubacebisi abaqeqeshiweyo (ukufumaneka kwahluka ngokwephondo)</li>
        <li><strong>Ukuthunyelwa</strong> — kwingcali yengqondo, kugqirha wengqondo, okanye kwisibhedlele sengqondo ukuba isifo sakho sifuna unyango lwengcali</li>
        <li><strong>Incwadi yokugula</strong> — yokuphumla emsebenzini ngenxa yempilo yengqondo (ukudandatheka, uxinzelelo lwengqondo, nokudinwa ngokugqithisileyo zizifo zonyango ezisemthethweni)</li>
      </ol>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Indlela yokucela uncedo</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Ngena nakuyiphi na ikliniki karhulumente. Akufuneki i-appointment. Xelela unobhala okanye umongikazi ukuba ufuna ukuthetha nomntu ngempilo yakho yengqondo. Ukuba kunzima ukuyithetha ngomlomo, ungayibhala ephepheni: "Ndifuna uncedo ngempilo yam yengqondo" — uze ulinike umongikazi.
      </p>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 8px;">
        Umongikazi uza kukusa kwigumbi labucala. Akukho ndlela iphosakeleyo yokuchaza into oyivayo. Izinto eziqhelekileyo abazithethayo abantu kutyelelo lokuqala:
      </p>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 4px; margin-top: 8px; color: var(--text-muted);">
        <li>"Andikwazi ukulala kwaye andikwazi ukuyeka ukukhathazeka"</li>
        <li>"Ndiziva ngathi andikwazi ukuvuka ebhedini okanye ndenze nantoni na"</li>
        <li>"Ndisela kakhulu kwaye ndifuna ukuyeka"</li>
        <li>"Ndisoloko ndinemibono ebuyayo / amaphupha amabi"</li>
        <li>"Andiziva ndinguye mna kwaye andiyazi ukuba kutheni"</li>
      </ol>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 12px;">
        Zonke ezi zizizathu ezivumelekileyo zokufuna uncedo. Umongikazi akazukukugweba.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Izifo eziqhelekileyo ezinyangwayo</h2>
      <div style="display: grid; gap: 12px;">
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <strong style="color: var(--primary-dark);">Ukudandatheka (depression)</strong>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.5;">Ukuhlala ubuhlungu entliziyweni, ukulahlekelwa ngumdla, ukudinwa, ukungakwazi ukugxila, utshintsho kumdla wokutya okanye ekulaleni. Unyango: amayeza e-SSRI (idla ngokuba yi-fluoxetine) + ucebiso. Abantu abaninzi bayaphucuka kakhulu ngaphakathi kweeveki ezi-4-6 emva kokuqala amayeza.</p>
        </div>
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <strong style="color: var(--primary-dark);">Izifo zoxinzelelo lwengqondo (anxiety)</strong>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.5;">Ukukhathazeka rhoqo, ukothuka ngequbuliso, uloyiko lokuba phakathi kwabantu, ukoyika izinto ezithile. Unyango: amayeza e-SSRI, maxa wambi ii-benzodiazepine zexesha elifutshane kwintlekele yokothuka, neendlela zokucinga nokuziphatha ezivela kumcebisi.</p>
        </div>
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <strong style="color: var(--primary-dark);">Uxinzelelo emva kwentlekele (PTSD)</strong>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.5;">Imibono ebuyayo, amaphupha amabi, ukusoloko ulindele ingozi, ukungabi navakalelo emva kwentlekele (ubundlobongela, ingozi, uhlaselo, intlekele). Iqhelekile kakhulu eMzantsi Afrika — kuqikelelwa ukuba abantu abazizigidi ezi-3.5 baphila ne-PTSD. Unyango: ucebiso olujolise kwintlekele + amayeza okulala neempawu ezingenayo engqondweni.</p>
        </div>
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <strong style="color: var(--primary-dark);">Izifo zokusetyenziswa gwenxa kweziyobisi</strong>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 4px; line-height: 1.5;">Utywala, intsangu, i-methamphetamine (tik), i-heroin (nyaope), nokusetyenziswa gwenxa kwamayeza abhalwe ngugqirha. Iikliniki zinokuqalisa unyango zize zithumele kwiinkqubo zokulungisa zoluntu. Ukulaliswa kwiziko lokulungisa kwinkqubo karhulumente kufuna incwadi yokuthunyelwa evela kunontlalontle okanye ekliniki.</p>
        </div>
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Indlela yokuthunyelwa</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Ukuba isifo sakho sifuna ngaphezu koko ikliniki inokukunika kona, umongikazi uya kukuthumela phezulu:
      </p>
      <div style="margin-top: 12px; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;">
        <div style="display: grid; grid-template-columns: auto 1fr; font-size: 0.9rem;">
          <div style="padding: 12px; background: var(--primary-light); font-weight: 600; border-bottom: 1px solid var(--border);">Inqanaba 1</div>
          <div style="padding: 12px; border-bottom: 1px solid var(--border); line-height: 1.6;"><strong>Ikliniki esisiseko</strong> — uhlolo, amayeza asisiseko, ucebiso lwabacebisi abaqeqeshiweyo, ukuthunyelwa</div>
          <div style="padding: 12px; background: var(--primary-light); font-weight: 600; border-bottom: 1px solid var(--border);">Inqanaba 2</div>
          <div style="padding: 12px; border-bottom: 1px solid var(--border); line-height: 1.6;"><strong>Iziko lezempilo loluntu / isibhedlele sesithili</strong> — ingcali yengqondo, umongikazi wengqondo, uluhlu olubanzi lwamayeza</div>
          <div style="padding: 12px; background: var(--primary-light); font-weight: 600; border-bottom: 1px solid var(--border);">Inqanaba 3</div>
          <div style="padding: 12px; border-bottom: 1px solid var(--border); line-height: 1.6;"><strong>Isibhedlele sengingqi</strong> — ugqirha wengqondo, ukulaliswa esibhedlele, iinkqubo ezikhethekileyo (izifo zokutya, ukufunyaniswa kwezifo ezimbini)</div>
          <div style="padding: 12px; background: var(--primary-light); font-weight: 600;">Inqanaba 4</div>
          <div style="padding: 12px; line-height: 1.6;"><strong>Isibhedlele esiphezulu / sengqondo</strong> — iimeko ezinzima, unyango lwengqondo lwezomthetho, ukulungiswa kwexesha elide</div>
        </div>
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Amalungelo akho emsebenzini</h2>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-bottom: 12px;">
        Izifo zempilo yengqondo zaziwa njengokukhubazeka phantsi komthetho waseMzantsi Afrika. Oku kuthetha ukuba umqeshi wakho unemisebenzi ethile:
      </p>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 6px;">
        <li><strong>Awunakugxothwa ngenxa yokuba unesifo sempilo yengqondo.</strong> Ukudandatheka, uxinzelelo lwengqondo, i-PTSD, nesifo se-bipolar zonke zizifo ezikhuselweyo phantsi koMthetho woLingano kwezeNgqesho (Employment Equity Act). Ukugxothwa ngezi zizathu akulunganga ngokuzenzekelayo.</li>
        <li><strong>Unelungelo lokuphumla ngenxa yokugula.</strong> Impilo yengqondo sisizathu sonyango esisemthethweni sokuphumla ngenxa yokugula. Umongikazi okanye ugqirha wasekliniki unokunika incwadi yokugula. Umqeshi wakho akanakufuna ukwazi ukuba isifo sakho sithini — kuphela ukuba ubungakwazi ukusebenza ngokwezonyango.</li>
        <li><strong>Ulungiselelo olufanelekileyo.</strong> Ukuba isifo sakho sisesexesha elide, umqeshi wakho kufuneka enze ulungiselelo olufanelekileyo: amaxesha aguqukayo, umsebenzi omncinci ngamaxesha okugula, indawo yokusebenza ethuleyo, okanye ixesha lokuya kwii-appointment zonyango.</li>
        <li><strong>Iinkqubo Zoncedo Lwabasebenzi (EAPs).</strong> Abaqeshi abaninzi abaphakathi nabakhulu banikezela ngocebiso lwasimahla noluyimfihlo nge-EAP — buza kwa-HR. Iiseshoni ze-EAP zidla ngokuba zizi-6-8 kwingxaki nganye, zenziwa ziingcali zengqondo ezibhalisiweyo, kwaye zizodwa kunyango lwakho lwasekliniki.</li>
        <li><strong>Isibonelelo sokukhubazeka sexeshana.</strong> Ukuba isifo sakho sempilo yengqondo sikuthintela ukuba usebenze kwaphela, unokufaneleka kwisibonelelo sokukhubazeka sexeshana (R2,190/ngenyanga ngo-2026). Faka isicelo kwa-SASSA unengxelo yonyango evela kugqirha wakho wengqondo okanye kugqirha okunyangayo.</li>
      </ol>
    </section>

    <section style="margin-bottom: 32px;">
