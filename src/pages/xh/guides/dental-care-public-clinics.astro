---
/**
 * isiXhosa — sentence-for-sentence translation of src/pages/guides/dental-care-public-clinics.astro.
 * Slugs stay English (they are the join key for hreflang and the language switcher).
 */
import Base from '../../../layouts/Base.astro';
import { facilities } from '../../../data/helpers';
import { localePath } from '../../../i18n/config';

const L = (p: string) => localePath(p, 'xh');

const dentalClinics = facilities.filter(f => f.services.dental);

const faqs = [
  {
    question: 'Lusimahla na unyango lwamazinyo kwiikliniki zikarhulumente?',
    answer: 'Ewe, kodwa kukho imida. Unyango lwamazinyo olungxamisekileyo (ukukhutshwa kwezinyo, ukukhutshwa kobovu, iintlungu ezimandundu) lusimahla kuzo zonke iikliniki zamazinyo zikarhulumente nakumacandelo amazinyo ezibhedlele. Unyango lokuthintela nolokulungisa (ukuvalwa kwamazinyo, ukucocwa, amazinyo okufakela) nalo lusimahla apho lukhoyo, kodwa uluhlu lokulinda lunokuba ziinyanga ubude. Iinkqubo ezinzima (i-root canal, iikrawuni, iibhulorho, ukutyalwa kwamazinyo) ngokubanzi azifumaneki kwinkqubo karhulumente — ungadinga ugqirha wamazinyo wabucala kwezi.',
  },
  {
    question: 'Ndifuna i-appointment yamazinyo?',
    answer: 'Kwiintlungu zamazinyo ezingxamisekileyo: iikliniki nezibhedlele ezininzi zamkela abantu abangenayo i-appointment, kodwa kunokufuneka ufike kwakusasa kakhulu (phambi kwe-07:00) kuba amathuba amazinyo agcwala ngokukhawuleza. Kunyango lwamazinyo oluqhelekileyo: ewe, ngokuqhelekileyo ufuna i-appointment. Cela unobhala wekliniki akufake kuluhlu lokulinda lwamazinyo. Amaxesha okulinda ayahluka ukusuka kwiiveki ukuya kwiinyanga kuxhomekeka kwiziko nakwiphondo.',
  },
  {
    question: 'Ingaba abantwana bangalufumana unyango lwamazinyo kwiikliniki zikarhulumente?',
    answer: 'Ewe. Abantwana babekwa phambili kwiinkonzo zamazinyo zikarhulumente. Uhlolo lwamazinyo ezikolweni lwenziwa nge-Integrated School Health Programme (ISHP), kodwa alufikeleli kuzo zonke iindawo. Nawuphi na umntwana angalufumana unyango lwamazinyo olungxamisekileyo kwikliniki karhulumente. Kunyango lokuthintela (i-fissure sealants, ukufakwa kwe-fluoride, ukuvalwa kwamazinyo), yisa umntwana wakho kwicandelo lamazinyo lekliniki — abantwana ngokuqhelekileyo babonwa ngokukhawuleza kunabantu abadala.',
  },
  {
    question: 'Kuthekani ngamazinyo okufakela?',
    answer: 'Amazinyo okufakela apheleleyo nangaphelelanga ayafumaneka kwamanye amaziko amazinyo karhulumente, kodwa amaxesha okulinda made — rhoqo ziinyanga ezi-6-18. Inkqubo: (1) uhlolo lwamazinyo kunye nokukhutshwa kwamazinyo ukuba kufuneka, (2) ixesha lokuphola (ngokuqhelekileyo iinyanga ezi-3-6 emva kokukhutshwa kwamazinyo), (3) ukuthathwa komlinganiso nokwenziwa kwamazinyo okufakela, (4) ukufakwa nokulungiswa. Kubekwa phambili izigulana ezingakwaziyo ukutya kakuhle. Ayingawo onke amaziko anazo iinkonzo zamazinyo okufakela — buza kwiziko lezempilo loluntu okanye kwicandelo lamazinyo lesibhedlele.',
  },
];

const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Indlela yokufumana unyango lwamazinyo kwikliniki karhulumente eMzantsi Afrika',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Fumana iziko elineenkonzo zamazinyo',
      text: 'Ayingayo yonke ikliniki yokuqala enesitulo samazinyo. Khangela iziko lezempilo loluntu (CHC), icandelo lamazinyo lesibhedlele sesithili, okanye isibhedlele sokuqeqesha oogqirha bamazinyo (esidibene neeyunivesithi zaseWits, Pretoria, UWC, UKZN, Sefako Makgatho, okanye Limpopo). Sebenzisa i-Clinic Finder ukukhangela amaziko anikeza unyango lwamazinyo kwindawo yakho.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Fika kwangethuba nesazisi sakho nekhadi lekliniki',
      text: 'Kwiintlungu zamazinyo ezingxamisekileyo (izinyo elibuhlungu kakhulu, ubovu, izinyo elaphukileyo), yiya kwiziko ungabhukishanga phambi kwe-07:00 — amathuba amazinyo agcwala ngokukhawuleza kwaye iikliniki ezininzi zisebenza ngo-07:30-16:00. Yiza nesazisi sakho saseMzantsi Afrika nekhadi lekliniki (ikhadi eliluhlaza). Kunyango olungangxamisekanga, fowunela iziko kuqala ukuze ufakwe kuluhlu lokulinda lwamazinyo.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Uhlolwe ngugqirha oncedisayo wamazinyo okanye ngugqirha wamazinyo',
      text: 'Ugqirha oncedisayo wamazinyo, ugcini-mpilo womlomo, okanye ugqirha wamazinyo uya kuhlola amazinyo akho, athathe ii-X-ray ukuba kufuneka, aze agqibe ukuba lolamnyango lufunekayo. Izigulana ezingxamisekileyo (iintlungu, ukudumba, usulelo) zibekwa phambili. Kunyango oluqhelekileyo olunjengokuvalwa kwamazinyo okanye ukucocwa, unokubhukishelwa i-appointment yokulandela.',
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Fumana unyango — ukukhutshwa kwezinyo, ukuvalwa, okanye ukuthunyelwa kwamazinyo okufakela',
      text: 'Ukukhutshwa kwezinyo okungxamisekileyo nokukhutshwa kobovu ngokuqhelekileyo kwenziwa ngosuku olunye. Ukuvalwa kwamazinyo okusisiseko nokucocwa kwamazinyo kunokwenziwa ngoko nangoko okanye kwi-appointment ebhukishiweyo. Kumazinyo okufakela, inkqubo ithatha utyelelo oluninzi ngeenyanga ezi-6-18: uhlolo, ukukhutshwa kwamazinyo, ixesha lokuphola, ukuthathwa komlinganiso, ukwenziwa, nokufakwa. Lonke unyango kumaziko karhulumente lusimahla.',
    },
    {
      '@type': 'HowToStep',
      position: 5,
      name: 'Landela uze uqhubeke nonyango lokuthintela',
      text: 'Emva konyango, landela imiyalelo yokuzinyamekela (ungahlambi umlomo iiyure ezingama-24 emva kokukhutshwa kwezinyo, gqiba wonke amayeza okubulala intsholongwane owanikiweyo). Ukuze amazinyo akho ahlale ephilile, xukuxa kabini ngosuku ngentlama yamazinyo ene-fluoride, unciphise iswekile phakathi kwezidlo, uze ubuye ujongwe nyaka ngamnye. Abantwana kufuneka basiwe kunyango lokuthintela (i-fissure sealants, ukufakwa kwe-fluoride) — ngokuqhelekileyo babonwa ngokukhawuleza kunabantu abadala kwiikliniki zamazinyo zikarhulumente.',
    },
  ],
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Ukufumana Unyango Lwamazinyo Kwikliniki Karhulumente eMzantsi Afrika',
    description: 'Zeziphi iinkonzo zamazinyo ezifumanekayo kwiikliniki zikarhulumente eMzantsi Afrika: ukukhutshwa kwamazinyo ngokungxamiseka, ukuvalwa kwamazinyo, amazinyo okufakela, nendlela yokuzifumana.',
    url: 'https://clinicfinder.co.za/xh/guides/dental-care-public-clinics',
    publisher: { '@type': 'Organization', name: 'Clinic Finder SA' },
    author: { '@type': 'Organization', name: 'Clinic Finder SA' },
    datePublished: '2026-04-16',
    dateModified: '2026-05-14',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(faq => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
  howToLd,
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Ikhaya', item: 'https://clinicfinder.co.za/xh' }, { '@type': 'ListItem', position: 2, name: 'Izikhokelo', item: 'https://clinicfinder.co.za/xh/guides' }, { '@type': 'ListItem', position: 3, name: 'Unyango Lwamazinyo Kwiikliniki Zikarhulumente' }] },
];
---
<Base
  title="Unyango Lwamazinyo Kwiikliniki Zikarhulumente — Clinic Finder SA"
  description="Zeziphi iinkonzo zamazinyo ezifumanekayo kwiikliniki zikarhulumente eMzantsi Afrika: ukukhutshwa kwamazinyo ngokungxamiseka, ukuvalwa kwamazinyo, amazinyo okufakela, unyango lwamazinyo abantwana, nendlela yokuzifumana."
  jsonLd={jsonLd}
>
  <div class="container" style="padding: 32px 0; max-width: 720px;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
      <a href={L('/')}>Ikhaya</a> &rsaquo; <a href={L('/guides')}>Izikhokelo</a> &rsaquo; Unyango Lwamazinyo
    </nav>

    <h1 style="font-size: 1.5rem; margin-bottom: 8px;">Unyango Lwamazinyo Kwiikliniki Zikarhulumente</h1>
    <p style="color: var(--text-muted); margin-bottom: 32px; line-height: 1.7;">
      UMzantsi Afrika unokunqongophala okumandundu kweenkonzo zamazinyo zikarhulumente — malunga nogqirha wamazinyo omnye kubantu abali-10,000 kwicandelo likarhulumente, xa kuthelekiswa nomnye kubantu abangama-2,000 kwicandelo labucala. Kodwa unyango lwamazinyo lwasimahla lukhona. Esi sikhokelo sichaza into ekhoyo, indlela yokuyifumana, nento omawuyilindele.
    </p>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Zeziphi iinkonzo zamazinyo ezikhoyo?</h2>
      <div style="display: grid; gap: 12px;">
        <div style="border-left: 4px solid var(--primary); padding: 12px 16px; background: var(--primary-light); border-radius: 0 var(--radius) var(--radius) 0;">
          <strong style="color: var(--primary-dark);">Ziyafumaneka kwiikliniki zamazinyo ezininzi</strong>
          <ol style="padding-left: 16px; font-size: 0.9rem; margin-top: 4px; line-height: 1.6; display: grid; gap: 2px;">
            <li>Ukukhutshwa kwezinyo (ukutsalwa kwamazinyo)</li>
            <li>Ukukhutshwa kobovu</li>
            <li>Ukudanjiswa kweentlungu ngokungxamiseka</li>
            <li>Ukuvalwa kwamazinyo okusisiseko (i-amalgam okanye i-composite)</li>
            <li>Ukucocwa nokupolishwa kwamazinyo</li>
            <li>Imfundo yempilo yomlomo</li>
          </ol>
        </div>
        <div style="border-left: 4px solid #fd7e14; padding: 12px 16px; background: #fff8f0; border-radius: 0 var(--radius) var(--radius) 0;">
          <strong style="color: #e65100;">Ziyafumaneka kwamanye amaziko (ukulinda okude)</strong>
          <ol style="padding-left: 16px; font-size: 0.9rem; margin-top: 4px; line-height: 1.6; display: grid; gap: 2px;">
            <li>Amazinyo okufakela apheleleyo nangaphelelanga</li>
            <li>I-fissure sealants yabantwana</li>
            <li>Ukufakwa kwe-fluoride</li>
            <li>Ukulungiswa kwamazinyo okusisiseko (iimeko ezimandundu kuphela)</li>
          </ol>
        </div>
        <div style="border-left: 4px solid #dc3545; padding: 12px 16px; background: #fff5f5; border-radius: 0 var(--radius) var(--radius) 0;">
          <strong style="color: #dc3545;">Ngokubanzi AZIFUMANEKI kwicandelo likarhulumente</strong>
          <ol style="padding-left: 16px; font-size: 0.9rem; margin-top: 4px; line-height: 1.6; display: grid; gap: 2px;">
            <li>Unyango lwe-root canal</li>
            <li>Iikrawuni, iibhulorho, ii-veneer</li>
            <li>Ukutyalwa kwamazinyo</li>
            <li>Unyango lwamazinyo lokuhomba</li>
            <li>Ukwenziwa mhlophe kwamazinyo</li>
          </ol>
        </div>
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Umawuye phi</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Ayingayo yonke ikliniki yokuqala eneenkonzo zamazinyo. Unyango lwamazinyo lugxile:
      </p>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 8px; margin-top: 8px;">
        <li><strong>Kumaziko ezempilo oluntu (ii-CHC)</strong> — amaziko amakhulu anesitulo samazinyo nogqirha oncedisayo wamazinyo. Le yindawo yakho yokuqala ebhetele kwiimfuno zamazinyo eziqhelekileyo.</li>
        <li><strong>Kwizibhedlele zesithili nezengingqi</strong> — amacandelo amazinyo ezibhedlele ajongana neemeko ezinzima ngakumbi, amazinyo okufakela, nabantu abathunyelwe zii-CHC. Anokuba nabagcini-mpilo bomlomo noogqirha bamazinyo abaqeshiweyo.</li>
        <li><strong>Kwizibhedlele zokuqeqesha oogqirha bamazinyo</strong> — amaziko adibene nezikolo zamazinyo (Wits, Pretoria, Western Cape, KZN, Sefako Makgatho, Limpopo). La rhoqo anamaxesha okulinda amafutshane kuba abafundi bafuna izigulana. Unyango lujongwa ngoogqirha bamazinyo abanezidanga. Lusimahla.</li>
        <li><strong>Kwiiyunithi zamazinyo ezihambayo</strong> — amanye amaphondo aqhuba iikliniki zamazinyo ezihambayo ezityelela iindawo ezingafikelelwayo ngokujikelezayo. Buza ekliniki yakho ukuba ikho na iyunithi ehambayo esebenzela indawo yakho.</li>
      </ol>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Yintoni omawuyenze ngeentlungu zamazinyo ngoku</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Ukuba uneentlungu zamazinyo ezimandundu kwaye awukwazi ukuya ekliniki namhlanje:
      </p>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 6px; margin-top: 8px;">
        <li><strong>Sela i-ibuprofen (Nurofen) okanye i-paracetamol (Panado)</strong> — ziyafumaneka kuyo nayiphi na ikhemisti ngaphandle kwencwadi kagqirha. I-ibuprofen isebenza ngcono kwiintlungu zamazinyo kuba inciphisa ukudumba. Landela imiyalelo yesilinganiso ekwibhokisi.</li>
        <li><strong>Xukuxa ngamanzi ashushu anetyuwa</strong> — isiqingatha secephe letiyi letyuwa kwiglasi yamanzi ashushu. Xukuxa kancinci kwindawo ebuhlungu. Phinda rhoqo emva kweeyure ezi-2-3.</li>
        <li><strong>SUKUFAKA i-aspirin ngokuthe ngqo entsingeni</strong> — le yinto abantu abaninzi abayicingayo kodwa inokutshisa inyama yomlomo.</li>
        <li><strong>Yiya ekliniki kwangentseni ngomso</strong> — fika phambi kwe-07:00. Izigulana zamazinyo ezingxamisekileyo ngokuqhelekileyo zibonwa ngaphandle kwe-appointment kodwa amathuba agcwala ngokukhawuleza.</li>
        <li><strong>Ukuba iintlungu zihamba nokudumba, umkhuhlane, okanye ukusokola ukuphefumla/ukuginya</strong> — yiya kwigumbi longxamiseko lesibhedlele. Ubovu bamazinyo bunokusongela ubomi ukuba usulelo luyasasazeka.</li>
      </ol>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Izibhedlele zokuqeqesha oogqirha bamazinyo — ukulinda okufutshane, unyango lwasimahla</h2>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-bottom: 12px;">
        UMzantsi Afrika unezikolo zamazinyo ezithandathu ezidibene neeyunivesithi. Iikliniki zazo zoqeqesho zinyanga izigulana zikarhulumente simahla ngoxa abafundi bonyaka wokugqibela befunda phantsi kwenkathalelo ethe ngqo. Kuba abafundi bafuna iiyure zokusebenza nezigulana, amaxesha okulinda rhoqo mafutshane kunakwizibhedlele zikarhulumente — ingakumbi kwukuvalwa kwamazinyo, amazinyo okufakela, nokulungiswa kwamazinyo.
      </p>
      <div style="overflow-x: auto;">
        <table style="width: 100%; font-size: 0.88rem; border-collapse: collapse; line-height: 1.6;">
          <thead>
            <tr style="background: var(--bg-alt); text-align: left;">
              <th style="padding: 10px 12px; border-bottom: 2px solid var(--border);">Iyunivesithi</th>
              <th style="padding: 10px 12px; border-bottom: 2px solid var(--border);">Indawo</th>
              <th style="padding: 10px 12px; border-bottom: 2px solid var(--border);">Isibhedlele samazinyo</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 10px 12px;">University of the Witwatersrand</td><td style="padding: 10px 12px;">Johannesburg, Gauteng</td><td style="padding: 10px 12px;">Wits Oral Health Centre (Charlotte Maxeke campus)</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 10px 12px;">University of Pretoria</td><td style="padding: 10px 12px;">Pretoria, Gauteng</td><td style="padding: 10px 12px;">Oral and Dental Hospital, Bophelo Road</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 10px 12px;">University of the Western Cape</td><td style="padding: 10px 12px;">Cape Town, Western Cape</td><td style="padding: 10px 12px;">Tygerberg Oral Health Centre</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 10px 12px;">University of KwaZulu-Natal</td><td style="padding: 10px 12px;">Durban, KwaZulu-Natal</td><td style="padding: 10px 12px;">King Edward VIII Hospital dental department</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 10px 12px;">Sefako Makgatho Health Sciences University</td><td style="padding: 10px 12px;">Pretoria, Gauteng</td><td style="padding: 10px 12px;">Medunsa Oral Health Centre</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 10px 12px;">University of Limpopo</td><td style="padding: 10px 12px;">Mankweng, Limpopo</td><td style="padding: 10px 12px;">Mankweng Hospital dental unit</td></tr>
          </tbody>
        </table>
      </div>
      <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 8px; line-height: 1.6;">Ungangena nje okanye ufowunele unobhala wesikolo samazinyo ukubhukisha. Yiza nesazisi sakho nekhadi lekliniki. Unyango luthatha ixesha elide kunakugqirha wamazinyo wabucala (abafundi basebenza ngononophelo phantsi kwenkathalelo) kodwa umgangatho wonyango uphezulu — kwaye lusimahla.</p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Ukuthintela iingxaki zamazinyo</h2>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-bottom: 12px;">
        Iinkonzo zamazinyo zikarhulumente zixinene kakhulu. Ukuthintela kukusindisa ekungeneni kwiiluhlu ezinde zokulinda — nakwiintlungu ebezinokuphetywa.
      </p>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 6px;">
        <li><strong>Xukuxa kabini ngosuku ngentlama yamazinyo ene-fluoride.</strong> Intlama yamazinyo eyona itshiphu eShoprite okanye ePnP inayo i-fluoride — akufuneki uthenge eyona ibizayo. Tshintsha ibrashi yakho yamazinyo qho kwiinyanga ezi-3 okanye xa iinwele zayo sele zichithakele.</li>
        <li><strong>Nciphisa iswekile, ingakumbi phakathi kwezidlo.</strong> Ayikho kwinto yokuba utya iswekile engakanani — kukuba uyitya kangaphi. Ukusela iziselo ezinoswekile (icooldrink, ijusi, iti enoswekile) imini yonke kugcina amazinyo akho eseasidini rhoqo. Sela amanzi phakathi kwezidlo.</li>
        <li><strong>Sukusebenzisa amazinyo akho njengezixhobo.</strong> Ukuvula iibhotile, ukukrazula iipakethi, nokuqhekeza amandongomane ngamazinyo akho kubangela ukwaphuka okuphelela ekukhutshweni kwamazinyo.</li>
        <li><strong>Ukuba utshixiza amazinyo ebusuku,</strong> xelela ikliniki — le nto iqhelekile xa unoxinzelelo kwaye ekugqibeleni yaphula amazinyo. I-mouthguard elula (ayifumaneki kwiikliniki ezininzi zikarhulumente, kodwa iyafikeleleka nge-R200-R500 kugqirha wamazinyo wabucala) ithintela umonakalo obizayo.</li>
        <li><strong>Abantwana abangaphantsi kweminyaka emi-6:</strong> sebenzisa intlama yamazinyo elingana nembotyi uze ujonge xa bexukuxa. Amazinyo abantwana abalulekile — ukulahleka kwawo kwangethuba ngenxa yokubola kubangela ukuba amazinyo angunaphakade aphume egoso, into eyenza iingxaki ezinkulu ngakumbi kamva.</li>
      </ol>
    </section>

    <section style="background: var(--primary-light); border-radius: var(--radius); padding: 20px; margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 8px; color: var(--primary-dark);">Fumana ikliniki eneenkonzo zamazinyo</h2>
      <p style="font-size: 0.9rem; margin-bottom: 12px;">
        Amaziko angu-{dentalClinics.length} kuvimba wethu weenkcukacha anikeza unyango lwamazinyo.
      </p>
      <a href="/services/dental" class="btn btn--primary" style="font-size: 0.9rem;">Khangela iikliniki zamazinyo</a>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px;">Imibuzo Ebuzwa Rhoqo</h2>
      <div style="display: grid; gap: 12px;">
        {faqs.map(faq => (
          <details style="border: 1px solid var(--border); border-radius: var(--radius);">
            <summary style="cursor: pointer; font-weight: 600; font-size: 0.95rem; padding: 14px; list-style: none; display: flex; justify-content: space-between; align-items: center;">
