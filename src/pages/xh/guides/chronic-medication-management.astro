---
/**
 * isiXhosa chronic medication guide — sentence-for-sentence translation of
 * src/pages/guides/chronic-medication-management.astro.
 * Slugs stay English (they are the join key for hreflang and the language switcher).
 */
import Base from '../../../layouts/Base.astro';
import { facilities } from '../../../data/helpers';
import { localePath } from '../../../i18n/config';

const L = (p: string) => localePath(p, 'xh');

const chronicClinics = facilities.filter(f => f.services.chronic_medication);

const conditions = [
  {
    name: 'Uxinzelelo lwegazi oluphezulu (hypertension)',
    prevalence: 'Ichaphazela omnye kwabathathu kubantu abadala baseMzantsi Afrika. Ngunobangela ophambili westrowuk nesifo sentliziyo.',
    treatment: 'Amayeza (hydrochlorothiazide, amlodipine, enalapril), utshintsho lwendlela yokuphila (nciphisa ityuwa, zilolonge, ehlisa ubunzima bomzimba), ukujongwa rhoqo koxinzelelo lwegazi.',
    atClinic: 'Ukujongwa koxinzelelo lwegazi kutyelelo ngalunye. Uvavanyo lwegazi rhoqo ngeenyanga ezi-6-12 (ukusebenza kwezintso, i-cholesterol). Amayeza alungiswa ngokwezibalo ezifundiweyo. Injongo: ngaphantsi kwe-140/90.',
  },
  {
    name: 'Isifo seswekile (diabetes) (uHlobo 2)',
    prevalence: 'Sichaphazela abantu abazizigidi ezi-4.5 baseMzantsi Afrika. Sikhula ngokukhawuleza — sinxulumene nokutya, ukutyeba, nokuhlala ezidolophini.',
    treatment: 'I-Metformin (eyokuqala), i-glimepiride, i-insulin (ukuba amayeza aselwayo ayasilela). Ulawulo lokutya, ukuzilolonga, ukukhathalela iinyawo.',
    atClinic: 'Uvavanyo lweswekile egazini kunye ne-HbA1c rhoqo ngeenyanga ezi-3-6. Ukuthunyelwa kuhlolo lwamehlo minyaka le (ukuhlolwa kwe-diabetic retinopathy). Ukujongwa kweenyawo kutyelelo ngalunye. Ucebiso lwengcali yokutya apho lukhoyo.',
  },
  {
    name: 'Isifo sokuwa (epilepsy)',
    prevalence: 'Sichaphazela malunga nomnye kwabali-100 abantu. Sidla ngokunganyangwa ngokwaneleyo emaphandleni oMzantsi Afrika ngenxa yehlazo.',
    treatment: 'I-Sodium valproate, i-carbamazepine, okanye i-phenytoin. Kufuneka aselwe yonke imihla ngaphandle kokuphazamiseka — ukuyeka ngequbuliso kunokubangela ukuwa okubulalayo.',
    atClinic: 'Ukujongwa kwencwadi yokubhala ukuwa kutyelelo ngalunye. Ukujongwa komthamo weyeza egazini ukuba ukuwa akulawuleki. Ukuthunyelwa kwingcali yezengqondo neemithambo kwiimeko ezinzima. Ucebiso ngemiqathango yokuqhuba.',
  },
  {
    name: 'Umbefu (asthma)',
    prevalence: 'Uchaphazela abantu abazizigidi ezi-3.9 baseMzantsi Afrika. Awunyangwa ngokwaneleyo — izigulana ezininzi zisebenzisa kuphela ii-inhaler zoncedo olukhawulezayo.',
    treatment: 'I-beclomethasone ephefumlwayo (ethintelayo, yonke imihla) + i-salbutamol (edambisayo, xa kufuneka). Isixhobo se-spacer sandisa ukusebenza. I-theophylline eselwayo kwiimeko ezinzima.',
    atClinic: 'Ukujongwa kwendlela yokusebenzisa i-inhaler kutyelelo ngalunye (izigulana ezininzi zisebenzisa ii-inhaler ngendlela engachanekanga). Ukujongwa kwe-peak flow. Isicwangciso sombefu esibhaliweyo. Ukuchongwa kwezinto ezibangela umbefu nocebiso lokuziphepha.',
  },
  {
    name: 'Ukudandatheka (depression) / Uxinzelelo lwengqondo (anxiety) (oluqhubekayo)',
    prevalence: 'Omnye kwabathathu baseMzantsi Afrika unesifo sempilo yengqondo. Ukudandatheka noxinzelelo lwengqondo zezona ziqhelekileyo.',
    treatment: 'I-Fluoxetine (SSRI) kukudandatheka/uxinzelelo lwengqondo. I-Amitriptyline kukudandatheka okunokungalali okanye iintlungu eziqhubekayo. Ucebiso apho lukhoyo.',
    atClinic: 'Izixhobo zokuhlola i-PHQ-9 okanye i-GAD-7. Ukujongwa kwamayeza rhoqo ngeenyanga ezi-3 kunyaka wokuqala, emva koko rhoqo ngeenyanga ezi-6. Ukuthunyelwa kucebiso. Unyango luqhubeka ubuncinci iinyanga ezili-12 emva kokuba iimpawu ziphelile.',
  },
];

const faqs = [
  {
    question: 'Ndibhalisa njani njengesigulana esinesifo esiqhubekayo ekliniki?',
    answer: 'Xa ugqirha okanye umongikazi ekufumanisa unesifo esiqhubekayo aze aqalise unyango, ubhaliswa ngokuzenzekelayo kwinkqubo yekliniki yezigulana ezinezifo eziqhubekayo. Uya kunikwa umhla othile wokubuya (idla ngokuba nyanga zonke okanye rhoqo ngeenyanga ezi-3) kwaye amayeza akho aya kulungiselelwa ukuze uwalande ngaloo mhla. Emva kweenyanga ezi-6-12 zonyango oluzinzileyo, unokufaneleka kwi-CCMDD (ukulanda amayeza kwikhemesti endaweni yekliniki).',
  },
  {
    question: 'Ndingawafumana amayeza aqhubekayo nakuyiphi na ikliniki?',
    answer: 'Ubhaliswe "kwikliniki yasekhaya" ethile ephethe ifayile yakho. Ukuze uphinde ufumane amayeza aqhelekileyo, yiya kwikliniki yakho yasekhaya. Ukuba uyahamba okanye ufudukela kwindawo entsha, nayiphi na ikliniki karhulumente inokukunika amayeza angxamisekileyo enyanga enye. Ukuze ususe ifayile yakho ngokusisigxina, cela ikliniki yakho yangoku ilungiselele incwadi yokutshintsha uze uyise kwikliniki entsha. Ukutshintshwa kubandakanya yonke imbali yonyango lwakho.',
  },
  {
    question: 'Kwenzeka ntoni ukuba ikliniki iphelelwa ngamayeza am?',
    answer: 'Ukuphelelwa yimpahla kuyenzeka, ingakumbi kwiikliniki zasemaphandleni. Ukuba amayeza akho aphelile: (1) cela umongikazi akunike elinye iyeza kwiqela elinye lamayeza, (2) cela ukuthunyelwa kwikhemesti yesibhedlele esikufuphi, (3) qhagamshelana nosokhemesti wesithili (ikliniki kufuneka ibe nale nombolo) ukuze ufumane iziko elikufuphi elinamayeza. Ungaze uyeke nje ukusela amayeza aqhubekayo — ukuphazamisa unyango kunokuba yingozi.',
  },
  {
    question: 'Ngaba kufuneka ndisele amayeza aqhubekayo ngonaphakade?',
    answer: 'Kwizifo eziqhubekayo ezininzi — ewe. I-hypertension, isifo seswekile, isifo sokuwa, ne-HIV ziyalawulwa, aziphiliswa. Ukuyeka amayeza kukhokelela ekubuyeni kwesifo, kudla ngokuba kubi ngakumbi kunangaphambili. Owahlukileyo kukudandatheka — emva kweenyanga ezingaphezu kweli-12 zemvakalelo ezinzileyo usela amayeza, ugqirha wakho unokuwunciphisa kancinci umthamo ukuze abone ukuba iimpawu ziyahlala zingekho na. Ungaze uyeke amayeza aqhubekayo ngaphandle kokuthetha nomongikazi okanye ugqirha wasekliniki yakho.',
  },
];

const howToLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Indlela yokufumana amayeza aqhubekayo kwiziko likarhulumente eMzantsi Afrika',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Tyelela ikliniki karhulumente ekufuphi nawe unesazisi sakho',
      text: 'Yiya kwikliniki yezempilo esisiseko ekufuphi nawe ngamaxesha okusebenza (idla ngoku-07:30-16:00 ngeentsuku zeveki). Phatha isazisi sakho saseMzantsi Afrika okanye ipasipoti. Xelela unobhala ukuba ufuna ukubona umongikazi okanye ugqirha ngengxaki yempilo. Akukho i-appointment okanye incwadi yokuthunyelwa efunekayo kutyelelo lokuqala.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Fumanisa isifo sakho uze ubhaliswe njengesigulana esinesifo esiqhubekayo',
      text: 'Umongikazi okanye ugqirha uza kukuhlola, enze uvavanyo (uxinzelelo lwegazi, iswekile egazini, njl.), aze afumanise isifo sakho. Emva kokufunyaniswa, ubhaliswa kwinkqubo yekliniki yezigulana ezinezifo eziqhubekayo uze wabelwe "ikliniki yasekhaya" ephethe ifayile yakho. Uya kufumana ikhadi lekliniki eliluhlaza njengengxelo yakho oyiphetheyo.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Fumana incwadi yakho yokuqala yamayeza namayeza',
      text: 'Ugqirha okubhalela amayeza uyakuqalisa kunyango olusuka kuluhlu lwamayeza abalulekileyo (Essential Drugs List) (umzekelo i-hydrochlorothiazide kwi-hypertension, i-metformin kwisifo seswekile). Incwadi yakho yokuqala yamayeza inikwa kwikhemesti yasekliniki kwangaloo mini — onke amayeza aqhubekayo kumaziko karhulumente asimahla. Unikwa umhla wokubuya, idla ngokuba yinyanga enye kamva.',
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Yiya kutyelelo lokubuya lwenyanga nenyanga okanye lwekota nganye',
      text: 'Buyela kwikliniki yakho yasekhaya ngomhla wakho ocwangcisiweyo ukuze ulande amayeza asele elungisiwe uze ujongwe iimpawu zomzimba (ubunzima, uxinzelelo lwegazi). Rhoqo ngeenyanga ezi-3 unohlolo olude apho umongikazi ajonga ukubambelela kunyango aze alungise amayeza ukuba kuyafuneka. Uhlolo lwaminyaka le lubandakanya uvavanyo lwegazi olupheleleyo (i-HbA1c, ukusebenza kwezintso, ii-lipid).',
    },
    {
      '@type': 'HowToStep',
      position: 5,
      name: 'Bhalisa kwi-CCMDD ukuze ulande ngokulula xa sele uzinzile',
      text: 'Emva kweenyanga ezi-6-12 zonyango oluzinzileyo (uhlangabezana neenjongo zonyango ezifana noxinzelelo lwegazi olungaphantsi kwe-140/90 okanye i-HbA1c engaphantsi kwe-7%), cela ikliniki yakho ikubhalise kwinkqubo ye-Central Chronic Medicine Dispensing and Distribution (CCMDD). Emva koko unokulanda amayeza akho kwindawo elula yokulanda ye-CCMDD — ikhemesti, iholo yecawa, okanye iziko loluntu — endaweni yokuma emgceni ekliniki. Usabuyela ekliniki ukuze uhlolwe kwikota nganye nakunyaka ngamnye.',
    },
  ],
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Ukulawula Izifo Eziqhubekayo Kwiikliniki Zikarhulumente eMzantsi Afrika',
    description: 'Indlela iikliniki zikarhulumente zaseMzantsi Afrika ezilawula ngayo i-hypertension, isifo seswekile, isifo sokuwa, umbefu, nokudandatheka: amayeza, ukujongwa, kunye ne-CCMDD.',
    url: 'https://clinicfinder.co.za/xh/guides/chronic-medication-management',
    publisher: { '@type': 'Organization', name: 'Clinic Finder SA' },
    author: { '@type': 'Organization', name: 'Clinic Finder SA' },
    datePublished: '2026-04-16',
    dateModified: '2026-05-14',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(faq => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
  howToLd,
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Ikhaya', item: 'https://clinicfinder.co.za/xh' }, { '@type': 'ListItem', position: 2, name: 'Izikhokelo', item: 'https://clinicfinder.co.za/xh/guides' }, { '@type': 'ListItem', position: 3, name: 'Amayeza Aqhubekayo Kwiikliniki Zikarhulumente' }] },
];
---
<Base
  title="Amayeza Aqhubekayo Kwiikliniki Zikarhulumente — Clinic Finder SA"
  description="Indlela iikliniki zikarhulumente zaseMzantsi Afrika ezilawula ngayo i-hypertension, isifo seswekile, isifo sokuwa, umbefu, nokudandatheka. Amayeza asimahla, iiskedyuli zokujongwa, kunye ne-CCMDD."
  jsonLd={jsonLd}
>
  <div class="container" style="padding: 32px 0; max-width: 720px;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
      <a href={L('/')}>Ikhaya</a> &rsaquo; <a href={L('/guides')}>Izikhokelo</a> &rsaquo; Amayeza Aqhubekayo
    </nav>

    <h1 style="font-size: 1.5rem; margin-bottom: 8px;">Amayeza Aqhubekayo Kwiikliniki Zikarhulumente</h1>
    <p style="color: var(--text-muted); margin-bottom: 32px; line-height: 1.7;">
      Umthwalo wezifo ezingosuleliyo eMzantsi Afrika mkhulu kakhulu: uxinzelelo lwegazi oluphezulu (hypertension), isifo seswekile (diabetes), nezifo zempilo yengqondo zichaphazela izigidi zabantu, kwaye uninzi lwazo lulawulwa kwiikliniki zezempilo esisiseko. Unyango lusimahla, lobomi bonke, kwaye — xa lulandelwa rhoqo — lukugcina ungangeni esibhedlele. Esi sikhokelo sithetha ngezona zifo eziqhubekayo ziqhelekileyo nento omawuyilindele ekliniki.
    </p>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px; color: var(--primary-dark);">Izifo eziqhubekayo eziqhelekileyo</h2>
      <div style="display: grid; gap: 20px;">
        {conditions.map(c => (
          <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 20px;">
            <strong style="font-size: 1.05rem; color: var(--primary-dark);">{c.name}</strong>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">{c.prevalence}</p>
            <div style="margin-top: 12px; display: grid; gap: 8px; font-size: 0.9rem;">
              <div><strong>Unyango:</strong> <span style="color: var(--text-muted);">{c.treatment}</span></div>
              <div><strong>Ekliniki:</strong> <span style="color: var(--text-muted);">{c.atClinic}</span></div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Into omawuze nayo kutyelelo lwakho lwesifo esiqhubekayo</h2>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 6px;">
        <li><strong>Ikhadi lekliniki eliluhlaza</strong> — ingxelo yakho oyiphetheyo</li>
        <li><strong>Onke amayeza akho angoku</strong> — kubandakanya iibhokisi/amaphakethe, ukuze umongikazi akwazi ukujonga ukuba usela ntoni nokuba kusele kangakanani</li>
        <li><strong>Iingxelo zokuzijonga ekhaya</strong> — ukuba uzijonga uxinzelelo lwegazi okanye iswekile egazini ekhaya, phatha izibalo</li>
        <li><strong>Uluhlu lweempawu okanye izinto ezikukhathazayo</strong> — zibhale phantsi kwangaphambili ukuze ungalibali</li>
        <li><strong>Isazisi</strong> — sinokufuneka ukuze kufunyanwe ifayile yakho</li>
      </ol>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Umjikelo wamayeza aqhubekayo</h2>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-bottom: 12px;">
        Izigulana ezinezifo eziqhubekayo zilandela umjikelo owaziwayo ekliniki:
      </p>
      <div style="display: grid; gap: 12px;">
        <div style="display: flex; gap: 16px; align-items: flex-start;">
          <div style="flex-shrink: 0; width: 36px; height: 36px; background: var(--primary-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; color: var(--primary-dark); font-size: 0.9rem;">1</div>
          <div>
            <strong>Ukulanda kwanyanga zonke/rhoqo kwiinyanga ezimbini</strong>
            <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 2px; line-height: 1.5;">Landa amayeza akho asele elungisiwe. Ukujongwa okukhawulezayo kweempawu zomzimba (ubunzima, uxinzelelo lwegazi). Uyangena uphume ngaphantsi kweyure ngosuku oluhle.</p>
          </div>
        </div>
        <div style="display: flex; gap: 16px; align-items: flex-start;">
          <div style="flex-shrink: 0; width: 36px; height: 36px; background: var(--primary-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; color: var(--primary-dark); font-size: 0.9rem;">2</div>
          <div>
            <strong>Uhlolo lwekota (rhoqo ngeenyanga ezi-3)</strong>
            <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 2px; line-height: 1.5;">Utyelelo olude. Umongikazi ujonga isifo sakho, ajonge ukubambelela kunyango, alungise amayeza ukuba kuyafuneka. Igazi lingathathwa.</p>
          </div>
        </div>
        <div style="display: flex; gap: 16px; align-items: flex-start;">
          <div style="flex-shrink: 0; width: 36px; height: 36px; background: var(--primary-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; color: var(--primary-dark); font-size: 0.9rem;">3</div>
          <div>
            <strong>Uhlolo lonyaka (kanye ngonyaka)</strong>
            <p style="font-size: 0.9rem; color: var(--text-muted); margin-top: 2px; line-height: 1.5;">Uhlolo olupheleleyo. Uvavanyo lwegazi olubanzi (iswekile xa ungatyanga, i-HbA1c, ii-lipid, ukusebenza kwezintso, ukusebenza kwesibindi). Ukuthunyelwa kuhlolo lwamehlo kwabanesifo seswekile. Ukuhlolwa kweenyawo. Ukuhlaziywa kwencwadi yamayeza yonyaka.</p>
          </div>
        </div>
      </div>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 16px;">
        Xa sele uzinzile, ungabhalisa kwi-<a href={L('/guides/ccmdd-chronic-meds-pickup')}>CCMDD</a> ukuze ulande amayeza kwindawo elula yokulanda endaweni yekliniki. Usabuyela ekliniki ukuze uhlolwe kwikota nganye nakunyaka ngamnye.
      </p>
    </section>

    <section style="background: var(--bg-alt); border-radius: var(--radius); padding: 20px; margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 12px; color: var(--primary-dark);">Ukubambelela kunyango — kutheni kubalulekile</h2>
      <p style="font-size: 0.95rem; line-height: 1.7;">
        Amayeza aqhubekayo asebenza kuphela ukuba uwasela rhoqo. Ukutsiba imithamo okanye ukuyeka unyango kukhokelela kwizifo ezingalawulekiyo, ekungeniseni esibhedlele, nakwiingxaki ebezinokuthintelwa (istrowuk, ukungasebenzi kwezintso, ukunqunyulwa komlenze ngenxa yesifo seswekile, ukuwa). EMzantsi Afrika, ukungabambeleli kunyango sesona sizathu siphambili sokuba izigulana ezinezifo eziqhubekayo ziphelele esibhedlele.
      </p>
      <p style="font-size: 0.95rem; line-height: 1.7; margin-top: 8px;">
        Ukuba unengxaki yokusela amayeza akho — iziphumo ezingafunwayo, ukulibala, iindleko zothutho lokuya ekliniki, ukuziva ubhetele uze ucinge ukuba awawadingi — <strong>xelela umongikazi wakho</strong>. Banokwenza inkqubo yakho yamayeza ibe lula, batshintshele kwiyeza elinyamezeleka ngcono, bakubhalise kwi-CCMDD, okanye bakudibanise nomhlobo wonyango. Eyona nto imbi ongayenza kukuyeka ngokuthe cwaka.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px;">Yintoni Ebalwa "Njengokuzinza" — Iinjongo Zonyango</h2>
      <p style="font-size: 0.9rem; line-height: 1.7; color: var(--text-muted); margin-bottom: 12px;">Ikliniki yakho ikuthatha njengozinzileyo (ufaneleka kwi-CCMDD, utyelela kancinci) xa uhlangabezana neenjongo ezithile. Ukuba ungaphandle kweenjongo, lindela utyelelo olwenzeka rhoqo notshintsho olunokwenzeka lwamayeza.</p>
      <div style="overflow-x: auto; margin-bottom: 16px;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem;">
          <thead><tr style="border-bottom: 2px solid var(--border);">
            <th style="text-align: left; padding: 10px 8px;">Isifo</th>
            <th style="text-align: left; padding: 10px 8px;">Injongo Yokuzinza</th>
            <th style="text-align: left; padding: 10px 8px;">Ngaphandle Kwenjongo — Isenzo</th>
          </tr></thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">Hypertension</td><td style="padding: 8px;">Uxinzelelo lwegazi luhlala lu&lt;140/90</td><td style="padding: 8px;">Umthamo weyeza uyandiswa, kongezwa elinye iyeza, kujongwe kwakhona kwiiveki ezi-4</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">Isifo seswekile (uHlobo 2)</td><td style="padding: 8px;">I-HbA1c &lt;7%, iswekile xa ungatyanga 4-7 mmol/L</td><td style="padding: 8px;">Umthamo we-metformin uyandiswa, kongezwe i-glimepiride/insulin, kuthunyelwe kwingcali yokutya</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">I-HIV (usela i-ART)</td><td style="padding: 8px;">Umthamo wentsholongwane egazini awufumaneki (&lt;50 copies/mL)</td><td style="padding: 8px;">Ucebiso olwandisiweyo lokubambelela kunyango iinyanga ezi-3, uze ujongwe kwakhona — ukuba isafumaneka, utshintshelwa kunyango lwesibini</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">Isifo sokuwa</td><td style="padding: 8px;">Akukho kuwa iinyanga ezingaphezu kweli-12</td><td style="padding: 8px;">Umthamo uyalungiswa, kongezwe elinye iyeza, kujongwe ngugqirha</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">Umbefu</td><td style="padding: 8px;">&lt;2 ukusetyenziswa kwe-inhaler yoncedo ngeveki</td><td style="padding: 8px;">Kwenyuselwa i-corticosteroid ephefumlwayo + i-LABA, kujongwe indlela yokuyisebenzisa</td></tr>
          </tbody>
        </table>
      </div>
      <p style="font-size: 0.9rem; line-height: 1.7; color: var(--text-muted);">Uvavanyo lwegazi lwenziwa minyaka le (okanye rhoqo ngakumbi ukuba awuzinzanga): i-HbA1c ne-creatinine kwisifo seswekile, i-urea/creatinine/potassium kwi-hypertension, umthamo wentsholongwane egazini kwi-HIV. Ezi zisimahla kumaziko karhulumente — akufuneki uye kwilebhu yabucala.</p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px;">Ukudibana Kwamayeza Omawukwazi</h2>
      <p style="font-size: 0.9rem; line-height: 1.7; color: var(--text-muted); margin-bottom: 12px;">Izigulana ezininzi ezinezifo eziqhubekayo zisela amayeza amaninzi. Ukudibana kwamanye kufuna ukulungiswa kwamaxesha okanye ukujongwa.</p>
      <div style="display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <div style="font-weight: 600; margin-bottom: 8px;">Ii-ARV + unyango lwe-TB</div>
          <p style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.6; margin: 0;">I-Rifampicin inciphisa amanqanaba e-efavirenz ne-dolutegravir. Umthamo we-dolutegravir uphindwa kabini ngexesha lonyango lwe-TB. Ungaze uzilungisele oku ngokwakho — ikliniki iyalawula oku kudibana.</p>
        </div>
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <div style="font-weight: 600; margin-bottom: 8px;">I-Metformin + iingxaki zezintso</div>
          <p style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.6; margin: 0;">I-Metformin kufuneka iyekwe ukuba i-creatinine inyuka ngaphezu kwenqanaba elithile. Uvavanyo lwegazi lwaminyaka le luyakubamba oku. Xela isicaphucaphu esiqhubekayo okanye iintlungu zezihlunu.</p>
        </div>
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <div style="font-weight: 600; margin-bottom: 8px;">Ii-ACE inhibitor + i-potassium</div>
          <p style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.6; margin: 0;">I-Enalapril (iyeza eliqhelekileyo loxinzelelo lwegazi) inyusa amanqanaba e-potassium. Musa ukusela izongezelelo ze-potassium okanye izinto ezithatha indawo yetyuwa (KCl) ungaxelelanga umongikazi.</p>
        </div>
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <div style="font-weight: 600; margin-bottom: 8px;">Isifo sokuwa + ukucwangcisa usapho</div>
          <p style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.6; margin: 0;">I-Carbamazepine ne-phenytoin zinciphisa ukusebenza kwepilisi. Inaliti (Depo-Provera) okanye i-IUD yekopa ngamanye amacebo akhethwayo. Bona <a href={L('/guides/family-planning-contraception')}>isikhokelo sethu sokucwangcisa usapho</a>.</p>
        </div>
      </div>
    </section>

    <section style="background: var(--primary-light); border-radius: var(--radius); padding: 20px; margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 8px; color: var(--primary-dark);">Fumana ikliniki yamayeza aqhubekayo</h2>
      <p style="font-size: 0.9rem; margin-bottom: 12px;">
        Amaziko angu-{chronicClinics.length} kwidatabhesi yethu anikezela ngeenkonzo zamayeza aqhubekayo.
      </p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="/services/chronic-medication" class="btn btn--primary" style="font-size: 0.9rem;">Khangela iikliniki zamayeza aqhubekayo</a>
        <a href={L('/guides/ccmdd-chronic-meds-pickup')} class="btn btn--outline" style="font-size: 0.9rem;">Isikhokelo sokulanda se-CCMDD</a>
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px;">Imibuzo Ebuzwa Rhoqo</h2>
      <div style="display: grid; gap: 12px;">
        {faqs.map(faq => (
          <details style="border: 1px solid var(--border); border-radius: var(--radius);">
            <summary style="cursor: pointer; font-weight: 600; font-size: 0.95rem; padding: 14px; list-style: none; display: flex; justify-content: space-between; align-items: center;">
              {faq.question}
              <span style="color: var(--text-muted); flex-shrink: 0; margin-left: 12px;">+</span>
            </summary>
            <div style="padding: 0 14px 14px; font-size: 0.9rem; color: var(--text-muted); line-height: 1.7;">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <section style="border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; font-size: 0.85rem; color: var(--text-muted); line-height: 1.6;">
      <strong style="color: var(--text);">Imithombo:</strong> Primary Care 101 guideline (NDoH). Essential Drugs List — Primary Healthcare. South African Hypertension Practice Guideline (2019). SEMDSA Type 2 Diabetes Guidelines (2023). South African Epilepsy Guidelines (ILAE). Global Asthma Report — South Africa chapter.
    </section>
    <section style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border);">
      <h2 style="font-size:1.2rem;margin-bottom:1rem;">Izikhokelo Ezinxulumeneyo</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:0.75rem;">
      <a href={L('/guides/ccmdd-chronic-meds-pickup')} style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Ukulanda Amayeza Aqhubekayo e-CCMDD</a>
      <a href={L('/guides/how-to-get-arvs')} style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Indlela Yokufumana Ii-ARV</a>
      <a href={L('/guides/hospital-referral-system')} style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Inkqubo Yokuthunyelwa Esibhedlele</a>
      <a href={L('/guides/find-nearest-clinic')} style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Fumana Ikliniki Ekufuphi Nawe</a>
      </div>
    </section>
    <section style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border);">
      <h2 style="font-size:1.2rem;margin-bottom:1rem;">Fumana Iikliniki ngePhondo</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:0.75rem;">
      <a href="/clinics/gauteng" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Gauteng</a>
      <a href="/clinics/kwazulu-natal" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">KwaZulu-Natal</a>
      <a href="/clinics/western-cape" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Western Cape</a>
      <a href="/clinics/eastern-cape" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Eastern Cape</a>
      <a href="/clinics/limpopo" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Limpopo</a>
      <a href="/clinics/mpumalanga" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Mpumalanga</a>
      <a href="/clinics/north-west" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">North West</a>
      <a href="/clinics/free-state" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Free State</a>
      <a href="/clinics/northern-cape" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Northern Cape</a>
      </div>
    </section>
  </div>
</Base>
