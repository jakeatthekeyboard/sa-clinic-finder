---
/**
 * isiXhosa — inguqulelo yesivakalisi-nge-sivakalisi ye src/pages/guides/child-immunisation-schedule.astro
 */
import Base from '../../../layouts/Base.astro';
import { facilities } from '../../../data/helpers';
import { localePath } from '../../../i18n/config';

const L = (p: string) => localePath(p, 'xh');

const immunClinics = facilities.filter(f => f.services.immunisation);

const schedule = [
  { age: 'Ekuzalweni', vaccines: 'BCG (isifo sephepha / tuberculosis), OPV 0 (i-polio eselwayo)', notes: 'Sinikwa phambi kokukhutshwa esibhedlele okanye kutyelelo lokuqala lwasekliniki.' },
  { age: 'Iiveki ezi-6', vaccines: 'DTaP-IPV-Hib-HBV 1 (6-in-1), OPV 1, PCV 1 (pneumococcal), RV 1 (rotavirus)', notes: 'Usuku lokuqala olukhulu lokugonya — izitofu ezi-4 + amathontsi ama-2 aselwayo. I-6-in-1 ikhusela kwi-diphtheria, i-tetanus, i-pertussis, i-polio, i-Hib, kunye ne-hepatitis B.' },
  { age: 'Iiveki eziyi-10', vaccines: 'DTaP-IPV-Hib-HBV 2, RV 2', notes: 'Idosi yesibini ye-6-in-1 kunye ne-rotavirus yesibini.' },
  { age: 'Iiveki eziyi-14', vaccines: 'DTaP-IPV-Hib-HBV 3, PCV 2, RV 3', notes: 'Idosi yesithathu ye-6-in-1, i-pneumococcal yesibini, i-rotavirus yesithathu. Uthotho lwe-rotavirus lugqityiwe.' },
  { age: 'Iinyanga ezi-6', vaccines: 'Measles 1 (kwiindawo ezinomngcipheko omkhulu kuphela)', notes: 'Sinikwa kuphela kwiindawo ezinesimo sesimungumungu (measles). Idosi yokuqala eqhelekileyo yeyakwiinyanga ezi-9.' },
  { age: 'Iinyanga ezi-9', vaccines: 'Measles 1, PCV 3', notes: 'Idosi yokuqala eqhelekileyo yesimungumungu. I-pneumococcal yesithathu. Uthotho lwe-pneumococcal lugqityiwe.' },
  { age: 'Iinyanga eziyi-12', vaccines: 'Measles 2', notes: 'Idosi yesibini yesimungumungu. Uthotho lwesimungumungu lugqityiwe.' },
  { age: 'Iinyanga eziyi-18', vaccines: 'DTaP-IPV-Hib-HBV booster', notes: 'Isitofu esiqinisayo (booster) se-6-in-1. Sibalulekile kukhuseleko lwexesha elide.' },
  { age: 'Iminyaka esi-6', vaccines: 'Td (isitofu esiqinisayo se-tetanus + diphtheria)', notes: 'Isitofu esiqinisayo sokungena esikolweni. Sinikwa ngenkqubo yempilo yesikolo okanye ekliniki.' },
  { age: 'Iminyaka eli-12', vaccines: 'Td booster, HPV (amantombazana kuphela, iidosi ezi-2 ezahlukaniswe ziinyanga ezi-6)', notes: 'Isitofu se-HPV sithintela umhlaza womlomo wesibeleko. Sinikwa ngezikolo. Ithimetheybhile yeedosi ezi-2 ngo-0 nango-6 weenyanga.' },
];

const faqs = [
  {
    question: 'Ngaba izitofu zokugonya zisimahla kwiikliniki zikarhulumente?',
    answer: 'Ewe. Zonke izitofu ezikwithimetheybhile ye-Expanded Programme on Immunisation (EPI-SA) zisimahla kumaziko empilo karhulumente. Akufuneki ube ne-medical aid. Ezi zitofu ziyafumaneka nakoogqirha babucala kodwa ngeendleko — akukho sizathu sonyango sokukhetha owabucala endaweni karhulumente kwizitofu eziqhelekileyo, kuba izitofu ziyafana.',
  },
  {
    question: 'Kuthekani ukuba umntwana wam uphose isitofu?',
    answer: 'Yiya ekliniki kwangoko kangangoko unako. Akukho mfuneko yokuqala uthotho kwakhona — ikliniki iya kuqhubeka apho ithimetheybhile iyeke khona (ithimetheybhile yokubuyela emva). Yiza nencwadi ye-Road to Health ukuze umongikazi abone ukuba zeziphi izitofu esezinikiwe. Ukuba uyilahlile incwadi, umongikazi uya kuqala entsha kwaye kusenokwenzeka anike izitofu ezithile kwakhona ukuze kukhuseleke.',
  },
  {
    question: 'Ngaba umntwana wam angagonywa xa enomkhuhlane omncinci?',
    answer: 'Ewe, kwiimeko ezininzi. Ukugula okuncinci (impumlo evuzayo, umkhuhlane ophantsi, ukukhohlela) ASISOSIZATHU sokulibazisa ukugonya. Ekuphela kwezinto ezinqandayo zezi: umkhuhlane ophezulu (ngaphezu kwe-38.5°C), ukungathandi kakhulu kwedosi edlulileyo yesitofu esifanayo (severe allergic reaction), okanye ukungabikho kwamandla omzimba okuzikhusela okuqinisekisiweyo (kwizitofu eziphilayo ezinje nge-BCG ne-OPV). Musa ukulibazisa — isitofu ngasinye esiphoswayo okanye esilityaziswayo lithuba lokuba umntwana asengozini.',
  },
  {
    question: 'Ngaba isitofu se-HPV sikhuselekile?',
    answer: 'Ewe. Isitofu se-HPV sesinikwe abantu abangaphezu kwezigidi ezingama-300 ehlabathini lonke ukusukela ngo-2006. Sithintela iindidi ze-HPV ezibangela i-70% yomhlaza womlomo wesibeleko. UMzantsi Afrika wasiqalisa ngo-2014 kumantombazana aneminyaka esi-9-12 ngenkqubo yempilo yesikolo. Iziphumo ezingafunwayo zincinci (ingalo ebuhlungu, umkhuhlane ophantsi ngamanye amaxesha). Umhlaza womlomo wesibeleko ubulala abafazi baseMzantsi Afrika abangaphezu kwe-3,000 ngonyaka — isitofu siyakuthintela oku.',
  },
  {
    question: 'Sirekhodwa phi isitofu somntwana wam?',
    answer: 'Kwincwadi ye-Road to Health (RTHB) — incwadi eluhlaza okanye emthubi enikwa ekuzalweni. Le yirekhodi esemthethweni yempilo yomntwana wakho. Yiza nayo kutyelelo ngalunye lwasekliniki nakubhaliso ngalunye lwesikolo. Ukuba ilahlekile, yiya ekliniki apho umntwana wakho wagonywa khona okokugqibela — basenokuba neerekhodi. Ikliniki iya kukhupha incwadi entsha.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Ithimetheybhile Yokugonya Abantwana — uMzantsi Afrika (EPI-SA)',
    description: 'Ithimetheybhile epheleleyo yokugonya yoMzantsi Afrika ukusuka ekuzalweni ukuya kwiminyaka eli-12: zeziphi izitofu, nini, nokuba uzifumana phi.',
    url: 'https://clinicfinder.co.za/xh/guides/child-immunisation-schedule',
    publisher: { '@type': 'Organization', name: 'Clinic Finder SA' },
    author: { '@type': 'Organization', name: 'Clinic Finder SA' },
    datePublished: '2026-04-16',
    dateModified: '2026-05-14',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(faq => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'Indlela Yokugonyisa Umntwana Wakho Ekliniki Karhulumente eMzantsi Afrika',
    description: 'Inkqubo yamanyathelo ama-5 yokuqinisekisa ukuba umntwana wakho ufumana zonke izitofu ze-EPI-SA ngexesha.',
    step: [
      { '@type': 'HowToStep', position: 1, name: 'Yiza nencwadi yakho ye-Road to Health ekliniki', text: 'Incwadi ye-Road to Health (RTHB — incwadi eluhlaza okanye emthubi enikwa ekuzalweni) yirekhodi esemthethweni yezitofu zomntwana wakho. Yiza nayo kutyelelo ngalunye lwasekliniki. Umongikazi uyayijonga ukubona ukuba zeziphi izitofu ezifunekayo. Ukuba uyilahlile, yiya ekliniki apho umntwana wakho wagonywa khona okokugqibela — bangakhupha entsha kwaye basenokunika izitofu kwakhona ukuze kukhuseleke.' },
      { '@type': 'HowToStep', position: 2, name: 'Yiya nakuyiphi na ikliniki karhulumente — akukho appointment ifunekayo', text: 'Izitofu zokugonya ziyafumaneka nakuyiphi na ikliniki karhulumente, iziko lempilo loluntu, okanye isibhedlele esinikeza iinkonzo zempilo yabantwana. Akukho appointment okanye ubhaliso lufunekayo. Ngena ngamaxesha asekliniki (idla ngokuba ngo-7:30am–4pm ngeentsuku zeveki). Ezinye iikliniki zineentsuku ezithile zokugonya — fowunela kuqala ujonge, kodwa ezininzi ziya kugonya nangaluphi na usuku.' },
      { '@type': 'HowToStep', position: 3, name: 'Xelela umongikazi ubudala bomntwana wakho nezitofu ezifunekayo', text: 'Bonisa i-RTHB. Umongikazi uya kujonga ukuba zeziphi izitofu ezifunekayo ngokusekelwe kubudala bomntwana wakho. Ithimetheybhile ye-EPI-SA isuka ekuzalweni ukuya kwiminyaka eli-12. Ukuba umntwana wakho uphose ezinye izitofu, umongikazi uya kulandela ithimetheybhile yokubuyela emva — akukho mfuneko yokuqala uthotho kwakhona. Zonke izitofu zisimahla.' },
      { '@type': 'HowToStep', position: 4, name: 'Linda imizuzu eli-15 emva kokugonywa ukuze kujongwe', text: 'Emva kwenaliti, hlala ekliniki imizuzu eli-15 ukuze umongikazi ajonge nayiphi na into engenzeka ngoko nangoko (into enqabileyo kakhulu). Iziphumo ezingafunwayo eziqhelekileyo: ingalo ebuhlungu, umkhuhlane omncinci, ukukhathazeka — konke kuqhelekile kwaye kuphela ngeeyure ezingama-24-48. Nika i-paracetamol (Panado) ukuba akakhululekanga. Iziphumo ezimbi ezifuna unyango zinqabile kakhulu (malunga no-1 kwisigidi seedosi).' },
      { '@type': 'HowToStep', position: 5, name: 'Cwangcisa utyelelo olulandelayo ngokwethimetheybhile ye-EPI-SA', text: 'Buza umongikazi ukuba sifuneka nini isitofu esilandelayo uze usibhale kwikhalenda yakho. Imihla ebalulekileyo: iiveki ezi-6 (usuku lokuqala olukhulu lokugonya — izitofu ezi-4 + amathontsi ama-2 aselwayo), iiveki eziyi-10, iiveki eziyi-14, iinyanga ezi-9 (isimungumungu sokuqala), iinyanga eziyi-12 (isimungumungu sesibini), iinyanga eziyi-18 (isitofu esiqinisayo), iminyaka esi-6 (isitofu esiqinisayo sokungena esikolweni), neminyaka eli-12 (i-Td + i-HPV kumantombazana). Ukuphosa okanye ukulibazisa izitofu kushiya umntwana wakho esengozini yezifo ezinokuthintelwa.' },
    ],
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Ikhaya', item: 'https://clinicfinder.co.za/xh' }, { '@type': 'ListItem', position: 2, name: 'Izikhokelo', item: 'https://clinicfinder.co.za/xh/guides' }, { '@type': 'ListItem', position: 3, name: 'Ithimetheybhile Yokugonya Abantwana (eMzantsi Afrika)' }] },
];
---
<Base
  title="Ithimetheybhile Yokugonya Abantwana (eMzantsi Afrika) — Clinic Finder SA"
  description="Ithimetheybhile epheleleyo ye-EPI-SA yokugonya ukusuka ekuzalweni ukuya kwiminyaka eli-12. Zeziphi izitofu kubudala ngabunye, iidosi zokubuyela emva, i-HPV yamantombazana, nokuba ungagonywa phi simahla."
  jsonLd={jsonLd}
>
  <div class="container" style="padding: 32px 0; max-width: 720px;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
      <a href={L('/')}>Ikhaya</a> &rsaquo; <a href={L('/guides')}>Izikhokelo</a> &rsaquo; Ithimetheybhile Yokugonya Abantwana
    </nav>

    <h1 style="font-size: 1.5rem; margin-bottom: 8px;">Ithimetheybhile Yokugonya Abantwana (eMzantsi Afrika)</h1>
    <p style="color: var(--text-muted); margin-bottom: 32px; line-height: 1.7;">
      Inkqubo yoMzantsi Afrika ye-Expanded Programme on Immunisation (EPI-SA) inikeza izitofu zasimahla ezikhusela kwizifo eziyi-13 ukusuka ekuzalweni ukuya kwiminyaka eli-12. Zonke izitofu zinikwa kwiikliniki zikarhulumente — akufuneki i-medical aid okanye i-appointment. Le thimetheybhile ihambelana no-2026.
    </p>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px; color: var(--primary-dark);">Ithimetheybhile yokugonya</h2>
      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
          <thead>
            <tr style="background: var(--primary-light);">
              <th style="padding: 10px; text-align: left; border-bottom: 2px solid var(--border); white-space: nowrap;">Ubudala</th>
              <th style="padding: 10px; text-align: left; border-bottom: 2px solid var(--border);">Izitofu</th>
              <th style="padding: 10px; text-align: left; border-bottom: 2px solid var(--border);">Amanqaku</th>
            </tr>
          </thead>
          <tbody>
            {schedule.map((row, i) => (
              <tr style={i % 2 === 1 ? 'background: var(--bg-alt)' : ''}>
                <td style="padding: 10px; border-bottom: 1px solid var(--border); font-weight: 600; white-space: nowrap; vertical-align: top;">{row.age}</td>
                <td style="padding: 10px; border-bottom: 1px solid var(--border); line-height: 1.5; vertical-align: top;">{row.vaccines}</td>
                <td style="padding: 10px; border-bottom: 1px solid var(--border); color: var(--text-muted); line-height: 1.5; vertical-align: top;">{row.notes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Izitofu zikhusela ntoni</h2>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-bottom: 12px;">
        Ithimetheybhile ye-EPI-SA ikhusela kwizifo eziyi-13 ebezidla ngokubulala okanye ukukhubaza amawaka abantwana baseMzantsi Afrika nyaka ngamnye:
      </p>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 0.9rem;">
        <div style="padding: 8px; background: var(--bg-alt); border-radius: 4px;"><strong>BCG:</strong> Isifo sephepha / tuberculosis (iindidi ezibuhlungu zabantwana)</div>
        <div style="padding: 8px; background: var(--bg-alt); border-radius: 4px;"><strong>OPV/IPV:</strong> I-polio</div>
        <div style="padding: 8px; background: var(--bg-alt); border-radius: 4px;"><strong>DTaP:</strong> I-diphtheria, i-tetanus, i-pertussis (ukhohlokhohlo)</div>
        <div style="padding: 8px; background: var(--bg-alt); border-radius: 4px;"><strong>Hib:</strong> I-Haemophilus influenzae type b (umhlaza wolwelwe / meningitis)</div>
        <div style="padding: 8px; background: var(--bg-alt); border-radius: 4px;"><strong>HBV:</strong> I-Hepatitis B</div>
        <div style="padding: 8px; background: var(--bg-alt); border-radius: 4px;"><strong>PCV:</strong> Isifo se-pneumococcal (umkhuhlane wamaphaphu, i-meningitis)</div>
        <div style="padding: 8px; background: var(--bg-alt); border-radius: 4px;"><strong>RV:</strong> I-Rotavirus (urhudo olubuhlungu)</div>
        <div style="padding: 8px; background: var(--bg-alt); border-radius: 4px;"><strong>Measles:</strong> Isimungumungu (izikhwaza, umkhuhlane, iingxaki)</div>
        <div style="padding: 8px; background: var(--bg-alt); border-radius: 4px;"><strong>HPV:</strong> I-Human papillomavirus (umhlaza womlomo wesibeleko)</div>
      </div>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Izitofu zokubuyela emva</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Ukuba umntwana wakho uphose ezinye izitofu, sukoyika — mse ekliniki kwangoko kangangoko unako. Umongikazi uya kujonga incwadi ye-Road to Health aze anike naziphi na iidosi ezisasilelayo. Akukho mfuneko yokuqala nawuphi na uthotho kwasekuqaleni. Amandla omzimba okuzikhusela "ayazikhumbula" iidosi ezidlulileyo nokuba kudlule iminyaka.
      </p>
      <p style="line-height: 1.7; font-size: 0.95rem; margin-top: 8px;">
        Iimeko eziqhelekileyo zokubuyela emva:
      </p>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 6px; margin-top: 8px;">
        <li><strong>Uzalelwe ekhaya / iidosi zokuzalwa ziphosiwe:</strong> Yiya ekliniki ngaphakathi kweeveki ezi-2 ufumane i-BCG ne-OPV0.</li>
        <li><strong>Izitofu zeeveki ezi-6 ziphosiwe:</strong> Zinganikwa nanini na kude kufike iinyanga eziyi-12. Ikliniki iya kulungisa ithimetheybhile.</li>
        <li><strong>Uphose nje isimungumungu kwiinyanga ezi-9:</strong> Sinike kwangoko kangangoko kunokwenzeka. Idosi yesibini yeenyanga eziyi-12 isenokunikwa ngexesha (ubuncinane iiveki ezi-4 phakathi kweedosi).</li>
        <li><strong>Akukho ncwadi ye-Road to Health:</strong> Ikliniki iya kuqala entsha. Ezinye izitofu zisenokuphindwa ukuba akukho rekhodi — oku kukhuselekile.</li>
      </ol>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">Amacebiso osuku lokugonya</h2>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 8px;">
        <li><strong>Yiza nencwadi ye-Road to Health</strong> — umongikazi uyayifuna ukurekhoda izitofu nokujonga into efunekayo.</li>
        <li><strong>Nxibisa usana iimpahla ezikhululekileyo</strong> — iinaliti ezininzi zihlatywa ethangeni (ngaphantsi kweenyanga eziyi-12) okanye engalweni ngaphezulu (ngaphezu kweenyanga eziyi-12). Ukufikeleleka lula konga ixesha.</li>
        <li><strong>Ncancisa ngexesha okanye emva nje kwenaliti</strong> — oku kunciphisa iintlungu kwaye kuzolise usana. Uphando luqinisekisa ukuba yeyona ndlela isebenzayo yokunciphisa iintlungu engeyoyamayeza kusana.</li>
        <li><strong>Lindela iziphumo ezingafunwayo ezincinci</strong> — iqhuma elincinci elibomvu apho ihlatywe khona, umkhuhlane ophantsi (ngaphantsi kwe-38°C), nokukhathazeka iiyure ezingama-24-48 kuqhelekile. Nika i-paracetamol (idosi ngokobunzima) ukuba usana alukhululekanga.</li>
        <li><strong>Fika kwangoko</strong> — iikliniki ezininzi zigonya kusasa (07:00-12:00). Fika ngo-07:00 ukuze ungalindi ixesha elide.</li>
      </ol>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px;">Izitofu Eziphosiweyo Okanye Ezilibazisiweyo — Imithetho Yokubuyela Emva</h2>
      <p style="font-size: 0.9rem; line-height: 1.7; color: var(--text-muted); margin-bottom: 12px;">Idosi ephosiweyo ayithethi ukuqala kwakhona. Umgaqo-nkqubo we-EPI wokubuyela emva uqala kwidosi ephosiweyo, ugcina zonke iidosi ezinikwe ngaphambili zisebenza. Amathuba abuncinane phakathi kweedosi asasebenza — umongikazi uya kubala umhla olandelayo okhuselekileyo.</p>
      <div style="overflow-x: auto; margin-bottom: 16px;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem;">
          <thead><tr style="border-bottom: 2px solid var(--border);">
            <th style="text-align: left; padding: 10px 8px;">Isitofu</th>
            <th style="text-align: left; padding: 10px 8px;">Ithuba Elincinci</th>
            <th style="text-align: left; padding: 10px 8px;">Ubudala Obukhulu Bokubuyela Emva</th>
          </tr></thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">OPV (i-polio eselwayo)</td><td style="padding: 8px;">Iiveki ezi-4 phakathi kweedosi</td><td style="padding: 8px;">Iminyaka emi-5</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">I-Hexavalent (DTaP-IPV-Hib-HepB)</td><td style="padding: 8px;">Iiveki ezi-4 phakathi kweedosi</td><td style="padding: 8px;">Iminyaka esi-7</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">PCV (pneumococcal)</td><td style="padding: 8px;">Iiveki ezi-8 phakathi kweedosi zokuqala</td><td style="padding: 8px;">Iminyaka emi-5</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">I-Rotavirus</td><td style="padding: 8px;">Iiveki ezi-4 phakathi kweedosi</td><td style="padding: 8px;">Ayinakuqalwa emva kweeveki eziyi-15; ayinakunikwa emva kweeveki ezingama-32</td></tr>
            <tr style="border-bottom: 1px solid var(--border);"><td style="padding: 8px;">Isimungumungu (measles)</td><td style="padding: 8px;">Iiveki ezi-4 phakathi kweedosi</td><td style="padding: 8px;">Akukho mda ophezulu — sinike nakuwuphi na ubudala ukuba siphosiwe</td></tr>
          </tbody>
        </table>
      </div>
      <p style="font-size: 0.9rem; line-height: 1.7; color: var(--text-muted);">I-Rotavirus kuphela isitofu se-EPI esinomda oqinileyo wobudala — ukuba umntwana wakho uphosa ithuba, ezinye iidosi kwithimetheybhile ziyaqhubeka ngokwesiqhelo. Xelela ikliniki umhla wesitofu sokugqibela esinikiweyo ukuze bacwangcise ukubuyela emva ngendlela echanekileyo.</p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px;">Iimpendulo Zesitofu — Xa Umawukhathazeke</h2>
      <p style="font-size: 0.9rem; line-height: 1.7; color: var(--text-muted); margin-bottom: 12px;">Iimpendulo ezininzi zincinci kwaye ziphela ngeeyure ezingama-48. Inani elincinci lifuna unyango.</p>
      <div style="display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        <div style="border: 1px solid var(--border); border-radius: var(--radius); padding: 16px;">
          <div style="font-weight: 600; margin-bottom: 8px; color: var(--primary-dark);">Kuqhelekile — kulungiswa ekhaya</div>
          <ol style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.7; padding-left: 1.2rem; margin: 0;">
            <li>Ukubomvu/ukudumba apho ihlatywe khona (iiyure ezingama-48)</li>
            <li>Umkhuhlane ophantsi ongaphantsi kwe-38°C (iiyure ezingama-24-48)</li>
            <li>Ukukhathazeka, ukungatyi kakuhle (iiyure ezingama-24)</li>
            <li>Urhudo oluncinci emva kwe-rotavirus (iintsuku ezi-3)</li>
            <li>Ilibhlisitha/isibazi esincinci se-BCG (iiveki ezi-6-12 ukuphola)</li>
          </ol>
        </div>
        <div style="border: 1px solid var(--border); border-left: 3px solid #c0392b; border-radius: var(--radius); padding: 16px;">
          <div style="font-weight: 600; margin-bottom: 8px; color: #c0392b;">Yiya ekliniki ngokungxamisekileyo</div>
          <ol style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.7; padding-left: 1.2rem; margin: 0;">
            <li>Umkhuhlane ongaphezu kwe-39°C ongaphenduliyo kwi-paracetamol</li>
            <li>Isifo sokuwa okanye ukuxhuzula</li>
            <li>Ukudumba okusasazekayo ngaphaya kwelungu</li>
            <li>Ithumba le-BCG elingaphezu kwe-3cm okanye eliphuma ubomvu</li>
            <li>Usana oludangeleyo, olungaphenduliyo, okanye olulila ngaphandle kokuthuthuzeleka iiyure ezi-3+</li>
          </ol>
        </div>
      </div>
    </section>

    <section style="background: var(--primary-light); border-radius: var(--radius); padding: 20px; margin-bottom: 32px;">
      <h2 style="font-size: 1.1rem; margin-bottom: 8px; color: var(--primary-dark);">Fumana ikliniki enikeza izitofu zokugonya</h2>
      <p style="font-size: 0.9rem; margin-bottom: 12px;">
        Amaziko angu-{immunClinics.length} kwidatabase yethu anikeza iinkonzo zokugonya.
      </p>
      <a href="/services/immunisation" class="btn btn--primary" style="font-size: 0.9rem;">Khangela iikliniki zokugonya</a>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 16px;">Imibuzo Ebuzwa Rhoqo</h2>
      <div style="display: grid; gap: 12px;">
        {faqs.map(faq => (
          <details style="border: 1px solid var(--border); border-radius: var(--radius);">
            <summary style="cursor: pointer; font-weight: 600; font-size: 0.95rem; padding: 14px; list-style: none; display: flex; justify-content: space-between; align-items: center;">
              {faq.question}
              <span style="color: var(--text-muted); flex-shrink: 0; margin-left: 12px;">+</span>
            </summary>
            <div style="padding: 0 14px 14px; font-size: 0.9rem; color: var(--text-muted); line-height: 1.7;">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <section style="border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; font-size: 0.85rem; color: var(--text-muted); line-height: 1.6;">
      <strong style="color: var(--text);">Imithombo:</strong> Expanded Programme on Immunisation — South Africa (EPI-SA, 2023 schedule). National Department of Health immunisation guidelines. WHO position papers on childhood vaccines. Road to Health booklet (RTHB) guidelines — NDoH. HPV vaccination programme — South African school health services.
    </section>
      <section style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border);">
      <h2 style="font-size:1.2rem;margin-bottom:1rem;">Izikhokelo Ezinxulumeneyo</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:0.75rem;">
      <a href={L('/guides/free-maternity-care')} style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Ukhathalelo Lwasimahla Lokukhulelwa</a>
      <a href={L('/guides/family-planning-contraception')} style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Ucwangciso Losapho Nokuthintela Ukumitha</a>
      <a href={L('/guides/hospital-referral-system')} style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Inkqubo Yokuthunyelwa Esibhedlele</a>
      <a href={L('/guides/medical-emergency-guide')} style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Isikhokelo Songxamiseko Lwezonyango</a>
      </div>
    </section>
    <section style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border);">
      <h2 style="font-size:1.2rem;margin-bottom:1rem;">Fumana Iikliniki ngePhondo</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:0.75rem;">
      <a href="/clinics/gauteng" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Gauteng</a>
      <a href="/clinics/kwazulu-natal" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">KwaZulu-Natal</a>
      <a href="/clinics/western-cape" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Western Cape</a>
      <a href="/clinics/eastern-cape" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Eastern Cape</a>
      <a href="/clinics/limpopo" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Limpopo</a>
      <a href="/clinics/mpumalanga" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Mpumalanga</a>
      <a href="/clinics/north-west" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">North West</a>
      <a href="/clinics/free-state" style="display:block;padding:0.75rem 1rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);color:var(--text);text-decoration:none;font-size:0.9rem;font-weight:500;">Free State</a>
