---
/**
 * isiXhosa guide page — sentence-for-sentence translation of src/pages/guide.astro.
 * Deliberately left in English: product, brand and tool names (Clinic Finder SA,
 * Google Maps, WhatsApp, OpenStreetMap, Humanitarian Data Exchange, HOTOSM, GPS,
 * ARVs, TB), the province name examples, the email address, and every number
 * (facility counts, 100 KB, 100%). Section numbering and step order are unchanged.
 */
import Base from '../../layouts/Base.astro';
import { facilities, PROVINCES } from '../../data/helpers';
import { localeHrefFor } from '../../i18n/links';

const L = localeHrefFor('xh');

const totalFacilities = facilities.filter(f => f.province !== '').length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Indlela yokufumana ikliniki karhulumente usebenzisa i-Clinic Finder SA',
  description: `Sebenzisa i-Clinic Finder SA ukukhangela amaziko empilo karhulumente angama-${totalFacilities} kulo lonke uMzantsi Afrika ngephondo, ngenkonzo, okanye ngendawo.`,
  step: [
    {
      '@type': 'HowToStep',
      name: 'Khangela ngegama',
      text: 'Yiya kwiphepha lokuKhangela uze uchwetheze igama lekliniki okanye lesibhedlele. Iziphumo ziyahluzwa njengoko uchwetheza.',
    },
    {
      '@type': 'HowToStep',
      name: 'Jonga ngephondo',
      text: 'Khetha iphondo kwikhasi lasekhaya okanye kwiphepha lamaPhondo ukuze ubone onke amaziko akuloo ndawo.',
    },
    {
      '@type': 'HowToStep',
      name: 'Hluza ngenkonzo',
      text: 'Sebenzisa iphepha leeNkonzo okanye uluhlu oluwayo lweenkonzo kwiphepha lokuKhangela ukufumana iikliniki ezinikeza ii-ARVs, ukuzala umntwana, unyango lwamazinyo, nezinye iinkonzo.',
    },
    {
      '@type': 'HowToStep',
      name: 'Bonisa iiNkcazo zeNdlela ze-Google Maps',
      text: 'Kulo naliphi na iphepha leziko, cofa u-"Bonisa iiNkcazo zeNdlela ze-Google Maps" ukuze uvule i-Google Maps eneenkcazo zendlela yokuqhuba ukusuka kwindawo okuyo ngoku.',
    },
    {
      '@type': 'HowToStep',
      name: 'Yabelana nge-WhatsApp',
      text: 'Cofa iqhosha le-WhatsApp kulo naliphi na iphepha leziko ukuze uthumele iinkcukacha zekliniki nekhonkco kumhlobo okanye kwilungu losapho.',
    },
  ],
};
---
<Base
  title="Indlela Yokusebenzisa i-Clinic Finder SA — Isikhokelo"
  description={`Funda indlela yokukhangela iikliniki nezibhedlele zikarhulumente ezingama-${totalFacilities} kulo lonke uMzantsi Afrika. Fumana amaziko ngegama, ngephondo, ngenkonzo, okanye ngendawo ye-GPS.`}
  jsonLd={[jsonLd, { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Ikhaya', item: 'https://clinicfinder.co.za/xh' }, { '@type': 'ListItem', position: 2, name: 'Isikhokelo' }] }]}
>
  <div class="container" style="padding: 32px 0; max-width: 720px;">
    <nav style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
      <a href={L('/')}>Ikhaya</a> &rsaquo; Isikhokelo
    </nav>
    <h1 style="font-size: 1.5rem; margin-bottom: 8px;">Indlela Yokusebenzisa i-Clinic Finder SA</h1>
    <p style="color: var(--text-muted); margin-bottom: 32px; line-height: 1.7;">
      Le sayithi ikunceda ufumane ikliniki okanye isibhedlele sikarhulumente esifanelekileyo, ujonge ukuba sinikeza ziphi iinkonzo, ufumane iinkcazo zendlela, uze wabelane ngolo lwazi nomntu oludingayo. Yonke into isebenza kuyo nayiphi na ifowuni, isebenzisa idatha encinci, kwaye ayifuni ukubhalisa.
    </p>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">1. Khangela ngegama lekliniki</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Yiya <a href={L('/search')}>kwiphepha lokuKhangela</a> uze uqale ukuchwetheza igama lekliniki okanye lesibhedlele. Iziphumo ziyahluzwa kwangoko njengoko uchwetheza — akukho mfuneko yokucofa u-Enter okanye yokulinda ukuba iphepha lilayishe. Ukukhangela kujonga kuwo onke amaziko angama-{totalFacilities.toLocaleString()} akwidatabheyisi yethu.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">2. Jonga ngephondo</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Ukusuka <a href={L('/')}>kwikhasi lasekhaya</a> okanye <a href={L('/clinics')}>kwiphepha lamaPhondo</a>, khetha iphondo lakho. Iphepha ngalinye lephondo lidwelisa lonke iziko likarhulumente elikuloo ndawo, lihlelwe ngokwabc. Uya kubona kwakhona uhlalutyo lweentlobo zamaziko (iikliniki, izibhedlele zezithili, amaziko empilo oluntu) neenkonzo ezifumanekayo. Amaphepha amaphondo aquka amacebiso empilo asekuhlaleni noluhlu lokuhlola lwento omawuyithathe uye kutyelelo lwakho.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">3. Hluza ngenkonzo</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Ufuna inkonzo ethile — ii-ARVs, ukhathalelo lokuzala umntwana, unyango lwamazinyo, impilo yengqondo? Sebenzisa <a href={L('/services')}>iphepha leeNkonzo</a> ukuze ubone kuphela amaziko anikeza oko ukufunayo. Kwiphepha lokuKhangela, uluhlu oluwayo lweenkonzo lukuvumela ukuba udibanise ukukhangela ngombhalo nesihluzi senkonzo. Umzekelo, khangela u-"Soweto" uze uhluze ngo-"Unyango lwe-TB" ukuze ufumane amaziko anyanga i-TB eSoweto.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">4. Fumana iikliniki ezikufuphi nawe (GPS)</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        <a href={L('/search')}>Kwiphepha lokuKhangela</a>, cofa iqhosha elithi <strong>"Ekufuphi nam"</strong>. Isikhangeli sakho siya kucela imvume yendawo — oku kwenziwa ngokupheleleyo kwisixhobo sakho kwaye indawo okuyo ayithunyelwa kuthi okanye igcinwe. Xa sele uyinikile, iziphumo zihlelwa ngomgama ukuze ubone iziko elikufuphi kuqala. Oku kusebenza kwiifowuni eziphathwayo, kwiithebhulethi, nakwiilaptop ezinenkonzo zendawo ezivuliweyo.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">5. Fumana iinkcazo zendlela eziya kwiziko</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Iphepha ngalinye leziko linekhonkco elithi "Bonisa iiNkcazo zeNdlela ze-Google Maps" elivula i-Google Maps ineziko njengendawo oya kuyo. I-Google Maps iya kubala indlela ukusuka naphi na apho ukhoyo. Ukuba awunayo idatha ye-Google Maps, bhala phantsi idilesi yeziko elikweli phepha — uninzi lwamaziko lubonisa idilesi yesitalato nelokishi.
      </p>
    </section>

    <section style="margin-bottom: 32px;">
      <h2 style="font-size: 1.2rem; margin-bottom: 12px; color: var(--primary-dark);">6. Yabelana ngekliniki nge-WhatsApp</h2>
      <p style="line-height: 1.7; font-size: 0.95rem;">
        Ufumene ikliniki efanelekileyo yomhlobo okanye yelungu losapho? Cofa iqhosha eliluhlaza elithi <strong>"Yabelana ku-WhatsApp"</strong> kulo naliphi na iphepha leziko. Oku kwenza umyalezo osele ubhaliwe onegama lekliniki, iinkonzo eziphambili, nekhonkco elithe ngqo. Umamkeli unokulivula ikhonkco kuyo nayiphi na ifowuni ukuze abone iinkcukacha ezipheleleyo afumane neenkcazo zendlela — akufuneki afakele nantoni na.
      </p>
    </section>

    <section style="background: var(--bg-alt); border-radius: var(--radius); padding: 24px; margin-bottom: 32px;">
      <h2 style="font-size: 1.15rem; margin-bottom: 12px; color: var(--primary-dark);">Amacebiso kubasebenzisi abanedatha encinci</h2>
      <ol style="padding-left: 20px; font-size: 0.95rem; line-height: 1.7; display: grid; gap: 8px;">
        <li>Le sayithi yakhelwe ukuba ibe lula. Iphepha eliqhelekileyo lisebenzisa idatha engaphantsi kwe-100 KB.</li>
        <li>Gcina iphepha leziko njengebhukhmakhi okanye ulifake kwisikrini sakho sasekhaya ukuze ulifikelele ngaphandle kwe-intanethi.</li>
        <li>Ukwabelana nge-WhatsApp kuthumela ikhonkco elingumbhalo, hayi umfanekiso — kubiza phantse akukho nto ngedatha.</li>
        <li>Ukuba ukwisicwangciso sedatha esilinganiselweyo, sebenzisa amaphepha amaphondo endaweni yokukhangela — alayisha kanye aze abonise yonke into.</li>
      </ol>
    </section>

    <section style="border: 1px solid var(--border); border-radius: var(--radius); padding: 24px;">
      <h2 style="font-size: 1.15rem; margin-bottom: 12px; color: var(--primary-dark);">Malunga nedatha yethu</h2>
      <p style="font-size: 0.95rem; line-height: 1.7;">
        I-Clinic Finder SA ithatha idatha kwa-OpenStreetMap nakwi-Humanitarian Data Exchange (HOTOSM). Siyaqinisekisa ngokuchasanisa noluhlu olusemthethweni lweSebe lezeMpilo apho kunokwenzeka khona, kodwa asiyosayithi karhulumente kwaye asinakuqinisekisa ukuchaneka kwe-100%. Ukuba iziko lifudukile, litshintshile amaxesha alo, okanye longeze iinkonzo ezintsha, <a href="mailto:hello@clinicfinder.co.za">sithumelele i-imeyile</a> kwaye siza kuyihlaziya.
      </p>
    </section>
  </div>
</Base>
