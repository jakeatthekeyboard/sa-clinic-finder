---
import { LOCALES, localeOf, localePath, stripLocale, type Locale } from '../i18n/config';
import { availableLocales } from '../i18n/translated';
import { strings } from '../i18n/strings';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import TranslationDisclaimer from '../components/TranslationDisclaimer.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  /** Defaults to the locale of the current URL — a page under /xh never has to declare it. */
  locale?: Locale;
}

const { title, description, canonical, jsonLd, noindex, locale = localeOf(Astro.url.pathname) } = Astro.props;
const url = canonical || Astro.url.href;
const ogImage = new URL('/social-image.png', Astro.site ?? 'https://clinicfinder.co.za').href;

const site = Astro.site ?? new URL('https://clinicfinder.co.za');
const basePath = stripLocale(Astro.url.pathname);
const t = strings(locale);
const nav = (path: string) => localePath(path, locale);

// hreflang: only emit alternates for translations that actually exist. Advertising a
// page that 404s makes Google drop the whole cluster (see src/i18n/translated.ts).
// Canonical stays self-referential — each locale is a distinct indexable document;
// the reader-facing relationship is carried by the disclaimer's link to English.
const alternates = availableLocales(basePath).map((code) => ({
  tag: LOCALES[code].tag,
  href: new URL(localePath(basePath, code), site).href,
}));
const xDefault = new URL(basePath, site).href;
---
<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="google-site-verification" content="uSpqQ6rUz_bHQT-Agy2OzDfp0mhxFwk46g20121lJss" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta name="robots" content="max-image-preview:large" />
  <link rel="canonical" href={url} />
  {alternates.length > 1 && alternates.map((alt) => (
    <link rel="alternate" hreflang={alt.tag} href={alt.href} />
  ))}
  {alternates.length > 1 && <link rel="alternate" hreflang="x-default" href={xDefault} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-friendly content" />
  <meta name="theme-color" content="#b91c1c" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={url} />
  <meta property="og:site_name" content="ClinicFinder" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1500" />
  <meta property="og:image:height" content="750" />
  <meta property="og:image:alt" content="ClinicFinder — find public health facilities and services near you in South Africa" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {jsonLd && (Array.isArray(jsonLd)
    ? jsonLd.map(ld => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)
    : <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
  <script is:inline>
    (function(c,l,a,r,i,t,y){
      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
      t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "whkj5s113q");
  </script>
  <style is:global>
    :root {
      --primary: #b91c1c;
      --primary-dark: #991b1b;
      --primary-light: #fef2f2;
      --text: #1a1a1a;
      --text-muted: #555;
      --bg: #fff;
      --bg-alt: #f7f9f8;
      --border: #e0e0e0;
      --radius: 8px;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      color: var(--text);
      background: var(--bg);
      line-height: 1.6;
      -webkit-text-size-adjust: 100%;
    }
    a { color: var(--primary); text-decoration: none; }
    a:hover { text-decoration: underline; }
    /* !important guards against per-page inline `style="padding: 32px 0;"` shorthand wiping horizontal padding. */
    .container {
      max-width: 960px;
      margin: 0 auto;
      padding-left: max(20px, env(safe-area-inset-left)) !important;
      padding-right: max(20px, env(safe-area-inset-right)) !important;
    }
    @media (min-width: 600px) {
      .container {
        padding-left: max(32px, env(safe-area-inset-left)) !important;
        padding-right: max(32px, env(safe-area-inset-right)) !important;
      }
    }
    .chip {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 0.8rem;
      background: var(--primary-light);
      color: var(--primary-dark);
      margin: 2px;
    }
    .chip--type {
      background: var(--primary);
      color: #fff;
      font-weight: 600;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 10px 20px;
      border-radius: var(--radius);
      font-weight: 600;
      font-size: 0.95rem;
      border: none;
      cursor: pointer;
      text-decoration: none;
    }
    .btn--primary { background: var(--primary); color: #fff; }
    .btn--primary:hover { background: var(--primary-dark); text-decoration: none; }
    .btn--outline { background: transparent; border: 2px solid var(--primary); color: var(--primary); }
    .btn--wa { background: #25D366; color: #fff; }
    .btn--wa:hover { background: #1da851; text-decoration: none; }
    .card {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px;
      transition: box-shadow 0.15s;
    }
    .card:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
  </style>
</head>
<body>
  <script>
    import { inject } from '@vercel/analytics';
    inject();
  </script>
  <header style="background: var(--primary); color: #fff; padding: 12px 0;">
    <div class="container" style="display: flex; align-items: center; justify-content: space-between;">
      <a href={nav('/')} style="color: #fff; font-weight: 700; font-size: 1.1rem; display: inline-flex; align-items: center; gap: 6px;"><span style="font-size: 1.3rem; line-height: 1;" aria-hidden="true">🇿🇦</span> {t.brand}</a>
      <div style="display: flex; align-items: center; gap: 16px;">
        <nav style="display: flex; gap: 16px; font-size: 0.9rem;" aria-label="Main navigation">
          <a href={nav('/clinics')} style="color: #fff;">{t.navProvinces}</a>
          <a href={nav('/services')} style="color: #fff;">{t.navServices}</a>
          <a href="/search" style="color: #fff;">{t.navSearch}</a>
          <a href={nav('/guides')} style="color: #fff;">{t.navGuides}</a>
        </nav>
        <LanguageSwitcher />
      </div>
    </div>
  </header>
  <TranslationDisclaimer locale={locale} />
  <main>
    <slot />
  </main>
  <footer style="background: var(--bg-alt); border-top: 1px solid var(--border); padding: 24px 0; margin-top: 48px; font-size: 0.85rem; color: var(--text-muted);">
    <div class="container">
      <p>{t.footerTagline}</p>
      <p style="margin-top: 8px;">{t.footerSource}</p>
      <p style="margin-top: 8px;">{t.footerNotAdvice}</p>
      <p style="margin-top: 8px;">{t.footerCorrections} <a href="/contact">{t.footerCorrectionsLink}</a>.</p>
      <p style="margin-top: 8px;"><a href="/about">About</a> · <a href="/contact">Contact</a> · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="/how-this-site-is-made">How This Site Is Made</a></p>
      <p style="margin-top: 8px;" data-ai-disclosure>AI disclosure: text on this page is AI-generated and published under human editorial review. <a href="/how-this-site-is-made">How this site is made</a>.</p>
    </div>
  </footer>
</body>
</html>
