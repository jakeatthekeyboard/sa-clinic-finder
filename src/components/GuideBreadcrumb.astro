---
interface Props {
  title: string;
}
const { title } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://clinicfinder.co.za/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://clinicfinder.co.za/guides' },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};
---
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
